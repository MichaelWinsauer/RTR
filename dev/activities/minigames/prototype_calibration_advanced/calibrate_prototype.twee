:: Calibrate prototype [nobr] {"position":"500,750"}
/* Layout of the Stage 0 prototype. Same mechanics as the devices (see "CalibrateDevice"), but a rougher machine:
   fewer dials, and it glitches more the less finished it is (see "glitch" in CalibrateDevice). */
<div class="cal">
	<div class="cal-head">
		<div class="cal-id">
			<div class="cal-device">
				<svg viewBox="0 0 100 100" width="100%" height="100%" fill="none" stroke="#EBDDC5" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
					<rect x="12" y="18" width="76" height="64" rx="6" fill="#EBDDC5" fill-opacity="0.06"></rect>
					<rect x="24" y="30" width="22" height="16" rx="2" opacity="0.7"></rect>
					<rect x="54" y="30" width="22" height="10" rx="2" opacity="0.7"></rect>
					<path d="M30 62 C40 56 46 70 56 62 S72 56 76 66" opacity="0.8"></path>
					<circle cx="70" cy="50" r="4" fill="#DB354C" stroke="none"></circle>
					<path d="M12 70 C2 72 4 88 14 90" stroke="#EAAF4C" opacity="0.8"></path>
				</svg>
			</div>
			<div>
				<div class="cal-title">Prototype Calibration</div>
				<div class="cal-sub">
					<span class="cal-tag"><<print _proto.name>></span>
					<span class="cal-tag"><<print setup.presetLabel(_preset).toUpperCase()>></span>
					<span class="cal-tag warn">Stability <<= Math.round(Math.clamp($company.prototype.progress, 0, 100))>>%</span>
				</div>
			</div>
		</div>
		<div class="cal-timer">
			<div id="timer">35s</div>
			<div class="cal-timer-label">Remaining</div>
		</div>
	</div>
	<div class="cal-bar"><div id="timer-bar"></div></div>

	<div class="cal-body">
		<div class="cal-panel cal-screen">
			<div class="cal-label"><span>Waveform match</span><span>Area calibration</span></div>
			<div class="cal-wave"><canvas id="wave-canvas" width="640" height="240"></canvas></div>
			<div class="cal-sliders">
				<label class="cal-slider"><span class="cal-slider-top"><span>Freq</span><output></output></span><input type="range" id="freq" min="0.02" max="0.06" step="0.01" value="0.04"></label>
				<label class="cal-slider"><span class="cal-slider-top"><span>Amp</span><output></output></span><input type="range" id="amp" min="20" max="80" step="10" value="50"></label>
				<label class="cal-slider"><span class="cal-slider-top"><span>Phase</span><output></output></span><input type="range" id="phase" min="0" max="6" step="0.5" value="3"></label>
			</div>
		</div>

		<div class="cal-panel cal-code">
			<div class="cal-label"><span>Signal decode</span><span>Type to restore</span></div>
			<div class="cal-signals">
				<div class="cal-signal">
					<div class="cal-signal-head"><span>Signal 1</span><span class="glitch-feedback">Corrupted</span></div>
					<div class="glitch-text"></div>
					<input type="text" class="glitch-input" placeholder="Type the exact phrase..." autocomplete="off" spellcheck="false">
				</div>
				<div class="cal-signal">
					<div class="cal-signal-head"><span>Signal 2</span><span class="glitch-feedback">Corrupted</span></div>
					<div class="glitch-text"></div>
					<input type="text" class="glitch-input" placeholder="Type the exact phrase..." autocomplete="off" spellcheck="false">
				</div>
			</div>
		</div>

		<div class="cal-panel cal-dials">
			<div class="cal-label"><span>Dials</span><span>Align to the marker</span></div>
			<div class="cal-dial-field">
				<div class="cal-dial-grid">
					<div class="dial-wrapper"><div class="dial"></div><div class="dial-label">Dial 1</div></div>
					<div class="dial-wrapper"><div class="dial"></div><div class="dial-label">Dial 2</div></div>
					<div class="dial-wrapper"><div class="dial"></div><div class="dial-label">Dial 3</div></div>
					<div class="dial-wrapper"><div class="dial"></div><div class="dial-label">Dial 4</div></div>
					<div class="dial-wrapper"><div class="dial"></div><div class="dial-label">Dial 5</div></div>
				</div>
			</div>
		</div>
	</div>

	<div class="cal-foot">
		<div id="cal-status"></div>
		<button id="submit-btn" class="submit-btn">Submit calibration</button>
	</div>
</div>
