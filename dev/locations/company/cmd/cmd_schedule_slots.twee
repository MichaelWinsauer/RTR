:: CMD Schedule Slots [nobr] {"position":"1975,3225","size":"100,200"}
<<for _i = 0; _i < $timeSlots.length; _i++>>
	<div class="cmd-schedule-timeslots">
        <<if $time.current.value == $timeSlots[_i].value>>
        	<span style="margin: 0 .25em; width: 20%; font-size: 10pt; font-weight: bold;" class="accent"><<= $timeSlots[_i].text>></span>
        <<else>>
        	<span style="margin: 0 .25em; width: 20%; font-size: 10pt"><<= $timeSlots[_i].text>></span>
        <</if>>
    </div>
<</for>>


