:: CMD Other [nobr] {"position":"2100,3025","size":"100,100"}
<div class="cmd-valenx-scroller">
  <<for _key, _proto range State.variables.company.devices>>
    <<if _proto.owned>>
      <<capture _key _proto>>
        <div class="cmd-valenx-device" @data-key="_key" onclick="openValenxDialog(this.dataset.key)">
          <div class="cmd-valenx-device-name"><<print _proto.name>></div>
          <<= _proto.design>>
          <div @class="'cmd-valenx-device-charge ' + (_proto.charge > 66 ? 'green' : (_proto.charge > 33 ? 'yellow' : 'red'))"><<print _proto.charge>>%</div>
          /* a device with a limited number of uses (the Anchor): how many are left */
          <<if _proto.maxUses>><div class="cmd-valenx-device-uses"><<= setup.deviceUsesLeft(_proto)>> of <<= _proto.maxUses>> uses left</div><</if>>
        </div>
      <</capture>>
    <</if>>
  <</for>>
  /* the hidden unit behind the vent of the Stage 1 office ("Company stats" in Define Company): no charge, a level instead */
  <<if $company.stage >= 1 && $company.vent.owned>>
    <<set _ventLevel to setup.ventLevel()>>
    <div class="cmd-valenx-device cmd-vent-device" onclick="openVentDialog()">
      <div class="cmd-valenx-device-name">Vent Unit</div>
      <<= setup.ventDesign>>
      <div @class="'cmd-valenx-device-charge ' + ['', '', 'yellow', 'red'][$company.vent.level]"><<= _ventLevel.name>> · <<= _ventLevel.output>>%</div>
    </div>
  <</if>>
</div>

<<script>>
window.openValenxDialog = function(key) {
  if (key === "vent") return window.openVentDialog();
  const proto = State.variables.company.devices[key];
  if (!proto) return;

  State.variables.temp = State.variables.temp || {};
  State.variables.temp.currentDeviceKey = key;

  const daysAgo = State.variables.date && State.variables.date.today ? (State.variables.date.dayCount - proto.lastUsedAtDay) : 0;
  const lastUsedText = proto.lastUsedOnWho ? `${setup.presetLabel(proto.lastUsedOnWho)} • ${daysAgo} days ago` : "Never used";

  let presetsHTML = '';
  proto.calibrationPresets.forEach(preset => {
    presetsHTML += `<option value="${preset}">${setup.presetLabel(preset)}</option>`;
  });

  const content = `
    <div class="valenx-dialog glass-panel">
      <div class="dialog-header">
        <div class="device-visual">
          ${proto.design}
        </div>
        <div class="header-left">
          <span class="device-name">${proto.name}</span>
          <span class="device-subtitle">Prototype Device</span>
        </div>
      </div>

      <div class="dialog-body">
        <div class="device-info">
          <div class="info-section">
            <div class="section-label">DESCRIPTION</div>
            <div class="description">${proto.description}</div>
          </div>

          <div class="info-section">
            <div class="section-label">CURRENT STATUS</div>
            <div class="stat-grid">
              <div class="stat-item">
                <span class="stat-label">Calibration</span>
                <span class=${proto.calibration == "mom" || proto.calibration == "sister" ? "stat-img" : "stat-value"}>
                ${proto.calibration == "mom" || proto.calibration == "sister" ?  "<<Media 'images/characters/portraits/" + proto.calibration + ".jpg' '' '' 'false'>>" : setup.presetLabel(proto.calibration)}
                </span>
              </div>
              <div class="stat-item">
                <span class="stat-label">Last Used</span>
                <span class="stat-value">${lastUsedText}</span>
              </div>
              ${proto.maxUses ? `<div class="stat-item">
                <span class="stat-label">USES LEFT</span>
                <span class="stat-value">${setup.deviceUsesLeft(proto)} of ${proto.maxUses}</span>
              </div>` : ""}
              <div class="stat-item">
                <span class="stat-label">CHARGE</span>
                <span class="charge-num ${proto.charge > 66 ? 'green' : proto.charge > 33 ? 'yellow' : 'red'}">${proto.charge}%</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="dialog-controls">
        <div class="control-group">
          <div class="section-label">CHANGE CALIBRATION PRESET</div>
          <div class="preset-row">
            <select id="calibration-select" class="glass-select">
              ${presetsHTML}
            </select>
            <button class="glass-btn primary" onclick="applyCalibration()">Calibrate</button>
          </div>
        </div>

        <div class="control-group">
          <div class="section-label">DEVICE ACTIONS</div>
          <div class="action-row">
            ${setup.chargeActionsToFull(proto) > 0
              ? `<button class="glass-btn" onclick="chargeDevice(1)">Charge (1 action, +${setup.deviceChargePerAction}%)</button>`
                + (setup.chargeActionsToFull(proto) > 1 ? `<button class="glass-btn" onclick="chargeDevice('full')">Charge to full (${setup.chargeActionsToFull(proto)} actions)</button>` : "")
              : `<button class="glass-btn" disabled>Fully charged</button>`}
          </div>
        </div>
      </div>
    </div>
  `;

  Dialog.setup("", "glass-dialog");
  Dialog.wiki(content);
  Dialog.open();
  
  setTimeout(() => {
    const select = document.getElementById('calibration-select');
    if (select) {
      select.value = proto.calibration;
    }
  }, 80);
};

window.applyCalibration = function() {
  const key = State.variables.temp.currentDeviceKey;
  const proto = State.variables.company.devices[key];
  if (!proto) return;

  const select = document.getElementById('calibration-select');
  if (!select) return;

  State.variables.activePrototype = key;
  State.variables.calibrationPreset = select.value;

  Dialog.close();
  setTimeout(() => {
    SugarCube.Engine.play('CalibrateDevice');
  }, 150);
};

/* Charging takes my time (Define Company, "Charging the Stage 1 devices"): actions = 1, or "full" for as many
   as it takes to fill it. The actions are spent with <<UseAction>>, so the clock, tasks and staff work go on as
   usual, and then the desk is drawn again. */
window.chargeDevice = function(actions) {
  const key = State.variables.temp.currentDeviceKey;
  const proto = State.variables.company.devices[key];
  if (!proto) return;
  const toFull = setup.chargeActionsToFull(proto);
  if (toFull <= 0) return;
  const n = actions === "full" ? toFull : Math.min(toFull, Math.max(1, Number(actions) || 1));

  proto.charge = Math.min(proto.maxCharge, proto.charge + n * setup.deviceChargePerAction);
  Notification.show(proto.name + (proto.charge >= proto.maxCharge ? " is fully charged." : " is at " + proto.charge + "% now."), { type: Notification.POSITIVE });

  Dialog.close();
  $.wiki('<<UseAction ' + n + '>>');
  setTimeout(() => Engine.play(State.active.title), 80);
};

/* The vent unit: one button per setup.ventLevels entry. What each level does to the efficiency target and
   to the morale the staff lose while working comes straight from that list (Define Company). */
window.openVentDialog = function() {
  const sv = State.variables;
  const levels = setup.ventLevels;
  const current = setup.ventLevel();
  const stats = sv.company.stats;
  const target = setup.efficiencyTarget();
  const breakdown = setup.efficiencyBreakdown()
    .map(s => `<div class="vent-row"><span>${s.label}</span><b>${s.value > 0 ? '+' : ''}${s.value}</b></div>`).join('');
  const buttons = levels.map((lvl, i) => `
    <button class="glass-btn vent-level ${lvl === current ? 'primary' : ''}" onclick="setVentLevelFromDialog(${i})">
      <span>${lvl.name}</span><small>${lvl.output}% · Eff. ${lvl.efficiency} · Morale ×${lvl.drain}</small>
    </button>`).join('');
  const trend = stats.efficiency < target ? 'rising' : (stats.efficiency > target ? 'falling' : 'steady');

  const content = `
    <div class="valenx-dialog glass-panel">
      <div class="dialog-header">
        <div class="device-visual">${setup.ventDesign}</div>
        <div class="header-left">
          <span class="device-name">Vent Unit</span>
          <span class="device-subtitle">Hidden installation · main room</span>
        </div>
      </div>

      <div class="dialog-body">
        <div class="device-info">
          <div class="info-section">
            <div class="section-label">DESCRIPTION</div>
            <div class="description">The full-strength ${sv.company.prototype.name} behind the ceiling vent of the main room. It runs off the building's power, so it never needs charging, and nobody who works under it knows it's there.</div>
          </div>

          <div class="info-section">
            <div class="section-label">CURRENT STATUS</div>
            <div class="stat-grid">
              <div class="stat-item"><span class="stat-label">Output</span><span class="stat-value">${current.output}%</span></div>
              <div class="stat-item"><span class="stat-label">Efficiency</span><span class="stat-value">${stats.efficiency} (${trend})</span></div>
              <div class="stat-item"><span class="stat-label">Target</span><span class="stat-value">${target}</span></div>
            </div>
            <div class="vent-breakdown">${breakdown}</div>
          </div>
        </div>
      </div>

      <div class="dialog-controls">
        <div class="control-group">
          <div class="section-label">OUTPUT LEVEL</div>
          <div class="vent-levels">${buttons}</div>
          <div class="description vent-note">${current.text}</div>
        </div>
      </div>
    </div>
  `;

  Dialog.setup("", "glass-dialog");
  Dialog.wiki(content);
  Dialog.open();
};

window.setVentLevelFromDialog = function(level) {
  setup.setVentLevel(level);
  $(".cmd-other").empty().wiki('<<include "CMD Other">>');
  window.openVentDialog();
};

setTimeout(() => {
  const scroller = document.querySelector('.cmd-valenx-scroller');
  if (!scroller) return;

  scroller.addEventListener('wheel', function(e) {
    if (e.deltaY === 0) return;
    e.preventDefault();
    scroller.scrollLeft += e.deltaY * 1;
  }, { passive: false });
}, 50);
<</script>>

<style>
.cmd-valenx-scroller {
  display: flex;
  gap: .6rem;
  overflow-x: scroll;
  align-items: center;
  width: 100%;
  height: 100%;
  overscroll-behavior: contain;
  scroll-behavior: smooth;
}

.cmd-valenx-device {
  height: 100%;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  transition: transform .1s ease;
  background-color: var(--card-bg);
  border: 1px solid var(--card-border);
  box-sizing: border-box;
  padding: .25rem;
  border-radius: .75rem;
  overflow-y: visible;
  min-width: 8rem;
}

.cmd-valenx-device:hover {
  transform: scale(0.975);
}

.cmd-valenx-device svg {
  width: 100%;
  flex: 1;
  display: block;
  min-height: 0;
}

.cmd-valenx-device-name {
  font-weight: 300;
  color: #EBDDC5;
  text-align: center;
  margin-bottom: .15rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 1px;
  text-transform: uppercase;
  font-size: .75rem;
}

.cmd-valenx-device-charge {
  font-size: .7rem;
  font-weight: 100;
  text-align: center;
  margin-top: .2rem;
}

.glass-dialog .dialog {
  background: rgba(20, 18, 35, 0.92);
  border: 1px solid rgba(235, 221, 197, 0.25);
  border-radius: 16px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(20px);
  max-width: 820px;
  width: 92vw;
}

.valenx-dialog {
  color: #EBDDC5;
  font-size: .95rem;
}

.dialog-header {
  display: flex;
  padding: .5rem;
  border-bottom: 1px solid rgba(235, 221, 197, 0.15);
  gap: 1rem;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.cmd-valenx-device-uses {
  font-size: .65rem;
  letter-spacing: .08em;
  text-transform: uppercase;
  opacity: .7;
}

.device-name {
  font-size: 1.35rem;
  font-weight: 300;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.device-subtitle {
  font-size: .7rem;
  opacity: .8;
  letter-spacing: 1px;
}

.dialog-body {
  display: flex;
  gap: 1.5rem;
  padding: 1.25rem;
  align-items: flex-start;
}

.device-visual {
  position: relative;
  height: 56%;
  width: 3rem;
}

.device-visual svg {
  width: 100%;
  height: auto;
  max-height: 280px;
  filter: drop-shadow(0 10px 30px rgba(235, 221, 197, 0.15));
}

.device-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
  min-width: 0;
}

.info-section {
  background: rgba(235, 221, 197, 0.04);
  border: 1px solid rgba(235, 221, 197, 0.12);
  border-radius: 10px;
  padding: .85rem 1rem;
}

.section-label {
  font-size: .65rem;
  letter-spacing: 2px;
  text-transform: uppercase;
  opacity: .8;
  margin-bottom: .75rem;
}

.description {
  font-size: .9rem;
  line-height: 1.45;
  opacity: 1;
}

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: .75rem;
}

.stat-item {
  display: flex;
  flex-direction: column;
  gap: 2px;
  align-items: center;
}

.stat-label {
  font-size: .55rem;
  letter-spacing: 1.5px;
  opacity: .8;
  text-transform: uppercase;
}

.stat-value {
  font-size: .95rem;
  font-weight: 300;
  color: #fff;
}

.stat-img {
  width: 2rem;
  overflow: hidden;
  height: 2rem;
  border-radius: 2rem;
  border: 2px solid var(--accent);
}

.dialog-controls {
  border-top: 1px solid rgba(235, 221, 197, 0.15);
  padding: 1.1rem 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.control-group {
  display: flex;
  flex-direction: column;
  gap: .5rem;
}

.preset-row,
.action-row {
  display: flex;
  gap: .6rem;
  align-items: center;
}

.glass-select {
  flex: 1;
  background: rgba(20, 18, 35, 0.6);
  border: 1px solid rgba(235, 221, 197, 0.25);
  color: #EBDDC5;
  padding: .55rem .85rem;
  border-radius: 8px;
  font-size: .9rem;
  outline: none;
}

.glass-select:focus {
  border-color: #EBDDC5;
}

.glass-btn {
  padding: .55rem 1.1rem;
  border-radius: 8px;
  border: 1px solid rgba(235, 221, 197, 0.25);
  background: rgba(235, 221, 197, 0.08);
  color: #EBDDC5;
  font-size: .85rem;
  cursor: pointer;
  transition: all .15s ease;
  white-space: nowrap;
}

.glass-btn:hover {
  background: rgba(235, 221, 197, 0.18);
  border-color: rgba(235, 221, 197, 0.4);
}

.glass-btn.primary {
  background: rgba(235, 221, 197, 0.2);
  border-color: #EBDDC5;
}

.glass-btn.primary:hover {
  background: rgba(235, 221, 197, 0.35);
}

/* the vent unit dialog */
.vent-breakdown {
  display: flex;
  flex-direction: column;
  gap: .2rem;
  margin-top: .75rem;
  padding-top: .6rem;
  border-top: 1px solid rgba(235, 221, 197, 0.12);
  font-size: .8rem;
}

.vent-row {
  display: flex;
  justify-content: space-between;
  opacity: .85;
}

.vent-levels {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: .5rem;
}

.vent-level {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .2rem;
  white-space: normal;
}

.vent-level small {
  font-size: .65rem;
  opacity: .75;
}

.vent-note {
  font-size: .85rem;
  opacity: .85;
}
</style>


