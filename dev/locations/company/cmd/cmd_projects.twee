/* ——— progress bars ——— */
.prj-bars {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
  gap: 1rem 1.4rem;
  margin-top: .9rem;
}

.prj-bar-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
