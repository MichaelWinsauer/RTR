}

.prj-bar-track {
  height: 6px;
  overflow: hidden;
  background-color: #EBDDC51f;
  border-radius: 999px;
}

.prj-bar-fill {
  height: 100%;
  background-color: #EBDDC5;
  border-radius: 999px;
  box-shadow: 0 0 .6em #EBDDC570;
  transition: width .5s ease;
}

.prj-bar.is-done .prj-bar-fill {
  background-color: #1cd88d;
  box-shadow: 0 0 .6em #1cd88d70;
}

.prj-hint {
  display: block;
  margin-top: .35rem;
  font-size: .72rem;
