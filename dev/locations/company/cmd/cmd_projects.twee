  background-color: #EBDDC510;
  border: 1px solid #EBDDC540;
  border-radius: 999px;
  cursor: pointer;
  transition: background-color .15s ease, color .15s ease;
}

.prj-pill-btn:hover:not([disabled]) {
  color: #1a1408;
  background-color: #EBDDC5;
}

.prj-pill-btn[disabled] {
  opacity: .35;
  cursor: default;
}

