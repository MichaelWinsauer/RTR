/* ——— buttons ——— */
.prj-btn {
  flex: 0 0 auto;
  width: 2rem;
  height: 2rem;
  padding: 0;
  font-family: inherit;
  font-size: 1.1rem;
  font-weight: 700;
  line-height: 1;
  border-radius: 50%;
  cursor: pointer;
  transition: background-color .15s ease, color .15s ease, border-color .15s ease;
}

.prj-btn.add {
  color: #EBDDC5;
  background-color: #EBDDC514;
  border: 1px solid #EBDDC560;
}

.prj-btn.add:hover {
  color: #1a1408;
  background-color: #EBDDC5;
