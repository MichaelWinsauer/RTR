:: CMD Mails [nobr] {"position":"2225,3375","size":"200,100"}
/* The rows are built in JS (window.cmdInboxRows, in the script below): this panel is drawn on every click at the desk,
   and a <<for>> with an <<Image>> per mail was slow. Title and preview may contain variables, so they go through window.wikifyMaybe */
<<script>>
window.cmdInboxRows = function () {
    const mails = State.variables.company.mails.slice().reverse().filter((mail) => mail.active == true);
    return mails.map((mail) => {
        const preview = mail.body && mail.body[0] ? String(mail.body[0].text).replace(/[\n\r]+/g, " ").trim() : "";
        /* the row shows one line of it: cut at a space after 160 characters (that never splits a naked variable) */
        const cut = preview.length > 160 ? preview.indexOf(" ", 160) : -1;
        const short = cut > 0 ? preview.slice(0, cut) + "..." : preview;
        return '<div class="cmd-inbox-mail" data-id="' + mail.id + '">'
            + '<div class="cmd-inbox-mail-read-icon-wrapper">'
            + '<div class="cmd-inbox-mail-read">' + (mail.read ? "" : "&#11044;") + '</div>'
            + '<div class="cmd-inbox-mail-icon">' + setup.mediaInline("image", ["images/characters/portraits/", mail.who.sysName, ".jpg", "", "", "false"]) + '</div>'
            + '</div>'
            + '<div class="cmd-inbox-mail-title-body-wrapper">'
            + '<div class="cmd-inbox-mail-title">' + window.wikifyMaybe(mail.title) + '</div>'
            + '<div class="cmd-inbox-mail-body">' + window.wikifyMaybe(short) + '</div>'
            + '</div>'
            + '<div class="cmd-inbox-mail-flag">' + (mail.flagged ? "&#10022;" : "&#10023;") + '</div>'
            + '</div>';
    }).join("");
};
$(output).append('<div class="cmd-inbox">' + window.cmdInboxRows() + '</div>');
<</script>>

<<script>>
/* === OPEN MAIL + INSTANT READ UPDATE ===
   Namespaced and switched off first: this script runs on every redraw of the panel, and a plain .on() would add
   one more handler each time (one click opening the mail several times). */
$(document).off('click.cmdMail').on('click.cmdMail', '.cmd-inbox-mail', function () {
    const $row = $(this);
    const id = parseInt($row.data('id'));
    const mail = State.variables.company.mails.find(m => m.id === id);
    
    if (!mail) return;

    /* Mark as read + remove the dot IMMEDIATELY */
    if (!mail.read) {
        mail.read = true;
        $row.find('.cmd-inbox-mail-read').html('');   /* instant visual update */
        if (window.cmdRefreshHeader) window.cmdRefreshHeader();   /* "Next up" unread count */
    }

    State.temporary.selectedMail = mail;

    /* Open the dialog */
    Dialog.setup("", "mail-dialog");
    const content = `<<Mail _selectedMail>>`;
    
    Dialog.append(function () {
        $(this).wiki(content);
    });
    Dialog.open();
});

/* === TOGGLE FLAG / STAR === */
$(document).off('click.cmdMailFlag').on('click.cmdMailFlag', '.cmd-inbox-mail-flag', function (e) {
    e.stopImmediatePropagation();

    const $row = $(this).closest('.cmd-inbox-mail');
    const id = parseInt($row.data('id'));
    const mail = State.variables.company.mails.find(m => m.id === id);
    
    if (!mail) return;

    mail.flagged = !mail.flagged;
    $(this).html(mail.flagged ? '✦' : '✧');
});

/* === HANDLE MAIL REPLY SELECTION === */
window.handleMailReply = function(mailId, optionId) {
    const mail = State.variables.company.mails.find(m => m.id === mailId);
    if (!mail) return;

    const option = mail.answerOptions.find(opt => opt.id === optionId);
    if (!option) return;
    /* a locked answer (an offer she isn't ready for, a price the account can't cover) can't be sent */
    if (setup.mailOptionLock(option)) return;
    if (option.money) setup.spend(option.money, mail.title);

    /* Add player reply to body */
    mail.body.push({
        who: { sysName: "player" },
        text: option.text
    });

    mail.answered = true;

    /* Run the eval you added (function or array of functions) */
    if (option.eval) {
        try {
            if (typeof option.eval === "function") {
                option.eval();
            } else if (Array.isArray(option.eval)) {
                option.eval.forEach(fn => {
                    if (typeof fn === "function") fn();
                });
            }
        } catch (e) {
            console.error("Error running mail eval:", e);
        }
    }

    /* Remove ALL answer options permanently */
    mail.answerOptions = [];

    /* Refresh the dialog so the reply appears and options disappear */
    Dialog.close();
    State.temporary.selectedMail = mail;

    Dialog.setup("", "mail-dialog");
    const content = `<<Mail _selectedMail>>`;
    Dialog.append(function () {
        $(this).wiki(content);
    });
    Dialog.open();
};
<</script>>

<style>
#ui-dialog-body.mail-dialog {
  background-color: transparent;
  border: none;
  backdrop-filter: none;
  width: 135% !important;
  transform: translateX(-13.5%);
}

#ui-dialog-body.mail-dialog.ui-close {
  transform: translateY(3em);
  z-index: 999;
}
</style>


