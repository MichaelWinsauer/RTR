:: Dev Caption  [system nobr] {"position":"1800,625","size":"200,100"}
<<if $debug == true>>
<<nobr>>
<div class="sb-dev">
<span class="sb-dev-toggle"><<link "Dev tools">>
	<<set $devOpen to !$devOpen>>
	<<run $('#sb-dev-body').toggleClass('open', $devOpen)>>
<</link>></span>
<div id="sb-dev-body" @class="$devOpen ? 'sb-dev-body open' : 'sb-dev-body'">

<div class="sb-dev-group"><span class="sb-dev-h">Time</span>
<<link "UseAction">>
	<<UseAction>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "AdvanceTime">>
	<<AdvanceTime>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "AdvanceDay">>
	<<AdvanceDay>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
</div>

<div class="sb-dev-group"><span class="sb-dev-h">Quests</span>
<<link "Next Main Quest">>
	<<NextQuest $player>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "Next $mom.callName Quest">>
	<<NextQuest $mom>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "Next $sister.callName Quest">>
	<<NextQuest $sister>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "Next $prof.callName Quest">>
	<<NextQuest $prof>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "Next $manager.callName Quest">>
	<<NextQuest $manager>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "Next $boss.callName Quest">>
	<<NextQuest $boss>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "Next $landlord.callName Quest">>
	<<NextQuest $landlord>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "Complete All Quests">>
	<<SkipToQuest $player "main_end" "false">>
	<<SkipToQuest $mom "mom_end" "false">>
	<<SkipToQuest $sister "sister_end" "false">>
	<<SkipToQuest $landlord "landlord_end" "false">>
	<<SkipToQuest $manager "manager_end" "false">>
	<<SkipToQuest $boss "boss_end" "false">>
	<<SkipToQuest $prof "prof_end" "false">>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
</div>

<div class="sb-dev-group"><span class="sb-dev-h">Player</span>
<<link "+5 Corruption">>
	<<set $player.stats.corruption += 5>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "+5 Progress">>
	<<set $company.prototype.progress += 5>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "+ $1000">>
	<<if $company.stage == 0>>
		<<set $player.money += 1000>>
	<<else>>
		<<set $company.finances.money += 1000>>
	<</if>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
</div>

<div class="sb-dev-group"><span class="sb-dev-h">Device</span>
<<link "Charge Full">>
	<<set $company.prototype.charge = $company.prototype.maxCharge>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "Cal. General">>
	<<set $company.prototype.calibration = "general">>
	<<set $company.prototype.calibrationQuality = 100>>
	<<set $company.prototype.calibratedAtDay = $date.dayCount>>

	<<set $company.devices.valenx.calibration = "general">>
	<<set $company.devices.valenx.calibrationQuality = 100>>
	<<set $company.devices.valenx.calibratedAtDay = $date.dayCount>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "Cal. $mom.callName">>
	<<set $company.prototype.calibration = "mom">>
	<<set $company.prototype.calibrationQuality = 100>>
	<<set $company.prototype.calibratedAtDay = $date.dayCount>>

	<<set $company.devices.valenx.calibration = "mom">>
	<<set $company.devices.valenx.calibrationQuality = 100>>
	<<set $company.devices.valenx.calibratedAtDay = $date.dayCount>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "Cal. $sister.callName">>
	<<set $company.prototype.calibration = "sister">>
	<<set $company.prototype.calibrationQuality = 100>>
	<<set $company.prototype.calibratedAtDay = $date.dayCount>>

	<<set $company.devices.valenx.calibration = "sister">>
	<<set $company.devices.valenx.calibrationQuality = 100>>
	<<set $company.devices.valenx.calibratedAtDay = $date.dayCount>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
</div>

<div class="sb-dev-group"><span class="sb-dev-h">Company</span>
/* Unlock All Tasks: every locked task is active, its intro event counts as played (setup.unlockAllTasks, Define Tasks).
   Complete Projects: fills every requirement of the active projects and lets setup.checkProjects finish them the normal way (reward,
   onComplete, notifications) */
<<link "Unlock All Tasks">>
	<<run Notification.show("Unlocked " + setup.unlockAllTasks() + " tasks.", { type: Notification.INFORMATION })>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "Complete Projects">>
	<<run $company.projects.forEach((p) => {
		if (!p || p.active !== true) { return; }
		Object.keys(p.requirements || {}).forEach((cat) => {
			if ((Number(p.requirements[cat]) || 0) > 0) { p.progress[cat] = p.requirements[cat]; }
		});
	})>>
	<<run setup.checkProjects()>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
</div>

<div class="sb-dev-group"><span class="sb-dev-h">$mom.callName</span>
<<link "+5 $mom.callName Relation">>
	<<set $mom.stats.relation += 5>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "+5 $mom.callName Corrupt.">>
	<<set $mom.stats.corruption to Math.min($mom.stats.max.corruption, $mom.stats.corruption + 5)>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "+1 $mom.callName Corr. Stage">>
	<<AdvanceCorruptionStage $mom "Skipped ahead with the debug menu.">>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
</div>

<div class="sb-dev-group"><span class="sb-dev-h">$sister.callName</span>
<<link "+5 $sister.callName Relation">>
	<<set $sister.stats.relation += 5>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "+5 $sister.callName Corrupt.">>
	<<set $sister.stats.corruption to Math.min($sister.stats.max.corruption, $sister.stats.corruption + 5)>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
<<link "+1 $sister.callName Corr. Stage">>
	<<AdvanceCorruptionStage $sister "Skipped ahead with the debug menu.">>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
</div>

/* micro events (MICRO_EVENTS_PLAN.md): the intimacy tiers, and one event by id with the current state. An inline
   event plays at the next place that has micro events, a desk visitor shows its card at My Desk right away */
<div class="sb-dev-group"><span class="sb-dev-h">Micro events</span>
<span>Tier $mom.callName <<= setup.intimacy("mom")>> <<= setup.intimacyName("mom")>>, $sister.callName <<= setup.intimacy("sister")>> <<= setup.intimacyName("sister")>></span>
<<textbox "$devMicroId" "">>
<<link "Play micro event">>
	<<run setup.debugPlayMicroEvent($devMicroId)>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
</div>

<div class="sb-dev-group"><span class="sb-dev-h">Locations</span>
<<textbox "$debugLocation" "">>
<<link "go to Location">><<script>>if (State.variables.debugLocation != "") { Engine.play(State.variables.debugLocation, null, "back")}<</script>><</link>>
<<link "Office">>
	<<goto $locations[$companyLocationIdReference].passage>>
    <<if $company.stage == 1>><<goto $locations[14].passage>><</if>>
<</link>>
<<link "Unlock CCTVs">>
	/* hangs a camera at every spot directly: setup.placeCamera needs one in the inventory for each spot */
	<<run Object.keys(setup.cameraSpots).forEach((key) => { if (!setup.hasCamera(key)) { $cctv.cameras[key] = $date.dayCount; } })>>
	<<run $cctv.pending = []>>
	<<script>>Engine.play(State.active.title, null, "back")<</script>>
<</link>>
</div>

</div>
</div>
<</nobr>>
<</if>>