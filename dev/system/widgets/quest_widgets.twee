:: Quest Widgets [nobr system widget] {"position":"2675,0","size":"100,100"}
/* Usage: =====================================================================
	<<NextQuest $player [ShowNotification]>>
	Finishes the line's current quest and moves on to the quest in its "next" field.
	Optional quests after it whose "skip" is true are jumped over (setup.skipQuests, Define Quests).
	Runs the finished quest's "set" (every lasting effect of its scene lives there, not in the passage) and shows
	its "notify" texts, unless ShowNotification is "false" (SkipToQuest, skip intro).
*/
<<widget "NextQuest">>
	<<set _nqLine to $args[0]>>
	<<set _done to setup.getCurrentQuest(_nqLine)>>

	<<if !_done or !_done.next>>
		<<run console.warn('NextQuest: "' + _nqLine.quest + '" is the last quest of ' + _nqLine.sysName + "'s line, there is nothing to move on to")>>
	<<else>>
		/*Apply the finished quest's "set" expressions*/
		<<if _done.set>>
			<<for _nqS = 0; _nqS < _done.set.length; _nqS++>>
				<<run Scripting.evalTwineScript(_done.set[_nqS])>>
			<</for>>
		<</if>>

		<<set _done.active to false>>
		<<set _done.done to true>>
		<<set _done.doneDay to $date.dayCount>>
		<<set _nqLine.quest to _done.next>>
		<<run setup.activateQuest(_nqLine.quest)>>
		/* jump over optional quests whose "skip" is already true (setup.skipQuests, Define Quests) */
		<<run setup.skipQuests(_nqLine)>>

		/*Make sure, that all finished quests & connected events are inactive*/
		<<for _nqI = 0; _nqI < _nqLine.quests.length; _nqI++>>
			<<set _nqQ to _nqLine.quests[_nqI]>>
			<<if _nqQ.done and $events[_nqQ.eventId] != undefined>>
				<<run _nqQ.active = false>>
				<<run $events[_nqQ.eventId].active = false>>
				<<run $events[_nqQ.eventId].finished = true>>
			<</if>>
		<</for>>

		/* what the finished quest unlocked ("notify": "New task for $mom.callName: ..."). Quiet when skipping */
		<<if $args[1] != "false" and _done.notify>>
			<<for _nqN = 0; _nqN < _done.notify.length; _nqN++>>
				<<run Notification.show(wikifyText(_done.notify[_nqN]), { type: Notification.INFORMATION })>>
			<</for>>
		<</if>>

		/* "New main quest!" / "New quest for Mr. Walsh!" (setup.questLineLabel). Hidden quests stay quiet */
		<<if $args[1] != "false" and !setup.getCurrentQuest(_nqLine).hidden>>
			<<set _nqLabel to setup.questLineLabel(_nqLine.sysName)>>
			<<run Notification.show(_nqLabel ? "New quest for " + wikifyText(_nqLabel) + "!" : "New main quest!", { type: Notification.QUEST })>>
		<</if>>
	<</if>>
<</widget>>

/* Usage: =====================================================================
	<<SkipToQuest $player "main_breakthrough" [ShowNotification]>>
	Calls <<NextQuest>> until the line is on the given quest, so every skipped quest's "set" still runs.
*/
<<widget "SkipToQuest">>
	<<set _stqLine to $args[0]>>
	<<set _stqTarget to $args[1]>>

	<<if setup.getQuestLine(_stqTarget) !== _stqLine>>
		<<run console.error('SkipToQuest: "' + _stqTarget + '" is not a quest of ' + _stqLine.sysName + "'s line")>>
	<<else>>
		<<for _stqGuard = 0; _stqLine.quest != _stqTarget and _stqGuard < _stqLine.quests.length; _stqGuard++>>
			<<NextQuest _stqLine $args[2]>>
		<</for>>
		<<if _stqLine.quest != _stqTarget>>
			<<run console.error('SkipToQuest: could not reach "' + _stqTarget + '", the line stopped at "' + _stqLine.quest + '"')>>
		<</if>>
	<</if>>
<</widget>>

/* Usage: =====================================================================
	<<CheckActiveQuestForCompletion $player>>
*/
<<widget "CheckActiveQuestForCompletion">>
	<<set _questLine = $args[0]>>
	<<set _quest  	 = setup.getCurrentQuest(_questLine)>>

	<<if _quest and _quest.active and _quest.check>>
		<<set _ok = !!Scripting.evalTwineScript(_quest.check)>>
		<<if _ok>><<NextQuest _questLine>><</if>>
	<</if>>
<</widget>>

/* Usage: =====================================================================
	<<UseQuestDevice $mom ["sister"] [power] ["keep"]>>
	Put it where the scene switches the device on. Spends the charge of the active quest's "device" field (once per
	entry and quest, through setup.useDevice in Define Quests), and sets _vxQuality (the calibration quality) for text
	variants. A quest with a device list (two targets) names the entry to use by its target: <<UseQuestDevice $player "mom">>.
	It also starts the screen pulse (<<DevicePulse>>) with the entry's impact, or with power if given
	(a number 0-10, "+1"/"-1", or 0 for no pulse). Turn the dial later in the scene with <<DevicePulse "+2">>.
	"keep" keeps the pulse over passage changes (multi-part scenes) until <<DevicePulse "off">>.
	Like <<DevicePulse>>, the pulse starts when the player has scrolled this far. The charge is spent at once.
*/
<<widget "UseQuestDevice">>
	<<set _uqdQuest to setup.getCurrentQuest(_args[0])>>
	<<if _uqdQuest and _uqdQuest.device>>
		<<set _uqdEntries to setup.questDeviceEntries(_uqdQuest.device)>>
		<<set _uqdEntry to _uqdEntries[0]>>
		<<set _uqdPower to null>>
		<<set _uqdKeep to false>>
		<<for _uqdI = 1; _uqdI < _args.length; _uqdI++>>
			<<set _uqdArg to _args[_uqdI]>>
			<<if _uqdArg == "keep">>
				<<set _uqdKeep to true>>
			<<elseif typeof _uqdArg == "string" and _uqdEntries.some(function (e) { return e.target == _uqdArg; })>>
				<<set _uqdEntry to _uqdEntries.find(function (e) { return e.target == _uqdArg; })>>
			<<else>>
				<<set _uqdPower to _uqdArg>>
			<</if>>
		<</for>>
		/* once per entry and quest: deviceUsedFor holds the targets that were already switched on */
		<<if !Array.isArray(_uqdQuest.deviceUsedFor)>><<set _uqdQuest.deviceUsedFor to []>><</if>>
		<<if !_uqdQuest.deviceUsedFor.includes(_uqdEntry.target)>>
			<<run _uqdQuest.deviceUsedFor.push(_uqdEntry.target)>>
			<<set _uqdQuest.deviceUsed to true>>
			<<run setup.useDevice(_uqdEntry.key, _uqdEntry.target, _uqdEntry.impact, _uqdQuest.id)>>
		<</if>>
		<<set _uqdDevice to (_uqdEntry.key ? $company.devices[_uqdEntry.key] : $company.prototype)>>
		<<set _vxQuality to _uqdDevice.calibrationQuality>>
		<<if _uqdPower === null>><<set _uqdPower to _uqdEntry.impact>><</if>>
		<<print setup.devicePulseMark(_uqdPower, { keep: _uqdKeep })>>
	<</if>>
<</widget>>

/* Usage: =====================================================================
	<<DevicePulse power ["keep"] ["#rrggbb"] ["3s"]>>
	A heartbeat glow over the whole screen while the device runs (setup.devicePulse in "Define Company").
	It never blocks clicks. power: 0-10, the same scale as a quest device impact (stronger and faster as it rises).
	A quoted "+2"/"-1" turns the dial from where it is now; 0 or "off" switches it off.
	It fades out on the next passage change. "keep" keeps it running across passages until <<DevicePulse "off">>.
	"3s" waits that many seconds before the change, e.g. <<DevicePulse "off" "3s">> for a device that sputters out.
	"cut" fades in or out almost at once instead of slowly (everything switched off in one go).
	The change happens when the player has scrolled this far, not when the passage is shown (setup.devicePulseMark),
	and scrolling back up above it takes it back. Inside <<silent>> it happens at once.
		<<DevicePulse 3>> ... <<DevicePulse "+2">> ... <<DevicePulse "off">>
*/
<<widget "DevicePulse">>
	<<set _dpOpts to {}>>
	<<for _dpI = 1; _dpI < $args.length; _dpI++>>
		<<if $args[_dpI] == "keep">>
			<<set _dpOpts.keep to true>>
		<<elseif $args[_dpI] == "cut">>
			<<set _dpOpts.fade to 150>>
		<<elseif String($args[_dpI]).startsWith("#")>>
			<<set _dpOpts.color to $args[_dpI]>>
		<<elseif /^[0-9.]+s$/.test(String($args[_dpI]))>>
			<<set _dpOpts.delay to parseFloat($args[_dpI]) * 1000>>
		<</if>>
	<</for>>
	<<print setup.devicePulseMark($args[0], _dpOpts)>>
<</widget>>


