:: Event Widgets [nobr system widget] {"position":"2425,150","size":"100,100"}
/* Usage: =====================================================================
	<<set _passage to passage()>>
	<<CheckForEvent _passage>>
	Plays the event that happens on this passage now, if any. The checks are in setup.pickEvent (Define Events):
	plain JS, because a TwineScript loop over every event on every passage was slow.
*/
<<widget "CheckForEvent">>
    <<set _cfe_event to setup.pickEvent($args[0])>>
    <<if _cfe_event>>
        <<set $CFE_EventRef to _cfe_event>>
        <<set $currentEvent to _cfe_event.id>>
        <<set $preEventLocation to $player.previousLocation>>
        <<set $currentlyInEvent to true>>

        /* a normal history entry: passage() and tags() then see the event, not the location (sidebar
           links, quick links, saves). $eventJustTriggered keeps PassageReady from running again for it. */
        <<run setTimeout(() => { Engine.play($CFE_EventRef.passage); }, 0)>>
        <<set $eventJustTriggered to true>>
    <</if>>
<</widget>>

/* Usage: =====================================================================
	<<CheckMicroEvent>>
	Includes the micro event that happens here right now, if any (setup.pickMicroEvent in Define Events), and sets
	$microEventActive / $currentMicroEvent. Events with a visitor block never show here, they are desk visitors.
*/
<<widget "CheckMicroEvent">>
	<<set $microEventActive = false>>
	/* an event was just triggered on this passage and replaces it in a moment: don't use up a micro event (dinner) behind it */
	<<set _cme_event to ($eventJustTriggered ? null : setup.pickMicroEvent("inline"))>>
	<<if _cme_event>>
		<<set $microEventActive = true>>
		<<set $currentMicroEvent to _cme_event.id>>
		<<nobr>>
			<<include _cme_event.passage>>
		<</nobr>>
	<</if>>
<</widget>>

/* Usage: =====================================================================
	<<MicroContext $mom>>
	Sets _mc for a micro event passage: her intimacy tier, lust band, whether she is alone with me, the offer lock,
	the near miss chance, the device state and whether this is the first time the event plays at her tier. Field
	list and rules: "Micro events that grow" in Define Events (setup.microContext).
*/
<<widget "MicroContext">>
	<<set _mc to setup.microContext(_args[0], $currentMicroEvent)>>
<</widget>>

/* Usage: =====================================================================
	<<MicroDevice $mom "#choice-id" "Use the prototype while she talks">>
		<<if _md.backfire>>
			<<DevicePulse `_md.power`>><<DevicePulse "off" "2s">>She notices, and leaves.
		<<else>>
			I switch it on. <<DevicePulse `_md.power`>> What it does to her.
		<</if>>
	<</MicroDevice>>
	The device choice of a micro event, as one option (a div) inside its choices block. Hidden while there is no
	device yet or her tier is past setup.microTuning.deviceMaxTier, locked with the reason while it was used today or
	is short of charge. A click replaces the choices block (the id) with the contents and the stat lines: _md holds
	{ backfire, power, relation, resistance, corruption, lust } (setup.useMicroDevice). The contents start and stop
	the pulse themselves (_md.power), so it can switch on in the middle of a sentence.
*/
<<widget "MicroDevice" container>>
	<<set _mdWho to (typeof _args[0] === "string" ? _args[0] : _args[0].sysName)>>
	<<set _mdTarget to _args[1]>>
	<<set _mdLabel to _args[2]>>
	<<set _mdBody to _contents>>
	<<set _mdState to setup.microDeviceState(_mdWho)>>
	<<if _mdState.available>>
		<div>
		<<if !_mdState.ok>>
			<span class="choice-locked">_mdLabel<small>_mdState.reason</small></span>
		<<else>>
			<<capture _mdWho _mdTarget _mdBody>>
			<<link _mdLabel>>
				<<replace _mdTarget>>
					<<set _md to setup.useMicroDevice(_mdWho)>>
					<<set _mdKey to _mdWho.charAt(0).toUpperCase() + _mdWho.slice(1)>>
					_mdBody
					<<if _md.relation != 0>><<UpdateStat `_md.relation > 0 ? "+" : "-"` `_mdKey + "Relation"` `Math.abs(_md.relation)`>><</if>>
					<<if _md.resistance > 0>><<UpdateStat "+" `_mdKey + "Resistance"` `_md.resistance`>><</if>>
					<<if _md.corruption > 0>><<UpdateStat "+" `_mdKey + "Corruption"` `_md.corruption`>><</if>>
					<<if _md.lust > 0>><<UpdateStat "+" `_mdKey + "Lust"` `_md.lust`>><</if>>
				<</replace>>
			<</link>>
			<</capture>>
		<</if>>
		</div>
	<</if>>
<</widget>>

/* Usage: =====================================================================
	<<MicroScene $mom "Mom Kitchen Wine Hands" [actions]>>
	Inside the click of a micro event offer: leaves the moment for its full scene. Counts her scene of the day
	(setup.microSceneToday), keeps this passage to come back to, spends the actions (default
	setup.microTuning.sceneActions) and goes to the scene. Works from a desk visitor drawer too. The scene is tagged
	[scene], keeps its effects in itself and ends with <<EndMicroScene>>. It can read
	setup.microSceneCount("mom", passage()) (1 = the first time) and roll setup.rollNearMiss("mom").
*/
<<widget "MicroScene">>
	<<set _msWho to (typeof _args[0] === "string" ? _args[0] : _args[0].sysName)>>
	<<set _msPassage to _args[1]>>
	<<set _msActions to (_args[2] !== undefined ? Number(_args[2]) : setup.microTuning.sceneActions)>>
	<<run setup.startMicroScene(_msWho, _msPassage)>>
	<<if _msActions > 0>><<UseAction _msActions>><</if>>
	<<goto _msPassage>>
<</widget>>

/* Usage: =====================================================================
	<<EndMicroScene ["Link text"]>>
	Ends a micro event scene (<<MicroScene>>) and goes back to where it started ($microSceneReturn), or to my
	location if that is not known.
*/
<<widget "EndMicroScene">>
	<<set _emsText to (_args[0] !== undefined ? _args[0] : "Continue")>>
	<div class="navigation-link"><<link _emsText>>
		<<set _emsGo to ($microSceneReturn || $locations[$player.location.id].passage)>>
		<<set $microSceneReturn to null>>
		<<goto _emsGo>>
	<</link>></div>
<</widget>>

/* Usage: =====================================================================
	<<ReturnFromEvent [TEXT] [PASSAGE TO RETURN]>>
*/
<<widget "ReturnFromEvent">>
	<<set _rfe_event to $events[$currentEvent]>>
	/* a deal that was stalled in this scene stays alive and comes back later ("Family offers" in Define Quests) */
	<<set _rfe_stalled to (_rfe_event.stalledDay === $date.dayCount && setup.offerStalled(_rfe_event))>>
    <<if _rfe_event.once == true and !_rfe_stalled>>
    	<<set $events[$currentEvent].active to false>>
    <</if>>
    <<if _rfe_event.cooldown > 0>>
    	<<set $events[$currentEvent].active to false>>
    <</if>>
    <<set $events[$currentEvent].completedAtDay to $date.dayCount>>
    <<if !_rfe_stalled>><<set $events[$currentEvent].finished to true>><</if>>
    <<set _passageToReturnTo to ($args[1] != undefined ? $args[1] : _rfe_event.returnPassage)>>
    <<set _text to ($args[0] != undefined ? $args[0] : "Continue")>>
    <div class="navigation-link"><<link _text>><<goto _passageToReturnTo>><</link>></div>
<</widget>>

/* Usage: =====================================================================
	<<ReturnFromCCTV [TEXT]>>
	Ends a scene opened with the CCTV arrow and goes back to where the camera was watched from.
*/
<<widget "ReturnFromCCTV">>
    <<set _text to ($args[0] != undefined ? $args[0] : "Continue")>>
    <div class="navigation-link"><<link _text>><<goto $cctv.returnPassage>><</link>></div>
<</widget>>

/* Usage: =====================================================================
	<<PovHeader $mom ["Kicker"]>>
	The header of a POV passage: her portrait, her name and a small kicker above it ("Her side" by default),
	so her first-person text is never mistaken for mine. A POV passage is written in HER voice (first person,
	present tense), is tagged [scene pov] and ends with <<EndPov>>. It opens from two doors: the CCTV arrow
	(a task stage passage or an activity cctvPassage) and her end-of-day report (Day Report). Both set
	$povReturn. Effects never go into a POV passage, it may be watched any number of times: they belong in the
	task onComplete or the scene that logged it.
*/
<<widget "PovHeader">>
	<<set _povNpc to _args[0]>>
	<<set _povKicker to (_args[1] !== undefined ? _args[1] : "Her side")>>
	<<set _povImg to $path + "images/characters/portraits/" + _povNpc.sysName + ".jpg">>
	<div class="pov-header">
		<div class="pov-avatar">
			<span class="pov-initial"><<= String(_povNpc.callName || "?").charAt(0)>></span>
			<img @src="_povImg" alt="" onerror="this.remove()">
		</div>
		<div class="pov-titles">
			<div class="pov-kicker"><<= _povKicker>></div>
			<div class="pov-name"><<= _povNpc.callName>></div>
		</div>
	</div>
<</widget>>

/* Usage: =====================================================================
	<<EndPov [TEXT]>>
	Ends a POV passage and goes back to the door it was opened from ($povReturn: the desk for the CCTV arrow,
	Day Report for her end-of-day report).
*/
<<widget "EndPov">>
	<<set _epText to (_args[0] !== undefined ? _args[0] : "Back")>>
	<div class="navigation-link"><<link _epText>>
		<<set _epGo to ($povReturn || $cctv.returnPassage || $locations[$player.location.id].passage)>>
		<<set $povReturn to null>>
		<<goto _epGo>>
	<</link>></div>
<</widget>>


/* Usage: =====================================================================
	<<StageTitle number ["subtitle"] ["label"]>>contents<</StageTitle>>
	A full-screen title card for a new stage: "Stage" types in behind a caret, the number lands with a heartbeat,
	the subtitle types in under a rule, then the contents (the continue link) fade in. The label defaults to
	"Stage". A click, Enter, Space or Esc skips to the end. Use it once per passage; the animation is
	setup.stageTitle() ("The stage title card" in Define Company), the look is .stage-card in StoryStylesheet.
	<<StageTitle 1 "The Third Floor">><<ReturnFromEvent "A week passes...">><</StageTitle>>
*/
<<widget "StageTitle" container>>
	<<set _stLabel to ($args[2] != undefined ? $args[2] : "Stage")>>
	<div class="stage-card" id="stage-card">
		<div class="stg-glow"></div>
		<div class="stg-center">
			<div class="stg-title"><span class="stg-label">_stLabel</span><span class="stg-gap">&nbsp;</span><span class="stg-num"><<= $args[0]>></span></div>
			<div class="stg-rule"></div>
			<<if $args[1] != undefined>><div class="stg-sub"><<= $args[1]>></div><</if>>
			<div class="stg-after">_contents</div>
		</div>
		<div class="stg-skip">Click to skip</div>
	</div>
	<<run setTimeout(() => setup.stageTitle("#stage-card"), 0)>>
<</widget>>
