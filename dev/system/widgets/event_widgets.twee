:: Event Widgets [nobr system widget] {"position":"2425,150","size":"100,100"}
/* Usage: =====================================================================
	<<set _passage to passage()>>
	<<CheckForEvent _passage>>
*/
<<widget "CheckForEvent">>
    <<set _cfe_passage to $args[0]>>
    <<for _i = 0; _i < $events.length; _i++>>
    	<<set _cfe_event to $events[_i]>>
        
        <<set _requirementsOk = true>>
        <<if _cfe_event.requirements>>
            <<for _r = 0; _r < _cfe_event.requirements.length; _r++>>
                <<if !Scripting.evalTwineScript(_cfe_event.requirements[_r])>>
                    <<set _requirementsOk = false>>
                    <<break>>
                <</if>>
            <</for>>
        <</if>>
        <<if _requirementsOk and _cfe_event.device and !setup.questDevice(_cfe_event.device).ok>>
            <<set _requirementsOk = false>>
        <</if>>

        <<if _cfe_event.where.some(function (place) { return ((typeof place === "object") ? place.passage : place) == _cfe_passage; }) &&
        	 _cfe_event.whenDay.includes($date.today.value) && 
             _cfe_event.whenTime.includes($time.current.value) &&
             _requirementsOk>>
        	<<if _cfe_event.active>>
          		<<if (_cfe_event.once == true && _cfe_event.finished == false) || _cfe_event.once == false>>
            		<<if random(1, 100) <= _cfe_event.chance>>
                        <<set $CFE_EventRef to _cfe_event>>
            			<<set $currentEvent to _cfe_event.id>>
                        <<set $preEventLocation to $player.previousLocation>>
                        <<set $currentlyInEvent to true>>
                        
                        /* a normal history entry: passage() and tags() then see the event, not the location (sidebar
                           links, quick links, saves). $eventJustTriggered keeps PassageReady from running again for it. */
        				<<run setTimeout(() => { Engine.play($CFE_EventRef.passage); }, 0)>>
                        <<set $eventJustTriggered to true>>
                        <<break>>
            		<</if>>
                <</if>>
        	<</if>>
        <</if>>
    <</for>>
<</widget>>

/* Usage: =====================================================================
	<<CheckMicroEvent>>
	Includes the micro event that happens here right now, if any (setup.pickMicroEvent in Define Events), and sets
	$microEventActive / $currentMicroEvent. Events with a visitor block never show here, they are desk visitors.
*/
<<widget "CheckMicroEvent">>
	<<set $microEventActive = false>>
	/* an event was just triggered on this passage and replaces it in a moment: don't use up a micro event (dinner) behind it */
	<<set _cme_event to ($eventJustTriggered ? null : setup.pickMicroEvent("inline"))>>
	<<if _cme_event>>
		<<set $microEventActive = true>>
		<<set $currentMicroEvent to _cme_event.id>>
		<<nobr>>
			<<include _cme_event.passage>>
		<</nobr>>
	<</if>>
<</widget>>

/* Usage: =====================================================================
	<<ReturnFromEvent [TEXT] [PASSAGE TO RETURN]>>
*/
<<widget "ReturnFromEvent">>
	<<set _rfe_event to $events[$currentEvent]>>
    <<if _rfe_event.once == true>>
    	<<set $events[$currentEvent].active to false>>
    <</if>>
    <<if _rfe_event.cooldown > 0>>
    	<<set $events[$currentEvent].active to false>>
    <</if>>
    <<set $events[$currentEvent].completedAtDay to $date.dayCount>>
    <<set $events[$currentEvent].finished to true>>
    <<set _passageToReturnTo to ($args[1] != undefined ? $args[1] : _rfe_event.returnPassage)>>
    <<set _text to ($args[0] != undefined ? $args[0] : "Continue")>>
    <div class="navigation-link"><<link _text>><<goto _passageToReturnTo>><</link>></div>
<</widget>>

/* Usage: =====================================================================
	<<ReturnFromCCTV [TEXT]>>
	Ends a scene opened with the CCTV arrow and goes back to where the camera was watched from.
*/
<<widget "ReturnFromCCTV">>
    <<set _text to ($args[0] != undefined ? $args[0] : "Continue")>>
    <div class="navigation-link"><<link _text>><<goto $cctv.returnPassage>><</link>></div>
<</widget>>


/* Usage: =====================================================================
	<<StageTitle number ["subtitle"] ["label"]>>contents<</StageTitle>>
	A full-screen title card for a new stage: "Stage" types in behind a caret, the number lands with a heartbeat,
	the subtitle types in under a rule, then the contents (the continue link) fade in. The label defaults to
	"Stage". A click, Enter, Space or Esc skips to the end. Use it once per passage; the animation is
	setup.stageTitle() ("The stage title card" in Define Company), the look is .stage-card in StoryStylesheet.
	<<StageTitle 1 "The Third Floor">><<ReturnFromEvent "A week passes...">><</StageTitle>>
*/
<<widget "StageTitle" container>>
	<<set _stLabel to ($args[2] != undefined ? $args[2] : "Stage")>>
	<div class="stage-card" id="stage-card">
		<div class="stg-glow"></div>
		<div class="stg-center">
			<div class="stg-title"><span class="stg-label">_stLabel</span><span class="stg-gap">&nbsp;</span><span class="stg-num"><<= $args[0]>></span></div>
			<div class="stg-rule"></div>
			<<if $args[1] != undefined>><div class="stg-sub"><<= $args[1]>></div><</if>>
			<div class="stg-after">_contents</div>
		</div>
		<div class="stg-skip">Click to skip</div>
	</div>
	<<run setTimeout(() => setup.stageTitle("#stage-card"), 0)>>
<</widget>>
