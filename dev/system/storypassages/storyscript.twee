:: StoryScript [script system] {"position":"250,300"}
if (!window.Chart) {
  var script = document.createElement("script");
  script.src = "https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js";
  script.onload = function() { console.log("Chart.js is ready"); };
  document.head.appendChild(script);
}

/* Loaded here instead of an @import in StoryStylesheet: Tweego merges all stylesheet passages
   into one <style>, and an @import that isn't at the very top of it gets ignored. */
if (!document.getElementById("font-manrope")) {
  var font = document.createElement("link");
  font.id = "font-manrope";
  font.rel = "stylesheet";
  font.href = "https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap";
  document.head.appendChild(font);
}

//Settings ============================================================
Config.history.maxStates = 5;
Config.saves.maxAutoSaves = 1;
Config.saves.autosave = function () {
    return State.turns > 0 && (State.turns % 10 === 0);
};

/* Deferred session write ================================================
   On every passage change SugarCube writes the whole history into sessionStorage (so that reloading the tab
   brings the game back): stringified and LZ-compressed, synchronously, before the new passage is drawn.
   That took most of the time of every click. The copy is only read again after a reload, so here the newest
   one waits until the browser is idle after drawing (only the last of several quick clicks is written at
   all). Leaving or reloading the page (pagehide), hiding the tab, and anything that reads the stored state
   write it at once; deleting it (restart) drops the waiting copy. Other keys are written as before. */
(function () {
	var store = SugarCube.session;
	var origSet = store.set, origGet = store.get, origHas = store.has, origDelete = store.delete;
	var pending = null;
	var scheduled = false;
	var flush = function () {
		scheduled = false;
		if (pending === null) { return; }
		var value = pending;
		pending = null;
		try { origSet.call(store, "state", value); }
		catch (ex) { console.error("Session write failed:", ex); }
	};
	var schedule = function () {
		if (scheduled) { return; }
		scheduled = true;
		if (typeof window.requestIdleCallback === "function") {
			window.requestIdleCallback(flush, { timeout: 1000 });
		} else {
			requestAnimationFrame(function () { setTimeout(flush, 0); });
		}
	};
	store.set = function (key, value) {
		if (key !== "state") { return origSet.call(store, key, value); }
		pending = value;
		schedule();
		return true;
	};
	store.get = function (key) {
		if (key === "state") { flush(); }
		return origGet.call(store, key);
	};
	store.has = function (key) {
		if (key === "state") { flush(); }
		return origHas.call(store, key);
	};
	store.delete = function (key) {
		if (key === "state") { pending = null; }
		return origDelete.call(store, key);
	};
	window.addEventListener("pagehide", flush);
	document.addEventListener("visibilitychange", function () {
		if (document.visibilityState === "hidden") { flush(); }
	});
})();

/* Playtime ==============================================================
   $playtime (Define Misc) is the time played in milliseconds.
   - A 1 s ticker counts real time into a pending amount, but only while the tab is visible, the
     player touched mouse/keyboard/touch in the last PLAYTIME_IDLE_MS, and the game is past the Main Menu.
   - :passageinit runs before SugarCube creates the new history moment, so adding the pending
     time there puts it into the state that gets saved.
   - A save only holds the state from the start of its passage, so Config.saves.metadata stores the
     exact total at the moment of saving (metadata.playtime), and Save.onLoad writes it back into
     the loaded moment. The saves dialog and the main menu read metadata.playtime for their label.
   setup.playtimeNow()            current total in ms
   setup.formatPlaytime(ms)       "01:34:52" (hours keep growing past 99) */
var PLAYTIME_IDLE_MS = 5 * 60 * 1000;
var playtimePending = 0;
var playtimeLastTick = Date.now();
var playtimeLastInput = Date.now();

setup.playtimeNow = function () {
	return (Number(State.variables.playtime) || 0) + playtimePending;
};

setup.formatPlaytime = function (ms) {
	var total = Math.max(0, Math.floor((Number(ms) || 0) / 1000));
	var pad = function (n) { return n < 10 ? "0" + n : String(n); };
	return pad(Math.floor(total / 3600)) + ":" + pad(Math.floor(total / 60) % 60) + ":" + pad(total % 60);
};

$(document).on("mousemove mousedown keydown wheel touchstart", function () {
	playtimeLastInput = Date.now();
});

setInterval(function () {
	var now = Date.now();
	/* a throttled or sleeping tab can deliver one huge gap, never count more than 2 s per tick */
	var delta = Math.min(now - playtimeLastTick, 2000);
	playtimeLastTick = now;
	if (document.visibilityState !== "visible") { return; }
	if (now - playtimeLastInput > PLAYTIME_IDLE_MS) { return; }
	if (State.passage === "" || State.passage === "Main Menu") { return; }
	playtimePending += delta;
}, 1000);

$(document).on(":passageinit", function () {
	if (playtimePending > 0) {
		State.variables.playtime = (Number(State.variables.playtime) || 0) + playtimePending;
		playtimePending = 0;
	}
});

Config.saves.metadata = function () {
	return { playtime: Math.floor(setup.playtimeNow()) };
};

Save.onLoad.add(function (save) {
	/* time spent before loading belongs to the other game */
	playtimePending = 0;
	var moment = save.state.history[save.state.index];
	if (moment && save.metadata && typeof save.metadata.playtime === "number") {
		moment.variables.playtime = save.metadata.playtime;
	}
});

/* Shows the playtime under each save in the saves dialog. SugarCube rebuilds the list after
   every save/delete without reopening the dialog, so a MutationObserver on the dialog body
   catches the rebuilds. The row only names its kind and number in the datestamp line
   ("Auto 1  -  date" / "Slot 3  -  date"), which is how a row is matched to its save. */
var addPlaytimeToSaves = function () {
	var body = Dialog.body();
	if (!body.classList.contains("saves")) { return; }
	var autoLabel = L10n.get("savesTextBrowserAuto");
	var slotLabel = L10n.get("savesTextBrowserSlot");
	var infos = { auto: {}, slot: {} };
	Save.browser.auto.entries().forEach(function (e) { infos.auto[e.index] = e.info; });
	Save.browser.slot.entries().forEach(function (e) { infos.slot[e.index] = e.info; });
	$(body).find("#saves-list .datestamp").each(function () {
		if ($(this).siblings(".playtime").length) { return; }
		/* SugarCube puts a no-break space between the label and the number */
		var match = /^(.+?)\s(\d+)(\s|$)/.exec($(this).text());
		if (!match) { return; }
		var kind = match[1] === autoLabel ? "auto" : match[1] === slotLabel ? "slot" : null;
		var info = kind && infos[kind][Number(match[2]) - 1];
		if (!info || !info.metadata || typeof info.metadata.playtime !== "number") { return; }
		$('<div class="details playtime"></div>')
			.text("Playtime " + setup.formatPlaytime(info.metadata.playtime))
			.insertAfter(this);
	});
};
var savesObserver = null;
$(document).on(":dialogopened", function () {
	if (!savesObserver) {
		savesObserver = new MutationObserver(addPlaytimeToSaves);
		savesObserver.observe(Dialog.body(), { childList: true });
	}
	addPlaytimeToSaves();
});

var imageHandler = function() {
	State.variables.settings.showImages = settings.showImages;
}

var switchToActivities = function() {
	State.variables.settings.switchToActivities = settings.switchToActivities;
}

var switchToActivitiesInsteadOfLocations = function() {
	State.variables.settings.switchToActivities = settings.switchToActivitiesInsteadOfLocations;
}

var mealNotificationsHandler = function() {
	State.variables.settings.showMealNotifications = settings.showMealNotifications;
}

var skipMinigamesHandler = function() {
	State.variables.settings.skipMinigames = settings.skipMinigames;
}

var cctvEffectHandler = function() {
	State.variables.settings.showCCTVEffect = settings.showCCTVEffect;
}

var cctvOverlayHandler = function() {
	State.variables.settings.showCCTVOverlay = settings.showCCTVOverlay;
}

var cctvBackgroundHandler = function() {
	State.variables.settings.showCCTVBackground = settings.showCCTVBackground;
}

Setting.addHeader("Gameplay");
Setting.addToggle("showImages", {
	label: "Display images in this game?",
  	default: true,
  	onChange: imageHandler
});
Setting.addToggle("switchToActivitiesInsteadOfLocations", {
	label: "Display Activities of NPCs when meeting them?",
  	default: true,
  	onChange: switchToActivitiesInsteadOfLocations
});
Setting.addToggle("switchToActivities", {
	label: "Automatically switch to \"Activities\" in the sidebar when meeting a NPC?",
  	default: false,
  	onChange: switchToActivities
});
Setting.addToggle("showMealNotifications", {
	label: "Show a notification when a meal with the family is ready?",
  	default: false,
  	onChange: mealNotificationsHandler
});
Setting.addToggle("showDevicePulse", {
	label: "Show a pulsing glow and creeping lines on the screen while the device is running?",
  	default: true,
  	onChange: function () {
		// Refresh a running pulse: hides it, or shows it again at the power it has now
		if (setup.devicePulse) { setup.devicePulse(setup.devicePulsePower()); }
	}
});
Setting.addToggle("skipMinigames", {
	label: "Skip Minigames?",
  	default: false,
  	onChange: skipMinigamesHandler
});
Setting.addHeader("CCTV Settings");
Setting.addToggle("showCCTVEffect", {
	label: "Display animated noise over CCTV Videos?",
  	default: true,
  	onChange: cctvEffectHandler
});
Setting.addToggle("showCCTVOverlay", {
	label: "Display a camera overlay over CCTV Videos?",
  	default: true,
  	onChange: cctvOverlayHandler
});
Setting.addToggle("showCCTVBackground", {
	label: "Display a black background to the CCTV Videos?",
  	default: true,
  	onChange: cctvBackgroundHandler
});

/* ———————————— Audio Settings ———————————— */
(function () {
  function applyMute() {
    try { SimpleAudio.mute(!settings.enableSound); } catch (e) {}
  }

  function applyVolumes() {
    // Volumes still get stored even while muted, so unmuting restores them
    try { SimpleAudio.volume((settings.volMaster ?? 80) / 100); } catch (e) {}
    try { SimpleAudio.select(':music').volume((settings.volMusic ?? 15) / 100); } catch (e) {}
    try { SimpleAudio.select(':ambience').volume((settings.volAmbience ?? 65) / 100); } catch (e) {}
    try { SimpleAudio.select(':sfx').volume((settings.volSfx ?? 50) / 100); } catch (e) {}
  }

  Setting.addHeader('Audio');

  // Sound toggle (default ON)
  Setting.addToggle('enableSound', {
    label: 'Enable sound',
    default: true,
    onChange: applyMute
  });

  const add = (name, label, def) => {
    Setting.addRange(name, {
      label, min: 0, max: 100, step: 1,
      default: def,
      onChange: applyVolumes
    });
  };

  add('volMaster',   'Master volume',   80);
  add('volMusic',    'Music volume',    15);
  add('volAmbience', 'Ambience volume', 65);
  add('volSfx', 	 'Sound effects volume', 50);

  // Slider fill: expose the value as --fill (0–1) so the stylesheet can draw the progress
  function updateFill(el) {
    var min = parseFloat(el.min) || 0;
    var max = parseFloat(el.max);
    if (isNaN(max)) { max = 100; }
    var p = max > min ? (parseFloat(el.value) - min) / (max - min) : 0;
    el.style.setProperty('--fill', Math.min(1, Math.max(0, p)));
  }

  $(document).on('input change', '#ui-dialog-body.settings input[type=range]', function () {
    updateFill(this);
  });

  $(document).on(':dialogopened', function () {
    $('#ui-dialog-body.settings input[type=range]').each(function () { updateFill(this); });
  });

  // Ensure the default mute is applied before your audio macro ever plays
  $(document).one(':storyready', function () {
    if (typeof settings.enableSound === 'undefined') { settings.enableSound = true; }
    applyMute();
    applyVolumes();
  });
})();

/* ———————————— Init Settings for new Games ————————————
   Runs before every passage, not just the first one: $settings is part of the saved state, so a Load or a step
   Back would bring back the values from that moment while the real settings stay as they are. Copying them
   again on every passage keeps the two in sync. */

$(document).on(':passageinit', function () {
    // Default values if they don't exist yet (new game or first load)
    if (typeof settings.showImages === 'undefined')          settings.showImages = true;
    if (typeof settings.switchToActivitiesInsteadOfLocations === 'undefined')  settings.switchToActivitiesInsteadOfLocations = true;
  	if (typeof settings.switchToActivities === 'undefined')  settings.switchToActivities = false;
    if (typeof settings.showMealNotifications === 'undefined') settings.showMealNotifications = true;
    if (typeof settings.skipMinigames === 'undefined') settings.skipMinigames = true;
    if (typeof settings.showCCTVEffect === 'undefined')      settings.showCCTVEffect = true;
    if (typeof settings.showCCTVOverlay === 'undefined')     settings.showCCTVOverlay = true;
    if (typeof settings.showCCTVBackground === 'undefined')  settings.showCCTVBackground = true;
    
    // Audio defaults (your code already has some, but make sure)
    if (typeof settings.enableSound === 'undefined')         settings.enableSound = true;
    if (typeof settings.volMaster === 'undefined')           settings.volMaster = 80;
    if (typeof settings.volMusic === 'undefined')            settings.volMusic = 15;
    if (typeof settings.volAmbience === 'undefined')         settings.volAmbience = 65;
  	if (typeof settings.volSfx === 'undefined') 			       settings.volSfx = 50;

    // Now copy them into State.variables so your widgets can read them easily
    State.variables.settings = State.variables.settings || {};
    State.variables.settings.showImages = settings.showImages;
    State.variables.settings.switchToActivities = settings.switchToActivities;
    State.variables.settings.showMealNotifications = settings.showMealNotifications;
    State.variables.settings.skipMinigames = settings.skipMinigames;
  	State.variables.settings.switchToActivitiesInsteadOfLocations = settings.switchToActivitiesInsteadOfLocations;
    State.variables.settings.showCCTVEffect = settings.showCCTVEffect;
    State.variables.settings.showCCTVOverlay = settings.showCCTVOverlay;
    State.variables.settings.showCCTVBackground = settings.showCCTVBackground;
    // No need for audio here unless your widgets check them too
});

/* ———————————— Audio Macro ———————————— */

(function () {
  function _isNight(S) {
    if (S.time && S.time.current && typeof S.time.current.value === 'number') {
      return S.time.current.value >= 5;
    }
    var h = null;
    if (S.time && typeof S.time.hour === 'number') { h = S.time.hour; }
    else if (S.time && typeof S.time.h === 'number') { h = S.time.h; }
    return (typeof h === 'number') ? (h < 6 || h >= 20) : false;
  }

  function _playAudioImpl() {
    var S = State.variables;

    // Passages that play their own audio (the Main Menu) are tagged no_location_audio
    if (tags().includes('no_location_audio')) { return; }

    var loc = S.player.location;
    if (!loc || !loc.audio) { return; }

    if (!S.audio) { 
      S.audio = { 
        now: { 
          music: null, 
          ambience: null 
        }, 
        override: { 
          music: null, 
          ambience: null 
        } 
      }; 
    }

    var wantMusic = (S.audio.override && S.audio.override.music)
      ? S.audio.override.music
      : (loc.audio.music || null);
    var wantAmbience = (S.audio.override && S.audio.override.ambience)
      ? S.audio.override.ambience
      : (loc.audio.ambience[ _isNight(S) ? 'night' : 'day' ] || null);

    var currentId = S.audio.now ? S.audio.now.music : null;
    var currentAmbienceId = S.audio.now ? S.audio.now.ambience : null;
    var mVol = (typeof settings !== 'undefined' && settings.volMusic != null ? settings.volMusic : 70) / 100  / 2;
    var aVol = (typeof settings !== 'undefined' && settings.volAmbience != null ? settings.volAmbience : 70) / 100  / 2;
    var XFADE_SEC = 0.0;

    // Music
    if (wantMusic && currentId !== wantMusic) {
      if (currentId) {
        (function (oldId, simpleAudio) {
          setTimeout(function () { 
            try {
            	simpleAudio.select(oldId).stop();
            } catch(e) {
            	console.log(e); 
            }

          }, Math.floor(XFADE_SEC * 1000) + 50);
        })(currentId, SimpleAudio);
      }
      try {
      	SimpleAudio.select(wantMusic).volume(mVol).loop(true).play(); 
      } catch(e) {
       	console.log(e); 
      }

      S.audio.now.music = wantMusic;
    } else if (wantMusic && currentId === wantMusic) {
      try {
      	SimpleAudio.select(wantMusic).volume(mVol).loop(true).play(); 
      } catch(e) {
       	console.log(e); 
      }
    }
    
    //Ambience
    if (wantAmbience && currentAmbienceId !== wantAmbience) {
      if (currentAmbienceId) {
        (function (oldId, simpleAudio) {
          setTimeout(function () { 
            try {
            	simpleAudio.select(oldId).stop();
            } catch(e) {
            	console.log(e); 
            }

          }, Math.floor(XFADE_SEC * 1000) + 50);
        })(currentAmbienceId, SimpleAudio);
      }
      try {
      	SimpleAudio.select(wantAmbience).volume(aVol).loop(true).play(); 
      } catch(e) {
       	console.log(e); 
      }

      S.audio.now.ambience = wantAmbience;
    } else if (wantAmbience && currentAmbienceId === wantAmbience) {
      try {
      	SimpleAudio.select(wantAmbience).volume(aVol).loop(true).play(); 
      } catch(e) {
       	console.log(e); 
      }
    }
  }

  Macro.add('PlayAudio', { handler: function () { _playAudioImpl(); } });
})();


/* —— Chat Macro ——
   Usage: <<Chat _msgs>>
*/

(function () {
  Macro.add("Chat", {
    handler() {
      if (!this.args.length || !Array.isArray(this.args[0])) {
        return this.error("<<Chat>> needs an array of messages as the first argument.");
      }

      var msgs  = this.args[0] || [];
      var opts  = this.args[1] || {};
      var sv    = State.variables || {};

      var theme = String((opts.theme || sv.chatTheme || "light")).toLowerCase();
      var me    = (opts.hasOwnProperty("me") ? opts.me : (sv.me != null ? sv.me : sv.player || null));
      var avatars = Object.assign({}, sv.chatAvatars || {}, opts.avatars || {});

      // Root and list
      var root = document.createElement("div");
      root.className = "chat chat--bare " + (theme === "dark" ? "chat--dark" : "chat--light");
      var list = document.createElement("div");
      list.className = "chat__messages";
      root.appendChild(list);

      function isMe(who, msg) {
        if (msg && msg.me === true) return true;
        if (!who || me == null) return false;
        if (who === me) return true;

        var wn = (typeof who === "object") ? (who.id || who.name) : String(who);
        var mn = (typeof me  === "object") ? (me.id  || me.name ) : String(me);
        return wn && mn && wn === mn;
      }

      function addNarration(text) {
        var row  = document.createElement("div");
        row.className = "chat__msg chat__msg--narr";
        var desc = document.createElement("div");
        desc.className = "chat__desc";
        new Wikifier(desc, text || "");
        row.appendChild(desc);
        list.appendChild(row);
      }

      function addMessage(m) {
        var who     = m.who;
        var whoName = (typeof who === "object")
          ? (who.name || who.id || "Unknown")
          : (who != null ? String(who) : "Unknown");

        var right = isMe(who, m) || m.side === "right" || m.right === true;

        var row = document.createElement("div");
        row.className = "chat__msg " + (right ? "chat__msg--right" : "chat__msg--left");

        // Avatar
        var base = sv.path ? sv.path : "";
        var guessPortrait = (typeof who === "object")
          ? base + "images/characters/portraits/" + (who.sysName || whoName) + ".jpg"
          : null;
        var avatarUrl = m.avatar || guessPortrait || avatars[whoName] || null;

        var avatar = document.createElement("div");
        avatar.className = "chat__avatar" + (avatarUrl ? "" : " chat__avatar--spacer");
        if (avatarUrl) {
          var img = document.createElement("img");
          img.src = avatarUrl; img.alt = whoName; img.loading = "lazy";
          avatar.appendChild(img);
        }

        // Bubble
        var bubble = document.createElement("div");
        bubble.className = "chat__bubble " + (right ? "chat__bubble--right" : "chat__bubble--left");

        if (m.name !== false) {
          var nameEl = document.createElement("div");
          nameEl.className = "chat__name";
          nameEl.textContent = m.label || whoName;
          bubble.appendChild(nameEl);
        }

        var textEl = document.createElement("div");
        textEl.className = "chat__text";
        new Wikifier(textEl, m.text || "");
        bubble.appendChild(textEl);

        // Order matters for sizing on the right side
        if (right) { row.appendChild(bubble); row.appendChild(avatar); }
        else       { row.appendChild(avatar); row.appendChild(bubble); }

        list.appendChild(row);
      }

      // Render
      for (var i = 0; i < msgs.length; i++) {
        var m = msgs[i] || {};
        if (m.who == null) addNarration(m.text);
        else               addMessage(m);
      }

      this.output.appendChild(root);
      requestAnimationFrame(function () { list.scrollTop = list.scrollHeight; });
    }
  });
})();

/*
#######################################################################
*/

window.capitalize = function(val) {
    return String(val).charAt(0).toUpperCase() + String(val).slice(1);
}

window.wikifyText = function(text, keepHTML = false) {
    if (!text || typeof text !== "string") return text || "";
    
    const $container = $("<div>").wiki(text);
    
    if (keepHTML) {
        return $container.html().trim();
    } else {
        return $container.text().trim();
    }
};

window.wikifyHTML = function(text) {
    return window.wikifyText(text, true);
};

/* ==== Stat definitions ===================================================
   path / label / goodIncrease / min / max / currency / text: what UpdateStat changes and how it reports it.
   active   optional function: while it returns false the stat is switched off and UpdateStat does nothing
            (Suspicion until Stage 2, see "Company stats" in Define Company)
   maxPath  optional: a path to a max that changes during the game, used when there is no fixed max
            (the cap on my own corruption, $player.stats.max.corruption, raised by the story)
   capText  optional: the line UpdateStat prints instead of "+0" when the stat is already at its max
            (the corruption bar of mom/sister: full means she is ready for her next stage, Define NPCs) */
setup.statDefs = {
  money:      { path: 'player.money',              label: 'Money',      goodIncrease: true,  currency: '$' },
  corruption: { path: 'player.stats.corruption',   label: 'Corruption', goodIncrease: true,  min: 0, maxPath: 'player.stats.max.corruption', capText: "Corruption can't go any higher for now." },
  reputation: { path: 'company.stats.reputation',  label: 'Reputation', goodIncrease: true,  min: 0, max: 100 },
  efficiency: { path: 'company.stats.efficiency',  label: 'Efficiency', goodIncrease: true,  min: 0, max: 100 },
  suspicion:  { path: 'company.stats.suspicion',   label: 'Suspicion',  goodIncrease: false, min: 0, max: 100, active: () => setup.suspicionActive() },
  morale:     { path: 'company.stats.morale',      label: 'Morale',     goodIncrease: true,  min: 0, max: 100 },
  prototype:  { path: 'company.prototype.progress',label: 'Prototype',  goodIncrease: true,  min: 0, maxPath: 'company.prototype.maxProgress', text: "Progress of $company.prototype.name", capText: "$company.prototype.name won't get any further until I know what it needs to do next." },
  momrelation:{ path: 'mom.stats.relation',		   label: 'MomRelation',goodIncrease: true,  min: 0, max: 100, text: "$mom.name's Relation" },
  momcorruption:{ path: 'mom.stats.corruption',    label: 'MomCorruption',goodIncrease: true,  min: 0, max: 100, text: "$mom.name's Corruption", capText: "$mom.callName is ready for more." },
  momresistance:{ path: 'mom.stats.resistance',	   label: 'MomResistance',goodIncrease: false, min: 0, max: 100, text: "$mom.name's Resistance" },
  momlust:	  { path: 'mom.stats.lust',		  	   label: 'MomLust',	goodIncrease: true,  min: 0, max: 100, text: "$mom.name's Lust" },
  sisterrelation:{ path: 'sister.stats.relation',  label: 'SisterRelation',goodIncrease: true,  min: 0, max: 100, text: "$sister.name's Relation" },
  sistercorruption:{ path: 'sister.stats.corruption',label: 'SisterCorruption',goodIncrease: true,  min: 0, max: 100, text: "$sister.name's Corruption", capText: "$sister.callName is ready for more." },
  sisterresistance:{ path: 'sister.stats.resistance',label: 'SisterResistance',goodIncrease: false, min: 0, max: 100, text: "$sister.name's Resistance" },
  sisterlust:	  { path: 'sister.stats.lust',	   label: 'SisterLust',	goodIncrease: true,  min: 0, max: 100, text: "$sister.name's Lust" },
  /* how comfortable she is being seen: the second gate of the family offers ("Family offers" in Define Quests) */
  momexhibition:   { path: 'mom.stats.exhibition',    label: 'MomExhibition',    goodIncrease: true, min: 0, maxPath: 'mom.stats.max.exhibition', text: "$mom.name's Exhibition", capText: "$mom.name's Exhibition can't go any higher for now." },
  sisterexhibition:{ path: 'sister.stats.exhibition', label: 'SisterExhibition', goodIncrease: true, min: 0, maxPath: 'sister.stats.max.exhibition', text: "$sister.name's Exhibition", capText: "$sister.name's Exhibition can't go any higher for now." },
};

/* Helpers to read/write v.* via string paths */
setup._getByPath = (root, path) => path.split('.').reduce((o, k) => (o ? o[k] : undefined), root);
setup._setByPath = (root, path, value) => {
  const keys = path.split('.');
  const last = keys.pop();
  const obj = keys.reduce((o, k) => o[k], root);
  obj[last] = value;
};

/* ==== <<UpdateStat "+"|"−" key amount>> ================================== */
/*
============================== Offer ==================================================
<<Offer>> <<plain "label" "cost" [money]>> ... <<family $mom level "label" ["cost"] ["lock"]>> ... <<stall "label" "questId" ["note"]>> ... <</Offer>>
A family card may name both of them ([$mom, $sister]): every one of them has to be ready. A non-empty "lock" text locks
it with that reason whatever her stats say (her own story isn't there yet).
A row of offer cards for a deal: the plain price, the family option, and stalling. Each card runs its own block
when clicked and the row goes away. A family card is locked with the reason until she is ready for that level, a
plain card with money is locked while the account can't cover it, a stall card is hidden once the deal has no
stalls left. The data and the helpers are in "Family offers" (Define Quests).
*/
Macro.add('Offer', {
    tags: ['plain', 'family', 'stall'],
    handler() {
        const $row = jQuery('<div class="offer-row"></div>');
        const $out = jQuery('<div class="offer-outcome"></div>');
        let decided = false;

        this.payload.slice(1).forEach((chunk) => {
            const a = chunk.args;
            let label = '';
            let cost = '';
            let lock = null;
            let npcs = [];
            let level = 0;
            let money = 0;
            let questId = null;

            if (chunk.name === 'plain') {
                label = a[0]; cost = a[1] || ''; money = Number(a[2]) || 0;
                if (money > 0 && !setup.canAfford(money)) { lock = "The account can't cover it"; }
            } else if (chunk.name === 'family') {
                npcs = (Array.isArray(a[0]) ? a[0] : [a[0]]).map((w) => setup.corruptionNpc(w)).filter(Boolean);
                level = Number(a[1]) || 0;
                label = a[2]; cost = a[3] || '';
                if (a[4]) { lock = a[4]; }
                npcs.forEach((n) => {
                    const ready = setup.offerReady(n, level);
                    if (!lock && !ready.ok) { lock = (npcs.length > 1 ? n.callName + ": " : '') + ready.reason; }
                });
            } else if (chunk.name === 'stall') {
                label = a[0]; questId = a[1]; cost = a[2] || '';
                if (!setup.canStall(questId)) { return; }
            }

            const $card = jQuery('<button type="button" class="offer-card"></button>').addClass('offer-' + chunk.name);
            if (npcs.length) {
                const lv = setup.offerLevels[Math.clamp(level, 0, setup.offerLevels.length - 1)];
                const $who = jQuery('<span class="offer-who"></span>');
                npcs.forEach((npc) => {
                    const $dot = jQuery('<span class="offer-dot"></span>').text(String(npc.callName || '?').charAt(0));
                    jQuery('<img alt="">')
                        .attr('src', State.variables.path + 'images/characters/portraits/' + npc.sysName + '.jpg')
                        .on('error', function () { jQuery(this).remove(); })
                        .appendTo($dot);
                    $who.append($dot);
                });
                $who.append(jQuery('<span class="offer-level"></span>').text(lv.name));
                $card.append($who);
            }
            $card.append(jQuery('<span class="offer-label"></span>').wiki(label));
            if (cost) { $card.append(jQuery('<span class="offer-cost"></span>').wiki(cost)); }

            if (lock) {
                $card.addClass('locked').attr('disabled', true)
                    .append(jQuery('<span class="offer-lock"></span>').text(lock));
            } else {
                $card.on('click', this.createShadowWrapper(() => {
                    if (decided) { return; }
                    decided = true;
                    if (money > 0) { setup.spend(money, jQuery('<span></span>').wiki(label).text()); }
                    if (questId) { setup.stallOffer(questId); }
                    $row.remove();
                    $out.wiki(chunk.contents);
                }));
            }
            $row.append($card);
        });

        jQuery(this.output).append($row, $out);
    }
});

Macro.add('UpdateStat', {
  handler () {
    const [opRaw, keyRaw, amtRaw] = this.args;
    const op = String(opRaw);
    const key = String(keyRaw).toLowerCase();
    const def = setup.statDefs[key];
    if (!(op === '+' || op === '-')) return this.error('First argument must be "+" or "-".');
    if (!def) return this.error(`Unknown stat "${keyRaw}".`);
    const amount = Number(amtRaw);
    if (!Number.isFinite(amount) || amount < 0) return this.error('Amount must be a positive number.');
    /* a stat that is switched off right now (Suspicion before Stage 2) neither changes nor shows a line */
    if (typeof def.active === 'function' && !def.active()) return;

    const v = State.variables;
    const delta = op === '+' ? amount : -amount;
    const cur = Number(setup._getByPath(v, def.path)) || 0;
    let next = cur + delta;
    if (typeof def.min === 'number') next = Math.max(def.min, next);
    const max = typeof def.max === 'number' ? def.max : (def.maxPath ? Number(setup._getByPath(v, def.maxPath)) : NaN);
    if (Number.isFinite(max)) next = Math.min(max, next);
    setup._setByPath(v, def.path, next);

    /* already full: one quiet line instead of "increased by 1" (her corruption bar waits for a milestone) */
    if (def.capText && delta > 0 && next === cur) {
      $(this.output).wiki(`<span class="statupdate">${def.capText}</span>`);
      State.temporary.statNotifications = State.temporary.statNotifications || [];
      State.temporary.statNotifications.push({ msg: Wikifier.wikifyEval(def.capText).textContent, type: Notification.INFORMATION });
      return;
    }

    /* Message prep */
    const increased = delta > 0;
    const positive = (increased && def.goodIncrease) || (!increased && !def.goodIncrease);
    const cls = positive ? 'green' : 'red';
    const verb = increased ? 'increased' : 'decreased';
    const shownAmt = (def.currency || '') + Math.abs(delta);
    const text = def.text || def.label;

    /* Show inline text (optional – keep for immediate feedback) */
    $(this.output).wiki(
      `<span class="${cls} statupdate">${text} has ${verb} by ${shownAmt}.</span>`
    );

    /* Queue notification silently */
    let type = positive ? Notification.POSITIVE : Notification.NEGATIVE;
    let msg = Wikifier.wikifyEval(`${text} has ${verb} by ${shownAmt}.`).textContent;

    /* Add to temp queue instead of showing immediately */
    State.temporary.statNotifications = State.temporary.statNotifications || [];
    State.temporary.statNotifications.push({ msg, type });
  }
});

