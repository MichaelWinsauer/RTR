#######################################################################
*/


class Notification {
  static notificationQueue = [];
  static POSITIVE = "positive";
  static NEGATIVE = "negative";
  static QUEST = "quest";
  static INFORMATION = "info";
  static WARN = "warn";

  constructor(text, settings = {}) {
    this.text = text;
    if(Wikifier != undefined) {
    	this.text = Wikifier.wikifyEval(this.text).textContent;
    }
    const defaults = {
      type: Notification.POSITIVE,
      duration: 10000,
    };
    this.settings = { ...defaults, ...settings };

    this.id = Date.now().toString(36) + Math.random().toString(36).substring(2);
  }

  static show(text, settings = {}) {
    const notification = new Notification(text, settings);
    notification.element = Notification.createElement(notification);
    Notification.pushNotification(notification);
  }

  static createElement(notification) {
    const notificationElement = document.createElement("div");
    notificationElement.classList.add("ntfct");
    notificationElement.id = notification.id;
    
    const wrapperElement = document.createElement("div");
    wrapperElement.classList.add("ntfct-wrapper");

    const iconWrapperElement = document.createElement("div");
    iconWrapperElement.classList.add("ntfct-icon");

    const iconElement = document.createElement("div");

    const contentElement = document.createElement("div");
    contentElement.classList.add("ntfct-content");
    contentElement.innerText = notification.text;

    const timeBarElement = document.createElement("div");
    timeBarElement.classList.add("ntfct-bar");
    timeBarElement.id = notification.id + "_bar";

    const closeElement = document.createElement("div");
    closeElement.classList.add("ntfct-close");
    closeElement.addEventListener("click", function() {
      Notification.removeNotification(notification);
    });

    closeElement.innerText = "X";
    
    let path = "./";
    
    if(State.variables.path != "") {
      path = State.variables.path;
    }
    
    path += "images/misc/";

    switch (notification.settings.type) {
      case Notification.POSITIVE:
      notificationElement.classList.add("positive-border");
      iconWrapperElement.classList.add("positive-color");
      iconElement.style.background = "url(" + path + "positive.svg)";
        iconElement.style.backgroundSize = "contain";
      timeBarElement.classList.add("positive-color");
      break;

      case Notification.NEGATIVE:
      notificationElement.classList.add("negative-border");
      iconWrapperElement.classList.add("negative-color");
      iconElement.style.background = "url(" + path + "negative.svg)";
        iconElement.style.backgroundSize = "contain";
      timeBarElement.classList.add("negative-color");
      break;

      case Notification.QUEST:
      notificationElement.classList.add("quest-border");
      iconWrapperElement.classList.add("quest-color");
      iconElement.style.background = "url(" + path + "quest.svg)";
      iconElement.style.backgroundSize = "contain";
      timeBarElement.classList.add("quest-color");
      break;

      case Notification.INFORMATION:
      notificationElement.classList.add("info-border");
      iconWrapperElement.classList.add("info-color");
      iconElement.style.background = "url(" + path + "info.svg)";
        iconElement.style.backgroundSize = "contain";
      timeBarElement.classList.add("info-color");
      break;
        
      case Notification.WARN:
      notificationElement.classList.add("warn-border");
      iconWrapperElement.classList.add("warn-color");
      iconElement.style.background = "url(" + path + "warn.svg)";
        iconElement.style.backgroundSize = "contain";
      timeBarElement.classList.add("warn-color");
      break;
    }

    iconWrapperElement.appendChild(iconElement);
    wrapperElement.appendChild(iconWrapperElement);
    wrapperElement.appendChild(contentElement);
    notificationElement.appendChild(timeBarElement);
    notificationElement.appendChild(wrapperElement);
    notificationElement.appendChild(closeElement);

    return notificationElement;
  }

  static pushNotification(notification) {
    Notification.notificationQueue.unshift(notification);
    notification.element.style.top = '3vh !important';
    document.body.appendChild(notification.element);

    notification.element.style.right = document.body.clientWidth + (notification.element.offsetWidth / 5) + "px";

    requestAnimationFrame(() => {
      notification.element.style.right = '2vw';
      notification.element.style.opacity = 1;
    });

    Notification.positionNotifications();

    let delta = 100;
    let barInterval = setInterval(function() {
      delta += 100;
      let width = notification.settings.duration - delta; 
      notification.element.children[0].style.width = width / notification.settings.duration * 100 + "%";
    }, 100);

    setTimeout(function() {      
      Notification.removeNotification(notification)
      clearInterval(barInterval);
    }, notification.settings.duration);
  }

  static positionNotifications() {
    let currentTop = 20;

    Notification.notificationQueue.forEach((n) => {
      if (n.element && document.body.contains(n.element)) {
        n.element.style.top = currentTop + "px";
        currentTop += n.element.offsetHeight + 20;
      }
    });
  }

  static removeNotification(notification) {
    const index = Notification.notificationQueue.indexOf(notification);
    if (index > -1) {
      Notification.notificationQueue.splice(index, 1);
    }

    if (notification.element && notification.element.parentNode) {
      notification.element.parentNode.removeChild(notification.element);
    }

    Notification.positionNotifications();
  }
}

window.Notification = Notification;

setup.initVisibilityNotificationHandler = function () {
  const triggers = document.querySelectorAll(".statupdate:not([data-ntf-handled])");
  if (triggers.length === 0) return;

  triggers.forEach(trigger => {
    trigger.dataset.ntfHandled = "true";

    const observer = new IntersectionObserver(entries => {
      if (!entries[0].isIntersecting) return;

      const queue = (State.temporary.statNotifications || []).splice(0);
      queue.forEach((n, i) => {
        setTimeout(() => {
          if (typeof Notification !== "undefined" && Notification.show) {
            Notification.show(n.msg, { type: n.type });
          }
        }, i * 120);
      });

      observer.disconnect();
    }, { threshold: 0.01 });

    observer.observe(trigger);

    setTimeout(() => {
      const rect = trigger.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        const queue = (State.temporary.statNotifications || []).splice(0);
        queue.forEach((n, i) => {
          setTimeout(() => {
            if (typeof Notification !== "undefined" && Notification.show) {
              Notification.show(n.msg, { type: n.type });
            }
          }, i * 120);
        });
        observer.disconnect();
      }
    }, 80);
  });
};

$(document).on(':passagerender', setup.initVisibilityNotificationHandler);

$(document).on("click keyup", () => {
  setTimeout(setup.initVisibilityNotificationHandler, 80);
});

/*
================================ Kept Scroll Positions: ==============================================
   Scroll boxes in setup.keptScroll keep their position when the passage reloads, or when their panel is
   redrawn with <<replace>> (call setup.restoreScroll() right after the replace).
   The positions are UI only (setup.scrollMemory), so they are not saved and start at the top after a load.
   scroll does not bubble, so one capturing listener on the document records every listed box.
*/

setup.keptScroll = ['.quests-wrapper', '#cctv-control-panel'];
setup.scrollMemory = {};

document.addEventListener('scroll', function (e) {
  const el = e.target;
  if (!(el instanceof Element)) return;
  setup.keptScroll.forEach(function (sel) {
    if (el.matches(sel)) setup.scrollMemory[sel] = el.scrollTop;
  });
}, true);

setup.restoreScroll = function () {
  setup.keptScroll.forEach(function (sel) {
    const el = document.querySelector(sel);
    if (el && setup.scrollMemory[sel] != null) el.scrollTop = setup.scrollMemory[sel];
  });
};

$(document).on(':passagerender', function () {
  setTimeout(setup.restoreScroll, 0);
});

/*
============================== Hover & Click Sound Effect =============================================
*/
(function () {
    $(document).one(':storyready', function () {
        $(document).on("mouseenter", "a, button, .link-internal, .link-external, .ca-btn:not(.idle), .ca-row, .cmd-management-employee-card, .cmd-projects-project-wrapper, .cmd-inbox-mail, .cmd-schedule-action", function () {
          	if (settings.volSfx == 0) return;
            var volume = (typeof settings !== 'undefined' && settings.volSfx != null ? settings.volSfx : 50) / 100  / 2;
          	SimpleAudio.select("effect-hover").volume(volume).loop(false).play();
        });

        $(document).on("click", "a, button, .link-internal, .link-external, .ca-btn:not(.idle), .ca-row, .cmd-management-employee-card, .cmd-projects-project-wrapper, .cmd-inbox-mail, .cmd-schedule-action", function () {
          	if (settings.volSfx == 0) return;
          	var volume = (typeof settings !== 'undefined' && settings.volSfx != null ? settings.volSfx : 50) / 100  / 2;
            SimpleAudio.select("effect-click").volume(volume).loop(false).play();
        });
    });
})();

/*
============================== Task Progression Check ==================================================
completeTaskEntry(sysName, entry) pays a finished $activeTasks entry out: revenue, her energy, count,
onComplete, her day log (End-of-day report, Define NPCs), stages. checkTaskProgression calls it when an entry reaches its endRow;
setup.completeTaskSceneEntry (Define Tasks) when a scene ends with no action left to spend.
*/
window.completeTaskEntry = function (sysName, taskEntry) {
    const task = taskEntry.task;
    const npc = State.variables[sysName];

    State.variables.company.finances.money += (task.revenue || 0);
    State.variables.company.finances.income.tasks += (task.revenue || 0);

    /* base cost plus the surcharge for missing morale (setup.taskEnergyCost, Define Tasks) */
    let energy = npc.stats.energy - setup.taskEnergyCost(task, npc);

    State.variables[sysName].stats.energy = Math.clamp(
        energy,
        npc.stats.min.energy,
        npc.stats.max.energy
    );

    task.count = (task.count || 0) + 1;
    task.lastCompletedAt = State.variables.date.dayCount;

    /* taskEntry.task is a copy, so mirror the progress onto the real task in $tasks */
    const liveTask = setup.getTaskById(task.id);
    if (liveTask && liveTask !== task) {
        liveTask.count = (liveTask.count || 0) + 1;
        liveTask.lastCompletedAt = State.variables.date.dayCount;
    }

    taskEntry.inProgress = false;

    /* the effects of the stage that was just played ("Task effects" in Define Tasks), before onComplete */
    setup.applyTaskEffects(sysName, liveTask || task);

    if (task.onComplete && typeof task.onComplete.forEach === "function") {
        task.onComplete.forEach(func => func());
    }

    /* her end-of-day report: an entry for the stage that was just played, if the task has a report
       ("End-of-day report" in Define NPCs). Before checkTaskStage, which may move the task on */
    setup.logTaskReport(sysName, task);

    /* a new stage changes the activity: setup.npcAt reads it from the task, nothing to copy */
    setup.checkTaskStage(task.id);
};

window.checkTaskProgression = function () {
    const currentGlobalRow = 
        State.variables.time.current.value * State.variables.time.actions.max +
        (State.variables.time.actions.max - State.variables.time.actions.left);

    const dayType = State.variables.date.today.value < 5 ? "weekday" : "weekend";
    let refreshScheduler = false;

    if (dayType === "weekend") return;

    /* once per action: <<UseAction>> runs it for every action, the Daily Update a second time for the first one */
    const checkKey = State.variables.date.dayCount * 21 + currentGlobalRow;
    if (State.variables.lastCheckedGlobalRow === checkKey) {
        return;
    }
    State.variables.lastCheckedGlobalRow = checkKey;

    const characters = ["mom", "sister"];

    characters.forEach(sysName => {
        const activeTasks = State.variables.activeTasks[sysName] || [];
        let hasActiveTaskThisTick = false;

        for (let i = activeTasks.length - 1; i >= 0; i--) {
            const taskEntry = activeTasks[i];
            const task = taskEntry.task;

            if (currentGlobalRow === taskEntry.endRow && taskEntry.inProgress) {
                /* tasks with the player only finish when he took part (see "Tasks with the player" in Define Tasks) */
                const allowed = setup.allowTaskCompletion(taskEntry);
                if (allowed === "wait") {
                    /* he may be walking over right now; CheckTaskScene decides once he has arrived */
                    refreshScheduler = true;
                    continue;
                }
                if (!allowed) {
                    taskEntry.inProgress = false;
                    refreshScheduler = true;
                    continue;
                }

                window.completeTaskEntry(sysName, taskEntry);
                refreshScheduler = true;
            }
        }

        for (let i = 0; i < activeTasks.length; i++) {
            const taskEntry = activeTasks[i];
            const task = taskEntry.task;

            /* it rests (cooldown), she is too tired, a private task has company, or the partner of a task
               for two can't come ("Starting a task" in Define Tasks) */
            if (currentGlobalRow === taskEntry.startRow
                && !setup.taskStartBlock(sysName, taskEntry)) {

                taskEntry.inProgress = true;
                refreshScheduler = true;
            }
        }

        for (let i = 0; i < activeTasks.length; i++) {
            const taskEntry = activeTasks[i];
            if (taskEntry.inProgress && 
                currentGlobalRow >= taskEntry.startRow && 
                currentGlobalRow < taskEntry.endRow) {
                
                hasActiveTaskThisTick = true;
                break;
            }
        }

        State.variables[sysName].flags.taskInProgress = hasActiveTaskThisTick;
        if (!hasActiveTaskThisTick && 
            setup.isTaskRow(sysName, currentGlobalRow)) {
            
            /* a free hour at her desk gives a little back (setup.taskEnergyTuning, Define Tasks) */
            const updatedEnergy = State.variables[sysName].stats.energy + setup.taskEnergyTuning.idlePerRow;
            State.variables[sysName].stats.energy = Math.min(
                updatedEnergy, 
                State.variables[sysName].stats.max.energy
            );
        }
    });

    if (refreshScheduler && State.passage === "Company Stage 1 Desk") {
        $("#cmd-schedule").empty().wiki('<<include "CMD Schedule">>');
    }
};

/*
============================== Task Stages ==================================================
A task can have an optional "stages" array. Each stage replaces the task's activity (an activity id
from Define Activities, and with it the pictures and the CCTV clip) and can name a passage the CCTV
arrow leads to:

    stage: 0,
    stages: [
        { activity: "helping_landlord0", passage: "CCTV Mom Landlord 0" },
        {
            activity: "helping_landlord1",
            passage: "CCTV Mom Landlord 1",
            requirements: [ () => setup.corruptionTotal("mom") >= 30 ],
            requirementsText: [ "$mom.callName needs 30 corruption" ],
            minCount: 3,          // times the task has to be finished on the previous stage
            corruptionStage: 2,   // optional: her corruption stage at least this (setup.corruptionStage)
            quest: "mom_crawl",   // optional: this quest is done (setup.questDone)
        },
    ],

Every time the task is finished, the next stage is checked and unlocked when all its requirements
pass. Story code can also force a stage with <<run setup.setTaskStage("task_mom_help_landlord", STAGE)>>.
For the picker, setup.taskStageNeeds(task) (Define Tasks) lists what the next stage still waits for.
*/
/* Tasks have string ids ("task_mom_test_session"), never use their index in $tasks */
setup.getTaskById = function (id) {
    return (State.variables.tasks || []).find(t => t.id === id);
};

/* The real task from $tasks (activeTasks only hold copies), falling back to the given copy */
setup.getLiveTask = function (task) {
    return (task && setup.getTaskById(task.id)) || task;
};

setup.getTaskStage = function (task) {
    const live = setup.getLiveTask(task);
    if (!live || !Array.isArray(live.stages) || live.stages.length === 0) return null;
    const index = Math.clamp(live.stage || 0, 0, live.stages.length - 1);
    return live.stages[index];
};

/* The activity id of the task's current stage (or of the task itself) */
setup.getTaskActivity = function (task) {
    const live = setup.getLiveTask(task);
    if (!live) return undefined;
    const stage = setup.getTaskStage(live);
    return (stage && stage.activity) || live.activity;
};

setup.getTaskPassage = function (task) {
    const live = setup.getLiveTask(task);
    if (!live) return undefined;
    const stage = setup.getTaskStage(live);
    return (stage && stage.passage) || live.passage;
};

/* Unlocks the next stage of a task if its requirements pass. Returns true if the stage changed. */
setup.checkTaskStage = function (id) {
    const live = setup.getTaskById(id);
    if (!live || !Array.isArray(live.stages)) return false;

    const current = live.stage || 0;
    const next = live.stages[current + 1];
    if (!next) return false;

    const countOnStage = (live.count || 0) - (live.stageStartCount || 0);
    if (next.minCount && countOnStage < next.minCount) return false;
    if (next.corruptionStage !== undefined && setup.corruptionStage(live.who.sysName) < next.corruptionStage) return false;
    if (next.quest && !setup.questDone(next.quest)) return false;
    if ((next.requirements || []).some(req => !req())) return false;

    setup.setTaskStage(id, current + 1);
    return true;
};

setup.setTaskStage = function (id, stage) {
    const live = setup.getTaskById(id);
    if (!live || !Array.isArray(live.stages)) return;
    live.stage = Math.clamp(stage, 0, live.stages.length - 1);
    live.stageStartCount = live.count || 0;
};

/*
============================== CCTV ==================================================
Works out what the camera at $cctv.currentId shows:
    null                      -> nobody there, show the empty room
    { npc, both, media, ... } -> clip of the character in view ($cctv.view picks one if both are there)

The clip is one of the activity's "cctv" files (images/characters/<sysName>/tasks/<file>), the same
one for the whole action; activities without any fall back to their "media" files (Define Activities).
The arrow passage is the task stage's passage, or the activity's cctvPassage when no task runs.
*/
setup.getCCTVSubject = function () {
    const sv = State.variables;
    const present = ["mom", "sister"].filter(sysName =>
        sv[sysName].location && setup.sameLocation(sv[sysName].location, sv.cctv.currentId));
    if (present.length === 0) return null;

    const sysName = present.includes(sv.cctv.view) ? sv.cctv.view : present[0];
    const npc = sv[sysName];
    const row = sv.time.current.actionSlot;
    const isWeekday = sv.date.today.value < 5;

    const entry = isWeekday ? (sv.activeTasks[sysName] || []).find(e =>
        e.inProgress && row >= e.startRow && row < e.endRow) : undefined;

    const activityId = entry ? setup.getTaskActivity(entry.task) : npc.activity;
    const activity = setup.getActivity(sysName, activityId);
    /* a task with the player is a scene he is in, not something to watch on the camera */
    let passage = (entry && !setup.isTaskWithPlayer(entry.task)) ? setup.getTaskPassage(entry.task) : undefined;
    if (!passage && activity) passage = activity.cctvPassage;

    return {
        sysName: sysName,
        npc: npc,
        both: present.length > 1,
        activity: activity,
        activityId: activityId,
        task: entry ? setup.getLiveTask(entry.task) : undefined,
        passage: (passage && Story.has(passage)) ? passage : undefined,
        media: setup.activityMedia(sysName, activityId, "cctv"),
    };
};

