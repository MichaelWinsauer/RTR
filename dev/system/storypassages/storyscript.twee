#######################################################################
*/

$(document).one(':storyready', function () {
  const $tray    = $('#ui-bar-tray');
  const $history = $('#ui-bar-history');

  // Make a small group container so we can style/position as a block
  const $group = $('<div/>', { id: 'custom-tray-buttons', class: 'tray-icons' });

  // Helpers
  const mkBtn = (label, iconEntity, onClick) => {
    return $('<button/>', {
      class: 'tray-icon-btn',
      'aria-label': label,
      title: label
    })
    .append($('<span/>', { class: 'sc-ic', html: iconEntity }))
    .on('click', onClick);
  };

  // Icons use SugarCube’s built-in icon font (sc-icons)
  const $saveBtn     = mkBtn('Saves',    '&#xf0c7;', () => UI.saves());     // floppy-disk
  const $restartBtn  = mkBtn('Restart',  '&#xf2f1;', () => UI.restart());   // rotate/sync
  const $settingsBtn = mkBtn('Settings', '&#xf013;', () => UI.settings());  // gear

  /* "?" opens the help dialog (dev/help_dialog) */
  const $helpBtn = $('<button/>', { class: 'tray-icon-btn', 'aria-label': 'Help', title: 'Help' })
    .append($('<span/>', { class: 'help-q', text: '?' }))
    .on('click', () => window.displayHelpDialog());

  $group.append($saveBtn, $restartBtn, $settingsBtn, $helpBtn);

  // Place our group before the history buttons (next to the stow toggle)
  if ($history.length) {
    $history.after($group);
  } else {
    $tray.append($group);
  }
});

