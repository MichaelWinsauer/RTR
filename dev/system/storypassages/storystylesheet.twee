:: StoryStylesheet [stylesheet system] {"position":"375,300"}

:root {
  --green: #35DB76;
  --red: #DB354C;
  --yellow: #DBAF35;

  --accent: #EBDDC5;
  --accent-transparent: #EBDDC566;
  --gold: #EAAF4C;

  --positive: #1cd88d;
  --positive-bg: #1cd88d10;
  --negative: #d81c4b;
  --negative-bg: #d81c4b10;
  --quest: #8d1cd8;
  --quest-bg: #8d1cd810;
  --info: #BFBFBF;
  --info-bg: #BFBFBF10;
  --warn: #d8a31c;
  --warn-bg: #d8a31c10;

  --main-bg: rgba(34, 34, 46, .6);
  --main-bg-deep: rgba(34, 34, 46, .9);
  --card-bg: #EBDDC50d;
  --card-border: #EBDDC51f;

  --link-bg: rgba(64, 64, 76, .6);
  --link-bg-transparent: rgba(64, 64, 76, .2);

  --chat-left: rgba(104, 104, 126, .6);
  --chat-right: rgba(64, 64, 76, .6);
}

.green {
  color: #35DB76; 
}

.red {
  color: #DB354C; 
}

.yellow {
  color: #DBAF35; 
}

.accent {
  color: var(--accent);
}

.bold {
  font-weight: bold;
}

.passage {
  font-family: "Manrope", sans-serif;
  font-optical-sizing: auto;
  font-weight: 300;
  font-size: 13pt;
  text-align: justify;
}

img, video {
  content-visibility: auto;
}

.media-wrapper {
    position: relative;
    display: inline-block;
}

.media-wrapper img,
.media-wrapper video {
    display: block;
    max-width: 100%;
    max-height: 100%;
    height: auto;
    width: auto;
}

a {
  color: var(--accent);
}

.passage a {
  color: #EAAF4C;
  font-weight: bold;
}

a:hover {
  color: #DFBE9F;
}

i {
  color: rgb(200, 200, 200);
}

hr {
  border-color: #EBDDC530;
  color: #EBDDC530;
  background-color: #EBDDC530;
}

input, select, textarea, button {
  padding: .4em;
  border-color: #EBDDC530;
  color: var(--accent);
  background-color: #EBDDC530;
  font-weight: bold;
}

html[data-outlines] input:focus, html[data-outlines] select:focus, html[data-outlines] textarea:focus, input:hover, select:hover, textarea:hover, button:hover {
  background-color: transparent;
}

input[type="range"]::-moz-range-track {
  background: #EBDDC550;

  border: 1px solid #EBDDC525;

  border-radius: 9999px;

  cursor: pointer;
  height: .25rem;
  width: 100%;
}
input[type="range"]::-moz-range-thumb {
  background: var(--accent);

  border: none;

  border-radius: 9999px;

  cursor: pointer;
  height: 1rem;
  width: 1.5rem;
}

.characters input {
  width: 100%;
  text-align: left;
}

/* ——— character configuration ——— */
.cc-page {
  max-width: 980px;
  margin: 0 auto;
  padding: 1.5rem 1rem 2rem;
  text-align: left;
}

.cc-header {
  position: relative;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--card-border);
}

.cc-title {
  font-size: 1.9rem;
  font-weight: 700;
  letter-spacing: .04em;
  color: var(--accent);
}

.cc-subtitle {
  margin-top: .25rem;
  font-size: .95rem;
  color: var(--info);
}

.cc-skip {
  margin-top: .75rem;
  font-size: .85rem;
}

.cc-card {
  box-sizing: border-box;
  padding: 1.25rem 1.4rem 1.4rem;
  border: 1px solid var(--card-border);
  border-radius: .6rem;
  background-color: var(--main-bg);
  backdrop-filter: blur(5px);
  box-shadow: 0 6px 24px rgba(0, 0, 0, .25);
}

.cc-player {
  margin-bottom: 1.25rem;
}

.cc-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.25rem;
}

.cc-card-head {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.1rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--card-border);
}

.cc-avatar {
  flex: 0 0 auto;
  width: 84px;
  height: 84px;
  border: 2px solid var(--accent);
  border-radius: 50%;
  object-fit: cover;
  object-position: center 20%;
  box-shadow: 0 0 18px rgba(0, 0, 0, .45);
}

.cc-card-tag {
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--accent);
}

.cc-card-question {
  margin-top: .15rem;
  font-size: 1.2rem;
  font-weight: 600;
  color: var(--accent);
}

.cc-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: .8rem;
}

.cc-field {
  display: block;
  margin-bottom: .85rem;
  min-width: 0;
}

.cc-player .cc-field {
  margin-bottom: 0;
}

.cc-label {
  display: block;
  margin-bottom: .3rem;
  font-size: .8rem;
  font-weight: 500;
  color: var(--accent);
  opacity: .8;
}

#textbox-momsurname, #textbox-momname, #textbox-sistersurname, #textbox-sistername {
  min-width: 0;
}

.cc-field input {
  box-sizing: border-box;
  width: 100%;
  padding: .55em .8em;
  border: 1px solid #EBDDC530;
  border-radius: .4rem;
  background-color: #EBDDC510;
  color: var(--accent);
  font-family: inherit;
  font-size: 1rem;
  font-weight: 500;
  text-align: left;
  transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease;
}

.cc-field input::placeholder {
  color: var(--accent);
  opacity: .3;
  font-weight: 300;
}

.cc-field input:hover {
  border-color: #EBDDC560;
  background-color: #EBDDC51a;
  color: var(--accent);
}

.cc-field input:focus {
  outline: none;
  border-color: var(--accent);
  background-color: #EBDDC51a;
  box-shadow: 0 0 0 3px #EBDDC530;
}

.cc-hint {
  margin: 1.1rem 0 .4rem;
  font-size: .8rem;
  text-align: center;
  color: var(--info);
  opacity: .8;
}

@media (max-width: 520px) {
  .cc-row {
    grid-template-columns: 1fr;
    gap: 0;
  }
  .cc-player .cc-row .cc-field + .cc-field {
    margin-top: .85rem;
  }
}

body {
  background-size: cover;
  background-repeat: no-repeat;
  background-attachment: fixed;
  background-position: center;
  /* background-image: url(images/misc/background.jpg); */
  /*background-image: url(https://images.unsplash.com/photo-1444084316824-dc26d6657664?q=80&w=2370&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D); */
}

/* The page background: the image (--page-bg, set by <<SetBackground>>) blurred on body::before, and the shade
   of the time of day (--page-shade) over it on body::after. The sidebar repeats both for its glass (#ui-bar::before).
   The blur is a plain filter on a layer of its own, painted once. It used to be a backdrop-filter on body::after,
   and Chrome recomputes a backdrop blur for the whole screen on every frame that anything on the page animates
   (quest pulses, the device pulse, title cards), which kept the GPU near full load. Keep backdrop-filter off
   big or full-screen elements for that reason. */
body {
  --page-shade: radial-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6));
}

body.early-morning {
  --page-shade: radial-gradient(rgba(7, 16, 44, 0.4), rgba(0, 2, 19, 0.6));
}

body.night {
  --page-shade: radial-gradient(rgba(7, 16, 44, 0.4), rgba(0, 2, 19, 0.8));
}

body.late-night {
  --page-shade: radial-gradient(rgba(7, 16, 44, 0.6), rgba(0, 2, 19, 1));
}

body::before {
  position: fixed;
  content: '';
  inset: 0;
  z-index: -2;
  pointer-events: none;
  background: var(--page-bg, none) center / cover no-repeat fixed;
  filter: blur(5px);
}

body::after {
  position: fixed;
  content: '';
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background: var(--page-shade);
}

@keyframes blink {
  0%   {color: rgba(105, 34, 28, 1);}
  50%  {color: rgba(105, 34, 28, 1);}
  100% {color: rgba(105, 34, 28, 0);}
}

@keyframes chapter {
  0%   {opacity: 0;}
  50%  {opacity: 1;}
  100% {opacity: 0;}
}

@keyframes appear {
  0%   {opacity: 0;}
  80%  {opacity: 0;}
  100% {opacity: 1;}
}

@keyframes disappear {
  0%   {opacity: 1;}
  100% {opacity: 0;}
}

.invisible {
  opacity: 0;
  transition: .5s ease-in-out;
}

.blink {
  font-weight: bold;
  animation-name: blink;
  animation-duration: 1.25s;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

.chapter {
  animation-name: chapter;
  animation-duration: 5s;
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  font-size: 100pt;
  font-family: 'Shadows Into Light', cursive;
  display: flex;
  justify-content: center;
  align-items: center;
}


/*
#######################################################################
#######################################################################
*/

\::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
\::-webkit-scrollbar-button {
  width: 0px;
  height: 0px;
}
\::-webkit-scrollbar-thumb {
  background: transparent;
  border: 0px none #ffffff;
  border-radius: 0px;
  transition: .3s ease-in-out;
}
\::-webkit-scrollbar-thumb:hover {
  background: var(--accent);
}
\::-webkit-scrollbar-thumb:active {
  background: var(--accent);
}
\::-webkit-scrollbar-track {
  background: transparent;
  border: 0px none transparent;
  border-radius: 0px;
}
\::-webkit-scrollbar-track:hover {
  background: transparent;
}
\::-webkit-scrollbar-track:active {
  background: transparent;
}
\::-webkit-scrollbar-corner {
  background: transparent;
}

* {
    -ms-overflow-style: none;
    scrollbar-width: none;
}
*::-webkit-scrollbar { 
    display: none;
}

/*
#######################################################################
#######################################################################
*/

/* ——— Modern Mobile Chat UI ——— */
.chat {
  max-width: 420px;
  margin: 1rem auto;
  border-radius: 20px;
  overflow: hidden;
  background: var(--bg);
  box-shadow: 0 8px 30px rgba(2, 6, 23, 0.08);
  border: 1px solid rgba(2,6,23,0.06);
  display: flex;
  flex-direction: column;
}

.chat__header {
  padding: .9rem 1rem;
  font-weight: 600;
  color: var(--fg);
  border-bottom: 1px solid rgba(2,6,23,0.06);
  letter-spacing: .2px;
  background: linear-gradient(180deg, rgba(2,6,23,0.03), transparent);
}

.chat__messages {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: .6rem;
  max-height: 60vh;
  overflow: auto;
  scroll-behavior: smooth;
}

.chat__msg {
  display: grid;
  grid-template-columns: 40px 1fr;
  align-items: end;
  gap: .5rem;
}
.chat__msg--right {
  grid-template-columns: 1fr 40px;
}

.chat__avatar {
  width: 36px;
  height: 36px;
  border-radius: 999px;
  overflow: hidden;
  background: #d1d5db;
  box-shadow: 0 0 0 2px var(--ring);

}
.chat__avatar img { width: 100%; height: 100%; object-fit: cover; border: none;
  padding: 0;}
.chat__avatar--spacer { background: transparent; box-shadow: none; }

.chat__bubble {
  max-width: 78%;
  border-radius: 16px;
  padding: .6rem .75rem;
  position: relative;
  line-height: 1.35;
  overflow-wrap: anywhere;
  backdrop-filter: blur(10px);
}

.chat__bubble--left {
  background: linear-gradient(90deg, var(--accent-transparent), transparent);
}

.chat__bubble--right {
  background: linear-gradient(270deg, var(--chat-right), transparent);
  min-width: 50%;
  justify-self: end;
  text-align: right;
}

.chat__name {
  font-size: .72rem;
  font-weight: 700;
  margin-bottom: .15rem;
  opacity: .8;
}

.chat__text {
  font-size: .95rem;
}

/* Bare layout: no card background, no border, no header */
.chat.chat--bare {
  background: transparent;
  box-shadow: none;
  border: none;
  border-radius: 0;
  margin: 0;
  max-width: none;
}

/* Only the message stream */
.chat__messages {
  padding: 0;            /* remove inner padding */
  max-height: unset;     /* let the page scroll normally */
  gap: .6rem;
}

/* Grid and alignment — keep bubbles wide on the "me" side */
.chat__msg {
  display: grid;
  grid-template-columns: 40px 1fr; /* avatar | bubble */
  align-items: end;
  gap: .5rem;
}
.chat__msg--right {
  grid-template-columns: 1fr 40px; /* bubble | avatar */
}

.chat img, .chat video {
  border: none;
  padding: 0;
}

.chat__msg--narr {
  display: flex !important;
  justify-content: center;
  margin: .5rem 0;
}

.chat__desc {
  max-width: 80ch;
  text-align: center;
  font-style: italic;
  opacity: .9;
  padding: 1rem .5rem;
}

/*
#######################################################################
#######################################################################
*/

#ui-dialog {
  left: 50% !important;
  right: auto !important;
  top: 50px;
  transform: translateX(-50%); 
}

#ui-dialog-body {
  background-color: var(--main-bg);
  backdrop-filter: blur(5px);
  border-radius: 2em;
  border: 1px solid var(--card-border); 
}

#ui-dialog-titlebar {
  background-color: transparent;
}

#ui-dialog-body.saves {
	padding: 1em;
}

#ui-dialog-body.saves > h2 {
  background-color: transparent !important;
  border: none !important;
}

#ui-overlay.open {
  backdrop-filter: blur(15px);
  background-color: #FFFFFF00;
  opacity: 1; 
}

#ui-dialog-title {
  text-align: left;
}

/*
#######################################################################
Task offer dialog (a task with the player starts: let it happen or not)
#######################################################################
*/
/* frame: compact, no SugarCube title bar, only a round close button in the corner (like the employee dialog) */
#ui-dialog:has(#ui-dialog-body.task-offer) {
  width: 460px;
  max-width: 92vw;
  top: 18vh;
}

#ui-dialog:has(#ui-dialog-body.task-offer) #ui-dialog-titlebar {
  position: absolute;
  top: 1rem;
  right: 1rem;
  z-index: 3;
  width: 1.9rem;
  height: 1.9rem;
  min-height: 0;
  padding: 0;
  background: transparent;
}

#ui-dialog:has(#ui-dialog-body.task-offer) #ui-dialog-title {
  display: none;
}

#ui-dialog:has(#ui-dialog-body.task-offer) #ui-dialog-close {
  inset: 0;
  width: 100%;
  height: 100%;
  font-size: .75rem;
  color: #EBDDC5;
  border: 1px solid #EBDDC535;
  border-radius: 50%;
  background-color: #EBDDC510;
  transition: background-color .15s ease, border-color .15s ease;
}

#ui-dialog:has(#ui-dialog-body.task-offer) #ui-dialog-close:hover {
  background-color: #EBDDC530;
  border-color: #EBDDC5;
}

#ui-dialog-body.task-offer {
  height: auto !important;
  padding: 1.35rem 1.5rem 1.4rem;
  font-family: "Manrope", sans-serif;
  color: #EBDDC5;
  background-color: rgba(34, 34, 46, .72);
  box-shadow: 0 24px 60px rgba(0, 0, 0, .45);
}

.tof {
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

/* "APPOINTMENT · NOON" with a fading rule */
.tof-kicker {
  display: flex;
  align-items: center;
  gap: .8rem;
  padding-right: 2.6rem;
  font-size: .7rem;
  font-weight: 800;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--accent);
}

.tof-kicker::after {
  content: "";
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, #EBDDC540, transparent);
}

.tof-head {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.tof-avatar {
  position: relative;
  width: 4.25rem;
  height: 4.25rem;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
  border: 2px solid #EBDDC5;
  box-shadow: 0 0 0 5px #EBDDC514, 0 8px 22px rgba(0, 0, 0, .35);
  background: linear-gradient(145deg, #EBDDC533, #EBDDC50d);
}

.tof-initial {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.6rem;
  font-weight: 800;
  color: #EBDDC5;
  opacity: .8;
}

.tof-avatar img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.tof-titles {
  display: flex;
  flex-direction: column;
  gap: .45rem;
  min-width: 0;
}

.tof-title {
  font-size: 1.3rem;
  font-weight: 800;
  line-height: 1.15;
  color: #EBDDC5;
}

.tof-meta {
  display: flex;
  flex-wrap: wrap;
  gap: .35rem;
}

.tof-chip {
  padding: .15rem .6rem;
  font-size: .66rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #EBDDC5cc;
  border: 1px solid #EBDDC530;
  border-radius: 999px;
}

/* the moment itself, as a quiet card */
.tof-prompt {
  margin: 0;
  padding: .9rem 1rem;
  font-size: .95rem;
  line-height: 1.55;
  color: #EBDDC5e6;
  background-color: #EBDDC50a;
  border: 1px solid #EBDDC51a;
  border-radius: .75rem;
}

.tof-cost {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: .4rem;
  font-size: .78rem;
}

.tof-cost-label {
  margin-right: .2rem;
  color: #EBDDC5;
  opacity: .6;
}

.tof-cost-chip {
  padding: .1rem .55rem;
  font-weight: 700;
  color: #ff6479;
  background-color: #DB354C1f;
  border: 1px solid #DB354C55;
  border-radius: 999px;
}

.tof-actions {
  display: flex;
  justify-content: flex-end;
  gap: .6rem;
  padding-top: 1rem;
  border-top: 1px solid #EBDDC51a;
}

.tof-btn {
  padding: .65rem 1.25rem;
  font-family: "Manrope", sans-serif;
  font-size: .85rem;
  font-weight: 700;
  letter-spacing: .02em;
  border-radius: .7rem;
  cursor: pointer;
  transition: background-color .15s ease, border-color .15s ease, color .15s ease, box-shadow .15s ease;
}

.tof-btn-ghost {
  color: #EBDDC5cc;
  background-color: transparent;
  border: 1px solid #EBDDC535;
}

.tof-btn-ghost:hover {
  color: #EBDDC5;
  background-color: #EBDDC512;
  border-color: #EBDDC570;
}

.tof-btn-primary {
  color: #fff;
  background-color: var(--accent-transparent);
  border: 1px solid var(--accent);
  box-shadow: 0 0px 5px var(--accent-transparent);
  transition: .2s;
}

.tof-btn-primary:hover {
  background-color: var(--accent);
  border-color: var(--accent);
  box-shadow: 0 0px 15px var(--accent);
  color: #000;
}

.tof-btn:focus-visible {
  outline: 2px solid #EBDDC5;
  outline-offset: 2px;
}

/*
#######################################################################
Settings dialog
#######################################################################
*/

/* dialog frame: wider, calmer */
#ui-dialog:has(#ui-dialog-body:is(.settings, .saves)) {
  width: 640px;
  max-width: 92vw;
}

#ui-dialog:has(#ui-dialog-body:is(.settings, .saves)) #ui-dialog-titlebar {
  padding: .6rem 0 .4rem;
}

#ui-dialog:has(#ui-dialog-body:is(.settings, .saves)) #ui-dialog-title {
  padding-left: 1.4rem;
  font-family: "Manrope", sans-serif;
  font-size: 1.15rem;
  font-weight: 700;
  letter-spacing: .18em;
  color: var(--accent);
}

#ui-dialog:has(#ui-dialog-body:is(.settings, .saves)) #ui-dialog-close {
  height: 100%;
  width: 3.2em;
  font-size: 100%;
  color: #EBDDC5aa;
  border: none;
  border-radius: 0 2em 0 0;
}

#ui-dialog:has(#ui-dialog-body:is(.settings, .saves)) #ui-dialog-close:hover {
  color: var(--accent);
}

#ui-dialog-body.settings,
#ui-dialog-body.saves {
  max-height: 75vh;
  padding: .5rem 1.4rem 1.4rem;
  background-color: var(--main-bg);
  font-family: "Manrope", sans-serif;
  font-weight: 400;
  scrollbar-width: none;
}

#ui-dialog-body.settings::-webkit-scrollbar,
#ui-dialog-body.saves::-webkit-scrollbar {
  display: none;
}

/* section headers */
#ui-dialog-body.settings div[id|=header-body] {
  margin: 1.6rem 0 .6rem;
  padding-top: 0;
  border-top: none;
}

#ui-dialog-body.settings div[id|=header-body]:first-child {
  margin-top: .4rem;
}

#ui-dialog-body.settings div[id|=header-body]:not(:first-child) {
  border-top: none;
  padding-top: 0;
}

#ui-dialog-body.settings h2[id|=header-heading] {
  display: flex;
  align-items: center;
  gap: .9rem;
  margin: 0;
  background: none;
  border: none;
  padding: 0;
  font-size: .78rem;
  font-weight: 800;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--accent);
}

#ui-dialog-body.settings h2[id|=header-heading]::after {
  content: "";
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, #EBDDC540, transparent);
}

#ui-dialog-body.settings p[id|=header-desc],
#ui-dialog-body.settings p[id|=setting-desc] {
  margin: .25rem 0 0;
  font-size: .8rem;
  color: #EBDDC599;
}

/* rows */
#ui-dialog-body.settings div[id|=setting-body] {
  margin: 0;
  padding: .7rem .9rem;
  border-radius: .9rem;
  transition: background-color .15s ease;
}

#ui-dialog-body.settings div[id|=setting-body] + div[id|=setting-body] {
  margin: 0;
}

#ui-dialog-body.settings div[id|=setting-body]:hover {
  background-color: #EBDDC50d;
}

#ui-dialog-body.settings [id|=setting-body] > div:first-child {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  width: 100%;
}

#ui-dialog-body.settings [id|=setting-label] {
  display: block;
  padding: 0;
  font-size: .95rem;
  line-height: 1.35;
  color: #f0e9dc;
}

#ui-dialog-body.settings [id|=setting-label] + div {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: .8rem;
  min-width: 0;
  flex-shrink: 0;
}

/* value read-out next to sliders */
#ui-dialog-body.settings [id|=setting-label] + div output,
#ui-dialog-body.settings span[id|=setting-input] {
  min-width: 2.6ch;
  text-align: right;
  font-size: .85rem;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--accent);
}

/* ——— switches (toggle buttons) ——— */
#ui-dialog-body.settings button[id|=setting-control] {
  position: relative;
  display: block;
  width: 46px;
  height: 26px;
  padding: 0;
  margin: 0;
  border: 1px solid #EBDDC530;
  border-radius: 999px;
  background-color: #EBDDC51a;
  font-size: 0;
  color: transparent;
  cursor: pointer;
  transition: background-color .2s ease, border-color .2s ease, box-shadow .2s ease;
}

#ui-dialog-body.settings button[id|=setting-control]:hover {
  background-color: #EBDDC52a;
  border-color: #EBDDC560;
}

#ui-dialog-body.settings button[id|=setting-control].enabled {
  background-color: var(--accent);
  border-color: var(--accent);
  box-shadow: 0 0 14px #EBDDC540;
}

#ui-dialog-body.settings button[id|=setting-control].enabled:hover {
  background-color: #f3dfbd;
  border-color: #f3dfbd;
}

/* knob (replaces SugarCube's icon-font ::after) */
#ui-dialog-body.settings button[id|=setting-control]::after,
#ui-dialog-body.settings button[id|=setting-control].enabled::after {
  content: "";
  position: absolute;
  top: 2px;
  left: 2px;
  width: 20px;
  height: 20px;
  margin: 0;
  border-radius: 50%;
  background-color: var(--accent);
  box-shadow: 0 1px 4px rgba(0, 0, 0, .4);
  transition: transform .2s cubic-bezier(.4, 0, .2, 1), background-color .2s ease;
}

#ui-dialog-body.settings button[id|=setting-control].enabled::after {
  transform: translateX(20px);
  background-color: #FFF;
}

#ui-dialog-body.settings button[id|=setting-control]:focus-visible,
#ui-dialog-body.settings input[type=range][id|=setting-control]:focus-visible {
  outline: 2px solid #EBDDC580;
  outline-offset: 3px;
}

/* ——— sliders ——— */
#ui-dialog-body.settings input[type=range][id|=setting-control] {
  -webkit-appearance: none;
  appearance: none;
  box-sizing: border-box;
  width: 200px;
  max-width: 35vw;
  min-height: 0;             /* SugarCube default is 1.2em */
  height: 20px;             /* 18px inner height (== thumb size) + 1px outline; a taller thumb would be clipped by overflow:hidden */
  margin: 0;
  padding: 0;
  border: 1px solid #EBDDC555;
  border-radius: 999px;
  background-color: #EBDDC51a;
  overflow: hidden;
  cursor: pointer;
  /* "filled" part: --fill (0–1) is kept up to date by the range handler in storyscript;
     the fill ends at the thumb's centre, which travels from 9px to (100% - 9px) */
  background-image: linear-gradient(var(--accent), var(--accent));
  background-repeat: no-repeat;
  background-size: calc(9px + (100% - 18px) * var(--fill, 0)) 100%;
}

#ui-dialog-body.settings input[type=range][id|=setting-control]:hover {
  border-color: #EBDDC599;
}

#ui-dialog-body.settings input[type=range][id|=setting-control]::-webkit-slider-runnable-track {
  height: 18px;
  background: transparent;
  border: none;
}

/* thumb: beige knob with a dark ring, so it stands out on the fill as well as on the empty track */
#ui-dialog-body.settings input[type=range][id|=setting-control]::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  box-sizing: border-box;
  width: 18px;
  height: 18px;
  margin-top: 0;             /* SugarCube's default range CSS sets -5px, which pulls the thumb up */
  border: 4px solid var(--accent);
  border-radius: 50%;
  background: #FFF;
  transition: border-width .12s ease;
}

#ui-dialog-body.settings input[type=range][id|=setting-control]:hover::-webkit-slider-thumb,
#ui-dialog-body.settings input[type=range][id|=setting-control]:active::-webkit-slider-thumb {
  border-width: 3px;
}

#ui-dialog-body.settings input[type=range][id|=setting-control]::-moz-range-track {
  height: 18px;
  border-radius: 999px;
  background: transparent;
  border: none;
}

#ui-dialog-body.settings input[type=range][id|=setting-control]::-moz-range-thumb {
  box-sizing: border-box;
  width: 18px;
  height: 18px;
  border: 4px solid var(--accent);
  border-radius: 50%;
  background: #FFF;
}

/* ——— footer buttons (OK / Reset) ——— */
#ui-dialog-body.settings ul.buttons {
  display: flex;
  justify-content: flex-end;
  gap: .7rem;
  margin-top: 1.4rem;
  padding-top: 1.1rem;
  border-top: 1px solid #EBDDC520;
}

#ui-dialog-body.settings ul.buttons li {
  margin: 0;
  padding: 0;
}

#ui-dialog-body.settings ul.buttons > li + li > button {
  margin-left: 0;
}

#ui-dialog-body.settings ul.buttons button {
  padding: .55rem 1.4rem;
  border: 1px solid #EBDDC535;
  border-radius: 999px;
  background-color: transparent;
  font-family: "Manrope", sans-serif;
  font-size: .85rem;
  font-weight: 700;
  letter-spacing: .06em;
  color: var(--accent);
  cursor: pointer;
  transition: background-color .15s ease, border-color .15s ease, color .15s ease;
}

#ui-dialog-body.settings ul.buttons button:hover {
  background-color: #EBDDC51a;
  border-color: #EBDDC570;
  color: #fff;
}

#ui-dialog-body.settings #settings-ok {
    background-color: #EBDDC520;
    border-color: var(--accent);
    color: #FFF;
    opacity: .7;
}

#ui-dialog-body.settings #settings-ok:hover {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #FFF;
    opacity: 1;
    text-shadow: 0 0 5px #000000;
}

#ui-dialog-body.settings #settings-reset {
  color: #DB354C;
  border-color: #DB354C50;
}

#ui-dialog-body.settings #settings-reset:hover {
  background-color: #DB354C20;
  border-color: #DB354C;
  color: #ff6479;
}

/*
#######################################################################
Saves dialog (frame, scrollbar and font are shared with the Settings dialog above)
#######################################################################
*/

#ui-dialog-body.saves {
  padding: .5rem 1.4rem 1.4rem;
}

/* section headers ("Browser Saves" ...) */
#ui-dialog-body.saves > h2 {
  display: flex;
  align-items: center;
  gap: .9rem;
  margin: 1.2rem 0 .7rem;
  padding: 0;
  font-size: .78rem;
  font-weight: 800;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--accent);
}

#ui-dialog-body.saves > h2:first-child {
  margin-top: .4rem;
}

#ui-dialog-body.saves > h2::after {
  content: "";
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, #EBDDC540, transparent);
}

#ui-dialog-body.saves > :not(:first-child) {
  border-top: none;
}

/* slot list: one card per slot */
#ui-dialog-body.saves table,
#ui-dialog-body.saves tbody {
  display: block;
  width: 100%;
}

#ui-dialog-body.saves tbody {
  display: flex;
  flex-direction: column;
  gap: .5rem;
}

#ui-dialog-body.saves tr,
#ui-dialog-body.saves tr:not(:first-child) {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: .65rem .9rem;
  border: 1px solid #EBDDC52a;
  border-radius: 1rem;
  background-color: #EBDDC508;
  transition: background-color .15s ease, border-color .15s ease;
}

#ui-dialog-body.saves tr:hover {
  background-color: #EBDDC512;
  border-color: #EBDDC555;
}

/* empty slot */
#ui-dialog-body.saves tr:has(.empty) {
  border-style: dashed;
  background-color: transparent;
}

#ui-dialog-body.saves td {
  padding: 0;
}

#ui-dialog-body.saves td:nth-child(3) {
  flex: 1;
  min-width: 0;
  width: auto;
  line-height: 1.3;
  font-size: .95rem;
  color: #f0e9dc;
}

#ui-dialog-body.saves td:nth-child(3) > div:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

#ui-dialog-body.saves .details {
  margin: .15rem 0 0;
  font-size: .75rem;
  letter-spacing: .02em;
  color: #EBDDC599;
}

/* time played, added by addPlaytimeToSaves (StoryScript) */
#ui-dialog-body.saves .details.playtime {
  margin-top: .05rem;
  font-variant-numeric: tabular-nums;
  color: #EBDDC580;
}

#ui-dialog-body.saves .empty {
  color: #EBDDC580;
}

/* round icon buttons in the list (load / save / delete) */
#ui-dialog-body.saves #saves-list button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.4rem;
  height: 2.4rem;
  padding: 0;
  border: 1px solid #EBDDC535;
  border-radius: 50%;
  background-color: transparent;
  font-size: .85rem;
  color: var(--accent);
  cursor: pointer;
  transition: background-color .15s ease, border-color .15s ease, color .15s ease, opacity .15s ease;
}

#ui-dialog-body.saves #saves-list button:disabled {
  opacity: .3;
  cursor: default;
  color: var(--accent);
  border-color: #EBDDC535;
}

#ui-dialog-body.saves #saves-list button:not(:disabled):hover {
  background-color: #EBDDC520;
  border-color: var(--accent);
  color: #fff;
}

#ui-dialog-body.saves #saves-list button.load:not(:disabled) {
  background-color: #EBDDC520;
  border-color: #EBDDC5aa;
  color: #fff;
}

#ui-dialog-body.saves #saves-list button.load:not(:disabled):hover {
  background-color: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

#ui-dialog-body.saves #saves-list button.delete:not(:disabled) {
  background-color: transparent;
  border-color: #DB354C50;
  color: #DB354C;
}

#ui-dialog-body.saves #saves-list button.delete:not(:disabled):hover {
  background-color: #DB354C20;
  border-color: #DB354C;
  color: #ff6479;
}

/* footer buttons (Save to Disk / Load from Disk / Export / Import / Clear) */
#ui-dialog-body.saves ul.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: .6rem;
  margin: 1.2rem 0 0;
  padding: 1.1rem 0 0;
  border-top: 1px solid #EBDDC520;
}

#ui-dialog-body.saves ul.buttons li,
#ui-dialog-body.saves .buttons li {
  margin: 0;
  padding: 0;
}

#ui-dialog-body.saves .buttons > li + li > button {
  margin-left: 0;
}

#ui-dialog-body.saves .buttons.slots > li:last-child {
  float: none;
  margin-left: auto;          /* "Clear" sits on the right */
}

#ui-dialog-body.saves ul.buttons button {
  display: inline-flex;
  align-items: center;
  padding: .55rem 1.2rem;
  border: 1px solid #EBDDC535;
  border-radius: 999px;
  background-color: transparent;
  font-family: "Manrope", sans-serif;
  font-size: .85rem;
  font-weight: 700;
  letter-spacing: .06em;
  color: var(--accent);
  cursor: pointer;
  transition: background-color .15s ease, border-color .15s ease, color .15s ease, opacity .15s ease;
}

#ui-dialog-body.saves ul.buttons button:hover:not(:disabled) {
  background-color: #EBDDC51a;
  border-color: #EBDDC570;
  color: #fff;
}

#ui-dialog-body.saves ul.buttons button:disabled {
  opacity: .35;
  cursor: default;
}

#ui-dialog-body.saves button[id=saves-clear]:not(:disabled) {
  background-color: transparent;
  color: #DB354C;
  border-color: #DB354C50;
}

#ui-dialog-body.saves button[id=saves-clear]:not(:disabled):hover {
  background-color: #DB354C20;
  border-color: #DB354C;
  color: #ff6479;
}

#ui-bar {
  background-color: transparent; /* the tinted glass is #ui-bar::before */
  border-right: 1px solid var(--card-border);
  border-radius: 0px 1em 1em 0;
  width: 30em;
}

/* The frosted glass of the sidebar: the page background again (image and shade, lined up with the page by
   background-attachment: fixed), blurred more and tinted, on a layer of its own. It replaces a
   backdrop-filter: blur(10px), which Chrome recomputed for the whole sidebar on every frame that anything in it
   animated (the quest-eligible pulse). inset -30px and the clip-path keep the soft edges of the blur out of view. */
#ui-bar::before {
  content: '';
  position: absolute;
  inset: -30px;
  z-index: -1;
  pointer-events: none;
  background:
    linear-gradient(var(--main-bg), var(--main-bg)),
    var(--page-shade) fixed,
    var(--page-bg, none) center / cover no-repeat fixed;
  filter: blur(11px);
  clip-path: inset(30px round 0 1em 1em 0);
}

#ui-bar img, #ui-bar video {
  padding: 0;
  border: 0;
}

#ui-bar-toggle {
  display: none;
}

#title {
  display: none;
}

#ui-bar-body>:not(:first-child) {
	margin-top: 0;
}

#ui-bar-body {
	padding: 0;
}

#story {
	margin-left: 30em;
}

#story-caption {
	display: grid;
}

.stat-bar {
  display: flex;
  justify-content: space-between;
}

.slider-progress {
  	background-color: var(--accent);
  	position: absolute;
  	left: 0;
  	top: 0;
  	height: .5em;
  	transition: 1s ease-in-out;
}

.slider-background {
  background-color: #EBDDC530;
  position: relative;
  height: .5em;
  width: 100%;
  overflow: hidden;
  align-self: center;
  border-radius: .25em;
  border: .1em solid #EBDDC510;
  box-sizing: border-box;
  margin-bottom: .5em;
}

#ui-bar-tray {
  display: flex;
  justify-content: space-between;
}

#ui-bar-history {
  margin: 0 1em;
}

#ui-bar-tray button, #ui-bar-tray button:active, .tray-icon-btn {
	color: var(--accent);
	background-color: #FFFFFF20;
  	backdrop-filter: blur(10px);
	border-color: transparent;
	border-radius: .5em !important;
}

#ui-bar-tray button:hover {
	color: var(--accent);
	background-color: #FFFFFF50;
  	backdrop-filter: blur(10px);
	border: 1px solid rgba(255,255,255,.50);
	border-radius: .5em;
}

#ui-bar-tray button:disabled {
  color: #EBDDC5A0;
  background-color: transparent;
  border-color: transparent;
  border-radius: .5em;
}

#custom-tray-buttons {
	margin: 0 1em; 
}

#custom-tray-buttons.tray-icons {
  display: flex;
  gap: .25rem;
  align-items: center;
}

/* Icon-only button look that matches the UI bar vibe */
#ui-bar-tray .tray-icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 4px;
  background: transparent;
  cursor: pointer;
}

#ui-bar-tray .tray-icon-btn:hover,
#ui-bar-tray .tray-icon-btn:focus {
  outline: none;
  background: rgba(127,127,127,.2);
}

/* Use SugarCube’s built-in icon font; color inherits */
#ui-bar-tray .tray-icon-btn .sc-ic {
  font-family: sc-icons !important;
  font-style: normal;
  font-weight: normal;
  line-height: 1;
  font-size: 16px;
}

.tray-icon-btn {
  margin: 0 .125em;
  background: #FFFFFF20 !important;
  padding: 1em;
  border: 1px solid transparent;
}

.tray-icon-btn:hover {
  background-color: #FFFFFF50 !important; 
}

#story-caption {
  max-width: 30em;
  margin: 1rem;
}


/* --- Glassy cards --- */
.cap-card {
  border-radius: .75em;
  border: 1px solid var(--card-border);
  background: var(--card-bg);
  backdrop-filter: blur(0px);
  box-shadow: 0 10px 30px rgba(0,0,0,.06) inset;
  color: #fff;
  font-weight: 100;
  padding: .25rem .5rem;
}

#ui-bar #menu {
  display: none; 
}

.quests-wrapper {
  height: 100%;
  width: 100%;
  overflow: scroll;
}

.quest {
  display: flex;
  flex-direction: column;
  align-items: start;
  padding-bottom: .5em;
  border-bottom: 1px solid #FFFFFF20;
}

.quest-title {
  font-size: 14pt;
  font-weight: bold;
}

.quest-body {
  text-align: left;
}

.quest-info-icon-wrapper {
  display: flex;
  width: 100%;
  justify-content: space-between;
}

.quest-info-wrapper {
  text-align: left;
  width: 90%;
}

.quest-avatar {
  width: 2.25rem;
  height: 2.25rem;
  margin-top: 1.25%;
  position: relative;
  border-radius: 9999px;
  overflow: hidden;
}

.quest-when {
  display: flex;
  flex-direction: column;
  align-items: start;
}

.quest-when, .quest-where {
  font-size: 10pt;
}

.activity-image-wrapper {
  flex: 1;
}

.activity-image-wrapper div {
  align-items: center; 
  max-height: inherit;
}

#ui-left-panel .activity-image-wrapper div div {
  box-sizing: border-box;
}

.activity-image-wrapper div img, .activity-image-wrapper div video {
  max-height: inherit;
  box-sizing: border-box;
}

.video-camera-overlay {
  position: absolute;
  width: 1.5em;
  aspect-ratio: 1/1;
  z-index: 1;
  background-color: transparent;
  background-size: contain;
  scale: .5;
}

.cctv-frame {
  position: relative;
  display: flex;
  height: 100%;
  justify-content: center;
  align-items: center;
}

.cctv-frame > div {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
}

.cctv-frame video {
  display: block;
  width: 100%;
  object-fit: contain;
  max-width: none;
  max-height: 100%;
  scale: 1.05;
}

/*
============================================================ Overlays
*/

/* overlay container */
.cctv-overlay {
	position: absolute;
	pointer-events: none;
	width: 100%;
	height: 100%;
	z-index: 1;
  	inset: 0;
}

/* scanlines + vignette */
.cctv-overlay::before {
  content: "";
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse at center, rgba(0,0,0,0) 65%, rgba(0,0,0,.35) 100%),
    repeating-linear-gradient(to bottom,
      rgba(255,255,255,.05) 0, rgba(255,255,255,.05) 1px,
      transparent 1px, transparent 3px);
  animation: flicker 6s steps(60) infinite;
}

/* animated noise via inline SVG (feTurbulence) */
.cctv-overlay::after {
  content: "";
  position: absolute; inset: 0;
  background-image: url("data:image/svg+xml;utf8,\<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'>\  <filter id='n'>\    <feTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='1' seed='2'>\      <animate attributeName='seed' values='0;50' dur='1s' repeatCount='indefinite'/>\    </feTurbulence>\  </filter>\  <rect width='100%' height='100%' filter='url(%23n)'/>\</svg>");
  background-size: cover;
  mix-blend-mode: overlay;
  opacity: .20;
  background-color: black;
}

@keyframes flicker {
  0%, 100% { opacity: .9 }
  40% { opacity: .95 }
  65% { opacity: .85 }
}

@keyframes etherealPulse {
    0%, 100% { opacity: 0.55; transform: scale(0.95); }
    50%      { opacity: 1; transform: scale(1.08); }
}

@keyframes dreamSparkle {
    0%   { opacity: 0.3; transform: scale(0.8); }
    100% { opacity: 1; transform: scale(1.3); }
}

.mindbend-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 8;
    overflow: hidden;
}

.mindbend-overlay::before {
    content: "";
    position: absolute;
    inset: -10%;
    background: radial-gradient(circle at center,
        rgba(255,255,255,0.08) 0%,
        rgba(0,0,0,0.2) 40%,
        rgba(0,0,0,0.6) 100%);
    animation: mindbendPulse 6s ease-in-out infinite;
}

.mindbend-overlay::after {
    content: "";
    position: absolute;
    inset: 0;

    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);

    mask-image: radial-gradient(circle at center,
        transparent 0%,
        transparent 45%,
        black 75%,
        black 100%);
    -webkit-mask-image: radial-gradient(circle at center,
        transparent 0%,
        transparent 45%,
        black 75%,
        black 100%);

    animation: mindbendBreath 6s ease-in-out infinite;
}

@keyframes mindbendPulse {
    0%, 100% { transform: scale(1); opacity: .6; }
    50% { transform: scale(1.15); opacity: .9; }
}

@keyframes mindbendWarp {
    0% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(1deg) scale(1.05); }
    100% { transform: rotate(0deg) scale(1); }
}

@keyframes mindbendBreath {
    0%, 100% {
        backdrop-filter: blur(1px);
        transform: scale(1);
    }
    50% {
        backdrop-filter: blur(4px);
        transform: scale(1.03);
    }
}

.corruption-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
    overflow: hidden;
  	opacity: .5;
}

/* RGB split glitch */
.corruption-overlay::before {
    content: "";
    position: absolute;
    inset: 0;
    background: inherit;

    mix-blend-mode: screen;
    opacity: 0.6;

    animation: glitchRGB 0.25s infinite, glitchJump 0.4s infinite;
}

/* scanline tearing + flicker */
.corruption-overlay::after {
    content: "";
    position: absolute;
    inset: 0;

    background:
        repeating-linear-gradient(
            to bottom,
            rgba(255,255,255,0.08) 0px,
            rgba(255,255,255,0.08) 2px,
            transparent 2px,
            transparent 6px
        );

    animation: glitchFlicker 0.15s infinite;
}

@keyframes glitchRGB {
    0%   { transform: translate(0,0); filter: hue-rotate(0deg); }
    20%  { transform: translate(-3px,1px); filter: hue-rotate(20deg); }
    40%  { transform: translate(3px,-2px); filter: hue-rotate(-20deg); }
    60%  { transform: translate(-2px,2px); filter: hue-rotate(15deg); }
    80%  { transform: translate(2px,-1px); filter: hue-rotate(-15deg); }
    100% { transform: translate(0,0); filter: hue-rotate(0deg); }
}

@keyframes glitchFlicker {
    0%,100% { opacity: 0.2; }
    50% { opacity: 0.6; }
}

@keyframes glitchJump {
    0%   { clip-path: inset(0 0 0 0); }
    20%  { clip-path: inset(10% 0 60% 0); }
    40%  { clip-path: inset(50% 0 10% 0); }
    60%  { clip-path: inset(30% 0 30% 0); }
    80%  { clip-path: inset(70% 0 5% 0); }
    100% { clip-path: inset(0 0 0 0); }
}

.influence-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 8;
    overflow: hidden;
}

/* main tendrils layer */
.influence-overlay::before {
    content: "";
    position: absolute;
    inset: -10%;

    background:
        linear-gradient(120deg, transparent 45%, rgba(156, 24, 24, 0.25) 50%, transparent 55%),
        linear-gradient(300deg, transparent 45%, rgba(156, 24, 24, 0.2) 50%, transparent 55%),
        linear-gradient(200deg, transparent 48%, rgba(156, 24, 24, 0.15) 50%, transparent 52%),
        linear-gradient(30deg, transparent 48%, rgba(156, 24, 24, 0.18) 50%, transparent 52%);

    background-size: 180% 180%;

    animation:
        tendrilMoveA 13s ease-in-out infinite,
        tendrilMoveB 17s ease-in-out infinite,
        tendrilDrift 19s ease-in-out infinite;

    opacity: 0.65;
}

/* center “capture” glow */
.influence-overlay::after {
    content: "";
    position: absolute;
    inset: 0;

    background: radial-gradient(circle at center,
        rgba(156, 24, 24, 0.25) 0%,
        rgba(156, 24, 24, 0.1) 20%,
        transparent 50%
    );

    animation: tendrilFocus 10s ease-in-out infinite;
}

.influence-overlay.left::before {
    background:
        linear-gradient(90deg, rgba(156, 24, 24, 0.25), transparent 80%);
}

@keyframes tendrilMoveA {
    0% {
        background-position: 0% 0%, 100% 100%, 50% 0%, 0% 50%;
    }
    30% {
        background-position: 80% 20%, 20% 80%, 60% 40%, 10% 90%;
    }
    60% {
        background-position: 30% 70%, 70% 30%, 40% 100%, 90% 10%;
    }
    100% {
        background-position: 0% 0%, 100% 100%, 50% 0%, 0% 50%;
    }
}

@keyframes tendrilMoveB {
    0% {
        background-position: 50% 100%, 0% 0%, 100% 50%, 50% 0%;
    }
    50% {
        background-position: 20% 40%, 80% 60%, 30% 80%, 70% 20%;
    }
    100% {
        background-position: 50% 100%, 0% 0%, 100% 50%, 50% 0%;
    }
}

/* subtle organic motion (THIS is what makes it feel alive) */
@keyframes tendrilDrift {
    0% {
        transform: scale(1) rotate(0deg);
    }
    25% {
        transform: scale(1.03) rotate(0.6deg);
    }
    50% {
        transform: scale(0.98) rotate(-0.8deg);
    }
    75% {
        transform: scale(1.02) rotate(0.4deg);
    }
    100% {
        transform: scale(1) rotate(0deg);
    }
}

@keyframes tendrilFocus {
    0%, 100% {
        transform: scale(0.95);
        opacity: 0.4;
    }
    50% {
        transform: scale(1.05);
        opacity: 0.7;
    }
}

/*
============================================================
*/

.npc-here-wrapper {
  padding: .5rem;
  border-radius: .5rem;
  border: 1px solid var(--accent);
  background-color: var(--card-border);
  font-size: 1rem;
  letter-spacing: .25px;
}

.locations-wrapper {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  align-items: center;
}

.location-link {
  aspect-ratio: 16/9;
  border-radius: .5em;
  overflow: hidden;
  max-width: 15em;
  min-width: 15em;
  position: relative;
  margin: .5em;
  background-color: #ffffff10;
}

.location-image, .location-image div {
  width: 100%;
  height: 100%;  
  transition: .1s ease;
}

.location-link:hover > .location-image {
  scale: 1.05;
}

/* closed right now (<<LocationLinks>>): grey, no hover, no click */
.location-link.closed {
  pointer-events: none;
  cursor: default;
}

.location-link.closed .location-image,
.location-link.closed .location-avatar {
  filter: grayscale(1) brightness(.55);
}

.location-link.closed .location-name {
  color: #EBDDC580 !important;
}

.location-closed {
  position: absolute;
  top: 1.5em;
  width: 100%;
  height: 100%;
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: .05em;
  color: var(--accent);
  display: flex;
  justify-content: start;
  align-items: center;
  flex-direction: column;
  line-height: 1.1;
  z-index: 1;
  opacity: .7;
}

.location-closed span {
  font-weight: 300;
  opacity: .8;
  font-size: .8rem;
}

.location-image img {
  padding: 0;
  margin: 0;
  width: 100%;
  border: none;
}

.location-image.quest-hint::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(transparent 55%, #EAAF4C 100%);
  animation: quest-hint-pulse 3s ease-in-out infinite;
  pointer-events: none;
  z-index: 5;
}

@keyframes quest-hint-pulse {
  0%, 100% { opacity: .25; }
  50%      { opacity: .9; }
}

.location-name {
  display: flex;
  justify-content: center;
  align-items: center;
  backdrop-filter: blur(2px);
  position: absolute;
  left: 0;
  bottom: 0;
  height: 3em;
  width: 100%;
  background-color: var(--link-bg-transparent);
  font-size: 14pt;  
  font-weight: bold;
  box-shadow: 0 0 30px rgba(0,0,0, .25) inset;
  border-top: 1.5px solid var(--accent);
}

.location-avatar {
  width: 36px;
  height: 36px;
  border-radius: 999px;
  overflow: hidden;
  background: #d1d5db;
  box-shadow: 0 0 15px 2px #151515;

}
.location-avatar img { width: 100%; height: 100%; object-fit: cover; border: none; padding: 0}

.navigation-link a, .navigation-link div, #choice1 a {
  width: 100%;
  display: block;
  border: 1px solid var(--card-border);
  text-align: center;
  border-radius: .25em;
  background-color: var(--link-bg);
  backdrop-filter: blur(5px);
  margin: .5em 0;
  color: var(--accent);
}

/*
  ==================================== CMD
*/

#Company-Management-Dashboard {
  display: grid;
  grid-template-columns: .25fr 1.25fr 1fr 1fr 1fr 1fr;
  grid-template-rows: .5fr .75fr .75fr 1fr 1fr;
  grid-column-gap: .5em;
  grid-row-gap: .5em;
  width: 80vw;
  height: 85vh;
  position: absolute;
  left: 50%;
  transform: translate(-50%);
  grid-template-areas:
    "header	 		header	 	header		header			header		header"
    "other2			other		finances	cctv-control	cctv		cctv"
    "schedule-slots schedule   stats		cctv-control 	cctv		cctv"
    "schedule-slots	schedule   stats 		management 		management	projects"
    "schedule-slots	schedule 	mails 		mails 			actions		actions";
  background: var(--main-bg);
  border-radius: 1em;
  vertical-align: middle;
  padding: 1em;  
  backdrop-filter: blur(15px);
}

.cmd-area, .cctv-wrapper {
  background-color: var(--card-bg);
  border-radius: .75em;
  border: 1px solid var(--card-border);
  box-shadow: 0 10px 30px rgba(0,0,0,.06) inset;
  font-weight: 100;
  overflow: hidden;  
  padding: .5em;
}

.cmd-area h3 {
  margin: 0;
}

.cmd-header {
  grid-area: header;
}

.cmd-finances {
  grid-area: finances;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 0;
}

.cmd-cctv-control {
  grid-area: cctv-control;
}

.cmd-projects {
  grid-area: projects;
  position: relative;
  display: flex;
  flex-direction: column;
}

.cmd-cctv {
  grid-area: cctv;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cmd-stats {
  grid-area: stats;
}

.cmd-management {
  grid-area: management;
}

.cmd-other {
  grid-area: other;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cmd-mails {
  grid-area: mails;
  padding: .5em 0 0 0;
}

.cmd-actions {
  grid-area: actions;
}

.cctv-location-button {
  background-color: var(--card-bg);
  border-radius: .75em;
  border: 1px solid var(--card-border);
  box-shadow: 0 10px 30px rgba(0, 0, 0, .06) inset;
  font-weight: 100;
  transition: .2s ease-in-out;
  text-align: left;
  font-size: .75rem;
  position: relative;
  height: 4rem;
}

.cctv-location-button:hover, .cctv-location-button-active {
  background-color: var(--link-bg);
}

.cctv-location-button a {
  display: flex;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  color: inherit;
  text-decoration: none;
  padding: .3em;
  align-items: center;
}

.cctv-location-button-avatar {
  width: 2rem;
  height: 2rem;
  position: absolute;
  bottom: .25rem;
  right: 1.25rem;
  box-sizing: border-box;
  padding: .1rem;
  border: 2px solid var(--accent);
  border-radius: 2rem;
  overflow: hidden;
}

.cctv-location-button-avatar > div {
  border-radius: 9999rem;
  overflow: hidden;
  height: 100%;
  width: 100%;
}

.cctv-location-button-avatar:last-child {
  right: .25rem;
}

.cctv-view-toggle {
  display: flex;
  gap: .25rem;
  padding: .15rem;
  /* background-color: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: .75em; */
}

.cctv-view-toggle-button {
  width: 3.5rem;
}

.cctv-view-toggle-button a {
  display: block;
  padding: .15em .75em;
  border-radius: .6em;
  font-size: .75rem;
  color: inherit;
  text-decoration: none;
  transition: .2s ease-in-out;
}

.cctv-view-toggle-button a:hover, .cctv-view-toggle-button-active a {
  background-color: var(--link-bg);
}

.cctv-arrow-disabled {
  opacity: .3;
  cursor: default;
}

.cmd-projects > div[style*="overflow-y"] {
  flex: 1;                  
  overflow-y: auto;         
  justify-content: flex-start; 
  align-items: center;      
}

.cctv-wrapper {
  aspect-ratio: 16/9;
  padding: 0;
}

/*Schedule Grid*/

.cmd-schedule-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: repeat(21, 1fr);
  height: 100%;
  gap: 1px 5px;
}

.cmd-schedule-grid::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background-color: var(--accent-transparent);
  border-radius: 2px;
  pointer-events: none;
  z-index: 10;
  transition: top 0.0s ease-out;
  top: var(--time-line-top, -100px);
}

.cmd-schedule-grid.has-time-line::before {
    opacity: 1;
}

/* Scheduled task blocks, built by renderTaskElement in "CMD Schedule".
   The left bar (--st-accent) carries the state: cream planned / running (bright frame), gold with me,
   green done, red low energy / missed. st-rows-1|2|3 pick the layout for the block's height. */
.cmd-schedule-task {
  --st-accent: var(--accent-transparent);
  position: relative;
  min-height: 0;
  overflow: hidden;
  border-radius: .45em;
  background: rgba(24, 22, 30, .85);
  border: 1px solid #EBDDC522;
  box-shadow: inset 3px 0 0 var(--st-accent), 0 0px 14px rgba(0, 0, 0, .25);
  color: #EBDDC5;
  text-align: left;
  transition: border-color .15s ease, box-shadow .15s ease, opacity .15s ease;
}

.cmd-schedule-task:hover {
  border-color: #EBDDC566;
  opacity: 1;
}

/* the place, fading in from the right so the text stays readable */
.st-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  opacity: .5;
  -webkit-mask-image: linear-gradient(90deg, transparent 10%, #000 90%);
  mask-image: linear-gradient(90deg, transparent 10%, #000 90%);
  transition: opacity .2s ease;
  pointer-events: none;
}

.cmd-schedule-task:hover .st-bg {
  opacity: .75;
}

.st-body {
  position: relative;
  z-index: 1;
  height: 100%;
  min-width: 0;
  box-sizing: border-box;
  padding: .3em .55em .3em .8em;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: .1em;
  text-shadow: 0 1px 2px rgba(0, 0, 0, .7);
}

.st-head {
  display: flex;
  align-items: center;
  gap: .4em;
  min-width: 0;
  transition: padding .15s ease;
}

.st-title {
  flex: 1 1 auto;
  min-width: 0;
  font-size: .8rem;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* the task feeds her end-of-day report (renderTaskElement, CMD Schedule) */
.st-report {
  flex: 0 0 auto;
  display: inline-flex;
  width: .8rem;
  height: .8rem;
  color: #1cd88d;
}
.st-report svg { width: 100%; height: 100%; }

.st-badge {
  flex-shrink: 0;
  padding: .05rem .4rem;
  font-size: .52rem;
  font-weight: 800;
  letter-spacing: .12em;
  line-height: 1.5;
  text-transform: uppercase;
  text-shadow: none;
  white-space: nowrap;
  color: #EBDDC5cc;
  background: rgba(20, 18, 26, .7);
  border: 1px solid #EBDDC540;
  border-radius: 999px;
}

.st-badge-me { 
  color: #EAAF4C; 
  border-color: #EAAF4C80; 
}

.st-badge-done { 
  color: #1cd88d; 
  border-color: #1cd88d80; 
}

.st-badge-missed, .st-badge-low { 
  color: #ff6479; 
  border-color: #ff647980; 
}

.st-badge-now { 
  color: #1b1a20; 
  background: var(--accent); 
  border-color: var(--accent); 
}

.st-badge-now::before {
  content: "";
  display: inline-block;
  width: .4em;
  height: .4em;
  margin-right: .35em;
  vertical-align: .1em;
  border-radius: 50%;
  background: #1b1a20;
  animation: st-pulse 1.4s ease-in-out infinite;
}

.st-info {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: .5em;
  min-width: 0;
  font-size: .66rem;
  line-height: 1.25;
}

.st-place {
  min-width: 0;
  opacity: .75;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.st-meta {
  display: flex;
  gap: .5em;
  flex-shrink: 0;
  font-weight: 700;
}

.st-energy { opacity: .6; }
.st-money { color: #1cd88d; }

/* one action: just the title line, the rest is in the tooltip */
.st-rows-1 .st-body { justify-content: center; padding-top: 0; padding-bottom: 0; }
.st-rows-1 .st-info { display: none; }

/* three or more: title, place underneath, numbers at the bottom, a face in the corner */
.st-rows-3 .st-head { padding-right: 1.9rem; }
.st-rows-3 .st-title {
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.st-rows-3 .st-info {
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
}

.st-avatar {
  position: absolute;
  z-index: 1;
  top: .35em;
  right: .4em;
  width: 1.5rem;
  height: 1.5rem;
  object-fit: cover;
  border: 1px solid #EBDDC5 !important;
  border-radius: 50%;
  box-shadow: 0 2px 6px rgba(0, 0, 0, .4);
  transition: opacity .15s ease;
}

/* states */
.cmd-schedule-task.st-with-me { --st-accent: #EAAF4C; }
.cmd-schedule-task.st-done { --st-accent: #1cd88d; opacity: .6; }
.cmd-schedule-task.st-past { opacity: .45; filter: grayscale(.6); }
.cmd-schedule-task.st-low { --st-accent: #ff6479; }
.cmd-schedule-task.st-low .st-bg { filter: grayscale(1); }
/* a task with a cooldown that rests today (Define Tasks): it stays planned, but nothing happens */
.cmd-schedule-task.st-rest { opacity: .45; border-style: dashed; }
.cmd-schedule-task.st-rest .st-bg { filter: grayscale(1); }
.st-rest { opacity: .8; font-style: italic; }

.cmd-schedule-task.st-missed { --st-accent: #ff6479; opacity: .45; }
.cmd-schedule-task.st-missed::after {
  content: "";
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(135deg, #ff647914 0 6px, transparent 6px 12px);
  pointer-events: none;
}

.cmd-schedule-task.st-now {
--st-accent: var(--accent);
  border-color: var(--accent);
  box-shadow: inset 3px 0 0 var(--st-accent), 
              0 0 0 1px var(--accent-transparent), 
              0 0 18px var(--accent-transparent);
}

/* how far today's run is */
.st-progress {
  position: absolute;
  z-index: 2;
  left: 0;
  right: 0;
  bottom: 0;
  height: 2px;
  background: #EBDDC533;
}

.st-progress::after {
  content: "";
  position: absolute;
  inset: 0 auto 0 0;
  width: var(--st-progress, 0%);
  background: var(--accent);
}

/* take it off again: only on hover */
.cmd-schedule-task .st-remove {
  position: absolute;
  z-index: 3;
  top: .3em;
  right: .3em;
  width: 1.15rem;
  height: 1.15rem;
  min-width: 0;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font: 700 .85rem/1 "Manrope", sans-serif;
  color: #EBDDC5;
  background: rgba(20, 18, 26, .85);
  border: 1px solid #EBDDC560;
  border-radius: 50%;
  opacity: 0;
  cursor: pointer;
  transition: opacity .15s ease, background-color .15s ease, border-color .15s ease;
}

.st-rows-1 .st-remove { top: 50%; transform: translateY(-50%); }
.cmd-schedule-task:hover .st-remove { opacity: 1; }
.cmd-schedule-task .st-remove:hover { background: #DB354C; border-color: #DB354C; }
.cmd-schedule-task:hover .st-head { padding-right: 1.3rem; }
.cmd-schedule-task:hover .st-avatar { opacity: 0; }

/* a block that was just placed */
.cmd-schedule-task.st-new { animation: st-pop .35s ease-out; }

@keyframes st-pop {
  0% { opacity: 0; transform: scale(.94); box-shadow: inset 3px 0 0 var(--st-accent), 0 0 0 2px var(--accent); }
  60% { opacity: 1; transform: scale(1.01); }
  100% { transform: none; }
}

@keyframes st-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .3; }
}

.cmd-schedule-slots {
  grid-area: schedule-slots;
}

.cmd-schedule {
  grid-area: schedule;
  /*background-image: linear-gradient(0deg, #FFDFDF30, #0000);*/
  position: relative;
  margin: 0;
  padding: 0;
  overflow: scroll;
}

.cmd-schedule-timeslots {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: calc((100% - (3px * 7))/7);
  margin: 3px 0;
  border-bottom: 1px solid #FFFFFF30;
  box-sizing: border-box;
}

.cmd-schedule-timeslots:last-child {
  border-bottom: none;
}

.cmd-schedule-actions {
  display: flex;
  justify-content: center;
  flex-direction: column;
  flex: 1;
  height: 100%;
}

.cmd-schedule-action {
  flex: 1;
  background-color: var(--card-bg);
  margin: 0;
  transition: .1s ease-in-out;
  cursor: pointer;
}

.cmd-schedule-action:hover {
  background-color: var(--link-bg);
}

.cmd-schedule-action-locked {
  background-color: var(--link-bg-transparent);
  color: #AAA;
  cursor: auto;
}

.locked-label {
  font-size: .6rem;
  text-align: center;
  opacity: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
}

/*
###########################################################################
*/

.ntfct {
  opacity: 0;
  position: fixed;
  right: -2vw;
  min-width: 15rem;
  max-width: 15rem;
  box-shadow: 10px 10px 20px -15px black;
  background: #FFFFFFBF;
  backdrop-filter: blur(10px);
  transition: .2s ease-out;
  overflow: hidden;
  font-family: "Manrope", sans-serif;
  font-optical-sizing: auto;
  font-size: .8rem;
  background: #ebddc520;
  border: 1px solid #ebddc550;
  border-radius: .5rem;
}

.ntfct-wrapper {
  padding: 1em;
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.ntfct-content {
  letter-spacing: 1px;
  font-weight: 100;
}

.ntfct-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  height: .0575em;
  width: 100%;
  transition: .2s ease;
  z-index: 99999;
}

.ntfct-close {
  position: absolute;
  top: .25em;
  right: .25em;
  height: 1em;
  aspect-ratio: 1;
  background: transparent;
  transition: .2s ease;
  padding: .5em;
  color: lightgray;
  cursor: pointer;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 2em;
}

.ntfct-close:hover {
  background: #000000A0;
}

/*icons*/

.ntfct-icon {
  color: white;
  padding: 1em;
  border-radius: 1em;
  margin-right: 1em;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 1em;
  aspect-ratio: 1;
  padding: .5em;
}

.ntfct-icon div {
  width: 100%;
  height: 100%;
  filter: invert(100%) sepia(1%) saturate(7495%) hue-rotate(287deg) brightness(101%) contrast(103%);
}

.positive-color {
  background-color: #1cd88d;
}

.positive-border {
  border: 1px solid var(--positive);
  background-color: var(--positive-bg);
}

.positive-icon {
  background-image: url("./images/misc/positive.svg");
}

.negative-color {
  background-color: #d81c4b;
}

.negative-border {
  border: 1px solid var(--negative);
  background-color: var(--negative-bg);
}

.negative-icon {
  background-image: url("./images/misc/negative.svg");
}

.quest-color {
  background-color: #8d1cd8;
}

.quest-border {
  border: 1px solid var(--quest);
  background-color: var(--quest-bg);
}

.quest-icon {
  background-image: url("./images/misc/quest.svg");
}

.info-color {
  background-color: #BFBFBF;
}

.info-border {
  border: 1px solid var(--info);
  background-color: var(--info-bg);
}

.info-icon {
  background-image: url("./images/misc/info.svg");
}

.warn-color {
  background-color: var(--warn);
}

.warn-border {
  border: 1px solid var(--warn);
  background-color: var(--warn-bg);
}

.warn-icon {
  background-image: url("./images/misc/warn.svg");
}

/*Mail Stuff*/

.mail-container {
  border-radius: .75em;
  border: 1px solid var(--card-border);
  background: var(--main-bg);
  backdrop-filter: blur(10px);
  box-shadow: 0 10px 30px rgba(0,0,0,.06) inset;
  color: #fff;
  font-weight: 100;
  padding: .25rem 0rem; 
  position: relative;
  overflow: hidden;
  width: 80%;
  margin: 0 10%;
}

.mail-container::before {
	content: ''; 
}

.mail-title {
  margin-top: 1rem;
  padding-left: .5rem;
  font-size: 18pt;  
  line-height: .75rem;
  font-weight: bold;
}

.mail-address {
  width: 100%;
  padding-left: .5rem;
  padding-top: .2rem;
  font-size: 10pt;
  color: #AAA;
  padding-bottom: .125em;
  border-bottom: 1px solid rgba(255, 255, 255, .25);
}

.mail-body-part {
  padding: .5em 2em 2em 2em;
  margin: 0 1em;
  border-bottom: 1px solid rgba(255, 255, 255, .25);
  font-size: 11pt;
}

.mail-body-part:last-child {
  border-bottom: none;
}

.right {
  padding-left: 10%;
  box-sizing: boder-box;
}

.mail-answer-options {
    border-top: 1px solid rgba(255, 255, 255, .25);
}

.mail-answer-options a {
    display: inline-block;
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    padding: 1rem 1.5rem;
    margin: .5rem;
    border-radius: .5rem;
    text-decoration: none;
    font-weight: bold;
    cursor: pointer;
}

.mail-answer-options a:hover {
    background-color: var(--link-bg);
}

.cmd-inbox {
  display: flex;
  flex-direction: column;
  position: relative;
  row-gap: 2px;
  height: stretch;
  height: -webkit-fill-available;
  overflow-y: scroll;
}

.cmd-inbox-mail {
  width: 100%;
  min-width: 0;
  background: var(--card-bg);
  box-shadow: 0 10px 30px rgba(0, 0, 0, .05) inset;
  font-size: 10pt;
  display: flex;
  position: relative;
  gap: .25rem;
  height: 3em;
  transition: .2s ease;
  cursor: pointer;
  border-top: 1px solid var(--card-border);
  border-bottom: 1px solid var(--card-border);
}

.cmd-inbox-mail:hover {
  background: var(--link-bg);
}

.cmd-inbox-mail div {
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.cmd-inbox-mail-read-icon-wrapper {
  width: 4em;
  height: 100%;
  position: relative;
}

.cmd-inbox-mail-read {
  width: 50%;
  text-align: center;
  height: 100%;
  justify-content: center !important;
}

.cmd-inbox-mail-icon {
  border-radius: 9999px;
  overflow: hidden;
  background-color: #bbb;
  justify-content: center !important;
  aspect-ratio: 1;
  height: 65%;
  margin-top: .25%;
}

.cmd-inbox-mail-icon img {
  border: none !important; 
  height: 110%;
}

.cmd-inbox-mail-address {
  grid-area: address;
  color: #bbb;
}

.cmd-inbox-mail-title-body-wrapper {
  width: 80%;
  height: 100%;
  position: relative;
  gap: 1em;
}

.cmd-inbox-mail-title {
  max-width: 60%;
  text-overflow: ellipsis;
  font-weight: 700;
  font-size: .9rem;
  white-space: nowrap;
  display: block !important;
  overflow: hidden;
}

.cmd-inbox-mail-body {
  min-width: 0;
  color: #DDD;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 70%;
  display: block !important;
  font-size: .75rem;
}

.cmd-inbox-mail-flag {
  justify-content: center !important;
  flex: auto;
  font-size: 16pt;
  cursor: pointer;
  transition: all 0.2s ease;
  user-select: none;
  text-align: center;
}

.cmd-inbox-mail-flag:hover {
    transform: scale(1.1);
    color: #ffd700;
}

.cmd-inbox-mail-flag:active {
    transform: scale(0.95);
}
/*
============================================================ Device pulse
The heartbeat glow of setup.devicePulse() ("Define Company"). The function sets
--dp-rgb (color), --dp-alpha (edge strength), --dp-inner (where the glow starts, in % of the way to the corners),
--dp-flash (whole-screen flash, only above power 5), --dp-period (seconds per beat) and --dp-fade.
The registered properties let a turned dial glide to the new strength instead of jumping.
*/
@property --dp-alpha { syntax: "<number>"; inherits: true; initial-value: 0; }
@property --dp-inner { syntax: "<number>"; inherits: true; initial-value: 65; }
@property --dp-flash { syntax: "<number>"; inherits: true; initial-value: 0; }

#device-pulse {
  position: fixed;
  inset: 0;
  z-index: 9000; /* over the game, under SugarCube dialogs */
  pointer-events: none;
  opacity: 0;
  transition: opacity var(--dp-fade, 900ms) ease, --dp-alpha 1.4s ease, --dp-inner 1.4s ease, --dp-flash 1.4s ease;
}

#device-pulse.dp-on {
  opacity: 1;
}

#device-pulse > div {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

#device-pulse .dp-glow {
  background: radial-gradient(ellipse at center,
    rgba(var(--dp-rgb), 0) calc(var(--dp-inner) * 1%),
    rgba(var(--dp-rgb), calc(var(--dp-alpha) * .3)) calc((var(--dp-inner) + 100) / 2 * 1%),
    rgba(var(--dp-rgb), var(--dp-alpha)) 100%);
  box-shadow: inset 0 0 calc(30px + var(--dp-alpha) * 120px) rgba(var(--dp-rgb), calc(var(--dp-alpha) * .9));
  mix-blend-mode: screen; /* lights the screen up like a glow, light text stays readable */
  animation: dp-beat var(--dp-period, 2s) ease-in-out infinite;
  will-change: opacity;
}

#device-pulse .dp-flash {
  background: rgba(var(--dp-rgb), var(--dp-flash));
  mix-blend-mode: screen;
  animation: dp-flash var(--dp-period, 2s) ease-out infinite;
  will-change: opacity;
}

/* lub-dub: a strong beat, a short dip, a weaker second beat, then rest */
@keyframes dp-beat {
  0%        { opacity: .3; }
  10%       { opacity: 1; }
  22%       { opacity: .5; }
  32%       { opacity: .85; }
  60%, 100% { opacity: .3; }
}

@keyframes dp-flash {
  0%, 100% { opacity: 0; }
  10%      { opacity: 1; }
  30%      { opacity: 0; }
}

/* the tendrils that creep in from the edges (setup.devicePulseTendrils, Tendrils Script) */
#device-pulse .dp-tendrils {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  mix-blend-mode: screen;
}

/* the invisible marker <<DevicePulse>> leaves in the text: the pulse changes once it scrolls into view.
   Zero size, but still a box, so it has a position to measure */
.dp-mark {
  display: inline-block;
  width: 0;
  height: 0;
  overflow: hidden;
  vertical-align: top;
}

@media (prefers-reduced-motion: reduce) {
  #device-pulse .dp-glow  { animation: none; opacity: .6; }
  #device-pulse .dp-flash { display: none; }
  #device-pulse .dp-tendrils { display: none; }
}

/* ==== Stage title card (<<StageTitle>>, setup.stageTitle in Define Company) ==== */
/* Performance: everything that moves on the card animates only opacity, transform or filter, which the GPU
   compositor runs on its own without repainting. Glows are painted once on their own layers and faded in and
   out, never animated as text-shadow. The continue link drops its backdrop-filter: a backdrop blur is
   recomputed on every frame that anything around it animates (see the page background at the top).
   The page background layers are hidden while the card covers them, so the GPU does not blend them in every frame. */
body:has(.stage-card)::before,
body:has(.stage-card)::after { display: none; }

.stage-card {
  position: fixed;
  inset: 0;
  z-index: 8000; /* over the game, under the device pulse and SugarCube dialogs */
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: var(--accent);
  text-align: center;
  background: radial-gradient(ellipse 80% 70% at 50% 46%, #1b1820 0%, #0d0c11 55%, #050507 100%);
  cursor: default;
  user-select: none;
  animation: stg-in 1.2s ease both;
}

/* faint scanlines and a vignette over everything */
.stage-card::before,
.stage-card::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.stage-card::before {
  background: repeating-linear-gradient(0deg, rgba(235, 221, 197, .022) 0 1px, transparent 1px 3px);
}
.stage-card::after {
  background: radial-gradient(ellipse at center, transparent 45%, rgba(0, 0, 0, .65) 100%);
}

.stage-card .stg-glow {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0;
  background: radial-gradient(ellipse 45% 38% at 50% 45%, rgba(234, 175, 76, .32), rgba(234, 175, 76, .08) 55%, transparent 80%);
  will-change: opacity;
}

.stage-card .stg-center {
  position: relative;
  z-index: 1;
  padding: 0 16px;
  max-width: 100%;
}

.stage-card .stg-title {
  font-size: clamp(2.2rem, 7.2vw, 5.6rem);
  font-weight: 200;
  line-height: 1.15;
  text-transform: uppercase;
  white-space: nowrap;
}
.stage-card .stg-label { --stg-ls: .32em; letter-spacing: .32em; }
.stage-card .stg-num {
  --stg-ls: .04em;
  position: relative;
  isolation: isolate;
  display: inline-block;
  font-size: 1.3em;
  font-weight: 800;
  letter-spacing: .04em;
  color: var(--gold);
}
.stage-card .stg-sub {
  --stg-ls: .5em;
  min-height: 1.5em;
  padding-left: .5em; /* balances the letter spacing after the last letter */
  font-size: clamp(.78rem, 1.7vw, 1.05rem);
  font-weight: 500;
  letter-spacing: .5em;
  text-transform: uppercase;
  color: rgba(235, 221, 197, .72);
}

/* the letters: invisible but in place, then they come in out of a blur, gold-hot, and cool down to cream.
   The heat is a gold, glowing copy of the letter on top (::after, data-ch) that fades out */
.stage-card .stg-ch {
  position: relative;
  display: inline-block;
  opacity: 0;
  filter: blur(10px);
  transform: translateY(.14em);
  transition: opacity .35s ease, filter .5s ease, transform .5s cubic-bezier(.2, .7, .1, 1);
}
.stage-card .stg-ch::after {
  content: attr(data-ch);
  position: absolute;
  left: 0;
  top: 0;
  color: var(--gold);
  text-shadow: 0 0 .5em rgba(234, 175, 76, .9);
  pointer-events: none;
  transition: opacity 1.2s ease;
}
.stage-card .stg-sub .stg-ch { filter: blur(4px); }
.stage-card .stg-ch.stg-on {
  opacity: 1;
  filter: none;
  transform: none;
}
.stage-card .stg-ch.stg-on::after { opacity: 0; }
.stage-card.stg-skipped .stg-ch,
.stage-card.stg-skipped .stg-ch::after { transition-duration: .45s; transition-delay: 0s; }

/* the number glow: copies of the digits (setup.stageTitle adds them) that only show their shadow,
   behind the digits. .stg-num-glow breathes, .stg-num-flash is the white-hot flash of the landing */
.stage-card .stg-num-glow,
.stage-card .stg-num-flash {
  position: absolute;
  left: 0;
  top: 0;
  z-index: -1;
  white-space: nowrap;
  color: transparent;
  opacity: 0;
  pointer-events: none;
  will-change: opacity;
}
.stage-card .stg-num-glow > span,
.stage-card .stg-num-flash > span { display: inline-block; }
.stage-card .stg-num-glow { text-shadow: 0 0 .6em rgba(234, 175, 76, .72); }
.stage-card .stg-num-flash { text-shadow: 0 0 .08em rgba(255, 248, 230, .9), 0 0 .8em rgba(234, 175, 76, 1); }

/* the caret: takes no room, so nothing moves when it does */
.stage-card .stg-caret {
  position: relative;
  display: inline-block;
  width: 0;
  height: 0;
}
.stage-card .stg-caret::after {
  content: "";
  position: absolute;
  left: calc(var(--stg-ls, 0em) * -.6);
  bottom: -.12em;
  width: max(2px, .05em);
  height: .95em;
  background: var(--gold);
  box-shadow: 0 0 .5em rgba(234, 175, 76, .6);
  opacity: 0;
}
.stage-card.stg-caret-on .stg-caret::after { animation: stg-blink 1.06s steps(1, end) infinite; }
.stage-card.stg-typing .stg-caret::after { animation: none; opacity: 1; }

/* the number lands: a lub-dub, two rings and the room lights up, then it keeps breathing */
.stage-card.stg-hit .stg-num { animation: stg-beat 1.5s ease-out both; }
.stage-card.stg-hit .stg-num-flash { animation: stg-flash 1.5s ease-out both; }
.stage-card.stg-hit .stg-num-glow { animation: stg-glow-in 1.5s ease-out both, stg-breathe 4.5s ease-in-out 1.5s infinite; }
.stage-card.stg-hit .stg-glow { animation: stg-glow-beat 1.6s ease-out both, stg-glow-breathe 6s ease-in-out 1.6s infinite; }
.stage-card .stg-num::before,
.stage-card .stg-num::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 52%;
  width: 1em;
  height: 1em;
  border: 1px solid rgba(234, 175, 76, .7);
  border-radius: 50%;
  opacity: 0;
  transform: translate(-50%, -50%) scale(.3);
  pointer-events: none;
}
.stage-card.stg-hit .stg-num::before { animation: stg-ring 1.7s cubic-bezier(.15, .6, .3, 1) both; }
.stage-card.stg-hit .stg-num::after { animation: stg-ring 1.7s cubic-bezier(.15, .6, .3, 1) .32s both; }
.stage-card.stg-skipped .stg-num,
.stage-card.stg-skipped .stg-num-flash { animation: none; }
.stage-card.stg-skipped .stg-num-glow { animation: stg-breathe 4.5s ease-in-out infinite; }
.stage-card.stg-skipped .stg-glow { animation: stg-glow-breathe 6s ease-in-out infinite; }
.stage-card.stg-skipped .stg-num::before,
.stage-card.stg-skipped .stg-num::after { animation: none; }

.stage-card .stg-rule {
  width: min(28rem, 72vw);
  height: 1px;
  margin: 1.7rem auto 1.4rem;
  background: linear-gradient(90deg, transparent, rgba(234, 175, 76, .85), transparent);
  opacity: 0;
  transform: scaleX(0);
  transition: transform 1.4s cubic-bezier(.2, .7, .1, 1), opacity .6s ease;
}
.stage-card.stg-ruled .stg-rule { opacity: 1; transform: scaleX(1); }

.stage-card .stg-after {
  margin-top: 3.2rem;
  opacity: 0;
  transform: translateY(.6rem);
  pointer-events: none;
  transition: opacity 1.2s ease, transform 1.2s ease;
}
.stage-card.stg-done .stg-after { opacity: 1; transform: none; pointer-events: auto; }
.stage-card .stg-after .navigation-link { display: inline-block; }
.stage-card .stg-after .navigation-link a {
  display: inline-block;
  width: auto;
  min-width: min(14rem, 70vw);
  box-sizing: border-box;
  padding: .75em 2.4em;
  font-size: .78rem;
  font-weight: 600;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--accent);
  background: transparent;
  border: 1px solid rgba(235, 221, 197, .22);
  backdrop-filter: none;
  transition: color .3s ease, border-color .3s ease, background-color .3s ease;
}
.stage-card .stg-after .navigation-link a:hover {
  color: var(--accent);
  border-color: rgba(235, 221, 197, .7);
  background: rgba(235, 221, 197, .08);
}

.stage-card .stg-skip {
  position: absolute;
  right: 1.6rem;
  bottom: 1.4rem;
  z-index: 1;
  font-size: .66rem;
  letter-spacing: .25em;
  text-transform: uppercase;
  color: rgba(235, 221, 197, .32);
  opacity: 0;
  animation: stg-in 1s ease 2.6s forwards;
  transition: opacity .5s ease;
}
.stage-card.stg-done .stg-skip { animation: none; opacity: 0; }

@keyframes stg-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes stg-blink {
  0%   { opacity: 1; }
  50%  { opacity: 0; }
  100% { opacity: 0; }
}

@keyframes stg-beat {
  0%        { transform: scale(1.4); }
  13%       { transform: scale(.95); }
  25%       { transform: scale(1.08); }
  42%, 100% { transform: scale(1); }
}

@keyframes stg-flash {
  0%   { opacity: 1; }
  13%  { opacity: .5; }
  25%  { opacity: .75; }
  100% { opacity: 0; }
}

@keyframes stg-glow-in {
  0%   { opacity: 0; }
  100% { opacity: .55; }
}

@keyframes stg-breathe {
  0%, 100% { opacity: .55; }
  50%      { opacity: 1; }
}

@keyframes stg-ring {
  0%   { opacity: .9; transform: translate(-50%, -50%) scale(.3); }
  100% { opacity: 0;  transform: translate(-50%, -50%) scale(3.4); }
}

@keyframes stg-glow-beat {
  0%   { opacity: 0; }
  8%   { opacity: 1; }
  20%  { opacity: .35; }
  30%  { opacity: .75; }
  100% { opacity: .4; }
}

@keyframes stg-glow-breathe {
  0%, 100% { opacity: .4; }
  50%      { opacity: .22; }
}

@media (prefers-reduced-motion: reduce) {
  .stage-card .stg-ch { filter: none; transform: none; }
  .stage-card .stg-num,
  .stage-card .stg-num-flash,
  .stage-card .stg-num-glow,
  .stage-card .stg-num::before,
  .stage-card .stg-num::after,
  .stage-card.stg-hit .stg-glow { animation: none !important; }
  .stage-card.stg-hit .stg-glow { opacity: .35; }
  .stage-card.stg-hit .stg-num-glow { opacity: .7; }
}

/* ==== POV passages (tag pov, <<PovHeader>> in Event Widgets): her side, in her voice ==== */
.pov-header {
  display: flex;
  align-items: center;
  gap: .8rem;
  margin: 0 0 1.2rem;
  padding: .55rem .9rem;
  border: 1px solid #EBDDC555;
  border-radius: .8rem;
  background: rgba(235, 221, 197, .08);
  backdrop-filter: blur(5px);
}
.pov-avatar {
  position: relative;
  flex: none;
  width: 3rem;
  height: 3rem;
  border-radius: 50%;
  overflow: hidden;
  border: 2px solid var(--accent);
  background: #2a2230;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pov-avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.pov-initial { font-weight: 700; color: var(--accent); }
.pov-kicker { font-size: .65rem; letter-spacing: .25em; text-transform: uppercase; color: rgba(235, 221, 197, .7); }
.pov-name { font-size: 1.15em; font-weight: 700; color: #EBDDC5; }

/* ==== Family offers (<<Offer>>, "Family offers" in Define Quests): the price cards of a deal ==== */
.offer-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  gap: .5rem;
  margin: 1rem 0;
}
.offer-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: .25rem;
  padding: .6rem .8rem;
  border: 1px solid var(--card-border, #EBDDC533);
  border-radius: .6rem;
  background: var(--link-bg, rgba(235, 221, 197, .06));
  backdrop-filter: blur(5px);
  color: #EBDDC5;
  font: inherit;
  text-align: left;
  cursor: pointer;
  transition: border-color .2s, background-color .2s;
}
.offer-card:hover:not(.locked) { border-color: var(--accent); background: rgba(235, 221, 197, .1); }
.offer-label { font-weight: 700; color: var(--accent); }
.offer-cost { font-size: .78em; opacity: .75; }
/* gold marks the family option (her, instead of the plain price): its border, label, face and level */
.offer-family { border-color: #EAAF4C66; }
.offer-family .offer-label { color: #EAAF4C; }
.offer-family:hover:not(.locked) { border-color: #EAAF4C; background: rgba(234, 175, 76, .1); }
.offer-who { display: flex; align-items: center; gap: .45rem; }
.offer-dot {
  position: relative;
  width: 1.6rem;
  height: 1.6rem;
  border-radius: 50%;
  overflow: hidden;
  border: 1px solid #EAAF4C;
  background: #2a2230;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .7rem;
  color: #EAAF4C;
}
.offer-dot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.offer-level {
  padding: .05rem .5rem;
  border-radius: 1rem;
  background: #EAAF4C33;
  color: #EAAF4C;
  font-size: .62rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
}
.offer-stall { border-style: dashed; }
.offer-card.locked { cursor: not-allowed; opacity: .55; }
.offer-card.locked .offer-label { color: #EBDDC5; }
.offer-lock { font-size: .72em; color: #ff9aa9; }
.mail-answer-locked { opacity: .55; cursor: not-allowed; }
.mail-answer-locked small { color: #ff9aa9; margin-left: .4rem; }
