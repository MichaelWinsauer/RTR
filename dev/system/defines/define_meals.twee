/* Meal Logic */

<<set setup.getMealById = (id) => {
    let result = null;
    State.variables.meals.forEach((meal) => {
        if(meal.id == id) {
            result = meal;
        }
    });
    return result;
}>>

<<set setup.getImportantMeals = () => {
    let result = [];
    State.variables.meals.forEach((meal) => {
        if(meal.isImportant) {
            result.push(meal);
        }
    });
    return result;
}>>

<<set setup.getActiveMeals = () => {
    let result = [];
    State.variables.meals.forEach((meal) => {
        if(meal.isActive) {
            result.push(meal);
        }
    });
    return result;
}>>

<<set setup.isMealEligible = (meal) => {
    const dayTypeToday = State.variables.date.today.value < 5 ? "weekday" : "weekend";

    if (!meal.dayType.includes(dayTypeToday)) return false;
    if (!meal.mealType.includes(State.variables.mealType)) return false;
    if (meal.lastSeen >= 0 && meal.lastSeen + meal.cooldown > State.variables.date.dayCount) return false;
    if (meal.once && meal.lastSeen >= 0) return false;

    // everyone listed in 'present' must be home
    if (!meal.present.every(who => State.variables[who].flags.isHome)) return false;

    // everyone at home must be listed in 'present'
    if ([State.variables.mom.sysName, State.variables.sister.sysName].some(who => State.variables[who].flags.isHome && !meal.present.includes(who))) return false;

    return meal.requirements.every(req => req());
}>>

<<set setup.pickMeal = () => {
    let meals = setup.getImportantMeals().filter(meal => meal.isActive && setup.isMealEligible(meal));
    
    if (meals.length == 0) {
        meals = setup.getActiveMeals().filter(setup.isMealEligible);
    }
    
    if (meals.length == 0) {
        return setup.getMealById("default");
    }

    return meals[random(0, meals.length - 1)];
}>>

/* Meal reminders ==============================================================
   setup.getPendingMealTypes([types])  the meal types ("breakfast", "lunch", "dinner") at which an active
                                       important meal can still play today. Checks the day type, "once"/cooldown
                                       and requirements, not who is home (that changes during the day).
                                       Lunch only happens on weekends (Lunch micro event), so it's skipped on weekdays.
   setup.formatMealList(types)         ["breakfast", "dinner"] -> "breakfast and dinner"
   Used by the Daily Update reminder and the "... is ready!" alerts in PassageReady. */
<<set setup.getPendingMealTypes = (types) => {
    const v = State.variables;
    const weekend = v.date.today.value >= 5;
    const dayTypeToday = weekend ? "weekend" : "weekday";
    const candidates = (types || ["breakfast", "lunch", "dinner"]).filter((type) => type !== "lunch" || weekend);

    const pending = setup.getImportantMeals().filter((meal) => {
        if (!meal.isActive) { return false; }
        if (!meal.dayType.includes(dayTypeToday)) { return false; }
        if (meal.once && meal.lastSeen >= 0) { return false; }
        if (meal.lastSeen >= 0 && meal.lastSeen + meal.cooldown > v.date.dayCount) { return false; }
        return meal.requirements.every((req) => req());
    });

    return candidates.filter((type) => pending.some((meal) => meal.mealType.includes(type)));
}>>

<<set setup.formatMealList = (types) => {
    if (types.length <= 1) { return types.join(""); }
    return types.slice(0, -1).join(", ") + " and " + types[types.length - 1];
}>>