:: Define Company [system] {"position":"125,150","size":"100,100"}
<<set $company to {
	name: 'ValTec Co.',
    numberOfEmployees: 0,
    stage: 0,
}>>

<<set $company.employees to [

]>>

/* The company stats (0-100). What each one does and where it comes from: "Company stats" at the end of this
   passage. Efficiency and Morale start in the middle, where they change nothing. */
<<set $company.stats to {
	reputation: 0,
    efficiency: 50,
    suspicion: 0,
    morale: 50,
}>>

/* The full-strength unit hidden behind the ceiling vent of the Stage 1 office (Finishing Renovations).
   level is an index into setup.ventLevels, switched in the CMD device strip. 1 = the 18% baseline it was
   installed with. */
<<set $company.vent to {
	level: 1,
}>>

<<set $company.stats.max to {
	reputation: 100,
    efficiency: 100,
    suspicion: 100,
    morale: 100,
}>>

<<set $company.stats.min to {
	reputation: 0,
    efficiency: 0,
    suspicion: 0,
    morale: 0,
}>>

/* expenses and income are the current weekly/daily figures for the CMD Finances header (CalculateFinances).
   spentToday adds up what actually left the account today (rent, wages); the Daily Update pushes it into
   history.expenses for the chart and starts again at 0. */
<<set $company.finances to {
	money: 0,
    spentToday: 0,
    expenses: {
    	rent: $rent,
        wages: 0,
        utensils: 0,
        tax: 0,
        equipment: 0,
        utilities: 0,
        extra: 0,
    },
    income: {
    	projects: 0,
        revenue: 0,
        tasks: 0,
        subscriptions: 0,
        sales: 0,
        services: 0,
        investments: 0,
        rent: 0,
        extra: 0,
    },
    history: {
    	expenses: [
        
        ],
        income: [
        
        ]
    }
}>>

<<set $company.prototype to {
	name: 'Valenx',
    progress: 0,
    maxProgress: 40,
    charge: 0,
    maxCharge: 100,
    rechargePerDay: 10,     /* charge it regains by itself every night */
    chargePerAction: 20,    /* charge per action spent on "Activity Charge Prototype" */
    calibration: "mom",
    calibrationQuality: 0,
    calibratedAtDay: -1,
    calibrationPresets: [
        "mom",
        "sister",
        "general",
    ],
    lastUsedAtDay: -1,
    lastUsedOnWho: "",
    workbenchQueue: [],     /* job ids for the workbench, the next one first (setup.workbenchQueue) */
}>>

/* The workbench (Stage 0) =========================================================
   "Prototype Workbench" is the hands-on work on the prototype at the Company office: a minigame session of ONE job,
   scored from 0 to 1. Which job comes next is decided by a queue of job ids ($company.prototype.workbenchQueue), so
   the types come in a random order (hardware, hardware, test, software, ...) and the player can see what is coming.
   The queue is refilled with shuffled rounds of every job, so over time each one turns up equally often. The score
   decides the progress, and a clean job adds a bonus. The minigame passage applies the result itself.
   setup.workbench               tuning: maxGain (progress of a perfect session), flawlessAt and flawlessBonus,
                                 actions (what a session costs), tierAt (progress where the jobs get harder) and
                                 groups (the job ids per group; the jobs themselves live in the minigame passage)
   setup.workbenchTier()         0 rough, 1 working, 2 final build: how hard the jobs are, from the progress
   setup.workbenchGain(scores)   { score, base, bonus, gain } for a list of job scores (0 to 1)
   setup.workbenchQueue([n])     the next n job ids (default 1), the next one first; tops the queue up when needed
   setup.workbenchTake()         removes the job at the front of the queue (called once a session is over)
   setup.workbenchGroup(id)      the group of a job id: "hardware", "software" or "test" */
<<set setup.workbench to {
    maxGain: 5,
    flawlessAt: 0.95,
    flawlessBonus: 1,
    actions: 3,
    tierAt: [50, 70],
    groups: {
        hardware: ["wiring", "solder"],
        software: ["debug", "flash"],
        test: ["logic", "stress"],
    },
}>>
<<set setup.workbenchTier = () => {
    const p = Number(State.variables.company.prototype.progress) || 0;
    const at = setup.workbench.tierAt;
    return p >= at[1] ? 2 : (p >= at[0] ? 1 : 0);
}>>
<<set setup.workbenchQueue = (n) => {
    const p = State.variables.company.prototype;
    const want = Math.max(1, Number(n) || 1);
    if (!Array.isArray(p.workbenchQueue)) { p.workbenchQueue = []; }
    const jobs = Object.values(setup.workbench.groups).flat();
    while (p.workbenchQueue.length < want) {
        const round = jobs.slice();
        for (let i = round.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            const t = round[i]; round[i] = round[j]; round[j] = t;
        }
        p.workbenchQueue.push(...round);
    }
    return p.workbenchQueue.slice(0, want);
}>>
<<set setup.workbenchTake = () => {
    setup.workbenchQueue(1);
    return State.variables.company.prototype.workbenchQueue.shift();
}>>
<<set setup.workbenchGroup = (id) => Object.keys(setup.workbench.groups).find((g) => setup.workbench.groups[g].includes(id))>>
<<set setup.workbenchGain = (scores) => {
    const w = setup.workbench;
    const list = (scores || []).map((s) => Math.max(0, Math.min(1, Number(s) || 0)));
    const score = list.length ? list.reduce((a, b) => a + b, 0) / list.length : 0;
    const base = Math.round(score * w.maxGain);
    const bonus = (list.length && list.every((s) => s >= w.flawlessAt)) ? w.flawlessBonus : 0;
    return { score: score, base: base, bonus: bonus, gain: base + bonus };
}>>

/* Charge a quest scene costs, by its impact (1 = a small nudge ... 5 = the scene rests on the device).
   Quests set it with device: { target, impact } in "Define Quests". */
<<set $company.impactCost to [0, 10, 15, 25, 35, 50, 60, 65, 75, 85, 100]>>

/* Money for deals ===============================================================
   What a deal costs actually leaves the company account (the broker fee, the price of the supplier, ...).
   setup.canAfford(amount)            the company account can pay it (in Stage 0: the wallet, see setup.funds in
                                      Define Items)
   setup.spend(amount [, label] [, quiet])
                                      takes it out of the account, counts it for today's finance chart
                                      (finances.spentToday) and shows a notification "label: -$amount" (not with
                                      quiet: the Shop shows its own)

   Debts: the advance from the boss (the pay branch of The Supplier, STAGE1_PROPOSAL.md 4.12). No loan system,
   just a list of weekly installments that the Monday morning pays together with the wages.
   $company.debts = [ { id, label, perWeek, weeksLeft } ]
   setup.addDebt(id, label, amount, perWeek, weeks)
                                      puts amount into the account now and adds the installments. Returns the debt
   setup.payDebts()                   Daily Update, Monday: one installment of every debt, finished ones are removed
   setup.debtsPerWeek()               what all debts cost per week right now (for the CMD and the help page) */
<<set $company.debts to []>>

<<set setup.canAfford = (amount) => setup.funds() >= (Number(amount) || 0)>>

<<set setup.spend = (amount, label, quiet) => {
    const v = State.variables;
    const n = Math.max(0, Number(amount) || 0);
    if (n === 0) { return 0; }
    if (v.company.stage === 0) { v.player.money -= n; }
    else {
        v.company.finances.money -= n;
        v.company.finances.spentToday = (v.company.finances.spentToday || 0) + n;
    }
    if (!quiet) { Notification.show((label ? label + ": " : "") + "-$" + n.toLocaleString("en-US"), { type: Notification.NEGATIVE }); }
    return n;
}>>

<<set setup.addDebt = (id, label, amount, perWeek, weeks) => {
    const v = State.variables;
    v.company.finances.money += Number(amount) || 0;
    const debt = { id: id, label: label, perWeek: Number(perWeek) || 0, weeksLeft: Number(weeks) || 0 };
    v.company.debts.push(debt);
    Notification.show(label + ": +$" + (Number(amount) || 0).toLocaleString("en-US") + ", then $" + debt.perWeek.toLocaleString("en-US") + " every Monday for " + debt.weeksLeft + " weeks", { type: Notification.WARN });
    return debt;
}>>

<<set setup.payDebts = () => {
    const v = State.variables;
    let total = 0;
    v.company.debts.forEach((d) => {
        if (d.weeksLeft <= 0) { return; }
        total += d.perWeek;
        d.weeksLeft -= 1;
    });
    v.company.debts = v.company.debts.filter((d) => d.weeksLeft > 0);
    if (total > 0) {
        v.company.finances.money -= total;
        v.company.finances.spentToday = (v.company.finances.spentToday || 0) + total;
        Notification.show("Debts paid: $" + total.toLocaleString("en-US") + " this week.", { type: Notification.NEGATIVE });
    }
    return total;
}>>

<<set setup.debtsPerWeek = () => State.variables.company.debts.reduce((sum, d) => sum + (d.weeksLeft > 0 ? d.perWeek : 0), 0)>>

/* Wages =========================================================================
   Every employee (staff and family, $company.employees) earns wage per day and is paid for the whole week on
   Monday morning, from the company account (the Daily Update of a Monday calls it). The account may go below 0.
   setup.weeklyWages()   what this week costs: the sum of wage * 7 (the live NPCs, the list holds copies)
   setup.payWages()      pays it, counts it in spentToday (the finance chart) and shows a notification */
<<set setup.weeklyWages = () => {
    const v = State.variables;
    return v.company.employees.reduce((sum, e) => sum + (Number((v[e.sysName] || e).wage) || 0) * 7, 0);
}>>
<<set setup.payWages = () => {
    const v = State.variables;
    const total = setup.weeklyWages();
    if (total <= 0) { return 0; }
    v.company.finances.money -= total;
    v.company.finances.spentToday = (v.company.finances.spentToday || 0) + total;
    Notification.show("Wages paid: $" + total + " for this week.", { type: Notification.NEGATIVE });
    return total;
}>>

/* Charging the Stage 1 devices =====================================================
   Like the Stage 0 prototype (Activity Charge Prototype): plugging a device in at My Desk takes my time. Every
   action adds setup.deviceChargePerAction %, on top of the +15% each owned device regains overnight (Daily Update).
   The CMD device dialog offers one action, or as many as it takes to fill it (window.chargeDevice, CMD Other).
   setup.chargeActionsToFull(device)   actions it takes to fill it from where it is now */
<<set setup.deviceChargePerAction to 20>>
<<set setup.chargeActionsToFull = (device) => {
    const missing = Math.max(0, (Number(device.maxCharge) || 100) - (Number(device.charge) || 0));
    return Math.ceil(missing / setup.deviceChargePerAction);
}>>

/* The device I carry around at home ==============================================
   setup.homeDevice()   the device the home micro events use: the Stage 0 prototype ($company.prototype, the
                        same charge the quests spend) until Stage 1, then the full-strength valenx */
<<set setup.homeDevice = () => {
    const v = State.variables;
    return v.company.stage === 0 ? v.company.prototype : v.company.devices.valenx;
}>>

