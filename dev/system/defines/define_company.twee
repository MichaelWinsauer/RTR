/* Company stats ===============================================================
   $company.stats, 0-100. They only do something from $company.stage 1 on (setup.companyStatsActive);
   Stage 0 hides them. Each stat has one job:

   efficiency   How fast the staff turn their skills into project work: ProgressProjects multiplies their
                work by setup.efficiencyFactor() = 0.5 + efficiency / 100 (x0.5 at 0, x1 at 50, x1.5 at 100).
                My own Work button and the tasks of mom and sister are manual work and stay flat.
                Every night it moves toward setup.efficiencyTarget(), up by tuning.efficiencyRise and down by
                tuning.efficiencyFall points. The target is the sum of setup.efficiencySources, so a one-off
                boost fades again while the things in that list last.
                Now:   the vent unit level (35 / 50 / 65 / 80), low company Morale (below 40 it pulls the
                       target down), Secretary Work (+2 each time, a boost that fades).
                Later: office upgrades, the Veil in the office, quest bonuses: add them to efficiencySources
                       (lasting) or call setup.changeCompanyStat("efficiency", n) (one-off).
   reputation   Pay and unlocks. Repeatable client projects pay reward x setup.reputationRewardFactor(p)
                = 0.8 + reputation / 250 (x0.8 at 0, x1.2 at 100); story projects keep their reward. New projects
                and mails can ask for it in their unlock conditions ("$company.stats.reputation >= 25").
                +3 for a client project finished on time, -1 for every day a client project is overdue,
                plus story beats (the official product meeting). It never drifts.
   morale       The climate in the office. Every employee keeps an own morale for their own exhaustion;
                this one decides how fast they get it back and how fast work eats it:
                overnight recovery setup.moraleRecovery() = 5 + morale / 5 (+5 to +25, +15 at 50),
                work drain tuning.moraleDrainPerAction per action of project work x setup.moraleDrainFactor()
                = (1.5 - morale / 100) x the drain of the vent level. Their work is scaled by their own morale
                (50% at 0, 100% at full), so on Low they keep going at about 85%, Medium gets more done at
                about 70% morale, and High is a crunch: the most work for a week or so, then they run dry.
                +2 per Coffee Break, +2 for a project finished on time, -2 for one finished late,
                plus story beats. Moves 5 points toward 50 every week.
   suspicion    Inactive until Stage 2 (setup.suspicionActive): it stays 0, the sidebar and the CMD hide it and
                UpdateStat / changeCompanyStat ignore it. Planned for Stage 2: device use on clients, turning
                the vent unit up, risky tasks; a lawyer and clean projects bring it down; thresholds that fire
                events (a letter, an inspection, a raid) through $events requirements.

   The vent unit: setup.ventLevels, one entry per dial position, switched in the CMD device strip. It costs
   no charge (it runs on the building power). A higher level costs morale instead: drain multiplies the
   morale the staff lose while they work, so High gets more done per action but wears them out faster.

   Helpers:
   setup.companyStatsActive()        true from Stage 1 on
   setup.suspicionActive()           true from Stage 2 on
   setup.changeCompanyStat(key, n)   adds n (may be negative) to $company.stats[key], clamped, without a
                                     printed line (UpdateStat prints one). Ignores suspicion while inactive
   setup.ventLevel()                 the setup.ventLevels entry the unit is set to
   setup.setVentLevel(i)             switches the unit, refreshes the CMD stats panel
   setup.ventDesign                  its SVG for the CMD (CMD Other: card and openVentDialog)
   setup.efficiencyTarget()          where efficiency is heading, 0-100
   setup.efficiencyBreakdown()       [{ label, value }] of the sources that are not 0, for the UI
   setup.efficiencyFactor()          the multiplier on staff work
   setup.moraleRecovery()            employee morale won back overnight
   setup.moraleDrainFactor()         the multiplier on the morale work costs
   setup.reputationRewardFactor(p)   the multiplier on the reward of project p
   setup.companyStatsDaily()         efficiency drift (Daily Update)
   setup.companyStatsWeekly()        morale drift (Weekly Update) */
<<set setup.companyStatTuning to {
    efficiencyRise: 6,
    /* morale an employee spends per action of project work, before setup.moraleDrainFactor (ProgressProjects) */
    moraleDrainPerAction: 1.8,
    efficiencyFall: 2,
    lowMoraleFrom: 40,
    moraleBaseline: 50,
    moraleWeeklyDrift: 5,
    onTimeReputation: 3,
    lateReputationPerDay: 1,
    onTimeMorale: 2,
    lateMorale: 2,
}>>

<<set setup.ventLevels to [
    { name: "Off", output: 0, efficiency: 35, drain: 0.8,
      text: "Switched off. Everyone works at their own pace, which is slower than I'd like, but nobody wears out either." },
    { name: "Low", output: 18, efficiency: 50, drain: 1,
      text: "The 18% baseline I set it to on day one. It keeps the room warm and focused, and nobody would ever think to blame the ceiling." },
    { name: "Medium", output: 35, efficiency: 65, drain: 1.25,
      text: "A real push. The team gets a lot more done and goes home more tired than they can explain." },
    { name: "High", output: 60, efficiency: 80, drain: 1.6,
      text: "Everybody works like the deadline was yesterday. It burns through their morale fast, so it's for a crunch week, not for every day." },
]>>

/* drawing of the vent unit for the CMD device strip and its dialog (same frame as the device designs above) */
<<set setup.ventDesign to `<svg viewBox="0 0 200 240" width="100%" height="100%" preserveAspectRatio="xMidYMid meet">
      <rect x="20" y="40" width="160" height="160" rx="8" ry="8" fill="#EBDDC5" fill-opacity="0.06"
            stroke="#EBDDC5" stroke-width="6"></rect>
      <rect x="42" y="64" width="116" height="8" rx="3" ry="3" fill="#EBDDC5" opacity="0.45"></rect>
      <rect x="42" y="88" width="116" height="8" rx="3" ry="3" fill="#EBDDC5" opacity="0.45"></rect>
      <rect x="42" y="112" width="116" height="8" rx="3" ry="3" fill="#EBDDC5" opacity="0.45"></rect>
      <rect x="42" y="136" width="116" height="8" rx="3" ry="3" fill="#EBDDC5" opacity="0.45"></rect>
      <rect x="42" y="160" width="116" height="8" rx="3" ry="3" fill="#EBDDC5" opacity="0.45"></rect>
      <circle cx="34" cy="54" r="4" fill="#EBDDC5" opacity="0.4"></circle>
      <circle cx="166" cy="54" r="4" fill="#EBDDC5" opacity="0.4"></circle>
      <circle cx="34" cy="186" r="4" fill="#EBDDC5" opacity="0.4"></circle>
      <circle cx="166" cy="186" r="4" fill="#EBDDC5" opacity="0.4"></circle>
      <circle cx="100" cy="186" r="4" fill="#5CC8E8" opacity="0.9"></circle>
    </svg>`>>

<<set setup.efficiencySources to [
    { label: "Vent unit", value: () => setup.ventLevel().efficiency },
    { label: "Low morale", value: () => {
        const morale = State.variables.company.stats.morale;
        const from = setup.companyStatTuning.lowMoraleFrom;
        return morale < from ? -Math.round((from - morale) / 2) : 0;
    } },
]>>

<<set setup.companyStatsActive = () => State.variables.company.stage >= 1>>

<<set setup.suspicionActive = () => State.variables.company.stage >= 2>>

<<set setup.changeCompanyStat = (key, amount) => {
    const stats = State.variables.company.stats;
    if (!(key in stats)) { console.error('setup.changeCompanyStat: there is no company stat "' + key + '"'); return; }
    if (key === "suspicion" && !setup.suspicionActive()) { return; }
    stats[key] = Math.clamp((Number(stats[key]) || 0) + Number(amount), stats.min[key], stats.max[key]);
}>>

<<set setup.ventLevel = () => {
    const level = Number(State.variables.company.vent.level) || 0;
    return setup.ventLevels[Math.clamp(level, 0, setup.ventLevels.length - 1)];
}>>

<<set setup.setVentLevel = (level) => {
    State.variables.company.vent.level = Math.clamp(Number(level) || 0, 0, setup.ventLevels.length - 1);
    if ($("#cmd-stats").length) {
        $("#cmd-stats").empty().wiki('<<include "CMD Stats">>');
    }
}>>

<<set setup.efficiencyBreakdown = () => {
    return setup.efficiencySources
        .map((source) => ({ label: source.label, value: Math.round(Number(source.value()) || 0) }))
        .filter((entry) => entry.value !== 0);
}>>

<<set setup.efficiencyTarget = () => {
    const stats = State.variables.company.stats;
    const sum = setup.efficiencyBreakdown().reduce((total, entry) => total + entry.value, 0);
    return Math.clamp(sum, stats.min.efficiency, stats.max.efficiency);
}>>

<<set setup.efficiencyFactor = () => {
    if (!setup.companyStatsActive()) { return 1; }
    return 0.5 + State.variables.company.stats.efficiency / 100;
}>>

<<set setup.moraleRecovery = () => {
    if (!setup.companyStatsActive()) { return 15; }
    return Math.round(5 + State.variables.company.stats.morale / 5);
}>>

<<set setup.moraleDrainFactor = () => {
    if (!setup.companyStatsActive()) { return 1; }
    return (1.5 - State.variables.company.stats.morale / 100) * setup.ventLevel().drain;
}>>

<<set setup.reputationRewardFactor = (project) => {
    if (!project || project.type !== "repeatable" || !(Number(project.reward) > 0)) { return 1; }
    return 0.8 + State.variables.company.stats.reputation / 250;
}>>

<<set setup.companyStatsDaily = () => {
    if (!setup.companyStatsActive()) { return; }
    const stats = State.variables.company.stats;
    const tuning = setup.companyStatTuning;
    const target = setup.efficiencyTarget();
    if (stats.efficiency < target) {
        stats.efficiency = Math.min(target, stats.efficiency + tuning.efficiencyRise);
    } else if (stats.efficiency > target) {
        stats.efficiency = Math.max(target, stats.efficiency - tuning.efficiencyFall);
    }
}>>

<<set setup.companyStatsWeekly = () => {
    if (!setup.companyStatsActive()) { return; }
    const stats = State.variables.company.stats;
    const tuning = setup.companyStatTuning;
    const gap = tuning.moraleBaseline - stats.morale;
    stats.morale += Math.sign(gap) * Math.min(Math.abs(gap), tuning.moraleWeeklyDrift);
}>>

/* The device pulse ============================================================
   A heartbeat glow over the whole screen while the device is running. It is purely visual: it lives in the
   page, not in the game state, it is not saved, and it never catches clicks (pointer-events: none).
   setup.devicePulse(power [, opts])   power 0-10, the same scale as a quest device impact. Returns the new power.
                                       A string with a sign ("+2", "-1") turns the dial from where it is now.
                                       0, false or "off" switches it off (it fades out).
       opts.keep    true: keep it running across passage changes until it is switched off (multi-part scenes).
                    Without it, the pulse fades out on the next passage change. Once kept, later calls without
                    keep stay kept; keep: false drops it again.
       opts.color   "#rrggbb" for this pulse (kept by later "+1" calls), default setup.devicePulseStyle.color
       opts.fade    fade in/out time in ms, default setup.devicePulseStyle.fade
       opts.delay   ms to wait before the change happens (a device that sputters out a few seconds after it
                    was switched on). A passage change or any other call in the meantime cancels it.
   setup.devicePulsePower()            the power right now (0 while it is off)
   The widget is <<DevicePulse>> ("Quest Widgets"), and <<UseQuestDevice>> starts it with the quest impact.
   The look is the CSS of #device-pulse in StoryStylesheet. The player can switch it off in the settings
   (showDevicePulse); the power is still tracked then, so switching it back on mid-scene shows it again.

   Scroll position: a change written into a passage waits until the player has read that far.
   <<DevicePulse>> and <<UseQuestDevice>> do not call setup.devicePulse themselves. They print an invisible marker
   (setup.devicePulseMark) where they stand in the text, and the pulse follows the markers: it shows the state of the
   last marker whose top has scrolled above setup.devicePulseStyle.reach (a share of the window height). Scrolling
   back up above a marker takes its change back. Markers resolve in the order of the text, from the pulse the
   passage started with (a kept pulse from the passage before, or none), so "+1" counts from the marker above it.
   A marker that never reaches the page (inside <<silent>>) applies at once and counts as part of that start.
   setup.devicePulseMark(power [, opts])  the HTML of a marker, opts as for setup.devicePulse (keep, color, delay, fade)
   setup.devicePulseScan()                looks at the markers again and applies the one that is reached now. Runs
                                          on scroll, resize and whenever a new marker is printed
   A direct setup.devicePulse call still works at once, but the next marker that is reached overrides it. */
<<set setup.devicePulseStyle to {
    color: "#ff6479",   /* the default glow color */
    fade: 900,          /* ms to fade in and out */
    slowest: 3.2,       /* seconds per heartbeat at power 1 */
    fastest: 0.85,      /* seconds per heartbeat at power 10 */
    reach: 0.85,        /* a marker counts once its top is above this share of the window height */
}>>

<<set setup.devicePulsePower = () => {
    const el = document.getElementById("device-pulse");
    return el ? Number(el.dataset.power) || 0 : 0;
}>>

<<set setup.devicePulse = (power, opts) => {
    const options = opts || {};
    const style = setup.devicePulseStyle;
    const current = setup.devicePulsePower();
    const fade = options.fade !== undefined ? Number(options.fade) : style.fade;
    let el = document.getElementById("device-pulse");

    /* A delayed change waits, then runs as a normal call. A passage change, or any call in the meantime, cancels it */
    clearTimeout(Number(document.body.dataset.dpDelay));
    jQuery(document).off(":passagestart.devicePulseDelay");
    if (Number(options.delay) > 0) {
        const later = Object.assign({}, options, { delay: 0 });
        document.body.dataset.dpDelay = setTimeout(() => setup.devicePulse(power, later), Number(options.delay));
        jQuery(document).one(":passagestart.devicePulseDelay", () => clearTimeout(Number(document.body.dataset.dpDelay)));
        return current;
    }

    /* Work out the new power: absolute number, relative string, or off */
    const raw = power === undefined || power === null || power === false ? "off" : String(power).trim().toLowerCase();
    let power10;
    if (raw === "off") {
        power10 = 0;
    } else if (typeof power === "string" && (raw[0] === "+" || raw[0] === "-")) {
        power10 = current + Number(raw);
    } else {
        power10 = Number(raw);
    }
    if (!Number.isFinite(power10)) {
        console.error('setup.devicePulse: "' + power + '" is no power, use 0-10, "+1"/"-1" or "off"');
        return current;
    }
    power10 = Math.max(0, Math.min(10, power10));

    jQuery(document).off(":passagestart.devicePulse");

    /* Off: fade out, then remove the layer (unless it was switched on again in the meantime) */
    if (power10 <= 0) {
        if (el) {
            el.dataset.power = 0;
            el.dataset.keep = "";
            el.style.setProperty("--dp-fade", fade + "ms");
            el.classList.remove("dp-on");
            clearTimeout(Number(el.dataset.timer));
            el.dataset.timer = setTimeout(() => {
                if (!el.classList.contains("dp-on")) { el.remove(); }
            }, fade + 50);
        }
        return 0;
    }

    if (!el) {
        el = document.createElement("div");
        el.id = "device-pulse";
        el.setAttribute("aria-hidden", "true");
        el.innerHTML = '<div class="dp-glow"></div><div class="dp-flash"></div>';
        document.body.appendChild(el);
        setup.devicePulseTendrils(el);  /* the creeping lines from the edges (Tendrils Script) */
        void el.offsetWidth;  /* start from opacity 0, so the fade-in runs */
    }
    clearTimeout(Number(el.dataset.timer));

    const hex = String(options.color || el.dataset.color || style.color).replace("#", "");
    const full = hex.length === 3 ? hex.split("").map((c) => c + c).join("") : hex.slice(0, 6);
    const rgb = [0, 2, 4].map((i) => parseInt(full.substr(i, 2), 16) || 0).join(", ");
    const p = power10 / 10;
    const period = Math.max(style.fastest, style.slowest - (style.slowest - style.fastest) * (power10 - 1) / 9);

    el.dataset.power = power10;
    el.dataset.color = "#" + full;
    if (options.keep === true) { el.dataset.keep = "1"; }
    if (options.keep === false) { el.dataset.keep = ""; }

    el.style.setProperty("--dp-fade", fade + "ms");
    el.style.setProperty("--dp-rgb", rgb);
    el.style.setProperty("--dp-alpha", (0.2 + 0.5 * p).toFixed(3));
    el.style.setProperty("--dp-inner", (62 - 27 * p).toFixed(1));
    el.style.setProperty("--dp-flash", (p <= 0.5 ? 0 : (p - 0.5) * 0.12).toFixed(3));
    el.style.setProperty("--dp-period", period.toFixed(2) + "s");
    el.classList.toggle("dp-on", settings.showDevicePulse !== false);

    if (!el.dataset.keep) {
        jQuery(document).one(":passagestart.devicePulse", () => setup.devicePulse(0));
    }
    return power10;
}>>

/* The state one marker leads to, from the state before it: { power, keep, color } */
<<set setup.devicePulseResolve = (from, mark) => {
    const raw = mark.power === undefined || mark.power === null || mark.power === false || mark.power === "" ? "off" : String(mark.power).trim().toLowerCase();
    let power;
    if (raw === "off") {
        power = 0;
    } else if (raw[0] === "+" || raw[0] === "-") {
        power = from.power + Number(raw);
    } else {
        power = Number(raw);
    }
    if (!Number.isFinite(power)) {
        console.error('setup.devicePulse: "' + mark.power + '" is no power, use 0-10, "+1"/"-1" or "off"');
        power = from.power;
    }
    power = Math.max(0, Math.min(10, power));
    if (power <= 0) { return { power: 0, keep: false, color: null }; }
    return {
        power: power,
        keep: mark.keep === true ? true : mark.keep === false ? false : from.keep,
        color: mark.color || from.color || null,
    };
}>>

<<set setup.devicePulseApply = (state, opts) => setup.devicePulse(state.power > 0 ? state.power : "off",
    Object.assign({ keep: state.keep, color: state.color || setup.devicePulseStyle.color }, opts || {}))>>

/* The pulse the current passage started with lives on the page (body data), like the pulse itself */
<<set setup.devicePulseBase = () => {
    try {
        const base = JSON.parse(document.body.dataset.dpBase);
        if (base && typeof base.power === "number") { return base; }
    } catch (error) { /* no base yet */ }
    return { power: 0, keep: false, color: null };
}>>
<<set setup.devicePulseSetBase = (base) => { document.body.dataset.dpBase = JSON.stringify(base); }>>

<<set setup.devicePulseReadMark = (el) => ({
    power: el.dataset.dpPower,
    keep: el.dataset.dpKeep === "1" ? true : el.dataset.dpKeep === "0" ? false : undefined,
    color: el.dataset.dpColor || null,
    delay: Number(el.dataset.dpDelay) || 0,
    fade: el.dataset.dpFade !== undefined ? Number(el.dataset.dpFade) : undefined,
})>>

<<set setup.devicePulseMark = (power, opts) => {
    const o = opts || {};
    const id = "dp-mark-" + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
    const attr = (name, value) => (value === undefined || value === null ? "" : " data-dp-" + name + '="' + String(value).replace(/["<]/g, "") + '"');
    const keep = o.keep === true ? "1" : o.keep === false ? "0" : null;
    /* The marker is on the page by the time this runs, unless it was printed inside silent */
    setTimeout(() => {
        if (!document.getElementById(id)) {
            const next = setup.devicePulseResolve(setup.devicePulseBase(), { power: power, keep: o.keep, color: o.color });
            setup.devicePulseSetBase(next);
            setup.devicePulseApply(next, { delay: o.delay, fade: o.fade });
        }
        setup.devicePulseScan();
    }, 0);
    return '<span class="dp-mark" aria-hidden="true" id="' + id + '"' + attr("power", power === false ? "off" : power)
        + attr("keep", keep) + attr("color", o.color) + attr("delay", o.delay) + attr("fade", o.fade) + "></span>";
}>>

<<set setup.devicePulseScan = () => {
    const marks = Array.from(document.querySelectorAll("#passages .dp-mark"));
    const line = window.innerHeight * setup.devicePulseStyle.reach;
    let state = setup.devicePulseBase();
    let before = state;
    let active = null;
    for (const mark of marks) {
        if (mark.getClientRects().length === 0) { continue; }   /* hidden (display none somewhere above it) */
        if (mark.getBoundingClientRect().top >= line) { break; }
        before = state;
        state = setup.devicePulseResolve(state, setup.devicePulseReadMark(mark));
        active = mark;
    }
    const last = document.querySelector("#passages .dp-mark.dp-active");
    if (active === last) { return; }
    if (last) { last.classList.remove("dp-active"); }
    if (!active) {
        setup.devicePulseApply(state);
        return;
    }
    active.classList.add("dp-active");
    const mark = setup.devicePulseReadMark(active);
    if (mark.delay > 0) {
        /* reached together with the marker before it (on, then off two seconds later): show that one first */
        setup.devicePulseApply(before, { fade: mark.fade });
        setup.devicePulseApply(state, { delay: mark.delay, fade: mark.fade });
    } else {
        setup.devicePulseApply(state, { fade: mark.fade });
    }
}>>

/* Every passage starts from the pulse that is left after the passage change (a kept one, or none), and the
   markers are checked again whenever the page scrolls or the window changes its size */
<<run jQuery(document).off(":passagerender.devicePulseScroll").on(":passagerender.devicePulseScroll", () => {
    const el = document.getElementById("device-pulse");
    const power = setup.devicePulsePower();
    setup.devicePulseSetBase(power > 0
        ? { power: power, keep: !!(el && el.dataset.keep), color: el ? el.dataset.color || null : null }
        : { power: 0, keep: false, color: null });
})>>
<<run (() => {
    if (document.body.dataset.dpScroll) { return; }
    document.body.dataset.dpScroll = "1";
    let queued = false;
    const queue = () => {
        if (queued) { return; }
        queued = true;
        requestAnimationFrame(() => { queued = false; setup.devicePulseScan(); });
    };
    document.addEventListener("scroll", queue, { capture: true, passive: true });
    window.addEventListener("resize", queue, { passive: true });
})()>>

/* Loading a save never keeps a pulse from the game that was running before */
<<run Save.onLoad.add(() => setup.devicePulse(0, { fade: 0 }))>>

/* The stage title card ========================================================
   The full-screen title that opens a new stage of the company ("Stage 1 Follow Up"). Like the device pulse it
   only lives in the page; nothing of it is saved.
   setup.stageTitle(target)   plays the card that <<StageTitle>> ("Event Widgets") built in target (an element or a
                              selector). The label types in letter by letter behind a caret, the number lands with
                              a heartbeat, a rule draws out and the subtitle types in under it, then .stg-after (the
                              continue link) fades in. A click, Enter, Space or Esc jumps to the end, and so does
                              prefers-reduced-motion. Each card plays once.
   setup.stageTitleStyle      the timing in ms. The look is .stage-card in StoryStylesheet. */
<<set setup.stageTitleStyle to {
    start: 1100,          /* black screen before the caret shows up */
    caretLead: 1000,      /* the caret blinks on its own before the first letter */
    letter: 150,          /* base time per letter of the label */
    jitter: 0.45,         /* each letter strays up to 45 percent from that, so it reads like a person typing */
    beforeNumber: 1100,   /* the pause after the label, caret blinking */
    numberLetter: 240,    /* time per digit when the number has more than one */
    afterNumber: 1700,    /* the heartbeat plays out before the rule draws */
    subtitleLead: 900,    /* the rule draws out before the subtitle starts */
    subtitleLetter: 62,   /* base time per subtitle letter */
    end: 1300,            /* the caret blinks at the end of the subtitle before the link fades in */
}>>

<<set setup.stageTitle = (target) => {
    const root = typeof target === "string" ? document.querySelector(target) : target;
    if (!root || root.dataset.stPlayed) { return; }
    root.dataset.stPlayed = "1";
    const style = setup.stageTitleStyle;
    const timers = [];
    let finished = false;

    /* One span per letter. Every letter holds its place from the start, so the centered line never shifts while it types */
    const split = (el) => {
        if (!el) { return []; }
        const text = el.textContent.replace(/\s+/g, " ").trim();
        el.textContent = "";
        return Array.from(text).map((ch) => {
            const span = document.createElement("span");
            span.className = "stg-ch";
            span.textContent = ch === " " ? "\u00a0" : ch;
            span.dataset.ch = span.textContent;
            el.appendChild(span);
            return span;
        });
    };
    const label = root.querySelector(".stg-label");
    const gap = root.querySelector(".stg-gap");
    const sub = root.querySelector(".stg-sub");
    const labelChars = split(label);
    const num = root.querySelector(".stg-num");
    const numChars = split(num);
    const subChars = split(sub);

    /* The number glow: copies of the digits that only show their shadow. They are painted once and only faded,
       which the GPU does for free, where an animated text-shadow would be repainted on every frame */
    if (num) {
        ["stg-num-glow", "stg-num-flash"].forEach((cls) => {
            const copy = document.createElement("span");
            copy.className = cls;
            copy.setAttribute("aria-hidden", "true");
            numChars.forEach((ch) => {
                const digit = document.createElement("span");
                digit.textContent = ch.textContent;
                copy.appendChild(digit);
            });
            num.appendChild(copy);
        });
    }

    const caret = document.createElement("span");
    caret.className = "stg-caret";
    caret.setAttribute("aria-hidden", "true");

    const at = (ms, fn) => { timers.push(setTimeout(fn, ms)); };
    const typing = (on) => root.classList.toggle("stg-typing", on);
    const show = (ch) => { ch.classList.add("stg-on"); ch.after(caret); };
    const step = (ms) => ms * (1 + (Math.random() * 2 - 1) * style.jitter);
    const hit = () => { typing(false); caret.remove(); root.classList.add("stg-hit"); };

    const onClick = () => finish(true);
    const onKey = (ev) => {
        if (typeof Dialog !== "undefined" && Dialog.isOpen()) { return; }
        if (ev.key === "Enter" || ev.key === " " || ev.key === "Escape") {
            ev.preventDefault();
            ev.stopPropagation();
            finish(true);
        }
    };
    const unbind = () => {
        document.removeEventListener("keydown", onKey, true);
        root.removeEventListener("click", onClick);
        jQuery(document).off(":passagestart.stageTitle");
    };
    /* skipped: the letters snap in quickly and the number skips its heartbeat */
    const finish = (skipped) => {
        if (finished) { return; }
        finished = true;
        timers.forEach(clearTimeout);
        unbind();
        if (skipped) { root.classList.add("stg-skipped"); }
        root.querySelectorAll(".stg-ch").forEach((ch) => ch.classList.add("stg-on"));
        caret.remove();
        root.classList.remove("stg-typing");
        root.classList.add("stg-caret-on", "stg-hit", "stg-ruled", "stg-done");
    };

    if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        finish(true);
        return;
    }
    document.addEventListener("keydown", onKey, true);
    root.addEventListener("click", onClick);
    jQuery(document).one(":passagestart.stageTitle", () => { timers.forEach(clearTimeout); unbind(); });

    /* The label: the caret blinks alone for a moment, then the letters come in at an uneven pace */
    let t = style.start;
    at(t, () => { label.prepend(caret); root.classList.add("stg-caret-on"); });
    t += style.caretLead;
    at(t, () => typing(true));
    labelChars.forEach((ch) => { at(t, () => show(ch)); t += step(style.letter); });
    at(t, () => typing(false));

    /* The number: a held breath, the caret steps over the space, the number lands with a heartbeat */
    t += style.beforeNumber;
    if (numChars.length) {
        at(t, () => { typing(true); (gap || label).after(caret); });
        t += style.numberLetter * 1.6;
        numChars.forEach((ch, i) => {
            const last = i === numChars.length - 1;
            at(t, () => { show(ch); if (last) { hit(); } });
            t += last ? style.afterNumber : style.numberLetter;
        });
    }

    /* The rule draws out, then the subtitle types in under it, quicker than the label */
    at(t, () => root.classList.add("stg-ruled"));
    if (subChars.length) {
        t += style.subtitleLead;
        at(t, () => { sub.prepend(caret); typing(true); });
        t += 380;
        subChars.forEach((ch) => { at(t, () => show(ch)); t += step(style.subtitleLetter); });
        at(t, () => typing(false));
    }
    t += style.end;
    at(t, () => finish(false));
}>>
