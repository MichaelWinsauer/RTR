/* Catching her (after The Booze Night) =========================================
   Micro events 46 to 48: she's alone at home and touches herself on the couch, at the kitchen counter, in the shower
   with the door not quite shut, and I walk in on it. Each offers watching quietly, letting her notice me, or walking away.
   setup.momCanBeCaught()   after The Booze Night (mom_boozeNight), with her Lust at 30 or more
   setup.momCatchChance()   the chance in percent that it happens when I come in: grows with her Lust, at most 70 */
<<set setup.momCanBeCaught = () => setup.questDone("mom_boozeNight") && State.variables.mom.stats.lust >= 30>>

<<set setup.momCatchChance = () => Math.clamp(Math.round((State.variables.mom.stats.lust - 20) * 0.9), 0, 70)>>

/* A normal workday ===========================================================
   Stage 1: small moments at the office while the staff is in (micro events 32 to 44): desk visitors from $mom, the
   staff and $sister, and inline moments in the main room. They are everyday things, so most of them come back only
   every few days (dayCooldown), and several change with her corruption stage or how far her quest line is. Two of
   them happen once ($flags.brianAskedAboutVent, $flags.dariusAskedAboutNumbers, set in their passages, so a visit
   that was waved off can come back).
   setup.officeWorkday([who])   after Too Much Work, a weekday during work hours (and, with a sysName, that
                                employee works here)
   setup.momWorksHere()         a workday, and she is at my office at her own desk (activity working, so not in
                                the middle of a task with me) */
<<set setup.officeWorkday = (who) => {
    const v = State.variables;
    if (!setup.questDone("main_tooMuchWork") || !setup.isOfficeWorkTime()) { return false; }
    return !who || v.company.employees.some((e) => e.sysName === who);
}>>

<<set setup.momWorksHere = () => {
    return setup.officeWorkday() && setup.npcIsAt("mom", "companystage1") && setup.npcNow("mom").activity === "working";
}>>

/* Her rounds =================================================================
   Stage 1, sister line: after Mostly Done (sister_mostlyDone) she is at the office from Noon on, and I told her to
   spend that time with the staff: talk to them, keep them company, bring everyone coffee. Micro events 28 to 31 show
   it in the main room while the staff is in (a coffee round, and one visit each to $brian, $ethan and $darius).
   They change the company Morale a little, and some of them let me call her back to my side.
   setup.sisterMakesRounds([who])   true when she is at the office during work hours after Mostly Done (and, with
                                    a sysName, that employee works here) */
<<set setup.sisterMakesRounds = (who) => {
    const v = State.variables;
    if (!setup.questDone("sister_mostlyDone") || !setup.isOfficeWorkTime()) { return false; }
    if (!setup.npcIsAt("sister", "companystage1")) { return false; }
    return !who || v.company.employees.some((e) => e.sysName === who);
}>>

/* Her excuses to be near me ===================================================
   Stage 1, sister line: from sister_waitSupportiveSister until sister_itMakesADifference is done she keeps finding
   reasons to be around me at the office (micro events 23 to 27: three desk visitors, two inline events in the main
   room). Each one that plays out counts in $sister.flags.officeExcuses, and sister_waitSupportiveSister waits for
   a few of them (its check in Define Quests), so the next scene never comes before the player has seen her doing it.
   setup.sisterSeeksExcuses()      true while that stretch of her line runs
   setup.sisterWorkedHereToday()   her plan had her at my office at the end of the afternoon (the late visit) */
<<set setup.sisterSeeksExcuses = () => {
    return setup.questReached("sister_waitSupportiveSister") && !setup.questDone("sister_itMakesADifference");
}>>

<<set setup.sisterWorkedHereToday = () => {
    const here = setup.npcAt("sister", 11);
    return !!here.location && setup.sameLocation(here.location, setup.getLocationBySysName("companystage1"));
}>>

/* Event lookup ================================================================
   setup.pickEvent(passage)       the event of $events that plays now on this passage, or null (<<CheckForEvent>>,
                                  on every passage). The first event in the list that is active (and not a finished
                                  once-event), belongs to this passage, weekday and time slot, passes its requirements,
                                  its device check and isn't stalled ("Family offers" in Define Quests), and whose
                                  chance roll hits. The cheap checks come first, so the requirements (TwineScript)
                                  only run for the few events that could play here right now. */
<<set setup.pickEvent = (passageName) => {
    const v = State.variables;
    const weekday = v.date.today.value;
    const slot = v.time.current.value;
    for (const ev of v.events) {
        if (!ev.active) { continue; }
        if (!(ev.once == false || (ev.once == true && ev.finished == false))) { continue; }
        if (!ev.where.some((place) => ((typeof place === "object") ? place.passage : place) == passageName)) { continue; }
        if (!ev.whenDay.includes(weekday) || !ev.whenTime.includes(slot)) { continue; }
        if (ev.requirements && !ev.requirements.every((req) => Scripting.evalTwineScript(req))) { continue; }
        if (ev.device && !setup.questDevice(ev.device).ok) { continue; }
        if (setup.offerStalled(ev)) { continue; }
        if (random(1, 100) <= ev.chance) { return ev; }
    }
    return null;
}>>

/* Micro event lookup ==========================================================
   setup.pickMicroEvent([kind])   the micro event that happens now where I am, or null. Collects every event in
                                  $microEvents that passes its checks, then rolls them: chance 100 first (the meals),
                                  the rest in random order, so an event late in the list gets the same odds as an
                                  early one. The first hit wins and gets lastSeenDay/lastSeenAP. kind "inline"
                                  (default) only takes events without a visitor
                                  block (<<CheckMicroEvent>> in location passages), "visitor" only those with one
                                  (setup.updateDeskVisitor). Nothing happens before the intro is done.
                                  During The Silence (Define NPCs) events with mom (conditions.npc or visitor.who
                                  "mom") are skipped, unless they have duringSilence: true.
   setup.isOfficeWorkTime()       a weekday and the current action lies in $company.workHours: the staff is in */
<<set setup.pickMicroEvent = (kind) => {
    const v = State.variables;
    if (!v.flags.introDone) { return null; }
    const wantVisitor = kind === "visitor";
    const here = v.player.location || {};
    const slot = v.time.current.value;
    const day = v.date.dayCount;
    const row = setup.scheduleCurrentRow();
    const silent = setup.momSilent();
    const candidates = [];
    for (const ev of v.microEvents) {
        if (!ev.active || !!ev.visitor !== wantVisitor) { continue; }
        if (!ev.where.includes(here.name) && !ev.where.includes(here.sysName)) { continue; }
        /* The Silence (Define NPCs): nothing with her that week, except her attempts to make up */
        if (silent && !ev.duringSilence && ((ev.conditions || {}).npc === "mom" || (ev.visitor && ev.visitor.who === "mom"))) { continue; }
        if (ev.oncePerDay && ev.lastSeenDay === day) { continue; }
        if (ev.dayCooldown > 0 && day - ev.lastSeenDay < ev.dayCooldown) { continue; }
        if (ev.apCooldown > 0 && ev.lastSeenDay === day && row - ev.lastSeenAP < ev.apCooldown) { continue; }
        const c = ev.conditions || {};
        if (c.whenTime && c.whenTime.length > 0 && !c.whenTime.includes(slot)) { continue; }
        const npc = c.npc ? v[c.npc] : null;
        if (npc) {
            if (c.npcLocation && c.npcLocation.length > 0 && !c.npcLocation.includes((npc.location || {}).name)) { continue; }
            if (c.npcPreviousLocation && c.npcPreviousLocation.length > 0 && !c.npcPreviousLocation.includes((npc.previousLocation || {}).name)) { continue; }
        }
        if ((c.eval || []).some((fn) => !fn())) { continue; }
        candidates.push(ev);
    }
    const sure = candidates.filter((ev) => ev.chance >= 100);
    const rolled = candidates.filter((ev) => ev.chance < 100).shuffle();
    for (const ev of sure.concat(rolled)) {
        if (random(1, 100) > ev.chance) { continue; }
        ev.lastSeenDay = day;
        ev.lastSeenAP = row;
        return ev;
    }
    return null;
}>>

<<set setup.isOfficeWorkTime = () => {
    const v = State.variables;
    return v.date.today.value < 5 && v.company.workHours[setup.scheduleCurrentRow()] === true;
}>>

/* Scenes ======================================================================
   setup.inScene()   true while a full scene is on screen: an event, a quest scene or a task scene (passage tags
                     event, scene, task_scene). The sidebar links that would leave it (her profile, her location,
                     the prototype chips) are switched off then, and the closed-location bounce waits. */
<<set setup.inScene = () => tags().includesAny("event", "scene", "task_scene")>>

/* Desk visitors ===============================================================
   My Desk shows the dashboard instead of a location image, so a micro event has no image to replace there.
   Micro events with a visitor block show up as a card in the CMD header instead ("CMD Visitor"):
       visitor: {
           who:      "sister",   sysName of whoever comes by: the portrait (images/characters/portraits/<who>.jpg)
                                 and the name on the card and in the drawer
           teaser:   "...",      one or two lines for the card, may contain variables
           decline:  "...",      optional notification for "Not now"
       }
   "Talk" opens a drawer on the right side of the dashboard and includes the event passage there. It is written like
   any other micro event passage (Chat, <<replace>> choices, UpdateStat), costs no action and must not <<goto>> the
   desk. Closing the drawer renders the desk again, so the dashboard shows what changed.
   The card only stays for the action it came up in: working on, or leaving the desk, lets the visit pass without
   any effect. "Not now" does the same, with the decline notification.
   Desk visitors are rolled once per action (rendering the desk again in the same action, after a dialog or the
   profile, keeps the card and never rolls twice) and at most once every setup.deskVisitorCooldown actions.

   $deskVisitor           null, or { id, at } while a card is up (at: setup.absoluteAction() it came up in)
   $deskVisitorRolledAt   the action of the last roll
   $deskVisitorLastAt     the action the last visitor came up in

   setup.deskVisitorCooldown        actions between two visitors
   setup.absoluteAction()           one number per action over the whole game (dayCount * 21 + row)
   setup.updateDeskVisitor()        the desk passage, on every render: drops an old card, rolls a new one
   setup.deskVisitor()              { event, npc, name } of the card that is up now, or null
   setup.takeDeskVisitor()          "Talk": the same, and the card is used up
   setup.dismissDeskVisitor()       "Not now": removes the card and shows the decline notification */
<<set $deskVisitor to null>>
<<set $deskVisitorRolledAt to -1>>
<<set $deskVisitorLastAt to -999>>

<<set setup.deskVisitorCooldown to 6>>

<<set setup.absoluteAction = () => {
    const v = State.variables;
    return v.date.dayCount * v.timeSlots.length * v.time.actions.max + setup.scheduleCurrentRow();
}>>

<<set setup.updateDeskVisitor = () => {
    const v = State.variables;
    const now = setup.absoluteAction();
    if (v.deskVisitor && v.deskVisitor.at !== now) { v.deskVisitor = null; }
    if (v.deskVisitorRolledAt === now) { return; }
    v.deskVisitorRolledAt = now;
    if (v.deskVisitor || now - v.deskVisitorLastAt < setup.deskVisitorCooldown) { return; }
    const ev = setup.pickMicroEvent("visitor");
    if (!ev) { return; }
    v.deskVisitor = { id: ev.id, at: now };
    v.deskVisitorLastAt = now;
}>>

<<set setup.deskVisitor = () => {
    const v = State.variables;
    if (!v.deskVisitor || v.deskVisitor.at !== setup.absoluteAction()) { return null; }
    const ev = v.microEvents.find((e) => e.id === v.deskVisitor.id);
    if (!ev || !ev.visitor) { return null; }
    const npc = v[ev.visitor.who] || null;
    return { event: ev, npc: npc, name: npc ? (npc.callName || npc.name) : "" };
}>>

<<set setup.takeDeskVisitor = () => {
    const info = setup.deskVisitor();
    State.variables.deskVisitor = null;
    return info;
}>>

<<set setup.dismissDeskVisitor = () => {
    const info = setup.takeDeskVisitor();
    if (info && info.event.visitor.decline) {
        Notification.show(wikifyText(info.event.visitor.decline), { type: Notification.INFORMATION });
    }
}>>
