:: Define Events [system] {"position":"750,0","size":"100,100"}
<<set $currentEvent to 0>>

<<set $events to [   
	{
    	/* The landlord comes for the rent: from the evening of rent day on, as soon as I am at home or at the office
           (the rent passages and helpers are explained under The weekly rent in Define Misc). When it starts is
           decided by $rentDueDay alone, so it is always active and has no cooldown. It returns to where it found me */
    	id: 0,
        passage: "Rent Due",
        returnPassage: "Bedroom",
        where: ["Bedroom", "Hallway", "Living Room", "Kitchen", "Mom Room", "Sister Room", "Company", setup.getLocationBySysName("companystage1").passage, setup.getLocationBySysName("companystage1desk").passage, setup.getLocationBySysName("companystage1meeting").passage],
        whenTime: [ 0, 1, 2, 3, 4, 5, 6 ],
        whenDay: [ 0, 1, 2, 3, 4, 5, 6 ],
        requirements: [ "setup.rentIsOverdue()" ],
        chance: 100,
        cooldown: 0,
        once: false,
        active: true,
        finished: false,
        completedAtDay: 0,
    },
    {
    	id: 1,
        passage: "Mom Bathroom",
        returnPassage: "Hallway",
        where: ["Bathroom"],
        whenTime: [ 0, 1, 2, 3, 4, 5, 6 ],
        whenDay: [ 0, 1, 2, 3, 4, 5, 6 ],
        /* only when her plan has her in the bathroom right now (Define Schedule), then always */
        requirements: [ "setup.npcIsAt('mom', 'bathroom')" ],
        chance: 100,
        cooldown: 0,
        once: false,
        active: true,
        finished: false,
        completedAtDay: 0,
    },
    {
    	id: 2,
        passage: "Sister Bathroom",
        returnPassage: "Hallway",
        where: ["Bathroom"],
        whenTime: [ 0, 1, 2, 3, 4, 5, 6 ],
        whenDay: [ 0, 1, 2, 3, 4, 5, 6 ],
        /* only when her plan has her in the bathroom right now (Define Schedule), then always */
        requirements: [ "setup.npcIsAt('sister', 'bathroom')" ],
        chance: 100,
        cooldown: 0,
        once: false,
        active: true,
        finished: false,
        completedAtDay: 0,
    },            
    {
    	id: 3,
        passage: "Mom Bed Masturbation",
        returnPassage: "Hallway",
        where: [ "Mom Room" ],
        whenTime: [ 5, ],
        whenDay: [ 0, 1, 4, 5, 6],
        chance: 25,
        cooldown: 0,
        once: false,
        active: false,
        finished: false,
        completedAtDay: 0,
    },            
    {
    	id: 4,
        passage: "Sister Bed Masturbation",
        returnPassage: "Hallway",
        where: [ "Sister Room" ],
        whenTime: [ 4, 5, ],
        whenDay: [ 0, 1, 2, 3, 4, 5, 6],
        /* she has to be in her room; the chance is set from her stats in PassageReady, like $events[3] */
        requirements: [ "setup.npcIsAt('sister', 'sisterroom')" ],
        chance: 10,
        cooldown: 0,
        once: false,
        active: false,
        finished: false,
        completedAtDay: 0,
    },
]>>

<<set $microEventActive = false>>

/* Micro-event fields:
   where        location names or sysNames where it can happen ("Kitchen", "My Desk")
   chance       percent per check, rolled each time a passage of that place renders
   oncePerDay   at most once a day
   apCooldown   actions that must pass (on the same day) before it can happen again
   dayCooldown  optional: days that must pass before it can happen again (2 = not tomorrow, the day after at the
                earliest). For everyday moments that would wear thin if they came back every day
   lastSeenDay / lastSeenAP   dayCount and action row (slot * 3 + action) it last happened
   visitor      optional: makes it a desk visitor instead of an inline event, see "Desk visitors" below

   Micro-event conditions:
   whenTime  slots 0 Early Morning, 1 Morning, 2 Noon, 3 Afternoon, 4 Evening, 5 Night, 6 Late Night (empty = any time)
   eval      list of functions, all must return true. Day-of-week (today.value 0-4 = Mon-Fri, 5-6 = weekend) and the
             NPC's presence (isHome / location.name) are checked here, always against the live State.variables.
   npc       "mom" / "sister" (a key, not a copy of the character), null if the event does not belong to one */
<<set $microEvents to [
