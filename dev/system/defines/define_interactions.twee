:: Define Interactions [system] {"position":"750,150","size":"100,100"}
/* ==========================================================================
   Everything the player can do with Mom or Sister on the "NPC Interaction" screen.

   $interactions.actions: every entry is one card on that screen
     id        unique key (also used for the once-per-day log)
     group     id of one of $interactions.groups
     text      button text
     hidden    true = never shown (not implemented yet)
     highlight true = the card stands out on the screen while it can be used (the end-of-day report)
     hideWhen  hides the card while her flags match, e.g. { isFollowing: true }
     who       optional list of the NPCs it is offered to, e.g. ["mom"] (default: both)
     requires  optional TwineScript condition, e.g. "setup.questDone('mom_nightVisit')": the card stays hidden
               until it is true (story unlocks; for stat thresholds use needs/max, which show a greyed-out card).
               {sysName} in it is replaced by hers ("mom" / "sister"): "setup.hasDayReport('{sysName}')"
     private   true = locked while anybody else is around: the other one of mom/sister in the same place, or the
               staff while I am in the office during work hours (setup.isOfficeWorkTime, Define Events)
     camera    location sysName from setup.cameraSpots (Define Items): asks her to hide a camera there.
               Only shown while the player has a camera and that spot has neither a camera nor a pending
               request. On success the camera goes to her (setup.requestCamera) and she hides it the next
               time she is there.
     lockWhen  greys the card out while the player's flags match: { playerFlags: { ... }, reason: "..." }
     cost      action points it uses
     money     optional money cost
     once      true = only once per day per person
     needs     minimum stats        { relation: 20, lust: 10 }
     max       maximum stats        { resistance: 40 }
     blocked   activities during which it is not possible (activity ids or bases, see Define Activities)
     only      optional list of activities it is limited to (ids or bases)
     effect    stat changes on success
     fail      stat changes on failure
     chance    optional chance to succeed in percent:
               base + sum(stat * weight) + sum(maxOfStat * weight), cut off at min (default 0) and max (default 100)
               { base: 30, min: 10, max: 90, stats: { relation: 0.5 }, maxStats: { resistance: 1 } }
     passage   optional passage name, the action then leads to a full scene
               {npc} = "Mom" / "Sister", {activityId} = the id of what she is doing right now
               While that passage doesn't exist or is still empty, the card is greyed out ("Not while she's ...")
     setFlags  the action does the whole thing itself: { npc: { flag: value }, player: { flag: value } }
     displayInformation / reload   only used together with setFlags
     scenes    short generated scene, one random entry is shown { mom: { success: [...], fail: [...] }, sister: { ... } }
               fail is optional (success is used then)
               scene   { narration: "...", msgs: [ { who: "player" | "npc", text: "..." }, { text: "narration line" } ], only: [activity ids] }
               {activity} in any text = what she is doing right now, as the player reads it ("watching TV")

   During The Silence every card with mom is locked (setup.interactionSilence, Define NPCs).

   Stat keys are the stat names of an NPC: relation, corruption, lust, resistance.
   In needs/max, corruption is her total over all stages (setup.corruptionTotal, Define NPCs): 40 is "40 in
   Stage 0" and stays met after a stage-up, "40 in Stage 1" is 140. In chance formulas it is
   setup.corruptionEffective (the bar plus a bonus per stage).
   ========================================================================== */
/* activities during which she can't be talked to at all; bring_coffee, internship_overview, flirt_duty and
   extra_friendly are tasks (her coffee round at the office, the overview meeting with me, her rounds with the
   staff, her time at the desk of the hardware guy), not moments for a chat */
   /* "bring_coffee", "internship_overview", "flirt_duty", "extra_friendly" */
<<set _busy to ["sleeping", "showering", "peeing", ]>>
<<set $interactions to {

	/* An action stays hidden while she is still too far from its requirements: when the stat points she is
	   missing (all "needs" added up, whichever stat) are more than this percentage of the stat points the action
	   requires in total. Closer than that, it shows up greyed out with its requirement. Change the number to taste:
	   0 = hidden until every requirement is met, 100 = always visible. */
	hideIfMissingPercent: 50,

	statLabels: { relation: "Relation", corruption: "Corruption", lust: "Lust", resistance: "Resistance" },

	/* in this order on the screen. The group report holds only her end-of-day report and stays empty (so hidden) on days
	   without one */
	groups: [
		{ id: "report", label: "Her day" },
		{ id: "social", label: "Social" },
		{ id: "flirt", label: "Flirt & tease" },
		{ id: "intimate", label: "Intimate" },
		{ id: "other", label: "Other" }
	],

	actions: [

		/* ———————————————————— Social ———————————————————— */
		{
			id: "talk", group: "social", text: "Chat with her", cost: 2,
			/* the talk scenes are named after her activity id: "Mom watching_tv", "Sister studying", ...
			   Mom showering/peeing are the walk-in scenes of the bathroom event, so the busy activities stay blocked */
			blocked: _busy,
			passage: "{npc} {activityId}"
		},
		{
			/* her end-of-day report (End-of-day report in Define NPCs): its own group at the top, at any time of day,
			   only while today has something she did not tell me yet. Not once a day:
			   whatever comes in later the same day brings it back. The passage applies the Relation (once a day) */
			id: "dayReport", group: "report", text: "How was your day?", cost: 1, highlight: true,
			requires: "setup.hasDayReport('{sysName}')",
			blocked: _busy,
			effect: { relation: 1 },
			passage: "Day Report"
		},
		{
			id: "askDay", group: "social", text: "Ask about her day", cost: 2, once: true,
			blocked: _busy,
			effect: { relation: 2 },
			scenes: {
				mom: {
					success: [
						{
							narration: "I pull up a chair and ask how she's holding up.",
							msgs: [
								{ who: "player", text: "How was your day? Really." },
								{ who: "npc", text: "Long. My feet hurt and the paperwork never ends. But it's fine." },
								{ who: "player", text: "It doesn't sound fine." },
								{ who: "npc", text: "It's fine now. Thank you for asking, honey." }
							]
						},
						{
							narration: "I sit down next to her and give her my full attention.",
							msgs: [
								{ who: "player", text: "Anything on your mind lately?" },
								{ who: "npc", text: "Money, mostly. Bills. And you two, of course. I worry." },
								{ who: "player", text: "You don't have to worry about me." },
								{ who: "npc", text: "That's not how being a $mom.relation works." }
								]
							},
							{
								narration: "I find her in a quiet moment and ask how she's really doing.",
								msgs: [
									{ who: "player", text: "Hey. How are you holding up?" },
									{ who: "npc", text: "Tired, honey. But hearing you ask makes it a little better." },
									{ who: "player", text: "You work too much." },
									{ who: "npc", text: "Someone has to. Now come here and sit with me a minute." }
								]
							},
							{
								narration: "I sit across from her while she's {activity} and ask about her day.",
								msgs: [
									{ who: "player", text: "Tell me something good that happened today." },
									{ who: "npc", text: "Something good? Hmm. Your $sister.relation did the dishes without me asking." },
									{ who: "player", text: "That's a miracle." },
									{ who: "npc", text: "I know. Mark it on the calendar. And thank you for asking, honey." }
							]
						}
					]
				},
				sister: {
					success: [
						{
							narration: "I ask her how things are going while she keeps doing what she's doing.",
							msgs: [
								{ who: "player", text: "How was your day?" },
								{ who: "npc", text: "Annoying. A professor assigned three things for the same week. Who does that?" },
								{ who: "player", text: "Sounds rough." },
								{ who: "npc", text: "It is. Anyway. Thanks for asking, I guess." }
							]
						},
						{
							narration: "I sit down nearby and ask her what's going on in her life.",
							msgs: [
								{ who: "player", text: "So what's new with you?" },
								{ who: "npc", text: "You're being suspiciously nice." },
								{ who: "player", text: "I'm just curious." },
								{ who: "npc", text: "Okay. Well, there's this girl in my class who..." },
								{ text: "She talks for a few minutes. I listen, nod in the right places, and she seems to enjoy having someone to talk to." }
								]
							},
							{
								narration: "I lean against the wall near her and ask how her day went.",
								msgs: [
									{ who: "player", text: "Survived the day?" },
									{ who: "npc", text: "Barely. Group projects are the worst." },
									{ who: "player", text: "Let me guess, you're doing all of it." },
									{ who: "npc", text: "Obviously. Thanks for noticing, though." }
								]
							},
							{
								narration: "I ask about her day, and for once she actually stops what she's doing to answer.",
								msgs: [
									{ who: "player", text: "So how's life treating you lately?" },
									{ who: "npc", text: "Weirdly okay. I think I aced that test." },
									{ who: "player", text: "Of course you did." },
									{ who: "npc", text: "Don't jinx it! But thanks. It's nice when you ask." }
							]
						}
					]
				}
			}
		},
		{
			id: "compliment", group: "social", text: "Compliment her", cost: 2, once: true,
			blocked: _busy,
			effect: { relation: 2 },
			fail: { resistance: 10 },
			chance: { base: -5, stats: { resistance: -1 }, maxStats: { resistance: 1 } },
			scenes: {
				mom: {
					success: [
						{
							narration: "I wait until she looks up from {activity} and tell her she looks great today.",
							msgs: [
								{ who: "player", text: "You look really good today, you know that?" },
								{ who: "npc", text: "Oh, stop it. I haven't even done my hair." },
								{ who: "player", text: "It looks great anyway." },
								{ who: "npc", text: "You're sweet. Don't think I don't know you're after something." }
							]
						},
						{
							narration: "I lean in the doorway and watch her for a moment before I speak.",
							msgs: [
								{ who: "player", text: "I don't say it enough, but you're amazing. Everything you do for this family." },
								{ who: "npc", text: "Where is this coming from?" },
								{ who: "player", text: "Nowhere. I just wanted you to know." },
								{ who: "npc", text: "Well. Thank you, honey. That meant a lot." }
								]
							},
							{
								narration: "I catch her eye and tell her something I've been meaning to say.",
								msgs: [
									{ who: "player", text: "That color looks great on you." },
									{ who: "npc", text: "This old thing? It's been in my closet forever." },
									{ who: "player", text: "Then it's about time you wore it more." },
									{ who: "npc", text: "Flatterer. ...Thank you, sweetheart." }
								]
							},
							{
								narration: "I stop beside her and speak softly.",
								msgs: [
									{ who: "player", text: "You're a lot stronger than you give yourself credit for." },
									{ who: "npc", text: "Strong? Some days I feel like I'm barely keeping up." },
									{ who: "player", text: "That's what strong looks like." },
									{ who: "npc", text: "Oh, come here. You're going to make me tear up." }
							]
						}
					],
					fail: [
						{
							narration: "I wait until she looks up from {activity} and tell her she looks great today.",
							msgs: [
								{ who: "player", text: "You look really good today, you know that?" },
								{ who: "npc", text: "What do you want now, $player.name?" },
								{ who: "player", text: "What? Nothing, I just thought to give you a quick compliment." },
								{ who: "npc", text: "You're after something... Don't try to fool me." }
							]
						},
						{
							narration: "I lean in the doorway and watch her for a moment before I speak.",
							msgs: [
								{ who: "player", text: "I don't say it enough, but you're amazing. Everything you do for this family." },
								{ who: "npc", text: "I don't feel like this is genuine?" },
								{ who: "player", text: "What do you mean?!" },
								{ who: "npc", text: "I don't have the time for this now." }
								]
							},
							{
								narration: "I tell her she looks good, but it comes out like an afterthought.",
								msgs: [
									{ who: "player", text: "Looking good, $mom.callName." },
									{ who: "npc", text: "You didn't even look up when you said that." },
									{ who: "player", text: "I meant it!" },
									{ who: "npc", text: "Sure you did, honey. Say it with a little more conviction next time." }
								]
							},
							{
								narration: "I try to compliment her, but she's clearly in no mood.",
								msgs: [
									{ who: "player", text: "You're really good at all this, you know." },
									{ who: "npc", text: "Good at what? Cleaning up after everyone?" },
									{ who: "player", text: "That's not what I meant." },
									{ who: "npc", text: "Not now, please. I'm tired." }
							]
						}
					]
				},
				sister: {
					success: [
						{
							narration: "I wait until she looks up from {activity} and tell her she looks good today.",
							msgs: [
								{ who: "player", text: "Nice outfit. Is that new?" },
								{ who: "npc", text: "Is that a compliment or are you broke and need something?" },
								{ who: "player", text: "Can't it be both?" },
								{ who: "npc", text: "Fine. Thanks. It's from last month, but I'll take it." }
							]
						},
						{
							narration: "I wait for a break in what she's doing and tell her something nice.",
							msgs: [
								{ who: "player", text: "You've been working really hard lately. I noticed." },
								{ who: "npc", text: "Okay, who are you and what did you do with my $sister.playerRelation?" },
								{ who: "player", text: "Just saying." },
								{ who: "npc", text: "Hm. Thanks. Don't make it weird." }
								]
							},
							{
								narration: "I stop next to her and look at her for a moment.",
								msgs: [
									{ who: "player", text: "Your hair looks good like that." },
									{ who: "npc", text: "Seriously? I just threw it up." },
									{ who: "player", text: "Then you're just annoyingly good at everything." },
									{ who: "npc", text: "Okay, that's the weirdest compliment ever, but I'll accept it." }
								]
							},
							{
								narration: "I wait until she looks up from {activity}.",
								msgs: [
									{ who: "player", text: "You're actually pretty smart, you know." },
									{ who: "npc", text: "Actually pretty? Gee, thanks." },
									{ who: "player", text: "Don't ruin it. I meant it." },
									{ who: "npc", text: "...Fine. That was nice. Don't let it go to your head." }
							]
						}
					],
					fail: [
						{
							narration: "I wait until she looks up from {activity} and tell her she looks good today.",
							msgs: [
								{ who: "player", text: "Nice outfit. Is that new?" },
								{ who: "npc", text: "Is that a compliment or are you broke and need something?" },
								{ who: "player", text: "Can't it be both?" },
								{ who: "npc", text: "Stop, you're weirding me out..." }
							]
						},
						{
							narration: "I wait for a break in what she's doing and tell her something nice.",
							msgs: [
								{ who: "player", text: "You've been working really hard lately. I noticed." },
								{ who: "npc", text: "Okay? What are you suggesting?" },
								{ who: "player", text: "Just saying." },
								{ who: "npc", text: "Yeah, whatever..." }
								]
							},
							{
								narration: "I stop next to her and look at her for a moment.",
								msgs: [
									{ who: "player", text: "Your hair looks good like that." },
									{ who: "npc", text: "Did you lose a bet?" },
									{ who: "player", text: "No! It's a compliment." },
									{ who: "npc", text: "Then it's a weird one. Bye." }
								]
							},
							{
								narration: "I wait until she looks up from {activity}.",
								msgs: [
									{ who: "player", text: "You're actually pretty smart, you know." },
									{ who: "npc", text: "Actually pretty? Wow." },
									{ who: "player", text: "That came out wrong." },
									{ who: "npc", text: "Yeah, it did. Try again never." }
							]
						}
					]
				}
			}
		},
		{
			id: "treat", group: "social", text: "Get her a treat", cost: 1, once: true, money: 35,
			blocked: _busy,
			effect: { relation: 4 },
			scenes: {
				mom: {
					success: [
						{
							narration: "I pick up a few things she likes and put them in front of her.",
							msgs: [
								{ who: "player", text: "I got you something." },
								{ who: "npc", text: "You didn't have to spend money on me. You're always short." },
								{ who: "player", text: "It's not much. Just take it." },
								{ who: "npc", text: "Thank you. Really. That was thoughtful." }
								]
							},
							{
								narration: "I set a cup of coffee next to her, just the way she likes it.",
								msgs: [
									{ who: "player", text: "Fresh coffee. Two sugars, a bit of milk." },
									{ who: "npc", text: "You remembered how I take it?" },
									{ who: "player", text: "Of course I did." },
									{ who: "npc", text: "Thank you, honey. You have no idea how much I needed this." }
								]
							},
							{
								narration: "I bring her a small box from the bakery.",
								msgs: [
									{ who: "player", text: "Don't ask what it cost. Just eat." },
									{ who: "npc", text: "Honey, we can't really afford..." },
									{ who: "player", text: "It's one pastry, $mom.callName." },
									{ who: "npc", text: "Then I'm going to enjoy every bite. Thank you." }
							]
						}
					]
				},
				sister: {
					success: [
						{
							narration: "I drop a small bag next to her.",
							msgs: [
								{ who: "player", text: "Here. Your favorite." },
								{ who: "npc", text: "Wait, you remembered? What do you want?" },
								{ who: "player", text: "Nothing. Just enjoy it." },
								{ who: "npc", text: "Okay, now I'm suspicious. But also thanks. Seriously." }
								]
							},
							{
								narration: "I toss a chocolate bar onto her lap.",
								msgs: [
									{ who: "player", text: "Catch." },
									{ who: "npc", text: "Ooh, the good chocolate. What did you break?" },
									{ who: "player", text: "Nothing! Can't I just be nice?" },
									{ who: "npc", text: "You can. You just never are. Thanks, though." }
								]
							},
							{
								narration: "I put her favorite drink down next to her.",
								msgs: [
									{ who: "player", text: "Thought you could use this." },
									{ who: "npc", text: "Is this a bribe?" },
									{ who: "player", text: "It's a gift." },
									{ who: "npc", text: "Gifts are better when they're a bribe. Thanks, dummy." }
							]
						}
					]
				}
			}
		},
		{
			id: "help", group: "social", text: "Help her out", cost: 3, once: true,
			only: ["cooking", "doing_chores", "studying"],
			effect: { relation: 3 },
			scenes: {
				mom: {
					success: [
						{
							narration: "I roll up my sleeves and join her. We work side by side for a while.",
							msgs: [
								{ who: "player", text: "Give me something to do. I'm not just going to stand here." },
								{ who: "npc", text: "Well, if you insist. Take this one." },
								{ who: "player", text: "Like this?" },
								{ who: "npc", text: "Perfect. See? You're good at this when you try." }
								]
							},
							{
								narration: "I step up beside her and take over part of what she's doing without being asked.",
								msgs: [
									{ who: "player", text: "You look like you could use a second pair of hands." },
									{ who: "npc", text: "You don't have to do that." },
									{ who: "player", text: "I know. Move over." },
									{ who: "npc", text: "Okay, okay. Thank you. It's nice having you here." }
								]
							},
							{
								narration: "I ask what needs doing and get started before she can protest.",
								msgs: [
									{ who: "player", text: "Tell me what to do and I'll do it." },
									{ who: "npc", text: "You've never offered this before. Are you feeling alright?" },
									{ who: "player", text: "$mom.callName." },
									{ who: "npc", text: "Alright, alright. Start with that one. And thank you, honey." }
							]
						}
					]
				},
				sister: {
					success: [
						{
							narration: "I pull up a chair next to her and take over part of the job.",
							msgs: [
								{ who: "player", text: "Give me half. I'll handle it." },
								{ who: "npc", text: "Why are you being so weird?" },
								{ who: "player", text: "I'm being helpful." },
								{ who: "npc", text: "Same thing, apparently. ...Thanks. Really." }
							]
						},
						{
							narration: "I take something off her pile without asking.",
							msgs: [
								{ who: "player", text: "I've got this one. Don't argue." },
								{ who: "npc", text: "I wasn't going to. I'm just surprised." },
								{ who: "player", text: "Don't get used to it." },
								{ who: "npc", text: "Oh, I won't. But thanks, seriously." }
							]
						},
						{
							only: ["studying"],
							narration: "I sit down next to her and help with the notes for a while.",
							msgs: [
								{ who: "player", text: "Need a hand?" },
								{ who: "npc", text: "Wow. Voluntarily? Who are you?" },
								{ who: "player", text: "Do you want help or not?" },
								{ who: "npc", text: "Yes. Fine. Thanks. This actually goes faster with two people." }
							]
						},
						{
							only: ["cooking", "doing_chores"],
							narration: "I sit down next to her and help with the work for a while.",
							msgs: [
								{ who: "player", text: "Need a hand?" },
								{ who: "npc", text: "Wow. Voluntarily? Who are you?" },
								{ who: "player", text: "Do you want help or not?" },
								{ who: "npc", text: "Yes. Fine. Thanks. This actually goes faster with two people." }
							]
						}
					]
				}
			}
		},

		/* ———————————————————— Flirt & tease ———————————————————— */
		{
			id: "flirt", group: "flirt", text: "Flirt with her", cost: 2, once: true,
			needs: { relation: 20, corruption: 5 },
			blocked: _busy,
			effect: { lust: 3, corruption: 1, relation: 1 },
			fail: { relation: -3, resistance: 10 },
			chance: { base: 30, min: 10, max: 90, stats: { relation: 0.5, lust: 0.5, resistance: -0.7 } },
			scenes: {
				mom: {
					success: [
						{
							narration: "I let my voice drop a little and hold her gaze until she's the one who looks away.",
							msgs: [
								{ who: "player", text: "You know, you don't look like anyone's $mom.relation when you smile like that." },
								{ who: "npc", text: "$player.name! You can't say things like that." },
								{ who: "player", text: "It's only the truth." },
								{ text: "She laughs and looks away, but she's blushing, and she doesn't tell me to stop." }
								]
							},
							{
								narration: "I step into her space and let a slow smile show.",
								msgs: [
