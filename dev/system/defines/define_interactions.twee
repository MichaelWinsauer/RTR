}>>

/* Talk scene variants ==========================================================
   The talk scenes ("Chat with her", passages "{npc} {activityId}") pick one of several variants. A passage builds
   the list of variants that fit right now (some need a story step or a corruption stage) and lets this pick one,
   never the one it showed last time when there is another.
   $talkScenes                      { passage name: the variant shown last }
   setup.pickTalkScene(key, list)   one entry of list (numbers), remembered under key */
<<set $talkScenes to {}>>
<<set setup.pickTalkScene = (key, list) => {
    const v = State.variables;
    const fresh = list.filter((n) => n !== v.talkScenes[key]);
    const pick = (fresh.length ? fresh : list).random();
    v.talkScenes[key] = pick;
    return pick;
}>>
<<script>>
(function () {
	'use strict';

	function data() { return State.variables.interactions; }

	function def(id) {
		return data().actions.filter(function (a) { return a.id === id; })[0];
	}

	function log(npc) {
		if (!npc.interactionLog) { npc.interactionLog = {}; }
		return npc.interactionLog;
	}

	/* money comes from the wallet in stage 0 and from the company account afterwards (same as the rent) */
	function funds() {
		var v = State.variables;
		return v.company.stage === 0 ? v.player.money : v.company.finances.money;
	}
	function pay(amount) {
		var v = State.variables;
		if (v.company.stage === 0) { v.player.money -= amount; } else { v.company.finances.money -= amount; }
	}

	/* true when every flag of the object has the given value */
	function flagsMatch(flags, wanted) {
		return Object.keys(wanted || {}).every(function (k) { return !!flags[k] === wanted[k]; });
	}

	/* {npc}, {sysName}, {activity} and {activityId} in passage names, requires and scene texts */
	function fill(text, npc) {
		return String(text)
			.replace(/\{npc\}/g, npc.sysName === 'mom' ? 'Mom' : 'Sister')
			.replace(/\{sysName\}/g, npc.sysName)
			.replace(/\{activityId\}/g, npc.activity || '')
			.replace(/\{activity\}/g, setup.activityText(npc, npc.activity));
	}

	/* true when the scene passage of an action exists and has text: a missing or still empty one (a placeholder
	   for an activity nobody has written a scene for yet) would be a dead end, so the card is greyed out instead */
	function hasScene(name) {
		return Story.has(name) && Story.get(name).text.trim() !== '';
	}

	/* her value of a stat for the needs/max checks: corruption counts as the total over all her stages
	   (stage * 100 + bar, "Corruption stages" in Define NPCs), so a stage-up never locks an action again */
	function needValue(npc, k) {
		return k === 'corruption' ? setup.corruptionTotal(npc) : npc.stats[k];
	}

	/* how a needed value reads on a locked card ("Corruption 40 (stage 1)") */
	function needText(k, value) {
		return k === 'corruption' ? setup.corruptionNeedText(value) : String(value);
	}

	/* her value of a stat inside a chance formula: corruption with the per-stage bonus (setup.corruptionEffective) */
	function chanceValue(npc, k) {
		return k === 'corruption' ? setup.corruptionEffective(npc) : npc.stats[k];
	}

	/* chance to succeed in percent, see the description at the top */
	function chanceOf(chance, npc) {
		var v = chance.base || 0;
		Object.keys(chance.stats || {}).forEach(function (k) { v += chanceValue(npc, k) * chance.stats[k]; });
		Object.keys(chance.maxStats || {}).forEach(function (k) { v += npc.stats.max[k] * chance.maxStats[k]; });
		return Math.max(chance.min || 0, Math.min(chance.max === undefined ? 100 : chance.max, v));
	}

	/* one random scene that fits the situation, with the speakers and placeholders filled in */
	function buildScene(action, npc, success) {
		var set = (action.scenes || {})[npc.sysName];
		if (!set) { return { narration: '', msgs: [] }; }
		var pool = (success ? set.success : (set.fail || set.success)) || [];
		pool = pool.filter(function (s) { return !s.only || setup.activityIs(npc, npc.activity, s.only); });
		if (!pool.length) { return { narration: '', msgs: [] }; }

		var scene = either(pool);
		var speakers = { player: State.variables.player, npc: npc };
		return {
			narration: scene.narration ? fill(scene.narration, npc) : '',
			msgs: scene.msgs.map(function (m) {
				var msg = { text: fill(m.text, npc) };
				if (m.who) { msg.who = speakers[m.who]; }
				return msg;
			})
		};
	}

	/* null when nobody else is around (action.private), otherwise who is */
	function privacyIssue(npc) {
		var v = State.variables;
		var other = ['mom', 'sister'].filter(function (k) { return k !== npc.sysName; })
			.map(function (k) { return v[k]; })
			.filter(function (o) { return o && o.location && setup.sameLocation(o.location, v.player.location); })[0];
		if (other) { return 'Not with ' + other.callName + ' right here.'; }
		if (setup.isOfficeWorkTime() && setup.sameLocation(v.player.location, setup.getLocationBySysName('companystage1'))) {
			return 'Not with the whole office around.';
		}
		return null;
	}

	/* an action with "requires" stays hidden until its TwineScript condition is true ({sysName} is hers) */
	function unlocked(action, npc) {
		if (!action.requires) { return true; }
		try { return !!Scripting.evalTwineScript(fill(action.requires, npc)); }
		catch (e) { console.error('Interaction "' + action.id + '": requires failed: ' + e.message); return false; }
	}

	/* null when the action is possible right now, otherwise a short reason for the greyed-out card */
	setup.interactionLockReason = function (npc, action) {
		var labels = data().statLabels;
		/* The Silence: I am not talking to her at all (Define NPCs) */
		var silence = setup.interactionSilence(npc);
		if (silence) { return silence; }
		if (action.once && log(npc)[action.id] === State.variables.date.dayCount) { return 'Already done today.'; }
		if (action.blocked && setup.activityIs(npc, npc.activity, action.blocked)) { return 'Not while she\'s ' + setup.activityText(npc, npc.activity) + '.'; }
		if (action.only && !setup.activityIs(npc, npc.activity, action.only)) { return "It's not the right moment..."; }
		if (action.passage && !hasScene(fill(action.passage, npc))) { return 'Not while she\'s ' + setup.activityText(npc, npc.activity) + '.'; }
		if (action.lockWhen && flagsMatch(State.variables.player.flags, action.lockWhen.playerFlags)) { return action.lockWhen.reason; }
		if (action.private) {
			var company = privacyIssue(npc);
			if (company) { return company; }
		}

		var needs = [];
		Object.keys(action.needs || {}).forEach(function (k) {
			if (needValue(npc, k) < action.needs[k]) { needs.push(labels[k] + ' ' + needText(k, action.needs[k])); }
		});
		Object.keys(action.max || {}).forEach(function (k) {
			if (needValue(npc, k) > action.max[k]) { needs.push(labels[k] + ' ' + needText(k, action.max[k]) + ' or lower'); }
		});
		if (needs.length) { return 'Needs ' + needs.join(', ') + '.'; }

		if (action.money && funds() < action.money) { return 'Costs $' + action.money + '.'; }
		return null;
	};

	/* short line under the title of a card: what it costs and what it changes */
	setup.describeInteraction = function (action) {
		var labels = data().statLabels;
		var parts = action.cost ? [action.cost + (action.cost === 1 ? ' action' : ' actions')] : [];
		if (action.money) { parts.push('$' + action.money); }
		if (action.camera) { parts.push('1 camera (' + setup.itemCount('camera') + ' owned)'); }
		Object.keys(action.effect || {}).forEach(function (k) {
			parts.push((action.effect[k] > 0 ? '+' : '−') + labels[k]);
		});
		return parts.join(' · ');
	};

	/* true while the stat points she is missing are more than hideIfMissingPercent of what the action requires (the card stays hidden) */
	setup.interactionTooFarAway = function (npc, action) {
		var required = 0, missing = 0;
		Object.keys(action.needs || {}).forEach(function (k) {
			required += action.needs[k];
			missing += Math.max(0, action.needs[k] - needValue(npc, k));
		});
		return required > 0 && (missing / required) * 100 > data().hideIfMissingPercent;
	};

	/* every action for this person with the reason it is locked (null = available) */
	setup.getInteractionOptions = function (npc) {
		return data().actions
			.filter(function (action) { return !action.hidden && !(action.hideWhen && flagsMatch(npc.flags, action.hideWhen)); })
			.filter(function (action) { return !action.who || action.who.includes(npc.sysName); })
			.filter(function (action) { return unlocked(action, npc); })
			.filter(function (action) {
				return !action.camera || (setup.itemCount('camera') > 0 && !setup.hasCamera(action.camera) && !setup.cameraPending(action.camera));
			})
			.filter(function (action) { return !setup.interactionTooFarAway(npc, action); })
			.map(function (action) {
				return {
					action: action,
					text: action.text,
					reason: setup.interactionLockReason(npc, action)
				};
			});
	};

	/* Runs an action: pays, logs, rolls success. Returns what the screen has to show and apply. */
	setup.performInteraction = function (id, key) {
		var v = State.variables;
		var npc = v[key];
		var action = def(id);
		if (!action || !unlocked(action, npc) || setup.interactionLockReason(npc, action)) { return null; }

		if (action.money) { pay(action.money); }
		if (action.once) { log(npc)[action.id] = v.date.dayCount; }

		var result = { cost: action.cost, passage: null, handled: false, narration: '', msgs: [], deltas: [], success: true };
		var changes = action.effect || {};

		if (action.chance) {
			result.success = Math.random() * 100 < chanceOf(action.chance, npc);
			if (!result.success) { changes = action.fail || {}; }
		}

		Object.keys(changes).forEach(function (stat) {
			result.deltas.push([key + stat, changes[stat] > 0 ? '+' : '-', Math.abs(changes[stat])]);
		});

		if (action.camera) { setup.requestCamera(key, action.camera); }

		if (action.setFlags) {
			result.handled = true;
			Object.assign(npc.flags, action.setFlags.npc);
			Object.assign(v.player.flags, action.setFlags.player);
			if (action.displayInformation !== undefined) { v.displayInformation = action.displayInformation; }
			if (action.reload) {
				/* after the click has finished: replaying the passage right here would clear the temporary variables of the running link */
				setTimeout(function () { Engine.play(State.active.title, null, 'back'); }, 0);
			}
		} else if (action.passage) {
			result.passage = fill(action.passage, npc);
		} else if (action.scenes) {
			var scene = buildScene(action, npc, result.success);
			result.narration = scene.narration;
			result.msgs = scene.msgs;
		}
		return result;
	};

	/* one line about how she seems right now, from her energy and morale */
	setup.npcMood = function (npc) {
		if (npc.stats.energy < 30) { return 'She looks exhausted.'; }
		if (npc.stats.morale < 30) { return 'She seems down.'; }
		if (npc.stats.energy > 80 && npc.stats.morale > 80) { return 'She seems to be in a good mood.'; }
		return '';
	};
})();
<</script>>
