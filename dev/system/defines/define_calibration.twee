:: Define Calibration [system] {"position":"500,150","size":"100,100"}
/* What the calibration minigame (CalibrateDevice) looks like for each target.
   The key is the calibration preset chosen on the device (mom, sister, low, high, wide, small, ...).
   A preset without an entry here uses "default", so a new target only needs a new entry.

   npc        who is being calibrated ("mom" / "sister"), null if nobody. Their resistance and corruption
              are read live when the minigame starts.
   time       seconds for the minigame. Their resistance makes it shorter (down to 20 seconds).
   phrases    one list of phrases per corruption stage. {player} is replaced with the player's name,
              {relation} with what the player is to the target (her playerRelation, e.g. "brother").
              Plain characters only: the player has to type them. The longer phrases are used when resistance is high.
   stageAt    corruption needed to reach stage 0, 1, 2, ...
   wave       the target's waveform signature:
                freq / amp   [lowest, highest] slider step the target can sit on (freq 0-4, amp 0-6)
                harmonic     0 = smooth, higher = spikier
                speed        how fast the wave moves */
<<set $calibrationProfiles to {
	default: {
		npc: null,
		time: 35,
		stageAt: [ 0 ],
		phrases: [
			[
				"I trust {player} completely",
				"{player} knows what is best for me",
				"I feel safe when {player} is in control"
			]
		],
		wave: { freq: [ 0, 4 ], amp: [ 0, 6 ], harmonic: 0, speed: 1 }
	},

	mom: {
		npc: "mom",
		time: 38,
		stageAt: [ 0, 20, 55 ],
		phrases: [
			[
				"my family comes first",
				"I only want {player} to be happy",
				"I worry about {player} too much",
				"I will always be there for {player}"
			],
			[
				"I can always count on {player}",
				"{player} understands me better than anyone",
				"I feel better when {player} is near",
				"it is easy to say yes to {player}"
			],
			[
				"I trust {player} completely",
				"{player} knows what is best for me",
				"I feel safe when {player} is in control"
			]
		],
		wave: { freq: [ 0, 2 ], amp: [ 1, 4 ], harmonic: 0, speed: 0.75 }
	},

	sister: {
		npc: "sister",
		time: 32,
		stageAt: [ 0, 20, 55 ],
		phrases: [
			[
				"my {relation} has my back",
				"I am proud of {player}",
				"{player} is my favorite person to annoy",
				"I can tell {player} anything"
			],
			[
				"I trust {player} with everything",
				"{player} always knows what to say",
				"I feel calm when {player} is around",
				"I would do anything to help {player}"
			],
			[
				"I trust {player} completely",
				"{player} knows what is best for me",
				"I feel safe when {player} is in control"
			]
		],
		wave: { freq: [ 2, 4 ], amp: [ 2, 6 ], harmonic: 0.35, speed: 1.3 }
	}
}>>

/* Preset labels ===============================================================
   setup.presetLabel(key)   what to show for a calibration preset or a lastUsedOnWho key:
                            a character's callName when the key is one ("mom" -> $mom.callName),
                            otherwise the capitalised key ("general" -> "General"). */
<<set setup.presetLabel = (key) => {
    const npc = State.variables[key];
    if (npc && typeof npc === "object" && npc.callName) { return npc.callName; }
    return capitalize(key);
}>>
