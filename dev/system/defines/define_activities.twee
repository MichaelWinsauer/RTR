<<set setup.getActivity = (who, id) => {
    const sysName = (who && typeof who === "object") ? who.sysName : who;
    if (!id) { return undefined; }
    const activity = (setup.activities[sysName] || {})[id];
    if (!activity) { console.error('setup.getActivity: "' + sysName + '" has no activity "' + id + '"'); }
    return activity;
}>>

<<set setup.getNpcActivity = (npc) => {
    return npc ? setup.getActivity(npc, npc.activity) : undefined;
}>>

<<set setup.activityByStage = (who, byStage) => {
    if (!byStage || typeof byStage !== "object") { return undefined; }
    const stage = setup.corruptionStage(who);
    const keys = Object.keys(byStage).map(Number).filter((key) => key <= stage);
    return keys.length ? byStage[Math.max(...keys)] : undefined;
}>>

<<set setup.activityText = (who, id) => {
    const activity = setup.getActivity(who, id);
    if (!activity) { return id || ""; }
    const text = setup.activityByStage(who, activity.stageText) || activity.text;
    return text.includes("$") ? wikifyText(text) : text;
}>>

<<set setup.activityIs = (who, id, list) => {
    if (!id || !Array.isArray(list)) { return false; }
    const activity = setup.getActivity(who, id);
    return list.includes(id) || !!(activity && activity.base && list.includes(activity.base));
}>>

<<set setup.getActivitiesForLocation = (who, location) => {
    const sysName = (who && typeof who === "object") ? who.sysName : who;
    return Object.values(setup.activities[sysName] || {}).filter((activity) =>
        (activity.locations || []).some((loc) => setup.sameLocation(loc, location))
    );
}>>

<<set setup.activityMedia = (who, id, kind, random) => {
    const sysName = (who && typeof who === "object") ? who.sysName : who;
    const activity = setup.getActivity(sysName, id);
    if (!activity) { return ""; }
    let folder = "activities";
    /* a stage list that is still empty falls back to the plain list */
    const nonEmpty = (list) => (Array.isArray(list) && list.length ? list : undefined);
    let files = nonEmpty(setup.activityByStage(sysName, activity.stageMedia)) || activity.media || [];
    const cctv = nonEmpty(setup.activityByStage(sysName, activity.stageCctv)) || activity.cctv || [];
    if (kind === "cctv" && cctv.length) {
        folder = "tasks";
        files = cctv;
    }
    if (!files.length) { return ""; }

    const v = State.variables;
    const row = v.time.current.value * v.time.actions.max + (v.time.actions.max - v.time.actions.left);
    const index = random ? Math.floor(Math.random() * files.length) : ((Number(v.date.dayCount) || 0) * 21 + row) % files.length;
    return "images/characters/" + sysName + "/" + folder + "/" + files[index];
}>>
