/* Name-dependent fields =======================================================
   setup.syncNameFields()   rebuilds every field that is made from another character's name or relation
                            (the sister's callPlayer, the client surnames, "<Mom>'s boss", the dad's relation, ...).
   The values above are only the defaults at StoryInit. Character Configuration and Skip Intro call this
   once the player has picked the names, so a renamed character never shows the default name. */
<<set setup.syncNameFields = () => {
    const v = State.variables;
    v.sister.callPlayer = v.player.name;
    v.dad.surname = v.player.surname;
    v.dad.playerRelation = v.mom.playerRelation;
    v.dad.callPlayer = v.mom.playerRelation;
    v.boss.callPlayer = v.player.surname;
    v.prof.callPlayer = v.player.surname;
    v.manager.callPlayer = v.player.surname;
    v.boss.relation = v.mom.callName + "'s boss";
    v.prof.relation = v.sister.callName + "'s professor";
    v.bestFriend.relation = v.sister.callName + "'s best friend";
    /* her short name for me: bro, or whatever the player renamed the relation to */
    v.sister.callPlayerShort = String(v.sister.playerRelation).toLowerCase() === "brother" ? "bro" : v.sister.playerRelation;
    /* the mail addresses are made from the names too (N.Howell@..., victor.anderson@...) */
    const addr = (text) => String(text).replace(/\s+/g, "");
    v.landlord.mailAddress = addr(v.landlord.name.charAt(0) + "." + v.landlord.surname) + "@landlord.to";
    v.boss.mailAddress = addr(v.boss.name + "." + v.boss.surname).toLowerCase() + "@business.to";
    v.prof.mailAddress = addr(v.prof.surname + "." + v.prof.name.charAt(0)).toLowerCase() + "@yahoo.com";
    v.manager.mailAddress = addr(v.manager.name + "-" + v.manager.surname).toLowerCase() + "@diner.to";
}>>



/* Corruption stages ===========================================================
   The corruption of mom and sister (stats.corruption, 0-100) is the progress inside her current stage;
   $mom.corruptionStage / $sister.corruptionStage is the stage she is in (0 at the start). The bar stops at
   its max: 100 means she is ready, and points above that are lost, so grinding stops paying and the story
   has to move on. A milestone scene moves her up with <<AdvanceCorruptionStage $mom>> (Profile Widgets):
   stage +1, the bar back to 0, a notification and an entry in her Progression log.

   setup.corruptionStages.<sysName> = [ { name, milestone }, ... ]   constants, one entry per stage
       name        short label for the sidebar, the profile and the CMD
       milestone   id of the quest whose scene leads INTO this stage, null while that is not decided. Only
                   read by the UI and the help page; the scene itself calls <<AdvanceCorruptionStage>>
       To add a stage, add an entry (and a milestone scene). She can only move up into a stage that has an
       entry, so a full bar in the last stage does not count as ready.

   Checks never read stats.corruption directly. They use one of these two:
   setup.corruptionTotal(who)       stage * 100 + corruption, for thresholds. The Stage 0 checks keep their
                                    numbers (30, 40, 60, 75) and stay true after a stage-up; new content
                                    counts higher ("stage 1, 40" is 140). Quests, task stages, interaction
                                    needs/max, camera spots, calibration phrases, text variants.
   setup.corruptionEffective(who)   corruption + stage * $statInfluence.corruptionPerStage, for formulas
                                    (daily lust and resistance drift, chances), so a stage-up does not
                                    drop them and the raw total of 100+ does not blow them up.

   setup.corruptionStage(who)                 her stage number
   setup.corruptionStageInfo(who [, stage])   the entry of that stage (default: hers), or undefined
   setup.corruptionStageName(who)             the name of her stage ("" if it has none)
   setup.corruptionReady(who)                 the bar is full and there is a next stage
   setup.corruptionLabel(who)                 "Corruption · <name>" plus " · ready": the label of her bar
   setup.corruptionNeedText(total)            a total as the player reads it: 40 -> "40", 140 -> "40 (stage 1)"
   setup.advanceCorruptionStage(who)          the stage-up itself (the widget calls it), false without a next stage
   who is "mom" / "sister" or the NPC object. Anyone else counts as stage 0 with their plain corruption. */
/* STAGE1-STUB: the names of stages 2 and 3 (and her Yearning) are the working names from STAGE1_PROPOSAL.md.
   main_catalystNight is the milestone of both into stage 2 (one event, two parts) */
<<set setup.corruptionStages to {
    mom: [
        { name: "Reserved", milestone: null },
        { name: "Dutiful", milestone: "mom_briefing" },
        { name: "Willing", milestone: "main_catalystNight" },
        { name: "Complicit", milestone: "mom_calendar" },
    ],
    sister: [
        { name: "Conflicted", milestone: null },
        { name: "Yearning", milestone: "sister_souvenirs" },
        { name: "Devoted", milestone: "main_catalystNight" },
        { name: "Mine", milestone: "sister_everything" },
    ],
}>>

<<set setup.corruptionNpc = (who) => {
    if (who && typeof who === "object") { return State.variables[who.sysName] || who; }
    return State.variables[who];
}>>

<<set setup.corruptionStage = (who) => {
    const npc = setup.corruptionNpc(who);
    return npc ? (Number(npc.corruptionStage) || 0) : 0;
}>>

<<set setup.corruptionStageInfo = (who, stage) => {
    const npc = setup.corruptionNpc(who);
    if (!npc) { return undefined; }
    const list = setup.corruptionStages[npc.sysName] || [];
    return list[stage === undefined ? setup.corruptionStage(npc) : stage];
}>>

<<set setup.corruptionStageName = (who) => {
    const info = setup.corruptionStageInfo(who);
    return info ? info.name : "";
}>>

<<set setup.corruptionTotal = (who) => {
    const npc = setup.corruptionNpc(who);
    if (!npc || !npc.stats) { return 0; }
    return setup.corruptionStage(npc) * 100 + (Number(npc.stats.corruption) || 0);
}>>

<<set setup.corruptionEffective = (who) => {
    const npc = setup.corruptionNpc(who);
    if (!npc || !npc.stats) { return 0; }
    const perStage = Number(State.variables.statInfluence.corruptionPerStage) || 0;
    return (Number(npc.stats.corruption) || 0) + setup.corruptionStage(npc) * perStage;
}>>

<<set setup.corruptionReady = (who) => {
    const npc = setup.corruptionNpc(who);
    if (!npc || !npc.stats) { return false; }
    const full = npc.stats.corruption >= npc.stats.max.corruption;
    /* only ready when the next stage has a milestone scene that can take her there (the sister has none yet) */
    const next = setup.corruptionStageInfo(npc, setup.corruptionStage(npc) + 1);
    return full && !!next && !!next.milestone;
}>>

<<set setup.corruptionLabel = (who) => {
    const name = setup.corruptionStageName(who);
    let label = "Corruption";
    if (name) { label += " · " + name; }
    if (setup.corruptionReady(who)) { label += " · ready"; }
    return label;
}>>

<<set setup.corruptionNeedText = (total) => {
    const stage = Math.floor(Number(total) / 100);
    return stage > 0 ? (Number(total) - stage * 100) + " (stage " + stage + ")" : String(total);
}>>

<<set setup.advanceCorruptionStage = (who) => {
    const npc = setup.corruptionNpc(who);
    if (!npc || !npc.stats) { return false; }
    const next = setup.corruptionStage(npc) + 1;
    if (!setup.corruptionStageInfo(npc, next)) {
        console.error("setup.advanceCorruptionStage: " + npc.sysName + " has no corruption stage " + next + " (setup.corruptionStages)");
        return false;
    }
    npc.corruptionStage = next;
    npc.stats.corruption = npc.stats.min.corruption;
    return true;
}>>



/* Feelings ====================================================================
   How mom or sister feels about one person: anyone with a story variable, the player too (STAGE1_PROPOSAL.md
   3.6). It never blocks anything, it only colors: a scene, a POV passage or a report line can read it and pick a
   variant where there is a natural spot for one. Keys are sysNames ("boss", "ethan", "player"), so renaming a
   character changes nothing.

   $mom.feelings / $sister.feelings = { <sysName>: { mood: n, floor: n } }
       mood    what she feels right now, from -setup.feelingRange to +setup.feelingRange. setup.feels reads it
       floor   where the mood settles again: every night the mood moves one step toward it
   A plain change only moves the mood, so it fades over the next days. A "lasting" change moves the floor too
   (and the mood with it), for the big moments: what the boss did at the handover stays.

   <<Feel $mom "boss" -2 ["lasting"]>>       in a scene (Profile Widgets), prints nothing
   setup.feel(who, key, amount [, lasting])  the same from code, e.g. in a task onComplete
   setup.feels(who, key)                     her mood toward key, 0 while she has no feelings about them
   setup.feelsLabel(who, key)                a few words for it: "can't stand him", "wary of her", "fond of you"
   setup.feelingsList(who)                   [{ key, name, value, label }] of everyone she feels something about
                                             right now, strongest first (the Feelings tab of her profile)
   setup.feelingsDaily()                     Daily Update: every mood one step toward its floor
   who is "mom" / "sister" or the NPC object, like the corruption helpers. */
<<set $mom.feelings to {}>>
<<set $sister.feelings to {}>>

<<set setup.feelingRange to 10>>

/* the first entry whose min the value reaches wins. {o} is him, her, you or them */
<<set setup.feelingLabels to [
    { min: 7,   text: "drawn to {o}" },
    { min: 4,   text: "very fond of {o}" },
    { min: 2,   text: "fond of {o}" },
    { min: 1,   text: "likes {o}" },
    { min: 0,   text: "no strong feelings" },
    { min: -1,  text: "a little uneasy around {o}" },
    { min: -3,  text: "wary of {o}" },
    { min: -6,  text: "resents {o}" },
    { min: -99, text: "can't stand {o}" },
]>>

<<set setup.feel = (who, key, amount, lasting) => {
    const npc = setup.corruptionNpc(who);
    if (!npc || !key) { console.error("setup.feel: unknown character or key", who, key); return; }
    if (!npc.feelings) { npc.feelings = {}; }
    const range = setup.feelingRange;
    if (!npc.feelings[key]) { npc.feelings[key] = { mood: 0, floor: 0 }; }
    const f = npc.feelings[key];
    const n = Number(amount) || 0;
    if (lasting === true || lasting === "lasting") { f.floor = Math.clamp(f.floor + n, -range, range); }
    f.mood = Math.clamp(f.mood + n, -range, range);
}>>

<<set setup.feels = (who, key) => {
    const npc = setup.corruptionNpc(who);
    const f = npc && npc.feelings ? npc.feelings[key] : undefined;
    return f ? (Number(f.mood) || 0) : 0;
}>>

<<set setup.feelsLabel = (who, key) => {
    const value = setup.feels(who, key);
    const entry = setup.feelingLabels.find((l) => value >= l.min);
    const target = State.variables[key];
    let pronoun = "them";
    if (key === "player") { pronoun = "you"; }
    else if (target && target.gender === "female") { pronoun = "her"; }
    else if (target && target.gender === "male") { pronoun = "him"; }
    return entry.text.replace("{o}", pronoun);
}>>

<<set setup.feelingsList = (who) => {
    const npc = setup.corruptionNpc(who);
    if (!npc || !npc.feelings) { return []; }
    return Object.keys(npc.feelings)
        .map((key) => {
            const target = State.variables[key];
            const name = key === "player" ? "You" : (target ? (target.callName || target.name) : key);
            return { key: key, name: name, value: setup.feels(npc, key), label: setup.feelsLabel(npc, key) };
        })
        .filter((row) => row.value !== 0)
        .sort((a, b) => Math.abs(b.value) - Math.abs(a.value));
}>>

<<set setup.feelingsDaily = () => {
    ["mom", "sister"].forEach((sysName) => {
        const feelings = State.variables[sysName].feelings || {};
        Object.keys(feelings).forEach((key) => {
            const f = feelings[key];
            if (f.mood > f.floor) { f.mood -= 1; }
            else if (f.mood < f.floor) { f.mood += 1; }
        });
    });
}>>


/* End-of-day report ===========================================================
   "How was your day?" (STAGE1_PROPOSAL.md 3.5). What mom or sister did without me leaves an entry in her day
   log. As soon as there is something in it, I can ask her about it (card dayReport on the NPC Interaction screen,
   Define Interactions, passage Day Report, or the highlighted sidebar quick link that takes me straight to her,
   Define Quick Links): she sums up what is new, one line per entry in her own words, and I can pick an entry to hear
   in full. That plays its POV passage, her side of it (<<PovHeader>> in Event Widgets), the same one the CCTV
   arrow opens for things on camera. Places without cameras only have this door.

   $mom.dayLog / $sister.dayLog = [ { kind, id, day [, stage] [, line] [, told] [, heard] } ]
       kind    "task" (a finished task, added by completeTaskEntry), "event" or "deal" (<<LogDay>>)
       id      the task id, or the key of its entry in setup.dayReports
       day     the $date.dayCount it happened on. The Daily Update drops older entries
       stage   tasks: the index of the stage that was played (its report and passage are used)
       line    the index of the line that was picked, when the source has a list of lines
       told    true once she mentioned it in a summary (Day Report). Entries that come in later the same day are new
               again, and the card and the quick link come back for them
       heard   true once I listened to it in full

   Where the line and the passage come from:
       tasks    report: { line [, ask] [, passage] [, requires] } on the task, or on one of its stages (that one
                wins). The passage defaults to the passage of the stage that was played
       others   setup.dayReports.<sysName>.<id> = { line [, ask] [, passage] }, constants below
       line     what she says about it in the summary: a string that may contain variables, or a list of strings
                (one is picked when the entry is made and kept for the day)
       ask      the link text that plays the passage ("Ask about $brian.name"). Not needed without a passage
       requires optional TwineScript condition, checked when the entry is made: while false there is no entry

   The card shows once the report exists in the story (setup.dayReportsUnlocked: after Office Gossip,
   sister_officeGossip), at any time of day, but only while today's log has something she hasn't told me yet. A story
   I didn't hear in full doesn't keep the card up on its own: it stays in the list of the Day Report, which comes back
   with her next new entry that day (and things on camera stay behind the CCTV arrow). Listening is worth a little
   Relation once a day (Day Report). If I never ask, nothing breaks: the log is cleared overnight.

   <<LogDay $sister "diner_incident" ["deal"]>>   an entry for an event or a deal (Profile Widgets)
   setup.logDay(who, kind, id [, extra])          the same from code; extra is merged into the entry
   setup.logTaskReport(sysName, task)             completeTaskEntry: the entry for a finished task with a report
   setup.dayReportSource(who, entry)              { line, ask, passage } of an entry, or null
   setup.dayReportEntries(who)                    today's entries with a source:
                                                  [{ entry, index, line, ask, passage, told, heard }] (index into dayLog)
   setup.dayReportsUnlocked()                     the report exists in the story
   setup.hasDayReport(who)                        the card is offered right now: something untold (= dayReportNews)
   setup.dayReportNews(who)                       she has something new to tell (an entry that isn't told yet)
   setup.dayReportReachable(who)                  for the quick link: where she is, if I can walk up to her right
                                                  now and the card would be usable there ({ location }), else null
   setup.clearDayLogs()                           Daily Update: drops everything from before today */
<<set $mom.dayLog to []>>
<<set $sister.dayLog to []>>
<<set $povReturn to null>>  /* where <<EndPov>> goes back to (the desk for the CCTV, Day Report for the report) */

/* events and deals that she reports on, by sysName. Empty until the first scenes use them (the Diner Incident,
   Was That Right?, The Friend, see STAGE1_TODO.md) */
<<set setup.dayReports to {
    mom: {
        /* the club, the day after the Night Shift (logged by Night Shift 3 for the next day) */
        last_night: {
            line: "About last night, honey. If you want to hear it, I'll tell you all of it, every bit, and if you'd rather not, that's all right too, I only... I'd rather you heard it from me, that's all.",
            ask: "Let her tell you about the club",
            passage: "Last Night Mom POV",
        },
    },
    sister: {
        /* the club, the day after the Night Shift (logged by Night Shift 3 for the next day) */
        last_night: {
            line: "You can ask about last night, you know. I'm not going to fall apart on you. I just think you should have to hear it.",
            ask: "Ask her about the club",
            passage: "Last Night Sister POV",
        },
    },
}>>

<<set setup.logDay = (who, kind, id, extra) => {
    const npc = setup.corruptionNpc(who);
    if (!npc) { console.error("setup.logDay: unknown character", who); return; }
    if (!Array.isArray(npc.dayLog)) { npc.dayLog = []; }
    const entry = Object.assign({ kind: kind, id: id, day: State.variables.date.dayCount }, extra || {});
    /* a list of lines: pick one now, so the summary says the same thing all evening */
    const source = setup.dayReportSource(npc, entry);
    if (source && Array.isArray(source.lines)) { entry.line = random(0, source.lines.length - 1); }
    npc.dayLog.push(entry);
}>>

<<set setup.logTaskReport = (sysName, task) => {
    const live = setup.getLiveTask(task);
    if (!live) { return; }
    const stage = setup.getTaskStage(live);
    const report = (stage && stage.report) || live.report;
    if (!report) { return; }
    if (report.requires) {
        try { if (!Scripting.evalTwineScript(report.requires)) { return; } }
        catch (e) { console.error("setup.logTaskReport: requires of " + live.id + " failed: " + e.message); return; }
    }
    setup.logDay(sysName, "task", live.id, { stage: Number(live.stage) || 0 });
}>>

<<set setup.dayReportSource = (who, entry) => {
    const npc = setup.corruptionNpc(who);
    if (!npc || !entry) { return null; }
    let report;
    let passage;
    if (entry.kind === "task") {
        const live = setup.getTaskById(entry.id);
        if (!live) { return null; }
        const stage = Array.isArray(live.stages) ? live.stages[entry.stage || 0] : undefined;
        report = (stage && stage.report) || live.report;
        passage = (stage && stage.passage) || live.passage;
    } else {
        report = (setup.dayReports[npc.sysName] || {})[entry.id];
    }
    if (!report) { return null; }
    const lines = Array.isArray(report.line) ? report.line : null;
    return {
        line: lines ? lines[Math.clamp(entry.line || 0, 0, lines.length - 1)] : report.line,
        lines: lines,
        ask: report.ask || "Ask about it",
        passage: report.passage || passage || null,
    };
}>>

<<set setup.dayReportEntries = (who) => {
    const npc = setup.corruptionNpc(who);
    if (!npc || !Array.isArray(npc.dayLog)) { return []; }
    const today = State.variables.date.dayCount;
    const rows = [];
    npc.dayLog.forEach((entry, index) => {
        if (entry.day !== today) { return; }
        const source = setup.dayReportSource(npc, entry);
        if (!source || !source.line) { return; }
        const passage = source.passage && Story.has(source.passage) ? source.passage : null;
        rows.push({ entry: entry, index: index, line: source.line, ask: source.ask, passage: passage, told: !!entry.told, heard: !!entry.heard });
    });
    return rows;
}>>

<<set setup.dayReportsUnlocked = () => setup.questDone("sister_officeGossip")>>

<<set setup.hasDayReport = (who) => setup.dayReportNews(who)>>

<<set setup.dayReportNews = (who) => {
    if (!setup.dayReportsUnlocked()) { return false; }
    return setup.dayReportEntries(who).some((r) => !r.told);
}>>

/* The quick link only offers what the card would allow: not during The Silence, not while she is busy (the
   blocked list of the dayReport card), and only to a place that is open now and has a passage to stand in */
<<set setup.dayReportReachable = (who) => {
    const v = State.variables;
    const npc = setup.corruptionNpc(who);
    if (!npc || !setup.hasDayReport(npc)) { return null; }
    if (npc.sysName === "mom" && setup.momSilent()) { return null; }
    const card = v.interactions.actions.find((a) => a.id === "dayReport");
    if (card && card.blocked && setup.activityIs(npc, npc.activity, card.blocked)) { return null; }
    if (npc.flags.isFollowing) { return { location: v.player.location }; }
    const location = npc.location ? v.locations[npc.location.id] : null;
    if (!location || !location.passage || !Story.has(location.passage)) { return null; }
    if (!(location.open || []).includes(v.time.current.value)) { return null; }
    return { location: location };
}>>

<<set setup.clearDayLogs = () => {
    const today = State.variables.date.dayCount;
    ["mom", "sister"].forEach((sysName) => {
        const npc = State.variables[sysName];
        npc.dayLog = (npc.dayLog || []).filter((entry) => entry.day >= today);
    });
}>>


/* The Silence =================================================================
   Mom, STAGE1_PROPOSAL.md 5.5: the week after Not Enough. mom_notEnough sets $mom.flags.silence, mom_silence clears
   it seven days later. I stay cold for a week, and the game makes that a real choice:
     - every card on her NPC Interaction screen is locked (setup.interactionSilence, read by Define Interactions)
     - her tasks with me rest without a missed penalty: no massage, no test session (setup.taskRestsToday,
       Define Tasks)
     - micro events and desk visitors with her are skipped (setup.pickMicroEvent, Define Events), except her
       attempts to make up, which have duringSilence: true
     - no coffee at my bed in the morning (Activity Sleep)
     - the device I set before the week started keeps the guilt going: every night she loses some Morale and
       Resistance (setup.silenceDaily, numbers in setup.silenceTuning)
   Her attempts, which I can only ignore: a breakfast (meal silence_breakfast), a note on my pillow (micro event
   45, Mom Silence Note) and the lasagna (meal silence_lasagna). The set of mom_notEnough switches the meals on,
   the set of mom_silence switches them off again.

   setup.momSilent()             true during that week
   setup.silenceDay()            how far into the week it is: 1 on the day after Not Enough, 0 when not silent
   setup.interactionSilence(npc) the reason every card with her is locked right now, or null
   setup.silenceDaily()          Daily Update: the guilt */
<<set setup.silenceTuning to {
    moraleLoss: 4,
    resistanceLoss: 2,
}>>

<<set setup.momSilent = () => State.variables.mom.flags.silence === true>>

<<set setup.silenceDay = () => {
    if (!setup.momSilent()) { return 0; }
    const start = setup.getQuestById("mom_notEnough");
    return start && start.doneDay !== undefined ? State.variables.date.dayCount - start.doneDay : 0;
}>>

<<set setup.interactionSilence = (npc) => {
    if (!npc || npc.sysName !== "mom" || !setup.momSilent()) { return null; }
    return "I'm not talking to her this week.";
}>>

<<set setup.silenceDaily = () => {
    if (!setup.momSilent()) { return; }
    const mom = State.variables.mom;
    const t = setup.silenceTuning;
    mom.stats.morale = Math.clamp(mom.stats.morale - t.moraleLoss, mom.stats.min.morale, mom.stats.max.morale);
    mom.stats.resistance = Math.clamp(mom.stats.resistance - t.resistanceLoss, mom.stats.min.resistance, mom.stats.max.resistance);
}>>


/* The morning routine =========================================================
   After The Crawl ($mom.flags.morningRoutine) she brings my coffee in the morning, and that with it (STAGE1_PROPOSAL.md
   5.6). Activity Sleep offers it as the way to wake up (passage Morning Routine), next to a "Not this morning" link,
   instead of the old wake-up with coffee. Not during The Silence. $mom.flags.morningRoutines counts the mornings.
   setup.morningRoutineReady()   the routine is unlocked and nothing stops it tonight */
<<set setup.morningRoutineReady = () => State.variables.mom.flags.morningRoutine === true && !setup.momSilent()>>
