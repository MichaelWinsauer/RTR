:: Define Misc [system] {"position":"250,150","size":"100,100"}
/*delete!*/
<<set $path to "file:///E:/Daten/Development/Rise%20to%20Ruin/">>
/*<<set $path to "">>*/
<<set $debug to true>>
<<set $debugLocation to "">>
/*/delete!*/

/* time played in milliseconds, counted by the Playtime section of StoryScript */
<<set $playtime to 0>>

<<set $autosaveEvery to 10>>
<<set $lastAutosaveTurn to 0>>
/* once-per-action guards of "Action Update" (project work) and the morale warning, see ProgressProjects */
<<set $lastProgressKey to -1>>
<<set $lowMoraleNoticeKey to -1>>

<<set $preEventLocation to {}>>

<<set $displayInformation to 0>>

<<set $diner to {
	name: "The Diner",
    pay: 40,
    exp: 0,
}>>

/* STAGE1-STUB: the companies of the Stage 1 contacts (Define NPCs). Default names from the proposal, not renamable yet.
   Always write $gymChain.name and so on in texts, never the name itself */
<<set $marketingFirm to { name: "Pruitt Communications" }>>   /* $marketingOwner runs it */
<<set $gymChain to { name: "Peak Form Fitness" }>>            /* $gymOwner runs it */
<<set $retailChain to { name: "Hartwell Stores" }>>           /* the national chain, $investor opens the door */
<<set $club to { name: "The Lantern Room" }>>                 /* the club of $supplier, the last night */
<<set $rivalCompany to { name: "Clearline Labs" }>>           /* the startup $ethan launches with the stolen tech (The Morning After) */

<<set $mealType to "breakfast">>

<<set $cctv to {
	currentId: 13,
    view: "mom",            /* Who the camera shows when mom and sister are in the same room */
    returnPassage: "Company Stage 1 Desk",
    cameras: {},            /* <location sysName>: dayCount it was placed. Only these get a CCTV button (Define Items) */
    pending: [],            /* { place, who }: she has a camera and hides it the next time she is there */
}>>

<<set $rent to 2000>>
<<set $debtMissed to false>>

/* The weekly rent ==============================================================
   $rentDueDay   the dayCount of the Monday the next rent is due (day 0 is a Monday, the first rent is due a week in).
                 Paying, or telling him I am short, moves it on by 7 days (setup.settleRent)
   $debtMissed   true after I told him I was short once: next time it is all or Game Over ($player.debt holds
                 what I still owe from that week)

   How the week goes:
     Rent day before the evening   I can pay at his place (Landlord Apartment, "Landlord Pay Rent").
                                   He is a little friendlier when I bring it to him myself
     Rent day from the evening on  he comes for it ("Rent Due", $events[0]) as soon as I am at home or at the office.
                                   If I dodge him that night, he catches me there the next day
   Paying at his place stays possible as long as the rent is open, also once it is overdue.

   setup.rentOwed()      what he wants right now: this week plus anything left from last week
   setup.rentFunds()     the money I can pay with: my wallet in Stage 0, the company account from Stage 1 on
   setup.rentIsDue()     the rent can be paid now (rent day or later, and not settled yet)
   setup.rentIsOverdue() the rent day evening has come and it is still open: the Rent Due event may start
   setup.rentDaysLeft()  days until the rent day (0 = today, negative = overdue)
   setup.settleRent()    the rent of this week is dealt with (paid or deferred): the next one is due a week later.
                         Paying itself is the <<PayRent>> widget (Widgets) */
<<set $rentDueDay to 7>>

<<set setup.rentOwed = () => {
    const v = State.variables;
    return (Number(v.rent) || 0) + (Number(v.player.debt) || 0);
}>>

<<set setup.rentFunds = () => {
    const v = State.variables;
    return v.company.stage == 0 ? v.player.money : v.company.finances.money;
}>>

<<set setup.rentIsDue = () => State.variables.date.dayCount >= State.variables.rentDueDay>>

<<set setup.rentIsOverdue = () => {
    const v = State.variables;
    return v.date.dayCount > v.rentDueDay || (v.date.dayCount === v.rentDueDay && v.time.current.value >= 4);
}>>

<<set setup.rentDaysLeft = () => State.variables.rentDueDay - State.variables.date.dayCount>>

<<set setup.settleRent = () => {
    State.variables.rentDueDay += 7;
}>>

<<set $statInfluence = {
	lustBase: 0.05,
    lustScaling: 1.5,
    lustFlatGrowth: 3,
    lustFromCorruption: 0.5,
    lustFromResistance: -1.5,
    /* every night resistance drops by resistanceBase + relation * resistanceFromRelation + corruption * resistanceFromCorruption
       (about 7 a night at relation 60 and corruption 50), so a push with the device lingers for a day or two */
    resistanceBase: 2,
    resistanceFromRelation: 0.05,
    resistanceFromCorruption: 0.05,
    /* <<UseQuestDevice>> raises the resistance of the target by the device impact of the quest times this (impact 5: +10) */
    resistancePerImpact: 2,
    /* each corruption stage counts like this many extra points of corruption in the daily lust and resistance drift (Daily Update)
       and in the chances below (setup.corruptionEffective, Define NPCs), so a stage-up, which puts the
       bar back to 0, raises lust growth and lowers resistance a little for good */
    corruptionPerStage: 25,
    
    /* chance of the bed masturbation events (mom: $events[3], sister: $events[4]), set in PassageReady from her stats */
    chanceBase: 25,
  	chanceLust: 0.25,
  	chanceCorr: 0.30,
  	chanceRes:  0.25

}>>

<<set $companyLocationIdReference = 10>>
<<ShowInformationPanel 0>>
<<set $displayInformation = 0>>
<<set $previousDisplayInformation = 0>>
<<set $bossTalkedOnDay to 99999999>>
<<set $interactionCharacter to "mom">>



/* Media markup ================================================================
   setup.mediaHtml(kind, args)   the markup of <<Image>> (kind "image") or <<Video>> (kind "video") for the
                                 widget arguments: { tag, html }. tag is the bare img/video element ($imageReturn,
                                 $videoReturn), html the framed version with its overlays that the widget prints.
   Built in plain JS because the widgets run many times on every passage (portraits in the sidebar and on the
   dashboard), and building the same string with one TwineScript macro per piece was slow. */
<<set setup.mediaHtml = (kind, args) => {
    const v = State.variables;
    const path = v.path;
    const settings = v.settings;
    const isVideo = kind === "video";
    const overlay = isVideo ? args[4] : args[6];
    const border = args[5];
    const hideBorder = border != undefined && (border == "none" || border == "false");
    const close = ">";

    let tag;
    if (isVideo) {
        tag = '<video src="' + path + args[0];
        if (args[1] != undefined) { tag += args[1]; }
        if (args[2] != undefined) { tag += args[2]; }
        if (args[3] != undefined) { tag += '" style="max-width: ' + args[3] + 'px; max-height: ' + args[3] + "px;"; }
        tag += '" loop muted autoplay' + close + '</video' + close;
    } else {
        tag = '<img src="' + path + args[0];
        if (args[1] != undefined) { tag += args[1]; }
        if (args[2] != undefined) { tag += args[2]; }
        if (args[3] != undefined) { tag += '" width="' + args[3]; }
        if (args[4] != undefined) { tag += '" height="' + args[4]; }
        tag += '" alt="' + args[0];
        if (args[1] != undefined) { tag += args[1]; }
        if (args[2] != undefined) { tag += args[2]; }
        tag += '"' + close;
    }

    const overlays = (overlay && overlay.includes(" ")) ? overlay.split(" ") : [ overlay ];
    const cctvCorners = '<div class="video-camera-overlay" style="left: 2.5%; top: 2.5%; background-image: url(' + path + 'images/misc/cctv_1.png);"></div>'
        + '<div id="video-camera-overlay-2" class="video-camera-overlay" style="right: 2.5%; top: 2.5%; background-image: url(' + path + 'images/misc/cctv_2.png);"></div>'
        + '<div id="video-camera-overlay-3" class="video-camera-overlay" style="left: 2.5%; bottom: 2.5%; background-image: url(' + path + 'images/misc/cctv_3.png);"></div>'
        + '<div id="video-camera-overlay-4" class="video-camera-overlay" style="right: 2.5%; bottom: 2.5%; background-image: url(' + path + 'images/misc/cctv_4.png);"></div>'
        + '<div id="video-camera-overlay-5" class="video-camera-overlay" style="width: 4em; background-image: url(' + path + 'images/misc/cctv_5.png); align-self: center;"></div>';
    const frame = "<div style='display: flex; justify-content: center; height: 100%; width: 100%; position: relative'" + close;

    let html = "<div id='media-output' style='display: flex; justify-content: center; height: 100%; ";
    if (hideBorder) { html += "width: 100%;"; }
    html += "'" + close;
    html += "<div style='display: flex; justify-content: center; height: 100%; width: 100%; position: relative; border: 5px #EBDDC5 solid; padding: .25em;";
    if (hideBorder) { html += ' border: none; padding: 0;'; }
    else { html += isVideo ? ' width: initial; ' : ' width: initial;'; }
    overlays.forEach((o) => { if (o == "cctv-max") { html += ' position: inherit;'; } });
    html += "'" + close;

    overlays.forEach((o) => {
        if (settings.showCCTVOverlay != true) { return; }
        if (o == "cctv-max") {
            html += cctvCorners + "<div style='display: flex; justify-content: center; height: 100%; width: 100%;'" + close;
        }
        if (o == "cctv") {
            html += frame + cctvCorners;
        }
        if (o == "dream") {
            html += frame;
            html += '<div class="dream-haze" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, rgba(230,245,255,0.35) 0%, rgba(255,230,245,0.25) 50%, rgba(240,255,255,0.3) 100%); mix-blend-mode: screen; pointer-events: none; z-index: 5; filter: blur(2px);"></div>';
            html += '<div class="dream-light-orb1" style="position: absolute; top: 12%; left: 8%; width: 35%; height: 35%; background: radial-gradient(circle at 30% 30%, rgba(255,255,240,0.65) 0%, transparent 55%); border-radius: 50%; filter: blur(18px); animation: etherealPulse 9s infinite ease-in-out; pointer-events: none; z-index: 6;"></div>';
            html += '<div class="dream-light-orb2" style="position: absolute; bottom: 18%; right: 12%; width: 28%; height: 28%; background: radial-gradient(circle at 70% 40%, rgba(240,255,255,0.55) 0%, transparent 60%); border-radius: 50%; filter: blur(22px); animation: etherealPulse 13s infinite ease-in-out; pointer-events: none; z-index: 6;"></div>';
            html += '<div class="dream-sparkle1" style="position: absolute; top: 22%; right: 18%; width: 12px; height: 12px; background: radial-gradient(circle, #fff, transparent); box-shadow: 0 0 18px 6px rgba(255,255,255,0.85); border-radius: 50%; animation: dreamSparkle 2.8s infinite alternate ease-in-out; pointer-events: none; z-index: 7;"></div>';
            html += '<div class="dream-sparkle2" style="position: absolute; bottom: 35%; left: 25%; width: 8px; height: 8px; background: radial-gradient(circle, #fff, transparent); box-shadow: 0 0 14px 5px rgba(200,230,255,0.9); border-radius: 50%; animation: dreamSparkle 3.5s infinite alternate ease-in-out; pointer-events: none; z-index: 7;"></div>';
            html += '<div class="dream-sparkle3" style="position: absolute; top: 55%; left: 65%; width: 15px; height: 15px; background: radial-gradient(circle, #fff, transparent); box-shadow: 0 0 20px 7px rgba(255,245,230,0.8); border-radius: 50%; animation: dreamSparkle 2.2s infinite alternate ease-in-out; pointer-events: none; z-index: 7;"></div>';
        }
        if (o == "night") {
            html += frame;
            html += '<div class="night-tint" style="position: absolute; inset: 0; background: rgba(8, 18, 50, .5); mix-blend-mode: multiply; pointer-events: none; z-index: 5;"></div>';
            html += '<div class="night-vignette" style="position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(0, 0, 0, .20) 42%, rgba(2, 8, 35, 0.6) 100%); pointer-events: none; z-index: 6;"></div>';
            html += '<div class="night-glow" style="position: absolute; top: 15%; left: 20%; width: 32%; height: 32%; background: radial-gradient(circle, rgba(190, 215, 255, 0.16) 5%, transparent 65%); filter: blur(25px); pointer-events: none; z-index: 4;"></div>';
        }
        if (o == "prototype") {
            html += "<div style='display: flex; justify-content: center; height: 100%; width: 100%; position: relative; overflow: hidden'" + close;
        }
    });

    html += tag;

    if (settings.showCCTVEffect == true) {
        overlays.forEach((o) => {
            if (o == "cctv-max" || overlay == "cctv") { html += '<div class="cctv-overlay"></div>'; }
            if (o == "prototype") { html += '<div class="mindbend-overlay"></div><div class="corruption-overlay"></div><div class="influence-overlay"></div>'; }
        });
    }

    if (overlay != undefined && overlay != "") { html += '</div>'; }
    html += "</div></div>";
    return { tag: tag, html: html };
}>>

/* setup.mediaInline(kind, args)   what <<Image>> / <<Video>> print for these widget arguments, as an HTML string for
                                   panels that build their markup in JS (the CMD employee cards and inbox): the media
                                   while images are on, else in debug mode an image shows the first letter of its
                                   file name (like <<Image>>), else nothing */
<<set setup.mediaInline = (kind, args) => {
    const v = State.variables;
    if (v.settings.showImages == true) { return setup.mediaHtml(kind, args).html; }
    if (kind !== "image" || !v.debug) { return ""; }
    const file = String(args[0]) + (args[1] || "") + (args[2] || "");
    const letter = window.capitalize(file.split("/").pop().charAt(0));
    return '<div style="display: flex; justify-content: center; align-items: center; height: 100%; width: 100%;">' + letter + "</div>";
}>>
