<<set $locations[19].locationToReturnTo to $locations[7]>>
<<set $locations[20].locationToReturnTo to $locations[7]>>

/* setup.gymUnlocked()   the gym can be visited (after The Gym Meeting) */
<<set setup.gymUnlocked = () => setup.questDone("main_gymMeeting")>>

<<set setup.getLocationBySysName = (name) => {
  let result = null;
  State.variables.locations.forEach((location) => {
    if(location.sysName == name) {
      result = location;
    }
  });

  return result;
}>>

/* setup.sameLocation(a, b)   are a and b (location objects or ids) the same place? Locations with the same
                              "area" count as one: My Desk and the Stage 1 office */
<<set setup.sameLocation = (a, b) => {
    const areaOf = (loc) => {
        const location = (typeof loc === "object" && loc !== null) ? loc : State.variables.locations[loc];
        if (!location) { return undefined; }
        return (location.area !== undefined) ? location.area : location.id;
    };
    const areaA = areaOf(a);
    return areaA !== undefined && areaA === areaOf(b);
}>>
