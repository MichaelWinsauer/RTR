/* where the closed-location bounce (PassageReady) sends me when a place closes while I'm there. Without one it
   goes back to the previous location, which can be closed as well (College and its hallway close together). */
<<set $locations[8].locationToReturnTo to $locations[7]>>
<<set $locations[9].locationToReturnTo to $locations[7]>>
<<set $locations[10].locationToReturnTo to $locations[7]>>
<<set $locations[11].locationToReturnTo to $locations[7]>>
<<set $locations[17].locationToReturnTo to $locations[7]>>
