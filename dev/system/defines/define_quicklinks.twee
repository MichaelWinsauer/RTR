:: Define Quick Links [system] {"position":"1250,150","size":"100,100"}
/* Quick links ==================================================================
   Shortcuts that only show up when they save the player pointless clicks: the way to work in the morning, the
   next meal, bed at night, the way home, her report, how long to work at the desk, the way to an office quest. They are constants, the game
   state holds nothing about them. They show in two places:
     "sidebar"  the sidebar ("Quick Caption"), on location passages (tag "location") after the intro, so they
                never cut into a scene, an activity or a dialog
     "desk"     the actions panel of the dashboard at My Desk ("CMD Actions"), which hides the sidebar. Links with
                card: "work" go into its Work card (how long I work or wait), the rest into the list next to it
   This list is the one place for both: a new shortcut is one entry here, and "where" says where it shows.

   setup.quickLinks = [ {
       id:        "go_work",          unique key, the sidebar passes it back on click
       where:     ["sidebar", "desk"], optional, where it shows (default ["sidebar"])
       card:      "work",             optional, desk only: a button of the Work card instead of a list row.
                                      A Work card link whose cost comes out as 0 is left out
       slot:      0-3,                Work card only: its tile. The card always shows all four tiles, so it never
                                      changes its size; a tile without a link shows setup.deskWorkSlots[slot].
                                      Two links that never apply at the same time may share a tile
       items:     (ctx) => [ { key, ... } ],  optional: one link per item (one per quest that is ready). The
                                      functions below then get the item too: when(ctx, item), label(ctx, item)...
       working:   true,               optional: I work while its actions are spent ($playerWorking: +1 per
                                      requirement of every active project and action, like "One action")
       priority:  40,                 higher first. "wait" has 0 and always comes last
       when:      (ctx) => bool,      show it right now?
       label:     (ctx) => "...",     link text (build names from State.variables, never type one out)
       hint:      (ctx) => "...",     optional second line
       important: (ctx) => bool,      optional, highlights the link (accent border)
       minor:     true,               optional, a smaller, quieter link
       cost:      n or (ctx) => n,    actions to spend, one at a time with <<UseAction>> (0 = none)
       target:    (ctx) => "Passage", where the player ends up after the actions are spent
       before:    (ctx) => {},        optional, runs first (before any action is spent)
   } ]

   ctx (setup.quickLinkContext()) = { row, slot, weekday, here, atHome, atOffice, passage }
       row       the current action slot of the day (0-20), slot the time slot (0-6)
       here      the location object the player is at, atHome = in the house (ids 0-6)
       atOffice  one of setup.officeLocations (Stage 0 office, Stage 1 rooms, Stage 2 office)

   Going somewhere is free (work, home, bed, over to her), like walking there through the location tiles. Only
   waiting and working cost actions.

   Helpers:
   setup.quickLinkContext()        the ctx above
   setup.getQuickLinks([where])    the links to show now in "sidebar" (default) or "desk", sorted, each resolved to
                                   { id, label, hint, important, minor, card, working, cost, costText }
   setup.prepareQuickLink(id)      on click: checks "when" again, runs "before" and returns { cost, target, working },
                                   or null when the link no longer applies. The caller spends the cost (working
                                   while it does, if set) and goes on
   setup.quickLinkUntilText(cost)  "until Afternoon": the time slot reached after cost more actions (for hints)
   setup.deskWorkSlots             the four tiles of the Work card: { label, idle(ctx) }, shown greyed out while
                                   no link fills that tile, idle saying why
   setup.questQuickLinkTargets(ctx [, onlyPlaces])  the quests that are ready and only wait for me to go somewhere:
                                   [ { key (quest id), quest, location } ], the "Head to ..." links at the desk
                                   (only for setup.questQuickLinkPlaces, the office and the meeting room)
   setup.quickLinkWorkTask()       setup.getNextTaskWithPlayer() if that task happens in the office, else null
   setup.quickLinkWorkPlace()      where "Go to work" leads: My Desk in Stage 1 (the office of the current stage
                                   otherwise), or the place of a task with me that is already waiting
   setup.quickLinkNextMeal(ctx)    today's next meal that has not happened yet, { type, slot }, or null.
                                   Reads the meal micro events (Define Events, ids 0-2)
   setup.reportQuickLink(sysName)  the quick link entry for her end-of-day report (End-of-day report, Define NPCs):
                                   shown while setup.dayReportReachable(sysName) finds her, highlighted while she
                                   has something new. It walks me over to her and opens the NPC Interaction screen,
                                   where the "How was your day?" card waits. Free, like "Go home": spending an
                                   action on the way could let her walk off before I arrive */

<<set setup.officeLocations to [ "company", "companystage1", "companystage1desk", "companystage1meeting", "companystage2" ]>>

<<set setup.quickLinkContext = () => {
    const v = State.variables;
    const here = v.player.location;
    return {
        row: v.time.current.value * v.time.actions.max + (v.time.actions.max - v.time.actions.left),
        slot: v.time.current.value,
        weekday: v.date.today.value < 5,
        here: here,
        atHome: here.id <= 6,
        atOffice: setup.officeLocations.includes(here.sysName),
        passage: State.passage,
    };
}>>

<<set setup.quickLinkWorkTask = () => {
    const next = setup.getNextTaskWithPlayer();
    if (!next) { return null; }
    const places = setup.getTaskPlaces(next.task);
    const inOffice = places.some((id) => State.variables.locations[id] && setup.officeLocations.includes(State.variables.locations[id].sysName));
    return inOffice ? next : null;
}>>

<<set setup.quickLinkWorkPlace = () => {
    const v = State.variables;
    const next = setup.quickLinkWorkTask();
    if (next && next.waiting) { return setup.getTaskPlace(next.task); }
    return v.company.stage === 1 ? setup.getLocationBySysName("companystage1desk") : v.locations[v.companyLocationIdReference];
}>>

/* Breakfast, lunch and dinner are the micro events 0, 1 and 2. Each one names its time slot (whenTime) and may have
   extra conditions (lunch only on weekends). A meal that was already shown today (lastSeenDay) is over */
<<set setup.quickLinkNextMeal = (ctx) => {
    const v = State.variables;
    const meals = [ { id: 0, type: "breakfast" }, { id: 1, type: "lunch" }, { id: 2, type: "dinner" } ];
    for (const meal of meals) {
        const event = v.microEvents[meal.id];
        if (!event || !event.active || event.lastSeenDay === v.date.dayCount) { continue; }
        const slot = event.conditions.whenTime[0];
        if (slot < ctx.slot) { continue; }
        if (!(event.conditions.eval || []).every((check) => check())) { continue; }
        return { type: meal.type, slot: slot };
    }
    return null;
}>>

<<set setup.quickLinkUntilText = (cost) => {
    const v = State.variables;
    const ctx = setup.quickLinkContext();
    const slot = Math.min(v.timeSlots.length - 1, Math.floor((ctx.row + cost) / v.time.actions.max));
    return "until " + v.timeSlots[slot].text;
}>>

<<set setup.deskWorkSlots to [
    { label: "One action", idle: () => "" },
    { label: "Until the end of the work day", idle: (ctx) => (ctx.weekday ? "The work day is over" : "No work on the weekend") },
    { label: "Until her next task", idle: () => "No task with me later today" },
    { label: "Until her task is done", idle: () => "No task running right now" },
]>>

/* A quest is ready (setup.getEligibleQuests: right day and time, requirements and device met) and its event
   starts as soon as I walk into one of its places. Hidden quests stay hidden, and a place that is closed right
   now or the one I am already on does not count. My Desk is its own passage here: an event in the office does
   not start at the desk. onlyPlaces (location sysNames) limits the places that count: the desk link only offers
   the office and the meeting room (setup.questQuickLinkPlaces) */
<<set setup.questQuickLinkPlaces to [ "companystage1", "companystage1meeting" ]>>

<<set setup.questQuickLinkTargets = (ctx, onlyPlaces) => {
    const v = State.variables;
    const result = [];
    for (const quest of setup.getEligibleQuests()) {
        if (quest.hidden || !quest.needsEvent) { continue; }
        const places = (quest.where || []).map((place) => (typeof place === "object"
            ? v.locations[place.id]
            : v.locations.find((loc) => loc.passage === place)));
        const location = places.find((loc) => loc && loc.passage && Story.has(loc.passage)
            && (!onlyPlaces || onlyPlaces.includes(loc.sysName))
            && (loc.open || []).includes(ctx.slot) && loc.passage !== ctx.passage);
        if (location && !places.some((loc) => loc && loc.passage === ctx.passage)) {
            result.push({ key: quest.id, quest: quest, location: location });
        }
    }
    return result;
}>>

<<set setup.reportQuickLink = (sysName) => ({
    id: "report_" + sysName,
    where: ["sidebar", "desk"],
    priority: 50,
    when: () => setup.dayReportReachable(sysName) !== null,
    /* the morning after, before her workday, when all that is left is from yesterday (End-of-day report, Define NPCs) */
    label: () => setup.dayReportLater(sysName)
        ? "Ask " + State.variables[sysName].callName + " about yesterday"
        : "Hear about " + State.variables[sysName].callName + "'s day",
    hint: (ctx) => {
        const found = setup.dayReportReachable(sysName);
        const news = setup.dayReportNews(sysName);
        const where = setup.sameLocation(found.location, ctx.here) ? "right here" : found.location.name;
        return (news ? "She has something to tell me" : "There's more she could tell me") + " · " + where;
    },
    important: () => setup.dayReportNews(sysName),
    cost: 0,
    before: () => {
        const v = State.variables;
        const found = setup.dayReportReachable(sysName);
        v.interactionCharacter = sysName;
        v.interactionDesk = null;
        if (!setup.sameLocation(found.location, v.player.location)) {
            v.player.previousLocation = v.player.location;
            v.player.location = found.location;
            v.player.flags.isHome = found.location.id <= 6;
        }
    },
    target: () => "NPC Interaction",
})>>

<<set setup.quickLinks to [
    /* ——— My Desk: the Work card ——— */
    {
        /* one action of my own work, at any time */
        id: "work_one",
        where: ["desk"],
        card: "work",
        slot: 0,
        priority: 100,
        when: () => true,
        label: () => "One action",
        working: true,
        cost: 1,
        target: (ctx) => ctx.passage,
    },
    {
        /* before the work day: wait for it, without working */
        id: "work_wait",
        where: ["desk"],
        card: "work",
        slot: 1,
        priority: 95,
        when: (ctx) => ctx.weekday && State.variables.company.workHours.indexOf(true) > ctx.row,
        label: () => "Until work starts",
        hint: () => "Just waiting",
        cost: (ctx) => State.variables.company.workHours.indexOf(true) - ctx.row,
        target: (ctx) => ctx.passage,
    },
    {
        /* a task with me comes up later today: work until it starts, then be where it needs me */
        id: "work_task",
        where: ["desk"],
        card: "work",
        slot: 2,
        priority: 90,
        when: (ctx) => {
            const next = setup.getNextTaskWithPlayer();
            return !!next && !next.waiting && next.entry.startRow > ctx.row;
        },
        label: () => {
            const next = setup.getNextTaskWithPlayer();
            return "Until " + State.variables[next.sysName].callName + "'s " + next.task.title;
        },
        hint: (ctx) => setup.quickLinkUntilText(setup.getNextTaskWithPlayer().entry.startRow - ctx.row),
        working: true,
        cost: (ctx) => setup.getNextTaskWithPlayer().entry.startRow - ctx.row,
        target: () => setup.getTaskPlace(setup.getNextTaskWithPlayer().task).passage,
    },
    {
        /* one of her tasks is running: work until the first one is done */
        id: "work_task_end",
        where: ["desk"],
        card: "work",
        slot: 3,
        priority: 80,
        when: (ctx) => {
            const running = setup.getRunningTask();
            return !!running && running.entry.endRow > ctx.row;
        },
        label: () => {
            const running = setup.getRunningTask();
            return "Until " + State.variables[running.sysName].callName + "'s " + running.task.title + " is done";
        },
        hint: (ctx) => setup.quickLinkUntilText(setup.getRunningTask().entry.endRow - ctx.row),
        working: true,
        cost: (ctx) => setup.getRunningTask().entry.endRow - ctx.row,
        target: (ctx) => ctx.passage,
    },
    {
        /* during the work day: work through to its end */
        id: "work_day",
        where: ["desk"],
        card: "work",
        slot: 1,
        priority: 70,
        when: (ctx) => {
            const hours = State.variables.company.workHours;
            return ctx.weekday && hours.indexOf(true) >= 0 && hours.indexOf(true) <= ctx.row && hours.lastIndexOf(true) >= ctx.row;
        },
        label: () => "Until the end of the work day",
        hint: (ctx) => setup.quickLinkUntilText(State.variables.company.workHours.lastIndexOf(true) + 1 - ctx.row),
        working: true,
        cost: (ctx) => State.variables.company.workHours.lastIndexOf(true) + 1 - ctx.row,
        target: (ctx) => ctx.passage,
    },

    /* ——— the list (sidebar, and next to the Work card at the desk) ——— */
    {
        /* a task with me has started in another room of the office and she is waiting there (the meeting room).
           Outside the office, the Go to work link takes me there instead */
        id: "join_task",
        where: ["sidebar", "desk"],
        priority: 60,
        when: (ctx) => {
            const next = setup.getNextTaskWithPlayer();
            if (!ctx.atOffice || !next || !next.waiting) { return false; }
            const place = setup.getTaskPlace(next.task);
            return !!place && place.passage !== ctx.passage;
        },
        label: () => {
            const next = setup.getNextTaskWithPlayer();
            return "Join " + State.variables[next.sysName].callName + " in the " + wikifyText(setup.getTaskPlace(next.task).name);
        },
        hint: () => "She is already waiting",
        important: () => true,
        cost: 0,
        target: () => setup.getTaskPlace(setup.getNextTaskWithPlayer().task).passage,
    },
    {
        /* one per quest that is ready and only waits for me to walk into its place (setup.questQuickLinkTargets).
           Desk only, and only for the office and the meeting room: in the sidebar it turned the game into a click
           through the links (playtest 2026-11-24). Everywhere else the location hints show where a quest waits */
        id: "quest",
        where: ["desk"],
        priority: 55,
        items: (ctx) => setup.questQuickLinkTargets(ctx, setup.questQuickLinkPlaces),
        when: () => true,
        label: (ctx, item) => "Head to " + wikifyText(item.location.name),
        hint: (ctx, item) => wikifyText(setup.questDisplay(item.quest).title),
        important: () => true,
        cost: 0,
        target: (ctx, item) => item.location.passage,
    },
    setup.reportQuickLink("mom"),
    setup.reportQuickLink("sister"),
    {
        /* weekdays from Stage 1 on, until the work day is over, or later when a task with me waits in the office */
        id: "go_work",
        priority: 40,
        when: (ctx) => {
            const v = State.variables;
            if (v.company.stage < 1 || !ctx.weekday || ctx.atOffice) { return false; }
            const place = setup.quickLinkWorkPlace();
            const slotAfter = Math.floor((ctx.row + 1) / v.time.actions.max);
            if (!place || slotAfter >= v.timeSlots.length || !place.open.includes(slotAfter)) { return false; }
            /* the trip takes one action, so on the last work action there would be nothing left to arrive for */
            return ctx.row < v.company.workHours.lastIndexOf(true) || setup.quickLinkWorkTask() !== null;
        },
        label: () => "Go to work",
        hint: () => {
            const v = State.variables;
            const next = setup.quickLinkWorkTask();
            if (!next) { return ""; }
            const npc = v[next.sysName];
            if (next.waiting) { return npc.callName + " is already waiting for me"; }
            return npc.callName + "'s " + next.task.title + " · " + v.timeSlots[Math.floor(next.entry.startRow / v.time.actions.max)].text;
        },
        important: () => {
            const next = setup.quickLinkWorkTask();
            return !!(next && next.waiting);
        },
        cost: 0,
        target: () => setup.quickLinkWorkPlace().passage,
    },
    {
        /* at home: wait until the next meal starts and sit down in the kitchen, or just walk over if it is ready now */
        id: "meal",
        priority: 30,
        when: (ctx) => {
            if (!ctx.atHome) { return false; }
            const meal = setup.quickLinkNextMeal(ctx);
            return !!meal && !(meal.slot === ctx.slot && ctx.here.sysName === "kitchen");
        },
        label: (ctx) => {
            const meal = setup.quickLinkNextMeal(ctx);
            return meal.slot === ctx.slot ? meal.type.toUpperFirst() + " is ready" : "Wait for " + meal.type;
        },
        hint: (ctx) => {
            const meal = setup.quickLinkNextMeal(ctx);
            return setup.getPendingMealTypes([meal.type]).length > 0 ? "I should eat with my family today." : "";
        },
        important: (ctx) => setup.getPendingMealTypes([setup.quickLinkNextMeal(ctx).type]).length > 0,
        cost: (ctx) => {
            const meal = setup.quickLinkNextMeal(ctx);
            return Math.max(0, meal.slot * State.variables.time.actions.max - ctx.row);
        },
        target: () => "Kitchen",
    },
    {
        /* Night and Late Night: straight into bed, from anywhere. No action is spent on the way: sleeping ends the
           day anyway, and an action spent on the last one of Late Night would start the next day before the sleep */
        id: "go_bed",
        where: ["sidebar", "desk"],
        priority: 20,
        when: (ctx) => ctx.slot >= 5,
        label: (ctx) => ctx.atHome ? "Go to bed" : "Head home to bed",
        cost: 0,
        before: () => {
            const v = State.variables;
            const bed = setup.getLocationBySysName("bedroom");
            if (v.player.location.sysName !== bed.sysName) {
                v.player.previousLocation = v.player.location;
                v.player.location = bed;
                v.player.flags.isHome = true;
            }
        },
        target: () => "Activity Sleep",
    },
    {
        /* anywhere outside the house. The street out front has its own Home tile right there */
        id: "back_home",
        where: ["sidebar", "desk"],
        priority: 10,
        when: (ctx) => !ctx.atHome && ctx.here.sysName !== "residentialarea",
        label: () => "Go home",
        cost: 0,
        target: () => "Bedroom",
    },
    {
        id: "wait",
        priority: 0,
        minor: true,
        when: () => true,
        label: () => "Wait",
        cost: 1,
        target: (ctx) => ctx.passage,
    },
]>>

<<set setup.getQuickLinks = (where) => {
    const v = State.variables;
    const place = where || "sidebar";
    if (!v.flags.introDone) { return []; }
    if (place === "sidebar" && !tags().includes("location")) { return []; }
    const ctx = setup.quickLinkContext();
    return setup.quickLinks
        .filter((link) => (link.where || ["sidebar"]).includes(place))
        .flatMap((link) => setup.quickLinkInstances(link, ctx))
        .filter((one) => one.link.when(ctx, one.item))
        .sort((a, b) => b.link.priority - a.link.priority)
        .map((one) => {
            const link = one.link;
            const value = (field) => (typeof field === "function" ? field(ctx, one.item) : field);
            const cost = Math.max(0, Math.floor(Number(value(link.cost)) || 0));
            return {
                id: one.id,
                label: value(link.label),
                hint: link.hint ? value(link.hint) : "",
                important: link.important ? !!value(link.important) : false,
                minor: !!link.minor,
                card: place === "desk" ? link.card || "" : "",
                slot: link.slot || 0,
                working: !!link.working,
                cost: cost,
                costText: cost > 0 ? cost + (cost === 1 ? " action" : " actions") : "",
            };
        })
        .filter((link) => !(link.card === "work" && link.cost === 0));
}>>

/* An entry with "items" stands for one link per item, with the id "entry id:item key". All others are one link */
<<set setup.quickLinkInstances = (link, ctx) => {
    if (typeof link.items !== "function") { return [{ link: link, item: null, id: link.id }]; }
    return (link.items(ctx) || []).map((item) => ({ link: link, item: item, id: link.id + ":" + item.key }));
}>>

<<set setup.prepareQuickLink = (id) => {
    if (!State.variables.flags.introDone) { return null; }
    const ctx = setup.quickLinkContext();
    let one = null;
    for (const link of setup.quickLinks) {
        one = setup.quickLinkInstances(link, ctx).find((entry) => entry.id === id) || null;
        if (one) { break; }
    }
    if (!one || !one.link.when(ctx, one.item)) { return null; }
    const link = one.link;
    const cost = Math.max(0, Math.floor(Number(typeof link.cost === "function" ? link.cost(ctx, one.item) : link.cost) || 0));
    const target = link.target(ctx, one.item);
    if (!target || !Story.has(target)) {
        console.error('setup.prepareQuickLink: the quick link "' + id + '" leads to "' + target + '", which is no passage');
        return null;
    }
    if (link.before) { link.before(ctx, one.item); }
    return { cost: cost, target: target, working: !!link.working };
}>>
