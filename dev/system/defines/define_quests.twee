<<set $quests to [

]>>

/* The quest each line starts with. "quest" always holds the id of the line's current quest,
   <<NextQuest>> moves it along the "next" ids. */
<<set $player.quest to "main_meetSister">>
<<set $mom.quest to "mom_stressRelief">>
<<set $sister.quest to "sister_classProject">>
<<set $prof.quest to "prof_waitFirstProjects">>
<<set $boss.quest to "boss_waitStart">>
<<set $manager.quest to "manager_waitStart">>
<<set $landlord.quest to "landlord_waitStart">>

/* Quests that use the device: device: { target, impact [, key] [, minQuality] }
   key:        a device in $company.devices (Stage 1). Without it the Stage 0 prototype is used.
   target:     the calibration the scene needs (mom, sister, general, or a preset of that device). A device with
               anyTarget: true (the Catalyst) only needs a calibration of good enough quality, whatever its target
   impact:     1-10, the charge it costs (see $company.impactCost)
   minQuality: optional, the calibration quality needed. Without it any successful calibration counts.
   A scene that uses the device on two people gives a list instead: device: [ { key, target, impact }, { ... } ]
   (the Catalyst Night). Every entry costs its own charge (entries on the same device add up), and the scene
   switches each one on with <<UseQuestDevice $player "sister">> / <<UseQuestDevice $player "mom">>.
   A device with maxUses (the Anchor) also needs a use left.
   Checked separately from "requirements" (event check, eligible glow) and shown as pills on the sidebar quest.
   The scene spends the charge itself with <<UseQuestDevice $mom>> (see "Quest Widgets").

   setup.questDeviceEntries(device)   the entries as a list (a single object becomes a list of one)
   setup.questDevice(device)          { dev, cost, calOk, chargeOk, usesOk, ok, entries } for the current state.
                                      dev is the device of the first entry, cost the charge it needs for all its entries
   setup.questDeviceTarget(device)    who it is for, as the player reads it ("$mom.callName & $sister.callName")
   setup.deviceUsesLeft(dev)          uses left on a device with maxUses, Infinity without
   setup.useDevice(key, target, impact [, questId])
                                      switches a device on outside the quest check (the Anchor in The Calendar) and
                                      inside it (UseQuestDevice calls it): spends the charge, counts a use and writes a
                                      spike on a device with maxUses, sets lastUsed, and raises the resistance of mom or
                                      sister by impact * $statInfluence.resistancePerImpact. Returns the device */
<<set setup.questDeviceEntries = (device) => (!device ? [] : (Array.isArray(device) ? device : [ device ]))>>

<<set setup.deviceUsesLeft = (dev) => {
    if (!dev || !dev.maxUses) { return Infinity; }
    return Math.max(0, dev.maxUses - (Number(dev.uses) || 0));
}>>

<<set setup.questDevice = (device) => {
    const v = State.variables;
    const entries = setup.questDeviceEntries(device);
    const devOf = (e) => (e.key ? v.company.devices[e.key] : v.company.prototype);
    const costOf = (e) => (v.company.impactCost[e.impact] || 0);
    let calOk = entries.length > 0;
    let chargeOk = entries.length > 0;
    let usesOk = entries.length > 0;
    const needs = {};
    entries.forEach((e) => {
        const dev = devOf(e);
        const quality = !!dev && dev.calibrationQuality >= (e.minQuality || 1);
        if (!dev || !quality || (!dev.anyTarget && dev.calibration !== e.target)) { calOk = false; }
        const k = e.key || "prototype";
        needs[k] = needs[k] || { dev: dev, cost: 0, count: 0 };
        needs[k].cost += costOf(e);
        needs[k].count += 1;
    });
    Object.keys(needs).forEach((k) => {
        const n = needs[k];
        if (!n.dev || n.dev.charge < n.cost) { chargeOk = false; }
        if (setup.deviceUsesLeft(n.dev) < n.count) { usesOk = false; }
    });
    const first = entries[0];
    const firstNeed = first ? needs[first.key || "prototype"] : null;
    return {
        dev: firstNeed ? firstNeed.dev : undefined,
        cost: firstNeed ? firstNeed.cost : 0,
        calOk: calOk,
        chargeOk: chargeOk,
        usesOk: usesOk,
        ok: calOk && chargeOk && usesOk,
        entries: entries,
    };
}>>

<<set setup.questDeviceTarget = (device) => {
    const entries = setup.questDeviceEntries(device);
    const labels = entries.map((e) => setup.presetLabel(e.target)).filter((l, i, all) => all.indexOf(l) === i);
    return labels.join(" & ");
}>>

<<set setup.useDevice = (key, target, impact, questId) => {
    const v = State.variables;
    const dev = key ? v.company.devices[key] : v.company.prototype;
    if (!dev) { console.error("setup.useDevice: there is no device " + key); return undefined; }
    const cost = v.company.impactCost[impact] || 0;
    dev.charge = Math.max(0, dev.charge - cost);
    dev.lastUsedAtDay = v.date.dayCount;
    dev.lastUsedOnWho = target;
    if (dev.maxUses) {
        dev.uses = (Number(dev.uses) || 0) + 1;
        if (!Array.isArray(dev.spikes)) { dev.spikes = []; }
        dev.spikes.push({ day: v.date.dayCount, target: target, quest: questId || null });
    }
    /* using the device on her raises her resistance (once per use). A toast instead of an UpdateStat line, because
       this usually happens in the middle of a sentence */
    if (["mom", "sister"].includes(target)) {
        const npc = v[target];
        const rise = Math.min(npc.stats.max.resistance - npc.stats.resistance, impact * v.statInfluence.resistancePerImpact);
        if (rise > 0) {
            npc.stats.resistance += rise;
            Notification.show(npc.name + "'s Resistance has increased by " + rise + ".", { type: Notification.NEGATIVE });
        }
    }
    return dev;
}>>

/* Family offers ===============================================================
   STAGE1_PROPOSAL.md 3.1. A deal has a plain price (money, time, a worse contract), and the player may put mom or the
   sister on the table instead. The choice lives in the scene itself (and optionally in a mail answer), never on the
   interaction screen: the scene shows a row of offer cards with the <<Offer>> macro (StoryScript).

       <<Offer>>
       <<plain "I'll go myself" "20% off the contract">>          ...what happens if I go...
       <<plain "Pay the broker" "-$15,000" 15000>>                 the third argument is money: the card is locked
                                                                   while the account can't cover it, and clicking it
                                                                   takes the money (setup.spend, Define Company)
       <<family $mom 2 "Send $mom.callName" "the full contract">>  her card, locked with the reason until she is ready
                                                                   for that level (setup.offerReady)
       <<stall "Let me get back to you" "main_gymDinner">>         ends the scene without a decision. Hidden once the
                                                                   deal has no stalls left (setup.canStall)
       <</Offer>>

   Each card runs its own block when clicked (like <<linkreplace>>) and the row disappears. A family branch should end
   with what it does (flags, <<NextQuest>>, <<ReturnFromEvent>>), a stall branch with <<ReturnFromEvent>> only: the
   stall keeps the event alive, and it comes back after setup.offerStallDays days (CheckForEvent skips it until then).
   The scene can read setup.offerStalls(questId) to play a shorter version and to make the plain price a little worse
   for every stall.

   Mail answers: an answer option may have offer: { who: "mom", level: 2 } (locked like the card) and money: 15000
   (locked while the account can't cover it, paid when chosen). The Mail widget reads setup.mailOptionLock(option).

   The levels (proposal 3.1). STAGE1-STUB: the corruption and exhibition values are placeholders, the author sets them.
   corruption is her total over all stages (setup.corruptionTotal): 140 = "stage 1, 40".
   setup.offerLevels[level] = { name, corruption, exhibition }

   setup.offerReady(who, level)        { ok, reason }: reason is the text on a locked card
   setup.offerStallDays                days a stalled deal waits before it comes back
   setup.offerMaxStalls                stalls per deal (a quest may set its own maxStalls)
   setup.offerStalls(questId)          how often that deal has been stalled
   setup.canStall(questId)             another stall is allowed
   setup.stallOffer(questId [, days])  counts the stall and keeps the deal waiting (quest and event stalledUntil)
   setup.offerStalled(item)            a quest or event that is waiting after a stall
   setup.mailOptionLock(option)        the reason a mail answer is locked, or null */
<<set setup.offerLevels to [
    { name: "Charm",       corruption: 0,   exhibition: 0  },
    { name: "Warm-up",     corruption: 40,  exhibition: 10 },
    { name: "Entertain",   corruption: 140, exhibition: 25 },
    { name: "Handed over", corruption: 300, exhibition: 35 },   /* under the Stage 1 Exhibition cap of 40 (Define NPCs) */
]>>

<<set setup.offerStallDays to 3>>
<<set setup.offerMaxStalls to 2>>

<<set setup.offerReady = (who, level) => {
    const npc = setup.corruptionNpc(who);
    const lv = setup.offerLevels[Math.clamp(Number(level) || 0, 0, setup.offerLevels.length - 1)];
    if (!npc || !npc.stats) { return { ok: false, reason: "Nobody to ask" }; }
    const needs = [];
    if (setup.corruptionTotal(npc) < lv.corruption) {
        const stage = Math.floor(lv.corruption / 100);
        needs.push(lv.corruption % 100 === 0 && stage > 0 ? "Corruption stage " + stage : "Corruption " + setup.corruptionNeedText(lv.corruption));
    }
    if ((Number(npc.stats.exhibition) || 0) < lv.exhibition) { needs.push("Exhibition " + lv.exhibition); }
    if (needs.length === 0) { return { ok: true, reason: "" }; }
    return { ok: false, reason: "She isn't ready for that · needs " + needs.join(", ") };
}>>

/* The offer gates (playtest 2026-11-24: the family option was nearly always locked, because the main line got to its
   offer scenes long before mom and sister were ready). The main quests with an offer (main_gymDinner,
   main_retailIntroduction, main_supplier) wait until her line has reached the quest of her side of it and her
   corruption is high enough for the level of her card. Exhibition is not part of the gate: that one is up to me.
   setup.offerCorruptionMet(who, level)    her corruption total is at least the one of that offer level
   setup.offerCorruptionText(who, level)   the requirement line for it, with her progress: "Mom needs corruption
                                           40 (stage 1) (now 12 (stage 1))" or "Mom reaches corruption stage 3" */
<<set setup.offerCorruptionMet = (who, level) => {
    const lv = setup.offerLevels[Math.clamp(Number(level) || 0, 0, setup.offerLevels.length - 1)];
    return setup.corruptionTotal(who) >= lv.corruption;
}>>

<<set setup.offerCorruptionText = (who, level) => {
    const npc = setup.corruptionNpc(who);
    const lv = setup.offerLevels[Math.clamp(Number(level) || 0, 0, setup.offerLevels.length - 1)];
    const stage = Math.floor(lv.corruption / 100);
    if (lv.corruption % 100 === 0 && stage > 0) {
        return npc.callName + " reaches corruption stage " + stage + " (now stage " + setup.corruptionStage(npc) + ")";
    }
    return npc.callName + " needs corruption " + setup.corruptionNeedText(lv.corruption)
        + " (now " + setup.corruptionNeedText(Math.min(lv.corruption, setup.corruptionTotal(npc))) + ")";
}>>

<<set setup.offerStalls = (questId) => {
    const quest = setup.getQuestById(questId);
    return quest ? (Number(quest.stalls) || 0) : 0;
}>>

<<set setup.canStall = (questId) => {
    const quest = setup.getQuestById(questId);
    if (!quest) { return false; }
    const max = quest.maxStalls !== undefined ? quest.maxStalls : setup.offerMaxStalls;
    return (Number(quest.stalls) || 0) < max;
}>>

<<set setup.stallOffer = (questId, days) => {
    const v = State.variables;
    const quest = setup.getQuestById(questId);
    if (!quest) { return; }
    const until = v.date.dayCount + (days !== undefined ? days : setup.offerStallDays);
    quest.stalls = (Number(quest.stalls) || 0) + 1;
    quest.stalledUntil = until;
    if (quest.eventId !== undefined && v.events[quest.eventId]) {
        v.events[quest.eventId].stalledUntil = until;
        v.events[quest.eventId].stalledDay = v.date.dayCount;
    }
}>>

<<set setup.offerStalled = (item) => !!item && (Number(item.stalledUntil) || 0) > State.variables.date.dayCount>>

<<set setup.mailOptionLock = (option) => {
    if (!option) { return null; }
    if (option.offer) {
        const ready = setup.offerReady(option.offer.who, option.offer.level);
        if (!ready.ok) { return ready.reason; }
    }
    if (option.money && !setup.canAfford(option.money)) { return "The account can't cover it"; }
    return null;
}>>


<<set setup.getActiveQuests = () => {
    let result = [];

    setup.getQuestLines().forEach((line) => {
        line.quests.forEach((quest) => {
            if(quest.active) {
                result.push(quest);
            }
        });
    });

    return result;
}>>


<<set setup.getEligibleQuests = () => {
    const v = State.variables;
    const day = v.date.today.value;
    const time = v.time.current.value;

    const result = [];
    setup.getQuestLines().forEach((character) => {
        character.quests.forEach((quest) => {
            if (quest.active
                && quest.whenDay && quest.whenDay.includes(day)
                && quest.whenTime && quest.whenTime.includes(time)
                && setup.questRequirementsMet(quest)
                && (!quest.device || setup.questDevice(quest.device).ok)
                && !setup.offerStalled(quest)) {
                result.push(quest);
            }
        });
    });

    return result;
}>>

/* Locked quests ===============================================================
   While the requirements of a quest are not met yet (the device does not count), the sidebar card and the
   CMD header do not show its title, task, place, day and time, so nothing gets spoiled. They show
   setup.questLockedText instead, and the requirements checklist stays visible so the player knows what to do.
   A quest can bring its own stand-in text with the optional fields
       lockedTitle   "Something about $sister.callName"
       lockedTask    "She has been acting strange lately."
   setup.questRequirementsMet(quest)   every requirements string is true (true without requirements)
   setup.questLocked(quest)            it has requirements and they are not met yet
   setup.questDisplay(quest)           { title, task, locked }: what the UI shows for it right now */
<<set setup.questLockedText to {
    title: "Not yet available...",
    task: "",
}>>

<<set setup.questRequirementsMet = (quest) => {
    if (!quest || !quest.requirements) { return true; }
    return quest.requirements.every((req) => !!Scripting.evalTwineScript(req));
}>>

<<set setup.questLocked = (quest) => {
    return !!quest && !!quest.requirements && quest.requirements.length > 0 && !setup.questRequirementsMet(quest);
}>>

<<set setup.questDisplay = (quest) => {
    if (setup.questLocked(quest)) {
        return {
            title: quest.lockedTitle || setup.questLockedText.title,
            task: quest.lockedTask || setup.questLockedText.task,
            locked: true,
        };
    }
    return { title: quest.title, task: quest.task, locked: false };
}>>

/* Live counters in requirement texts ===========================================
   A requirementsText entry may hold {{TwineScript}}, which is replaced by its value whenever the text is shown
   (sidebar card, CMD header, profile): "Hold 10 test sessions ({{setup.getTaskById(...).count}}/10)".
   (A print macro in there would close the set macro that defines the quests, so it can not be used.)
   setup.questRequirementText(quest, i)   the i-th requirement text with its counters filled in */
<<set setup.questRequirementText = (quest, i) => {
    const raw = ((quest && quest.requirementsText) || [])[i];
    if (raw == null) { return ""; }
    return String(raw).replace(/\{\{(.+?)\}\}/g, (match, code) => {
        try { return String(Scripting.evalTwineScript(code)); }
        catch (e) { console.error('setup.questRequirementText: "' + code + '" failed: ' + e.message); return "?"; }
    });
}>>

/* Shortens runs of consecutive values: [0,1,2,3,4] with day labels gives "Mon-Fri", [5,6] gives "Sat, Sun". */
<<set setup.formatRuns = (values, labels) => {
    const sorted = [...new Set(values)].sort((a, b) => a - b);
    const runs = [];
    sorted.forEach((value) => {
        const last = runs[runs.length - 1];
        if (last && value === last.end + 1) {
            last.end = value;
        } else {
            runs.push({ start: value, end: value });
        }
    });
    return runs.map((run) => {
        if (run.start === run.end) { return labels[run.start]; }
        if (run.end === run.start + 1) { return labels[run.start] + ", " + labels[run.end]; }
        return labels[run.start] + "–" + labels[run.end];
    }).join(", ");
}>>

/* Quest lookup ================================================================
   Every quest has a unique string id ("main_...", "mom_...", "sister_...") and the id of the quest
   that follows it in "next" (the last quest of a line has none). Never reference quests by array index.

   setup.questLines            the characters that own a quest line. Add a new one here and the
                               helpers, events, checks, the sidebar and the CMD header pick it up.
                               A new line needs: <<set $<key>.quests to [ ... ]>> above, its start with
                               <<set $<key>.quest to "id">>, a "<key>_end" quest, and a portrait at
                               images/characters/portraits/<key>.jpg (sidebar card, CMD header).
                               Optional: a ring color for its CMD header chip (.cmd-quest[data-line] in CMD Header).
   setup.getQuestLines()       those characters' objects ($player, $mom, ...)
   setup.questLineLabel(key)   who a line belongs to, for notifications: "" for the main line, else the callName

   A quest with hidden: true runs like any other (check, set, events) but is never shown: no sidebar card,
   no CMD header chip. For background waits at the start of a line that the player should not know about yet.
   setup.getQuestById(id)      the quest with that id, from any line
   setup.getQuestLine(id)      the character whose line contains that quest
   setup.getCurrentQuest($mom) the quest the line is on right now (it can still be inactive)
   setup.questDone(id)         true once <<NextQuest>> moved past that quest
   setup.questReached(id)      true when the quest is the current one or done
   setup.activateQuest(id)     sets the quest active, and its event if it has one */
<<set setup.questLines = ["player", "mom", "sister", "prof", "boss", "manager", "landlord"]>>

<<set setup.getQuestLines = () => {
    return setup.questLines.map((key) => State.variables[key]);
}>>

<<set setup.questLineLabel = (key) => {
    if (key === "player") { return ""; }
    const owner = State.variables[key];
    return owner ? (owner.callName || owner.name || key) : key;
}>>

<<set setup.getQuestById = ((id) => {
    for (const line of setup.getQuestLines()) {
        const quest = line.quests.find((q) => q.id === id);
        if (quest) { return quest; }
    }
    console.error('setup.getQuestById: there is no quest with the id "' + id + '"');
    return undefined;
})>>

<<set setup.getQuestLine = ((id) => {
    return setup.getQuestLines().find((line) => line.quests.some((q) => q.id === id));
})>>

<<set setup.getCurrentQuest = ((character) => {
    return setup.getQuestById(character.quest);
})>>

<<set setup.questDone = ((id) => {
    const quest = setup.getQuestById(id);
    return !!(quest && quest.done);
})>>

<<set setup.questReached = ((id) => {
    const line = setup.getQuestLine(id);
    return setup.questDone(id) || (!!line && line.quest === id);
})>>

<<set setup.activateQuest = ((id) => {
    const quest = setup.getQuestById(id);
    if (!quest) { return; }
    quest.active = true;
    if (quest.eventId != null) {
        State.variables.events[quest.eventId].active = true;
    }
})>>

/* Optional quests (skip) ======================================================
   A quest with skip: "TwineScript" is optional. While the condition is true the line jumps over it: it counts as
   done (done: true, skipped: true, doneDay), its event is switched off, and its "set" does NOT run.
   The jump happens in two places:
   - <<NextQuest>>, right after the line moves onto the quest (the decision was already made), and
   - Check Quest Requirements on every passage, for a line that reached the quest before the decision was made.
   Because of the second case, decision flags are three-valued: null while undecided, then true or false.
   Write the skip so that it is false while undecided ("$mom.flags.gymDinner === false", not "!$mom.flags.gymDinner"),
   and give the quest a requirement that keeps it locked until the decision exists. A scene that offers the
   optional branch should only offer it once the line has reached the optional quest (setup.questReached), so the
   optional scene plays right after the decision and not weeks later.
   The last quest of a line (no next) can never be skipped.

   setup.questSkipped(quest)          its skip condition is true right now
   setup.skipQuests(line [, notify])  jumps the line over every skipped quest at its front, activates the quest it
                                      lands on, returns how many were skipped. notify: show the "new quest" toast */
<<set setup.questSkipped = (quest) => {
    if (!quest || !quest.skip) { return false; }
    try { return !!Scripting.evalTwineScript(quest.skip); }
    catch (e) {
        console.error('setup.questSkipped: the skip of "' + quest.id + '" failed: ' + e.message);
        return false;
    }
}>>

<<set setup.skipQuests = (line, notify) => {
    const v = State.variables;
    let count = 0;
    let quest = line ? setup.getCurrentQuest(line) : undefined;
    while (quest && quest.next && !quest.done && setup.questSkipped(quest)) {
        quest.active = false;
        quest.done = true;
        quest.skipped = true;
        quest.doneDay = v.date.dayCount;
        if (quest.eventId != null && v.events[quest.eventId]) {
            v.events[quest.eventId].active = false;
            v.events[quest.eventId].finished = true;
        }
        line.quest = quest.next;
        setup.activateQuest(line.quest);
        count++;
        quest = setup.getCurrentQuest(line);
    }
    if (count > 0 && notify && quest && !quest.hidden) {
        const label = setup.questLineLabel(line.sysName);
        Notification.show(label ? "New quest for " + wikifyText(label) + "!" : "New main quest!", { type: Notification.QUEST });
    }
    return count;
}>>

/* Needs the helpers above, so it runs last. */
<<GenerateEventsForQuests>>
