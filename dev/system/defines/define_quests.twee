    },
    {
    	id: "sister_waitSupportiveSister",
    	next: "sister_itMakesADifference",
    	title: "$sister.name is now working for you!",
        task: "$sister.name is working as an intern for you. She seems really happy lately, and she keeps finding reasons to come by your desk.",
        where: [ ],
        whenTime: [],
        whenDay:  [],
        active: false,
        check: "$date.dayCount >= setup.getQuestById('sister_internshipSeason').doneDay + 7 && $sister.flags.officeExcuses >= 5",
        /* the same two conditions as the check, so the card can show how far along they are. The card keeps its
           title and text while they are not met (lockedTitle/lockedTask). Her excuses are micro events that need
           her at the office (her afternoons, rows 9 to 11): tasks elsewhere then keep them from happening. */
        requirements: [
            "$date.dayCount >= setup.getQuestById('sister_internshipSeason').doneDay + 7",
            "$sister.flags.officeExcuses >= 5",
        ],
        requirementsText: [
            "Give her a week at the office (day {{Math.min(7, $date.dayCount - setup.getQuestById('sister_internshipSeason').doneDay)}}/7)",
            "She finds excuses to come by your desk ({{Math.min(5, $sister.flags.officeExcuses)}}/5), but only on afternoons she spends at the office, not on a task elsewhere",
        ],
        lockedTitle: "$sister.name is now working for you!",
        lockedTask: "$sister.name is working as an intern for you. She seems really happy lately, and she keeps finding reasons to come by your desk.",
    },
    {
    	id: "sister_itMakesADifference",
    	next: "sister_waitInternshipOverviewRequest",
    	/* Three passages: It Makes A Difference (her desk, I call her into the meeting room), It Makes A Difference 2
    	   (I thank her and tell her I stay late, then the clock jumps to the Night) and It Makes A Difference 3 (My Desk,
    	   the feed from the camera in her room). The camera requirement is there because the last part is watched through it */
    	title: "It makes a difference",
        task: "$sister.name has been working harder for me than anyone else in that office, and she should hear that from me.",
        lockedTask: "$sister.name comes up with a new reason to be near my desk every day.",
        where: [ setup.getLocationBySysName("companystage1") ],
        whenTime: [3,],
        whenDay:  [0, 1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "It Makes A Difference",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [
            "setup.hasCamera('sisterroom')",
        ],
        requirementsText: [
            "Hide a camera in $sister.callName's room",
        ],
    },
    {
    	id: "sister_waitInternshipOverviewRequest",
    	next: "sister_internshipOverviewRequest",
    	title: "Wait for tomorrow",
        task: "",
        where: [],
        whenTime: [],
        whenDay:  [],
        active: false,
        check: "$date.dayCount >= setup.getQuestById('sister_itMakesADifference').doneDay + 1",
    },
    {
    	/* Two passages: Internship Overview Meetings (she brings her internship journal to My Desk and asks for
    	   regular meetings) and Internship Overview Meetings 2 (the first one, in the meeting room). Finishing it
    	   unlocks the task Internship Overview, which runs every other day at most (cooldown, Define Tasks) */
    	id: "sister_internshipOverviewRequest",
    	next: "sister_waitMostlyDone",
    	title: "Internship Overview Meetings",
        task: "$sister.callName has been carrying a notebook around the office and closing it whenever I walk past. I give it a day before she brings it to my desk.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [2, 3,],
        whenDay:  [0, 1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "Internship Overview Meetings",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [
        ],
        requirementsText: [
        ],
        set: [ "setup.getTaskById('task_sister_internship_overview').active = true" ],
        notify: [ "New task for $sister.callName: Internship Overview" ],
    },
    {
    	id: "sister_waitMostlyDone",
    	next: "sister_mostlyDone",
    	title: "Wait for tomorrow",
        task: "",
        where: [],
        whenTime: [],
        whenDay:  [],
        active: false,
        check: "$date.dayCount >= setup.getQuestById('sister_internshipOverviewRequest').doneDay + 3",
    },
    {
    	id: "sister_mostlyDone",
    	next: "sister_theAsk",
    	title: "Good News?",
        task: "$sister.name wants to talk to me.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [1, 2, 3, 4,],
        whenDay:  [0, 1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "Mostly Done",
        returnPassage: "Company Stage 1",
        /* she has to be at the office, and the staff has to be hired: the scene sends her round to them */
        requirements: [
            "setup.questDone('main_tooMuchWork')",
        ],
        requirementsText: [
            "Hire your first employees",
        ],
        /* from now on she is at the office from Noon on (and her Noon cells open in the scheduler, Define Schedule).
           Her visits to the staff show up as micro events in the main room (Her rounds in Define Events) */
        set: [ "setup.useRoutine($sister.sysName, 'weekday', 'sister_stage1_noon')"],
        notify: [ "$sister.callName is at the office from Noon on now. Her Noon actions are open in the scheduler." ],
    },

    /* ==== Stage 1, her line after Good News? (STAGE1_PROPOSAL.md, section 6) ======================================
       STAGE1-STUB: everything from here to sister_end is structure only. The scene passages are empty stubs, and the
       requirements, timings and numbers are first guesses from the proposal. Each beat waits for the main beat of
       the same phase of the timeline (proposal section 8) with questDone. */
    {
    	/* 6.1 The analyst asks her out, she turns him down on her own and tells me that evening. Phase 2 (main_veil) */
    	id: "sister_theAsk",
    	next: "sister_souvenirs",
    	title: "The Ask",
        task: "$darius.name keeps finding reasons to stop by $sister.callName's desk. Today he didn't bother with a reason.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [3, 4],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Ask",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [
            "setup.questDone('main_veil')",
        ],
        requirementsText: [
            "Progress the main quest",
        ],
    },
    {
    	/* 6.2 Milestone into stage 1 (Yearning): the photos from the night of the party */
    	id: "sister_souvenirs",
    	next: "sister_officeGossip",
    	title: "Souvenirs",
        task: "I still have the photos from the night of the party. Maybe it's time $sister.callName saw them.",
        where: [ setup.getLocationBySysName("bedroom") ],
        whenTime: [5, 6],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Souvenirs",
        returnPassage: "Bedroom",
        requirements: [
            "$date.dayCount >= setup.getQuestById('sister_theAsk').doneDay + 7",
            "$sister.flags.photoTaken == true",
            "setup.corruptionReady('sister') || setup.corruptionStage('sister') >= 1",
        ],
        requirementsText: [
            "Give her a week",
            "Keep the photos from the night of the party",
            "$sister.callName's corruption is full",
        ],
    },
    {
    	/* 6.3 A comedy, and the first end-of-day report. Phase 4 (main_firstSale). Finishing it unlocks the report
    	   for both of them (setup.dayReportsUnlocked, End-of-day report in Define NPCs) */
    	id: "sister_officeGossip",
    	next: "sister_sendMeSomething",
    	title: "Office Gossip",
        task: "By noon $sister.callName knows everything that happens in this office. Somebody should ask her about it.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [3, 4],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Office Gossip",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [
            "setup.questDone('main_firstSale')",
        ],
        requirementsText: [
            "Progress the main quest",
        ],
        notify: [ "You can now ask $sister.callName and $mom.callName how their day was." ],
    },
    {
    	/* 6.4 The videos at night, then I walk in on her. Three parts. Phase 5 (main_gymMeeting) */
    	id: "sister_sendMeSomething",
    	next: "sister_whatAreWe",
    	title: "Send Me Something",
        task: "I don't need to touch $sister.callName to enjoy her. I just want to see her.",
        where: [ setup.getLocationBySysName("bedroom") ],
        whenTime: [5, 6],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Send Me Something",
        returnPassage: "Bedroom",
        requirements: [
            "setup.questDone('main_gymMeeting')",
        ],
        requirementsText: [
            "Progress the main quest",
        ],
    },
    {
    	/* 6.5 The morning after: What are we? */
    	id: "sister_whatAreWe",
    	next: "sister_beNiceToBrian",
    	title: "What Are We",
        task: "$sister.callName was up before me this morning, and she's been rehearsing something over her cereal.",
        where: [ setup.getLocationBySysName("kitchen") ],
        whenTime: [0, 1],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "What Are We",
        returnPassage: "Kitchen",
        requirements: [
            "$date.dayCount > setup.getQuestById('sister_sendMeSomething').doneDay",
        ],
        requirementsText: [
            "Wait until the next morning",
        ],
    },
    {
    	/* 6.5b Her first order about another man. Activates task_sister_be_nice_to_brian, which main_anchor waits for.
    	   After the diner incident (main_dinerIncident). She is in stage 1 already, Souvenirs comes first in the line */
    	id: "sister_beNiceToBrian",
    	next: "sister_waitCatalystNight",
    	title: "Be Nice to $brian.name",
        task: "$brian.name works best when he's happy, and nothing makes him happier than $sister.callName walking past his desk.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Be Nice To Brian",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [
            "setup.questDone('main_dinerIncident')",
        ],
        requirementsText: [
            "Progress the main quest",
        ],
        set: [ "setup.getTaskById('task_sister_be_nice_to_brian').active = true" ],
        notify: [ "New task for $sister.callName: Extra Friendly" ],
    },
    {
    	/* her Catalyst night (6.6) is part of the main event main_catalystNight */
    	id: "sister_waitCatalystNight",
    	next: "sister_twoTownsOver",
    	title: "Progress Main Quest",
        task: "Continue with the main quest before you can continue $sister.callName's.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "setup.questDone('main_catalystNight')",
    },
    {
    	/* 6.6b The date two towns over. The choice sets $sister.flags.datePhoto (true: her boyfriend, false: her brother) */
    	id: "sister_twoTownsOver",
    	next: "sister_theFriend",
    	title: "Two Towns Over",
        task: "$sister.callName wants one evening somewhere nobody knows us.",
        where: [ setup.getLocationBySysName("livingroom") ],
        whenTime: [4],
        whenDay: [4, 5],
        active: false,
        needsEvent: true,
        passage: "Two Towns Over",
        returnPassage: "Living Room",
        requirements: [
            "$date.dayCount >= setup.getQuestById('main_catalystNight').doneDay + 3",
        ],
        requirementsText: [
            "Give her a few days after the Catalyst",
        ],
    },
    {
    	/* 6.6c Her best friend from college. Stays an event, written as her end-of-day report at my desk */
    	id: "sister_theFriend",
    	next: "sister_rooftop",
    	title: "The Friend",
        task: "$bestFriend.name keeps texting $sister.callName, and $sister.callName keeps not answering.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [3, 4],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Friend",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [
            "$date.dayCount >= setup.getQuestById('sister_twoTownsOver').doneDay + 3",
        ],
        requirementsText: [
            "Give her a few days",
        ],
    },
    {
    	/* 6.7 OPTIONAL: only if I offer her as the hostess of the rooftop evening (main_retailIntroduction sets
    	   $flags.retailIntro to "sister") */
    	id: "sister_rooftop",
    	next: "sister_everything",
    	title: "The Rooftop",
        task: "$investor.callName's rooftop evening, with $sister.callName as our hostess.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [4],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Rooftop",
        returnPassage: "Company Stage 1",
        skip: "$flags.retailIntro != null && $flags.retailIntro !== 'sister'",
        requirements: [ "setup.questDone('main_retailIntroduction')" ],
        requirementsText: [ "Progress the main quest" ],
    },
    {
    	/* 6.8 Milestone into stage 3 (Mine). The night after the rooftop if she went, otherwise after The Friend */
    	id: "sister_everything",
    	next: "sister_knockAgain",
    	title: "Everything",
        task: "$sister.callName wants to know what she is to me. Tonight she gets an answer, and a choice.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [4],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Everything",
        returnPassage: "Company Stage 1",
        requirements: [
            "$flags.retailIntro != null && ($flags.retailIntro !== 'sister' || $date.dayCount > setup.getQuestById('sister_rooftop').doneDay)",
            "setup.corruptionReady('sister') || setup.corruptionStage('sister') >= 3",
        ],
        requirementsText: [
            "Settle the introduction to $retailChain.name",
            "$sister.callName's corruption is full",
        ],
    },
    {
    	/* 6.8b A late knock while she is in my bed. Needs the Calendar of mom (mom_calendar) */
    	id: "sister_knockAgain",
    	next: "sister_rehearsal",
    	title: "A Knock at Night, Again",
        task: "$sister.callName sleeps in my bed most nights now. It's a big house, but not that big.",
        where: [ setup.getLocationBySysName("bedroom") ],
        whenTime: [6],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Knock At Night Again",
        returnPassage: "Bedroom",
        requirements: [
            "setup.questDone('mom_calendar')",
            "$date.dayCount >= setup.getQuestById('sister_everything').doneDay + 3",
        ],
        requirementsText: [
            "Progress $mom.callName's quest",
            "Give her a few nights",
        ],
    },
    {
    	/* 6.8c OPTIONAL: only if I offer them to the supplier (main_supplier sets $flags.supplierOffered).
    	   An evening before the last night: the supplier names the date later, and the Client Evenings come in between */
    	id: "sister_rehearsal",
    	next: "sister_lastNight",
    	title: "Rehearsal",
        task: "$supplier.callName's evening is coming. Before it does, $sister.callName and I run through it.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [4],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Rehearsal",
        returnPassage: "Company Stage 1",
        skip: "$flags.supplierOffered === false",
        requirements: [ "setup.questDone('main_supplier')" ],
        requirementsText: [ "Progress the main quest" ],
    },
    {
    	/* 6.9 OPTIONAL, like the rehearsal. No event of its own: it is part of the main event main_nightShift, whose
    	   passage Last Night Sister advances it */
    	id: "sister_lastNight",
    	next: "sister_end",
    	title: "The Last Night",
        task: "Tonight she's the hostess, the way we rehearsed it.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        skip: "$flags.supplierOffered === false",
        requirements: [ "setup.questDone('main_supplier')" ],
        requirementsText: [ "Progress the main quest" ],
    },
    {
    	id: "sister_end",
    	title: "End of Content - $sister.name",
        task: "This is the end for the current Version.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
    },
]>>

/* The professor (STAGE1_PROPOSAL.md 7.4, venue: the college). His line starts hidden in the background (hidden: true)
   and only shows up once his mail arrives, a week after both first projects are done. Gate: The Dean's Visit comes
   before The Night Shift (main_nightShift waits for it, so the report exists the morning after) */
<<set $prof.quests to [
    {
    	/* runs from the start of the game, but nobody sees it: it only waits for the two first projects and then
    	   a week, and its set sends his mail ($company.mails[3]) */
    	id: "prof_waitFirstProjects",
    	next: "prof_mail",
    	title: "Waiting for the first projects",
        task: "",
        where: [],
        whenTime: [],
        whenDay: [],
        active: true,
        hidden: true,
        check: "setup.projectDone('project_boss_prototype') && setup.projectDone('project_diner_analysis') && $date.dayCount >= Math.max(setup.getProjectById('project_boss_prototype').completedAtDay, setup.getProjectById('project_diner_analysis').completedAtDay) + 7",
        set: [
            "$company.mails[3].active = true",
            "Notification.show('New mail from ' + $prof.callName + '.', { type: Notification.INFORMATION })",
        ],
    },
    {
    	/* advances when I answer his mail at My Desk; the answer sets the day of the meeting (answeredDay) */
    	id: "prof_mail",
    	next: "prof_researchProject",
    	title: "A mail from $prof.callName",
        task: "$sister.callName's calculus professor wants to meet me. It's been a while since I last stood in his office, and he didn't say why. His mail is in my inbox at My Desk.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$company.mails[3].answered == true",
    },
    {
    	/* He comes to the office on the Thursday afternoon after I answered his mail. Unlocks her college tutoring */
    	id: "prof_researchProject",
    	next: "prof_faceOfProject",
    	title: "The Proposition",
        task: "$prof.callName is coming by the office on Thursday afternoon. Whatever he wants, he didn't want to put it in writing.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [3],
        whenDay: [3],
        active: false,
        needsEvent: true,
        passage: "Research Project",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [ "$date.dayCount > ($company.mails[3].answeredDay || 0)" ],
        requirementsText: [ "Wait for the day of the meeting" ],
        set: [ "setup.getTaskById('task_sister_tutoring_college').active = true" ],
        notify: [ "New task for $sister.callName: Tutoring at the college" ],
    },
    /* ==== Stage 1, after The Proposition (STAGE1_PROPOSAL.md 7.4) ====================================================
       STAGE1-STUB: everything from here to prof_end is structure only. The scene passages are empty stubs, and the
       requirements and timings are first guesses from the timeline (proposal section 8). The Letter (7.4, 7) is no quest
       of its own: it is part of The Morning After (main_morningAfter). The Night Shift waits for prof_deansVisit. */
    {
    	/* 7.4, 2: she is told she is the face of the project. "Fine, but tights." Also gives her college tutoring task
    	   (task_sister_tutoring_college) its scenes */
    	id: "prof_faceOfProject",
    	next: "prof_theList",
    	title: "The Face of the Project",
        task: "$prof.callName's research project needs a face, and he already picked one. Somebody should tell $sister.callName before he does.",
        where: [ setup.getLocationBySysName("sisterroom") ],
        whenTime: [4, 5],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Face of the Project",
        returnPassage: "Sister Room",
        requirements: [ "setup.questDone('main_firstSale')" ],
        requirementsText: [ "Make the first real sale" ],
    },
    {
    	/* 7.4, 3: the study group on campus takes off. Introduces the athletes, the STEM club, the outsider, and the dean */
    	id: "prof_theList",
    	next: "prof_pilot",
    	title: "The List",
        task: "$sister.callName's study group has a waiting list now. $prof.callName wants me to see it with my own eyes.",
        where: [ setup.getLocationBySysName("college") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The List",
        returnPassage: "College",
        requirements: [
            "setup.getTaskById('task_sister_tutoring_college').count >= 3",
            "setup.questDone('main_gymMeeting')",
        ],
        requirementsText: [
            "$sister.callName tutors at the college ({{Math.min(3, setup.getTaskById('task_sister_tutoring_college').count)}}/3)",
            "Wait for the study group to grow",
        ],
    },
    {
    	/* 7.4, 4: the Veil goes into the lecture hall at night, with the hardware engineer. The second emitter on him */
    	id: "prof_pilot",
    	next: "prof_guestLecture",
    	title: "The Pilot",
        task: "The lecture hall is empty after nine. $brian.name and I have a ladder, a toolbox and a very good reason to be there.",
        where: [ setup.getLocationBySysName("college") ],
        whenTime: [5],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Pilot",
        returnPassage: "College",
        requirements: [ "setup.questDone('main_catalystNight')" ],
        requirementsText: [ "Wait for the next unit to be ready" ],
    },
    {
    	/* 7.4, 5: mom gives one guest lecture on running projects, and the students respect her. Only after The Crawl
    	   (proposal 7.5) */
    	id: "prof_guestLecture",
    	next: "prof_deansVisit",
    	title: "The Guest Lecture",
        task: "The dean wants a practitioner for one seminar, and $prof.callName suggested my consultant. $mom.callName has rewritten her notes four times.",
        where: [ setup.getLocationBySysName("college") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Guest Lecture",
        returnPassage: "College",
        requirements: [
            "setup.questDone('mom_crawl')",
            "setup.questDone('main_retailIntroduction')",
        ],
        requirementsText: [
            "Progress $mom.callName's quest",
            "Wait for the dean to ask",
        ],
    },
    {
    	/* 7.4, 6: the dean co-signs a preliminary report and asks for the raw data. In private he names his price for
    	   Stage 2: Fridays. main_nightShift waits for this (the report is the shield in The Letter, the morning after) */
    	id: "prof_deansVisit",
    	next: "prof_end",
    	title: "The Dean's Visit",
        task: "The dean read the numbers and wants to meet the people behind them. $prof.callName has ironed a shirt.",
        where: [ setup.getLocationBySysName("college") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Dean Visit",
        returnPassage: "College",
        requirements: [ "$date.dayCount >= setup.getQuestById('prof_guestLecture').doneDay + 2" ],
        requirementsText: [ "Give the dean a couple of days" ],
    },
    {
    	id: "prof_end",
    	title: "End of Content - $prof.callName",
        task: "This is the end for the current Version.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
    },
]>>

/* The boss (STAGE1_PROPOSAL.md 7.2, venue: his office tower, floor 6 and upstairs). The first person the device does
   not work on. Starts hidden and shows up after the handover (mom_briefing), when mom is his on-site consultant.
   Gates: The Arrangement sets $mom.flags.offeredToBoss (mom_afterHours waits for it), The Introduction comes before
   The Supplier (main_supplier waits for it). The sister stays out of this line in Stage 1.
   STAGE1-STUB: everything in this line is structure only. The scene passages are empty stubs, and the requirements
   and timings are first guesses from the timeline (proposal section 8). */
<<set $boss.quests to [
    {
    	/* hidden: waits for the handover, then the line shows up */
    	id: "boss_waitStart",
    	next: "boss_floorSix",
    	title: "Waiting for the handover",
        task: "",
        where: [],
        whenTime: [],
        whenDay: [],
        active: true,
        hidden: true,
        check: "setup.questDone('mom_briefing')",
    },
    {
    	/* 7.2, 1: mom back on her old floor as his "former assistant", the coffee, her old colleagues and the woman at
    	   her old desk. Told at home, or as her end-of-day report with a POV passage. Her feelings toward him start here */
    	id: "boss_floorSix",
    	next: "boss_supportReview",
    	title: "Floor Six",
        task: "$mom.callName spent the day on her old floor. She says it went fine. She has said that three times now.",
        where: [ setup.getLocationBySysName("livingroom"), setup.getLocationBySysName("kitchen") ],
        whenTime: [4, 5],
