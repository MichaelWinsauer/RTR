        needsEvent: true,
        passage: "Souvenirs",
        returnPassage: "Bedroom",
        requirements: [
            "$date.dayCount >= setup.getQuestById('sister_theAsk').doneDay + 7",
            "$sister.flags.photoTaken == true",
            "setup.corruptionReady('sister') || setup.corruptionStage('sister') >= 1",
            "setup.npcNow('sister').location && setup.inLocations(setup.npcNow('sister').location.sysName, ['home'])",
        ],
        requirementsText: [
            "Give her a week",
            "Keep the photos from the night of the party",
            "$sister.callName's corruption is full",
            "$sister.callName has to be home",
        ],
    },
    {
    	/* 6.3 A comedy, and the first end-of-day report. Phase 4 (main_firstSale).
    	   STAGE1-STUB: the How was your day? interaction (proposal 3.5) should exist for her from here on */
    	id: "sister_officeGossip",
    	next: "sister_sendMeSomething",
    	title: "Office Gossip",
        task: "By noon $sister.callName knows everything that happens in this office. Somebody should ask her about it.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [3, 4],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Office Gossip",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [
            "setup.questDone('main_firstSale')",
            "setup.npcIsAt('sister', 'companystage1')",
        ],
        requirementsText: [
            "Progress the main quest",
            "$sister.callName has to be at the office",
        ],
    },
    {
    	/* 6.4 The videos at night, then I walk in on her. Three parts. Phase 5 (main_gymMeeting) */
    	id: "sister_sendMeSomething",
    	next: "sister_whatAreWe",
    	title: "Send Me Something",
        task: "I don't need to touch $sister.callName to enjoy her. I just want to see her.",
