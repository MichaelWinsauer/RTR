        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Caught",
        returnPassage: "Company Stage 1",
        requirements: [
            "setup.questDone('main_veil')",
            "setup.npcIsAt('mom', 'companystage1')",
        ],
        requirementsText: [
            "Progress the main quest",
            "$mom.callName has to be at the office",
        ],
    },
    {
    	/* 5.3 A comedy: I coach her in flirting with the staff. Activates task_mom_flirt_duty. Phase 3 (main_lateNight) */
    	id: "mom_flirtDuty",
    	next: "mom_notEnough",
    	title: "Flirt Duty",
        task: "The staff works harder when somebody makes them feel good about it. $mom.callName could be that somebody, if she still remembers how to flirt.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [1, 2],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Flirt Duty",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [
            "setup.questDone('main_lateNight')",
            "setup.npcIsAt('mom', 'companystage1')",
        ],
        requirementsText: [
            "Progress the main quest",
            "$mom.callName has to be at the office",
        ],
        set: [ "setup.getTaskById('task_mom_flirt_duty').active = true" ],
    },
    {
    	/* 5.4 Handjobs are not enough, she says no, I send her away. Starts the silence ($mom.flags.silence).
    	   Phase 4 (main_firstSale) */
    	id: "mom_notEnough",
    	next: "mom_silence",
    	title: "Not Enough",
        task: "$mom.callName is getting good at her rounds. Her rule about what happens in my room hasn't kept up.",
        where: [ setup.getLocationBySysName("bedroom") ],
        whenTime: [5],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Not Enough",
        returnPassage: "Bedroom",
        requirements: [
            "setup.questDone('main_firstSale')",
            "setup.getTaskById('task_mom_flirt_duty').count >= 3",
            "setup.npcNow('mom').location && setup.inLocations(setup.npcNow('mom').location.sysName, ['home'])",
        ],
        requirementsText: [
            "Progress the main quest",
            "$mom.callName does her flirt duty rounds ({{Math.min(3, setup.getTaskById('task_mom_flirt_duty').count)}}/3)",
            "$mom.callName has to be home",
        ],
        set: [ "$mom.flags.silence = true" ],
    },
    {
    	/* 5.5 A week of nothing, then it moves on by itself.
    	   STAGE1-STUB: the interactions with her should be locked while $mom.flags.silence is true, and her small
    	   attempts to make up (breakfast, a note, lasagna) are not built */
    	id: "mom_silence",
    	next: "mom_crawl",
    	title: "The Silence",
        task: "A week. No talking, no favors, no smiling at breakfast. She needs to find out what it's like when I stop needing her.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$date.dayCount >= setup.getQuestById('mom_notEnough').doneDay + 7",
        set: [ "$mom.flags.silence = false" ],
    },
    {
    	/* 5.6 Friday, the empty office, her apology. Sets $mom.flags.morningRoutine. Phase 5 (main_gymMeeting).
    	   STAGE1-STUB: the morning routine it unlocks is not built */
    	id: "mom_crawl",
    	next: "mom_gymDinner",
    	title: "The Crawl",
        task: "It's Friday, the office empties out early, and $mom.callName has been working up to an apology all week.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [4, 5],
        whenDay: [4],
        active: false,
        needsEvent: true,
        passage: "The Crawl",
        returnPassage: "Company Stage 1",
        requirements: [ "setup.questDone('main_gymMeeting')" ],
        requirementsText: [ "Progress the main quest" ],
        set: [ "$mom.flags.morningRoutine = true" ],
    },
    {
    	/* 5.7 OPTIONAL: only if I sent her to the gym dinner (main_gymDinner sets $mom.flags.gymDinner).
    	   Her report when she comes home that night: Was that right?
    	   STAGE1-STUB: the end-of-day report system (proposal 3.5) does not exist, so this is a plain event for now */
    	id: "mom_gymDinner",
    	next: "mom_waitCatalystNight",
    	title: "Was That Right?",
        task: "$mom.callName had dinner with $rick.name tonight because I sent her. She'll want to tell me how it went.",
        where: [ setup.getLocationBySysName("livingroom"), setup.getLocationBySysName("kitchen") ],
        whenTime: [5, 6],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Mom Gym Dinner Report",
        returnPassage: "Living Room",
        skip: "$mom.flags.gymDinner === false",
        requirements: [
            "setup.questDone('main_gymDinner')",
            "setup.npcNow('mom').location && setup.inLocations(setup.npcNow('mom').location.sysName, ['home'])",
        ],
        requirementsText: [
            "Progress the main quest",
            "$mom.callName has to be home",
        ],
    },
    {
    	/* her Catalyst night (5.8) is part of the main event main_catalystNight */
    	id: "mom_waitCatalystNight",
    	next: "mom_calendar",
    	title: "Progress Main Quest",
        task: "Continue with the main quest before you can continue $mom.callName's.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "setup.questDone('main_catalystNight')",
    },
    {
    	/* 5.9 Milestone into stage 3 (Complicit). The choice sets $mom.flags.calendarChoice ("truth" or "anchor").
    	   Sets $mom.flags.freeUse. STAGE1-STUB: the Whenever interaction it unlocks is not built */
    	id: "mom_calendar",
    	next: "mom_afterHours",
    	title: "The Calendar",
        task: "$mom.callName keeps the company calendar, and this week she's been staring at it a lot.",
        lockedTask: "$mom.callName has been very quiet at her desk lately.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Calendar",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [
            "setup.projectDone('project_company_anchor')",
            "$date.dayCount >= setup.getQuestById('main_catalystNight').doneDay + 3",
            "setup.corruptionReady('mom') || setup.corruptionStage('mom') >= 3",
        ],
        requirementsText: [
            "Finish the Anchor project",
            "Give her a few days after the Catalyst",
            "$mom.callName's corruption is full",
        ],
        set: [ "$mom.flags.freeUse = true" ],
    },
    {
    	/* 5.10 OPTIONAL: only if I offer her to the boss (The Arrangement, boss line 7.2).
    	   STAGE1-STUB: the boss line does not exist yet, so $mom.flags.offeredToBoss is false and this is always skipped.
    	   Once the boss line exists, start the flag at null and make The Arrangement set it */
    	id: "mom_afterHours",
    	next: "mom_lastNight",
    	title: "After Hours",
        task: "Thursday evening. $boss.callName expects his consultant to stay late.",
        where: [ setup.getLocationBySysName("companystage1") ],
        whenTime: [4],
        whenDay: [3],
        active: false,
        needsEvent: true,
        passage: "After Hours",
        returnPassage: "Company Stage 1",
        skip: "$mom.flags.offeredToBoss !== true",
        requirements: [ "$mom.flags.offeredToBoss === true" ],
        requirementsText: [ "Offer $mom.callName to $boss.callName" ],
    },
    {
    	/* 5.11 OPTIONAL: only if I offer them to the supplier (main_supplier sets $flags.supplierOffered).
    	   No event of its own: it is part of the main event main_nightShift, whose passage Last Night Mom advances it */
    	id: "mom_lastNight",
    	next: "mom_end",
    	title: "The Last Night",
        task: "Tonight she wears what I picked for her.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        skip: "$flags.supplierOffered === false",
        requirements: [ "setup.questDone('main_supplier')" ],
        requirementsText: [ "Progress the main quest" ],
    },
    {
    	id: "mom_end",
    	title: "End of Content - $mom.name",
        task: "This is the end for the current Version.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
    },
]>>


<<set $sister.quests to [
	{
