:: Define Quests [system] {"position":"875,0","size":"100,100"}
<<set $player.quests to [
	{
    	id: "main_meetSister",
    	next: "main_plan",
    	title: "Meet $sister.name",
        task: "It's time to catch up with $sister.callName.",
        where: [ setup.getLocationBySysName("livingroom") ],
        whenTime: [0, 1, 2, 3, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6 ],
        active: true,
        needsEvent: true,
        passage: "Meet Sister",
        returnPassage: "Living Room",
        set: [ "setup.getMealById('welcome_home').isActive = true" ],
    },
    {
    	id: "main_plan",
    	next: "main_prototype40",
    	title: "Everyone needs a Plan",
        task: "I need a solid plan for the upcoming time.",   
        where: [ setup.getLocationBySysName("bedroom") ],
        whenTime: [0, 1, 2, 3, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6 ],
        active: false,
        needsEvent: true,
        passage: "Stage 0 Plan",
        returnPassage: "Bedroom",
        set: [ "$locations[7].open to [0, 1, 2, 3, 4, 5, 6]", "$flags.introDone = true" ],
    },
    {
    	id: "main_prototype40",
    	next: "main_testRunPrep",
    	title: "Work work work work work",
        task: "Get the progress of your $company.prototype.name prototype to 40.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$company.prototype.progress >= 40",
    },
    {
    	id: "main_testRunPrep",
    	next: "main_momRelation10",
    	title: "Prototype Test-Run Preparations",
        task: "Go to your Office and plan your Test-Run.",
        where: [ setup.getLocationBySysName("company") ],
        whenTime: [0, 1, 2, 3, 4, 5, ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Prototype Test-Run Preparation",
        returnPassage: "Company",
    },    
    {
    	id: "main_momRelation10",
    	next: "main_testRun",
    	title: "Further Preparations",
        task: "I have to strengthen my relationship with $mom.callName to at least 10.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$mom.stats.relation >= 10",
    },
    {
    	id: "main_testRun",
    	next: "main_continueMom",
    	title: "Prototype Test-Run",
        task: "Meet your $mom.relation in the Kitchen to test your prototype.",
        where: [ setup.getLocationBySysName("kitchen") ],
        whenTime: [ 4 ],
        whenDay: [ 0, 1, 2, 3, 4, 5, 6 ],
        active: false,
        needsEvent: true,
        passage: "Prototype Test-Run",
        device: { target: "mom", impact: 6 },
        returnPassage: "Bedroom",
        set: [ "setup.activateQuest('mom_stressRelief')", "$events[3].active = true" ],
    },      
    {
    	id: "main_continueMom",
    	next: "main_breakthrough",
    	title: "Continue $mom.callName's Quest",
        task: "Continue $mom.callName's ($mom.name $mom.surname) Quest",
        where: [ ],
        whenTime: [ ],
        whenDay: [ ],
        active: false,
    },          
    {
    	id: "main_breakthrough",
    	next: "main_prototype70",
    	title: "Breakthrough",
        task: "I can't believe it.",
        where: [ setup.getLocationBySysName("bedroom") ],
        whenTime: [ 5 ],
        whenDay: [ 0, 1, 2, 3, 4, 5, 6, ],
        active: false,
        needsEvent: true,
        passage: "Prototype Breakthrough",
        returnPassage: "Bedroom",
        set: [
            "$company.prototype.maxProgress to 70",
            "setup.activateQuest('sister_classProject')",
            "setup.getMealById('prototype_test_run_effect').isActive = true",
        ],
    },
    {
    	id: "main_prototype70",
    	next: "main_moreTimeNeeded",
    	title: "Things are getting started!",
        task: "Now that I'm sure that my prototype actually works, I should continue to work on it! [Progress to 70]",
        where: [ ],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$company.prototype.progress >= 70",
    },    
    {
    	id: "main_moreTimeNeeded",
    	next: "main_officeOutreach",
    	title: "More time needed",
        task: "Money's getting tight if I want to spend more time on my prototype. Maybe I can use my prototype on $sister.name to help me out a little...",
        where: [ setup.getLocationBySysName("sisterroom")],
        whenTime: [ 3, ],
        whenDay: [ 0, 1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "More Time Needed",
        device: { target: "sister", impact: 4 },
        returnPassage: "Living Room",
        set: [ "$sister.flags.doesChores to true", "setup.getMealById('more_time_needed').isActive = true" ],
        requirements: ["$sister.stats.relation >= 25"],
        requirementsText: ["$sister.name's relation >= 25"],
    },
    {
    	id: "main_officeOutreach",
    	next: "main_differentApproach",
    	title: "Office Outreach",
        task: "Now that I've enough time to focus on my prototype, I should try to advertise to some new clients!",
        where: [ setup.getLocationBySysName("company") ],
        whenTime: [ 2, ],
        whenDay: [ 0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Office Outreach",
        returnPassage: "Company",
    },
    {
    	id: "main_differentApproach",
    	next: "main_dinerSuggestion",
    	title: "Different approach",
        task: "Just writing mails won't work. I need connections, but how do I get those? Maybe $sister.name has an Idea",
        where: [ setup.getLocationBySysName("sisterroom") ],
        whenTime: [ 4, 5, ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Different Approach",
        returnPassage: "Bedroom",
        requirements: ["setup.questDone('sister_partyAnimal')"],
        requirementsText: ["Finish $sister.name's quest \"Party Animal\""],
    },
    {
    	id: "main_dinerSuggestion",
    	next: "main_prototype100",
    	title: "Not a bad Idea",
        task: "Honestly don't know why I didn't thought of that on my own. Anyway, I should talk to my manager at the Diner about my prototype. I should also get the prototype ready for the talk...",
        where: [ setup.getLocationBySysName("diner") ],
        whenTime: [ 3 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Diner Suggestion",
        returnPassage: "Diner",
        set: [ "$company.prototype.maxProgress = 100" ],
        requirements: ["setup.questReached('sister_conflictingFeelings')"],
        requirementsText: ["Reach $sister.callName's quest \"Conflicting feelings\""],
    },
    {
    	id: "main_prototype100",
    	next: "main_dinerTestRun",
    	title: "Time to Finish",
        task: "It's time to complete my prototype before I run the first offial test with strangers. [Progress to 100]",
        where: [ ],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$company.prototype.progress >= 100",
    },
    {
    	id: "main_dinerTestRun",
    	next: "main_expansionRequest",
    	title: "The time has come.",
        task: "Okay, with my Prototype finished, it's time to try my prototype in the real world. Fingers crossed.",
        where: [ setup.getLocationBySysName("diner") ],
        whenTime: [ 1 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Diner Test-Run",
        device: { target: "general", impact: 6 },
        returnPassage: "Diner",
        set: [ "$sister.flags.worksAtDiner = true" ],
    },
    {
    	id: "main_expansionRequest",
    	next: "main_homeRelations",
    	title: "Time to Expand",
        task: "Nice, now that I finally have a stable client, I should talk to $landlord.callName to get a larger Office, so I can hire employees!",
        where: [ setup.getLocationBySysName("company") ],
        whenTime: [ 1 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Landlord Expansion Request",
        returnPassage: "Company",
    },
    {
    	id: "main_homeRelations",
    	next: "main_familyLandlordHelp",
    	title: "Home Relations",
        task: "Progress $mom.callName's & $sister.callName's [Relation to 40] and [Corruption to 30]",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$mom.stats.relation >= 40 && setup.corruptionTotal('mom') >= 30 && $sister.stats.relation >= 40 && setup.corruptionTotal('sister') >= 30",
    },
    {
    	id: "main_familyLandlordHelp",
    	next: "main_waitLandlord",
    	title: "Family's there for one another.",
        task: "I need $mom.callName and $sister.callName to convince $landlord.callName.",
        where: [ setup.getLocationBySysName("livingroom") ],
        whenTime: [ 4 ],
        whenDay: [ 6 ],
        active: false,
        needsEvent: true,
        passage: "Family Landlord Help",
        returnPassage: "Residential Area",
        set: [ "$waitForLandlordMessage to $date.dayCount", "setup.getMealById('landlord_help_awkward').isActive = true" ],
    },
    {
    	id: "main_waitLandlord",
    	next: "main_stage1",
    	title: "Wait on $landlord.callName Message",
        task: "Fuck yeah, with my first client now, I can finally really get things rolling. I need to prepare the expansion of my Company!",
        where: [ ],
        whenTime: [ ],
        whenDay: [ ],
        active: false,
        check: "$waitForLandlordMessage + 3 <= $date.dayCount"
    },
    {
    	id: "main_stage1",
    	next: "main_finishingRenovations",
    	title: "Stage 1",
        task: "It's time to finally pay up the renovations and move into a larger office! [Money 10000]",
        where: [ setup.getLocationBySysName("company") ],
        whenTime: [0, 1, 2, 3, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Stage 1",
        returnPassage: "Company Stage 1",
        requirements: [
        	"setup.questDone('sister_internshipSeason')",
            "setup.questDone('mom_businessRelations')",
            "$player.money >= 10000",
        ],
        requirementsText: [
        	"Finish $sister.callName's quest \"Internship season!\"",
            "\nFinish $mom.callName's quest \"Business Relations\"",
            "\nMoney >= 10000",
        ],
        /* Stage 1: the corruption cap of the player rises to 100 (Stage 0: 40), and both of them work at my office now */
        set: [ "$companyLocationIdReference = 13", "$company.stage = 1", "$player.stats.max.corruption = 100", "setup.useRoutine('mom', 'weekday', 'mom_stage1')", "setup.useRoutine('sister', 'weekday', 'sister_stage1')", "$company.employees.push($mom)", "$company.employees.push($sister)" ]
    },    
    {
    	id: "main_finishingRenovations",
    	next: "main_tooMuchWork",
    	title: "Finishing Renovations",
        task: "It's been a week since I got the new office. It was quite a lot of work but worth it in the end...",
        where: [ setup.getLocationBySysName("companystage1") ],
        whenTime: [0, 1, 2, 3, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Finishing Renovations",
        returnPassage: "Company Stage 1",
    },
    {
    	id: "main_tooMuchWork",
    	next: "main_officialProductMeeting",
    	title: "Too Much Work",
        task: "I should answer all of my mails.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [1, 2, 3, 4, 5],
        whenDay: [0, 1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "Too Much Work",
        returnPassage: "Company Stage 1",
        requirements: [
            "$company.mails[0].answered == true",
            "$company.mails[1].answered == true",
            "$company.mails[2].answered == true",
        ],
        requirementsText: [
        	"Answer $landlord.callName's Mail.",
            "Answer $boss.callName's Mail.",
            "Answer $manager.callName's Mail.",
        ],
        set: [
            "$company.employees.push($ethan)",
            "$company.employees.push($brian)",
            "$company.employees.push($darius)"
        ],
    },
    {
    	id: "main_officialProductMeeting",
    	next: "main_veil",
    	title: "It'll be official",
        task: "Let's have a meeting to talk with everyone about the next step.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [1, 2, 3, 4, 5],
        whenDay: [1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "Official Product Meeting",
        returnPassage: "Company Stage 1",
        requirements: [
            "setup.projectDone('project_boss_prototype')",
            "setup.projectDone('project_diner_analysis')",
        ],
        requirementsText: [
        	"Finish $boss.callName's Project",
        	"Finish $manager.callName's Project",
        ],
        set: [  "setup.unlockProject('project_company_official')" ], /* shows the product project in the overview */
    },

    /* ==== Stage 1, acts 2 to 4 (STAGE1_PROPOSAL.md, section 4) ====================================================
       STAGE1-STUB: everything from here to main_end is structure only. The scene passages are empty stubs, and the
       requirements, timings and numbers are first guesses from the proposal. Find every open spot with
       grep -rn STAGE1-STUB dev (the quest audit counts them too). */
    {
    	/* 4.2 The idea comes from the proposition of the professor (prof_researchProject). Unlocks the Veil project */
    	id: "main_veil",
    	next: "main_lateNight",
    	title: "The Veil",
        task: "$prof.callName wants a whole lecture hall under one unit, and I told him that would take months. Time to tell the team what we're building next.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Veil",
        returnPassage: "Company Stage 1",
        requirements: [ "setup.questDone('prof_researchProject')" ],
        requirementsText: [ "Hear out what $prof.callName wants" ],
        set: [ "setup.unlockProject('project_company_veil')" ],
        notify: [ "New project available: $company.devices.valenxVeil.name" ],
    },
    {
    	/* 4.3 The night the Veil is finished. The project (onComplete) makes the device owned, this is its first switch-on */
    	id: "main_lateNight",
    	next: "main_waitFirstSaleLead",
    	title: "The Late Night",
        task: "The $company.devices.valenxVeil.name needs its field strength set before it goes anywhere near a lecture hall. That means a long night at the office, and $ethan.name has already claimed the pizza order.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [4, 5],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Late Night",
        returnPassage: "Company Stage 1",
        requirements: [ "setup.projectDone('project_company_veil')" ],
        requirementsText: [ "Finish the $company.devices.valenxVeil.name project" ],
    },
    {
    	/* hidden: a couple of days after The Late Night the mail of the marketing firm owner arrives ($company.mails[4]) */
    	id: "main_waitFirstSaleLead",
    	next: "main_firstSale",
    	title: "Waiting for the first lead",
        task: "",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        hidden: true,
        check: "$date.dayCount >= setup.getQuestById('main_lateNight').doneDay + 2",
        set: [
            "$company.mails[4].active = true",
            "Notification.show('New mail from ' + $marketingOwner.name + '.', { type: Notification.INFORMATION })",
        ],
    },
    {
    	/* 4.4 A clean sale to the marketing firm. The lead is her mail ($company.mails[4]), part 1 is her call the day
    	   after my answer (the sale), part 2 the bar with the old friend. pressClient matters at the end (they launch
    	   the rival company) */
    	id: "main_firstSale",
    	next: "main_waitGymLead",
    	title: "The First Real Sale",
        task: "$marketingOwner.name runs $marketingFirm.name, a building full of people who sell things for a living, and she wants to hear what a calmer conference room does for her pitches. No favors and no family friends this time, just a sale.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "First Real Sale",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [
            "$company.mails[4].answered == true",
            "$date.dayCount > ($company.mails[4].answeredDay || 0)",
        ],
        requirementsText: [
            "Answer $marketingOwner.name's mail",
            "Wait for her call at my desk",
        ],
        set: [
            "setup.unlockProject('project_marketing_veil')",
            "$flags.pressClient = true",
        ],
        notify: [ "New project available: $marketingFirm.name" ],
    },
    {
    	/* hidden: a few days after the first sale the mail of the gym owner arrives ($company.mails[5]) */
    	id: "main_waitGymLead",
    	next: "main_gymMeeting",
    	title: "Waiting for the gym lead",
        task: "",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        hidden: true,
        check: "$date.dayCount >= setup.getQuestById('main_firstSale').doneDay + 3",
        set: [
            "$company.mails[5].active = true",
            "Notification.show('New mail from ' + $gymOwner.name + '.', { type: Notification.INFORMATION })",
        ],
    },
    {
    	/* 4.5a Corporate talk, a comedy with a straight face. Part 2 is the afternoon of the router redesign */
    	id: "main_gymMeeting",
    	next: "main_gymDinner",
    	title: "The Gym Meeting",
        task: "$darius.name's old friend $gymOwner.name runs $gymChain.name and wants to talk about the wellbeing of his members. I'll need a straight face and a lot of coffee.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Gym Meeting",
        returnPassage: "Company Stage 1",
        requirements: [
            "$company.mails[5].answered == true",
            "$date.dayCount > ($company.mails[5].answeredDay || 0)",
        ],
        requirementsText: [
            "Answer $gymOwner.name's mail",
            "Wait for the day of the meeting",
        ],
    },
    {
    	/* 4.5b The first family option. The scene sets $mom.flags.gymDinner (true: she goes, false: I go and give a
    	   discount). Sending her is only offered once her line has reached mom_gymDinner. The scene uses the Offer macro
    	   (Family offers below): the plain price, her card at level 2 (Entertain), and a stall.
    	   It waits until her line has reached mom_gymDinner and her corruption is high enough for level 2 (Family offers:
    	   the offer gates). Her Exhibition is left to me: if I neglected it, her card is still locked, and that is my
    	   own doing (playtest 2026-11-24) */
    	id: "main_gymDinner",
    	next: "main_morale",
    	title: "The Gym Dinner",
        task: "$gymOwner.name won't sign anything until he's had dinner with the people behind the company. Somebody has to sit across the table from him and haggle.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [3, 4],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Gym Dinner",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [
            "$date.dayCount >= setup.getQuestById('main_gymMeeting').doneDay + 2",
            "setup.questReached('mom_gymDinner')",
            "setup.offerCorruptionMet('mom', 2)",
        ],
        requirementsText: [
            "Let $gymOwner.name think it over for a couple of days",
            "Progress $mom.callName's quest",
            "{{setup.offerCorruptionText('mom', 2)}}",
        ],
        set: [ "setup.unlockProject('project_gym_veil')" ],
    },
    {
    	/* 4.6 The scene sets $flags.dariusBroughtIn (true: ally with a stake, false: shut out) */
    	id: "main_morale",
    	next: "main_dinerIncident",
    	title: "Morale",
        task: "The new contracts are eating everyone alive. The office could use a little more warmth, and I know exactly who to ask for it.",
        where: [ setup.getLocationBySysName("companystage1") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Low Morale",
        returnPassage: "Company Stage 1",
        requirements: [ "$date.dayCount >= setup.getQuestById('main_gymDinner').doneDay + 3" ],
        requirementsText: [ "Let the new contract settle in" ],
    },
    {
    	/* 4.7 The first accident of the Veil, told by her at home, her telling as a POV passage (Diner Incident,
    	   Diner Incident POV, Diner Incident 2). Needs the Veil in the diner: the Debrief of the manager line
    	   (manager_debrief, 7.3). Plays on the evening of a day she worked a shift there, on the couch in the living room */
    	id: "main_dinerIncident",
    	next: "main_anchor",
    	title: "The Diner Incident",
        task: "Something happened at $diner.name today. $sister.callName came home quieter than usual, and she hasn't looked at her phone in an hour.",
        lockedTask: "$sister.callName keeps telling stories about the regulars at $diner.name.",
        where: [ setup.getLocationBySysName("livingroom") ],
        whenTime: [4, 5],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Diner Incident",
        returnPassage: "Living Room",
        requirements: [
            "setup.getTaskById('task_sister_diner_shift').count >= 10",
            "setup.questDone('manager_debrief')",
            "setup.getTaskById('task_sister_diner_shift').lastCompletedAt === $date.dayCount",
        ],
        requirementsText: [
            "$sister.callName works 10 shifts at $diner.name ({{Math.min(10, setup.getTaskById('task_sister_diner_shift').count)}}/10)",
            "Get $company.devices.valenxVeil.name into $diner.name",
            "$sister.callName works a shift at $diner.name that day",
        ],
    },
    {
    	/* 4.8 Needs a week of her attention for the hardware engineer (sister_beNiceToBrian, task_sister_be_nice_to_brian).
    	   Unlocks the Anchor project (only the hardware engineer works on it, its staff list). Its onComplete makes the
    	   Anchor device owned ($company.devices.valenxAnchor, two uses) */
    	id: "main_anchor",
    	next: "main_profitParty",
    	title: "The Anchor",
        task: "Some negotiations don't need a calmer room. They need one idea that stays where I put it. $brian.name can build that, as long as nobody tells him what it's for.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Anchor",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [ "setup.getTaskById('task_sister_be_nice_to_brian').count >= 3" ],
        requirementsText: [ "$sister.callName keeps $brian.name company ({{Math.min(3, setup.getTaskById('task_sister_be_nice_to_brian').count)}}/3)" ],
        set: [
            "setup.unlockProject('project_company_anchor')",
            "setup.getTaskById('task_sister_be_nice_to_brian').active = false",
        ],
        notify: [ "New project available: The Anchor (only $brian.name can work on it)" ],
    },
    {
    	/* 4.9 Only needs the company account in the black. Unlocks the Catalyst project. The old friend gets his
    	   token 2 percent here, no choice ($ethan.equity, back to 0 at The Morning After) */
    	id: "main_profitParty",
    	next: "main_catalystNight",
    	title: "The Profit Party",
        task: "The company account is in the black. For once the office has earned pizza that isn't a late-night apology.",
        where: [ setup.getLocationBySysName("companystage1") ],
        whenTime: [4],
        whenDay: [4],
        active: false,
        needsEvent: true,
        passage: "Profit Party",
        returnPassage: "Company Stage 1",
        requirements: [ "$company.finances.money > 0" ],
        requirementsText: [ "Get the company account into the black" ],
        set: [
            "setup.unlockProject('project_company_catalyst')",
            "$ethan.equity = 2",
        ],
        notify: [ "New project available: $company.devices.valenxCatalyst.name" ],
    },
    {
    	/* 5.8 and 6.6 as ONE event: the Catalyst night of both. Part 1 (office, evening) is her milestone into stage 2
    	   (Devoted), part 2 (home, night) is the milestone of mom into stage 2 (Willing). Both lines wait for it in
    	   mom_waitCatalystNight / sister_waitCatalystNight. The Catalyst is used on both of them (a device list: each
    	   part switches its own entry on with UseQuestDevice and her sysName). It needs no target */
    	id: "main_catalystNight",
    	next: "main_crack",
    	title: "The Catalyst Night",
        task: "The $company.devices.valenxCatalyst.name doesn't create anything. It only turns up what's already there, and I know what's already there in both of them.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [4],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Catalyst Night",
        returnPassage: "Company Stage 1",
        device: [
            { key: "valenxCatalyst", target: "sister", impact: 4 },
            { key: "valenxCatalyst", target: "mom", impact: 4 },
        ],
        requirements: [
            "setup.projectDone('project_company_catalyst')",
            "setup.questReached('mom_waitCatalystNight')",
            "setup.questReached('sister_waitCatalystNight')",
            "setup.corruptionReady('mom') || setup.corruptionStage('mom') >= 2",
            "setup.corruptionReady('sister') || setup.corruptionStage('sister') >= 2",
        ],
        requirementsText: [
            "Finish the $company.devices.valenxCatalyst.name project",
            "Progress $mom.callName's quest",
            "Progress $sister.callName's quest",
            "$mom.callName's corruption is full",
            "$sister.callName's corruption is full",
        ],
    },
    {
    	/* 4.10 Weekend: the old friend runs the full-strength code on himself. The Monday after is its own quest
    	   (main_crackLogs), so the clock does not have to jump two days inside one event */
    	id: "main_crack",
    	next: "main_crackLogs",
    	title: "The Crack",
        task: "$ethan.name wants the office to himself this weekend for some stability checks. I think I'll drop by anyway.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [1, 2, 3],
        whenDay: [5, 6],
        active: false,
        needsEvent: true,
        passage: "The Crack",
        returnPassage: "Company Stage 1",
        requirements: [ "$date.dayCount >= setup.getQuestById('main_catalystNight').doneDay + 2" ],
        requirementsText: [ "Wait a few days" ],
    },
    {
    	/* 4.10, the Monday after The Crack: the access log shows a pull of the raw data from the login of the analyst
    	   over the weekend, and I confront the wrong man. Softer if $flags.dariusBroughtIn */
    	id: "main_crackLogs",
    	next: "main_retailIntroduction",
    	title: "The Access Log",
        task: "Somebody pulled every raw log off the server this weekend. The access log has a name on it.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [1, 2, 3],
        whenDay: [0],
        active: false,
        needsEvent: true,
        passage: "The Crack 2",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [ "$date.dayCount > setup.getQuestById('main_crack').doneDay" ],
        requirementsText: [ "Wait for Monday" ],
    },
    {
    	/* 4.11, first half: the second family option. The scene sets $flags.retailIntro to "broker" (pay), "wait" (two
    	   weeks) or "sister" (she hosts the rooftop evening, sister_rooftop). Offering her only once her line has reached
    	   sister_rooftop. The scene uses the Offer macro (Family offers below): the broker fee as money (setup.spend), the
    	   wait, her card at level 2 (Entertain), and a stall.
    	   Like the Gym Dinner it waits for her line (sister_rooftop) and her corruption for level 2 (the offer gates) */
    	id: "main_retailIntroduction",
    	next: "main_retailPitch",
    	title: "The Introduction",
        task: "$investor.callName can open the door to $retailChain.name. Doors like that cost money, or time, or something else.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Retail Introduction",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [
            "$date.dayCount >= setup.getQuestById('main_crack').doneDay + 2",
            "setup.questReached('sister_rooftop')",
            "setup.offerCorruptionMet('sister', 2)",
        ],
        requirementsText: [
            "Wait a few days",
            "Progress $sister.callName's quest",
            "{{setup.offerCorruptionText('sister', 2)}}",
        ],
    },
    {
    	/* 4.11, second half: the night before the demo, master access for the old friend. The scene sets
    	   $flags.trustedEthan */
    	id: "main_retailPitch",
    	next: "main_supplier",
    	title: "The Retail Pitch",
        task: "The biggest pitch we've ever had is tomorrow. Everything has to work, so somebody has to set up the demo tonight.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [4, 5],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Retail Pitch",
        returnPassage: "Company Stage 1",
        requirements: [
            "$flags.retailIntro == 'broker' || ($flags.retailIntro == 'wait' && $date.dayCount >= setup.getQuestById('main_retailIntroduction').doneDay + 14) || ($flags.retailIntro == 'sister' && setup.questDone('sister_rooftop'))",
        ],
        requirementsText: [ "Get the introduction to $retailChain.name" ],
    },
    {
    	/* 4.12, first half: the price of the supplier, $20,000 or an evening with both of them. The scene sets
    	   $flags.supplierOffered. Offering them only once both lines have reached their optional quests
    	   (mom_lastNight, sister_rehearsal). It waits for both lines to get there and for their corruption for level 3
    	   (the offer gates in Family offers below), and for the boss to name the supplier (boss_introduction, 7.2).
    	   The scene uses the Offer macro: the price as money, their cards at level 3, and for the pay branch the advance from
    	   the boss (setup.addDebt, Define Company: the money now, installments every Monday) */
    	id: "main_supplier",
    	next: "main_nightShift",
    	title: "The Supplier",
        task: "Everything I've read since the incident at $diner.name says the right compounds would fix the problem. $supplier.callName has them, and he names his own price.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Supplier",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [
            "$date.dayCount >= setup.getQuestById('main_retailPitch').doneDay + 2",
            "setup.questDone('boss_introduction')",
            "setup.questReached('mom_lastNight') && setup.questReached('sister_rehearsal')",
            "setup.offerCorruptionMet('mom', 3)",
            "setup.offerCorruptionMet('sister', 3)",
        ],
        requirementsText: [
            "Wait a few days after the pitch",
            "Get a name from $boss.callName",
            "Progress $mom.callName's and $sister.callName's quests",
            "{{setup.offerCorruptionText('mom', 3)}}",
            "{{setup.offerCorruptionText('sister', 3)}}",
        ],
    },
    {
    	/* 4.12, second half: the night. If they go, it runs through Last Night Mom (mom_lastNight) and Last Night Sister
    	   (sister_lastNight), which advance those lines. The car, then the call of the old friend at 11:40 p.m.
    	   (the scene sets $flags.answeredEthan) */
    	id: "main_nightShift",
    	next: "main_morningAfter",
    	title: "The Night Shift",
        task: "Tonight $supplier.callName gets what he asked for, one way or the other.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [4],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Night Shift",
        returnPassage: "Company Stage 1",
        requirements: [
            "$date.dayCount > setup.getQuestById('main_supplier').doneDay",
            "$flags.supplierOffered !== true || (setup.questReached('mom_lastNight') && setup.questReached('sister_lastNight') && $date.dayCount > setup.getQuestById('sister_rehearsal').doneDay)",
            /* if I offered them: they go out with a client together first, three times (task Client Evening, Define Tasks) */
            "$flags.supplierOffered !== true || setup.getTaskById('task_mom_client_evening').count >= 3",
            /* the report the dean co-signed (prof_deansVisit, 7.4) is the shield in The Morning After, which has to be the
               morning right after this night, so its gate sits here */
            "setup.questDone('prof_deansVisit')",
        ],
        requirementsText: [
            "Wait until tomorrow",
            "Rehearse the evening with $sister.callName",
            "Send them out with a client together first ({{setup.getTaskById('task_mom_client_evening').count}}/3)",
            "Get the report signed at the college",
        ],
        /* the Client Evening POVs assume neither knows about the other: after the back seat it ends */
        set: [ "setup.lockTask('task_mom_client_evening')" ],
    },
    {
    	/* 4.13 End of Stage 1: the heist, the investigation, the rival launch (passages Morning After to Morning After 5).
    	   The set follows proposal 3.7: every device but the original is gone (the old friend took the units and bricked
    	   the rest), the vent unit too (vent.owned, its level back to Off), and he leaves the staff and every project he
    	   was assigned to. The CCTV keeps working: the cameras also record to a box of their own (the scene).
    	   $company.stage stays 1: Stage 2 (its office, Suspicion) is not built yet.
    	   The report the dean co-signed (prof_deansVisit, 7.4) is the shield in The Letter, part of this scene; its gate
    	   sits on main_nightShift, so this is always the morning right after that night. The Sale (landlord_sale, 7.1)
    	   comes up here if it happened */
    	id: "main_morningAfter",
    	next: "main_end",
    	title: "The Morning After",
        task: "Something's wrong at the office. I can feel it before I've even unlocked the door.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [0, 1],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Morning After",
        returnPassage: "Company Stage 1",
        requirements: [ "$date.dayCount > setup.getQuestById('main_nightShift').doneDay" ],
        requirementsText: [ "Wait until morning" ],
        set: [
            "Object.keys($company.devices).forEach((k) => { if (k !== 'valenx') { $company.devices[k].owned = false; } })",
            "$company.vent.owned = false",
            "$company.vent.level = 0",
            "$company.employees = $company.employees.filter((e) => e.sysName !== 'ethan')",
            "$company.projects.forEach((p) => { p.assigned = (p.assigned || []).filter((e) => e.sysName !== 'ethan'); })",
            "$ethan.assignedProjectCount = 0",
            "$ethan.equity = 0",
        ],
    },
    {
    	id: "main_end",
    	title: "End of Content - Main",
        task: "This is the end for the current Version.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
    },
]>>

<<set $mom.quests to [
	{
    	id: "mom_stressRelief",
    	next: "mom_relation25",
    	title: "$mom.callName Stress Relief",
        task: "I should check if I can catch her masturbating!",
        where: [ setup.getLocationBySysName("momroom") ],
        whenTime: [ 5, ],
        whenDay: [ 0, 1, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Mom Bed Masturbation",
        returnPassage: "Hallway",
    },
    {
    	id: "mom_relation25",
    	next: "mom_wakingTroubles",
    	title: "$mom.callName's relation",
        task: "I have to strengthen my relationship with $mom.callName to at least 25.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$mom.stats.relation >= 25",
    },
    {
    	id: "mom_wakingTroubles",
    	next: "mom_waitRent",
    	title: "Waking Troubles",
        task: "I should try to use $company.prototype.name on her again, now that we have a stronger relationship.",
        where: [ setup.getLocationBySysName("momroom"), setup.getLocationBySysName("livingroom"), setup.getLocationBySysName("kitchen") ],
        whenTime: [0, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Waking Troubles",
        device: { target: "mom", impact: 4 },
        returnPassage: "Bedroom",
        set: [ "$mom.flags.wakeUp = true" ],
    },
    {
    	id: "mom_waitRent",
    	next: "mom_hereToHelp",
    	title: "Waiting...",
        task: "Wait until after you paid this weeks rent.",
        where: [ ],
        whenTime: [ ],
        whenDay: [ ],
        active: false,
    },    
    {
    	id: "mom_hereToHelp",
    	next: "mom_waitMainOutreach",
    	title: "$mom.callName's here to help",
        task: "I should talk to her again in her room.",
        where: [ setup.getLocationBySysName("momroom") ],
        whenTime: [0, 1, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6 ],
        active: false,
        needsEvent: true,
        passage: "Mom's here to help",
        device: { target: "mom", impact: 4 },
        returnPassage: "Mom Room",
        set: [ "$mom.flags.rentHelp to true" ]
    },    
    {
    	id: "mom_waitMainOutreach",
    	next: "mom_descent",
    	title: "Progress Main Quest",
        task: "Continue with the main Quest before you can continue $mom.callName's.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "setup.questReached('main_officeOutreach')",
    },
    {
    	id: "mom_descent",
    	next: "mom_hasItTough",
    	title: "Descent",
        task: "Increase your [Corruption to 35]",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$player.stats.corruption >= 35",
    },
    {
    	id: "mom_hasItTough",
    	next: "mom_helpfulSon",
    	title: "$mom.callName has it tough.",
        task: "Catch $mom.callName in the living room in the evening. She's had a rough few days lately.",
        where: [ setup.getLocationBySysName("livingroom") ],
        whenTime: [ 4 ],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Mom Has It Tough",
        returnPassage: "Living Room",
        set: [ "$mom.flags.workUnlocked = true", "$locations[12].name = \"$mom.callName's Work\"", "setup.getMealById('mom_has_it_tough').isActive = true" ],
    },
    {
    	id: "mom_helpfulSon",
    	next: "mom_firstConfrontation",
    	title: "The Helpful $mom.playerRelation",
        task: "So $mom.callName's having trouble at work. I offered her to help her with my prototype at work, so I should meet her at her workplace to help her unwind a little...",
        where: [ setup.getLocationBySysName("momswork") ],
        whenTime: [ 1, 2, 3 ],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Helpful Son",
        device: { target: "mom", impact: 8 },
        returnPassage: "Residential Area",
    },
    {
    	id: "mom_firstConfrontation",
    	next: "mom_waitBoss",
    	title: "First Confrontation",
        task: "Damn, I just experienced first hand how terrible her boss really is. I will manipulate him using my prototype to shut him up for good!",
        where: [ setup.getLocationBySysName("momswork") ],
        whenTime: [ 1, 2, 3 ],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "First Boss Confrontation",
        device: { target: "general", impact: 6 },
        returnPassage: "Moms Work",
        set: [ "$bossTalkedOnDay to $date.dayCount" ],
        requirements: ["$company.prototype.progress >= 40"],
        requirementsText: ["Prototype Progress >= 40"],
    },
    {
    	id: "mom_waitBoss",
    	next: "mom_hasItToughAgain",
    	title: "Waiting",
        task: "I should wait a few days and see if all this has made any difference...",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$date.dayCount >= $bossTalkedOnDay + 3"
    },
    {
    	id: "mom_hasItToughAgain",
    	next: "mom_secondConfrontation",
    	title: "$mom.callName Has It Tough Again",
        task: "I should enter her room in the evening. She seems down lately again.",
        where: [ setup.getLocationBySysName("momroom") ],
        whenTime: [ 4, 5, 6 ],
        whenDay: [ 0, 1, 2, 3, 4 ],
        active: false,
        needsEvent: true,
        passage: "Mom Has It Tough Again",
        device: { target: "mom", impact: 7 },
        returnPassage: "Hallway",
        requirements: ["$player.stats.corruption >= 15"],
        requirementsText: ["Corruption >= 15"],
        set: [ "setup.getMealById('mom_has_it_tough_again').isActive = true" ],
    },    
    {
    	id: "mom_secondConfrontation",
    	next: "mom_agreement",
    	title: "Second Confrontation",
        task: "Fuck, I really made things worse. Okay, fuck this guy, I'll make him agree!",
        where: [ setup.getLocationBySysName("momswork") ],
        whenTime: [ 1, 2, 3 ],
        whenDay: [ 0, 1, 2, 3, 4 ],
        active: false,
        needsEvent: true,
        passage: "Second Boss Confrontation",
        device: { target: "general", impact: 8 },
        returnPassage: "Moms Work",        
        requirements: ["$company.prototype.progress >= 70"],
        requirementsText: ["Prototype progress >= 70"],
    },
    {
    	id: "mom_agreement",
    	next: "mom_agreement2",
    	title: "Agreement",
        task: "$mom.callName's Boss and I came to an agreement afterall. Though I have to get $5000 now and a short clip of $mom.callName masturbating... I'll focus on the money first.",
        where: [ ],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$player.money >= 5000",
    },
    {
    	id: "mom_agreement2",
    	next: "mom_sabotage",
    	title: "Agreement 2",
        task: "Now for the short Video of $mom.callName masturbating. I should walk in on her in her room when she's masturbating again.",
        where: [ setup.getLocationBySysName("momroom") ],
        whenTime: [ 5 ],
        whenDay: [ 0, 1, 4, 5, 6 ],
        active: false,
        check: "$player.flags.hasMomClip == true",
    },
    {
    	id: "mom_sabotage",
    	next: "mom_falseSympathy",
    	title: "Sabotage",
        task: "Ok, now that I have the money I need, it's time to sneak into $mom.callName's room at night and mess her work up.",
        where: [ setup.getLocationBySysName("momroom") ],
        whenTime: [ 6 ],
        whenDay: [ 0, 1, 2, 3, 4, 5, 6 ],
        active: false,
        needsEvent: true,
        passage: "Sabotage",
        returnPassage: "Hallway",
    },
    {
    	id: "mom_falseSympathy",
    	next: "mom_businessRelations",
    	title: "False Sympathy",
        task: "Now I just have to wait for $mom.callName to come back from work.",
        where: [ setup.getLocationBySysName("hallway") ],
        whenTime: [ 4 ],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "False Sympathy",
        device: { target: "mom", impact: 6 },
        returnPassage: "Hallway",
        requirements: ["setup.questDone('main_familyLandlordHelp')"],
        requirementsText: ["Finish the main quest \"Family's there for one another.\""],
        /* fired: she stays home on weekdays (Define Schedule), and no paycheck means no more $500 a week toward the rent */
        set: [ "setup.getMealById('false_sympathie').isActive = true", "setup.useRoutine('mom', 'weekday', 'stage0_fired')", "$mom.flags.rentHelp = false", "$locations[12].name = \"$boss.callName's Office\"" ],
    }, 
    {
    	id: "mom_businessRelations",
    	next: "mom_waitMainStage1",
    	title: "Business Relations",
        task: "I should talk to $mom.callName's boss again. I think we could profit from each other.",
        where: [ setup.getLocationBySysName("momswork") ],
        whenTime: [ 1, 2, 3, ],
        whenDay: [ 0, 1, 2, 3, 4 ],
        active: false,
        needsEvent: true,
        passage: "Business Relations",
        device: { target: "general", impact: 4 },
        returnPassage: "Moms Work",
        requirements: ["$player.money >= 5000"],
        requirementsText: ["Money >= 5000"],
    },      
    {
    	id: "mom_waitMainStage1",
    	next: "mom_ceoStruggles",
    	title: "Progress Main Quest",
        task: "Continue with the main Quest before you can continue $mom.callName's.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "setup.questDone('main_stage1')",
    },            
    {
    	id: "mom_ceoStruggles",
    	next: "mom_waitNewJobImpression",
    	title: "Being a CEO is hard...",
        task: "Three people depend on me now, and my back is starting to feel it. Maybe $mom.callName can help me unwind after work.",
        where: [ setup.getLocationBySysName("companystage1") ],
        whenTime: [4],
        whenDay: [0, 1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "CEO Struggles",
        returnPassage: $locations[13].passage,
        device: { key: "valenx", target: "mom", impact: 3 },
        requirements: [
            "setup.questDone('main_tooMuchWork')",
            "setup.questDone('main_tooMuchWork') && $date.dayCount >= setup.getQuestById('main_tooMuchWork').doneDay + 3",
        ],
        requirementsText: [
            "Hire your first employees",
            "Give them a few days to settle in",
        ],
        set: [ "setup.getTaskById('task_mom_private_attention').active = true" ], /* unlocks the "Private Attention" task */
        notify: [ "New task for $mom.callName: Private Attention" ],
    },
    {
    	id: "mom_waitNewJobImpression",
    	next: "mom_newJobImpression",
    	title: "Wait a few days...",
        task: "...",
        where: [ ],
        whenTime: [ ],
        whenDay:  [],
        active: false,
        check: "$date.dayCount >= setup.getQuestById('mom_ceoStruggles').doneDay + 3"
    },
    {
    	id: "mom_newJobImpression",
    	next: "mom_waitTestSessionRequest",
    	title: "How's your new job?",
        task: "Our first project is done. I should drop by $mom.callName's room in the evening and ask how she likes working for me.",
        where: [ setup.getLocationBySysName("momroom") ],
        whenTime: [4],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "New Job Impression",
        returnPassage: "Hallway",
        requirements: ["State.variables.company.projects.some((p) => p.timesCompleted > 0)"],
        requirementsText: ["Finish your first project"],
        /* finishing it opens her weekday Evening cells (rows 12-14) in the scheduler: see the task rows of
           the routine mom_stage1 in Define Schedule */
        notify: [ "$mom.callName's weekday evenings are open in the schedule now" ],
    },
    {
    	id: "mom_waitTestSessionRequest",
    	next: "mom_testSessionRequest",
    	title: "Wait till tomorrow",
        task: "...",
        where: [ ],
        whenTime: [ ],
        whenDay:  [ ],
        active: false,
        check: "$date.dayCount >= setup.getQuestById('mom_newJobImpression').doneDay + 1"
    },
    {
    	id: "mom_testSessionRequest",
    	next: "mom_controlSession",
    	title: "Can you help me a little more?",
        task: "$mom.callName wants to do more for the company. I could use a test subject who has no idea how $company.prototype.name works. I'll ask her to stay late and meet me in the meeting room.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [4],
        whenDay: [0, 1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "Test Session Request",
        returnPassage: $locations[13].passage,
        device: { key: "valenx", target: "mom", impact: 2 },
        set: [ "setup.getTaskById('task_mom_test_session').active = true" ], /* unlocks the "Test Session" task */
        notify: [ "New task for $mom.callName: Test Session" ],
    },
    {
    	/* the first test without the device: she undresses in my room because I ask her to. The last paragraph of
    	   the Test Session stage 3 scene reads questDone of this quest */
    	id: "mom_controlSession",
    	next: "mom_briefing",
    	title: "No stimulus",
        task: "Ten test sessions, and every one of them with $company.prototype.name doing the talking. I need to know what's left of all that when it's switched off. Tonight, in my room, with no box on the table.",
        where: [ setup.getLocationBySysName("bedroom") ],
        whenTime: [5],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Control Session",
        returnPassage: "Bedroom",
        requirements: [
            "setup.getTaskById('task_mom_test_session').count >= 10",
            "setup.corruptionTotal('mom') >= 40",
        ],
        requirementsText: [
            "Hold 10 test sessions with $mom.callName ({{Math.min(10, setup.getTaskById('task_mom_test_session').count)}}/10)",
            "$mom.callName needs 40 corruption ({{Math.min(40, setup.corruptionTotal('mom'))}}/40)",
        ],
    },
    {
    	/* Her first corruption milestone (stage 0 to 1, setup.corruptionStages in Define NPCs): the morning of the
    	   handover of the boss prototype. Two passages, The Briefing (meeting room, ends with the stage-up) and
    	   The Handover (the boss office, advances the quest). Finishing it unlocks the repeatable support project. */
    	id: "mom_briefing",
    	next: "mom_nightVisit",
    	title: "The Briefing",
        task: "$boss.callName's unit is finished, and the handover is on his floor, in front of his people. Before $mom.callName walks in there, I'll go through everything with her in the meeting room. What she says, and what she wears.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [1],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Briefing",
        returnPassage: $locations[13].passage,
        device: { key: "valenx", target: "mom", impact: 5 },
        requirements: [
            "setup.projectDone('project_boss_prototype')",
            "setup.corruptionReady('mom') || setup.corruptionStage('mom') >= 1",
        ],
        requirementsText: [
            "Finish $boss.callName's prototype",
            "$mom.callName's corruption is full",
        ],
        set: [ "setup.unlockProject('project_boss_support')" ],
    },
    {
    	/* A few nights after The Briefing, with her lust very high, she comes up to my room to take the handjob back.
    	   I turn the device all the way up and talk her into seeing it as her duty, and she does it again in my bed.
    	   Two passages, Night Visit and Night Visit 2. Finishing it unlocks the Handjob interaction (its requires in
    	   Define Interactions reads questDone of this quest) */
    	id: "mom_nightVisit",
    	next: "mom_boozeNight",
    	title: "A Knock at Night",
        task: "Since the morning of the handover, $mom.callName has been cleaning the kitchen until midnight again. Sooner or later she'll come upstairs to talk about it. When she does, I want $company.prototype.name in my desk drawer, calibrated to her and charged all the way.",
        lockedTask: "$mom.callName has been very cheerful since the handover. She's been cleaning a lot, too.",
        where: [ setup.getLocationBySysName("bedroom") ],
        whenTime: [5, 6],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Night Visit",
        returnPassage: "Bedroom",
        device: { key: "valenx", target: "mom", impact: 10 },
        requirements: [
            "$date.dayCount >= setup.getQuestById('mom_briefing').doneDay + 2",
            "$mom.stats.lust >= 80",
        ],
        requirementsText: [
            "Give her a few days after the handover",
            "$mom.callName needs 80 lust ({{Math.min(80, $mom.stats.lust)}}/80)",
        ],
        notify: [ "New interaction with $mom.callName: Ask her to take care of you" ],
    },

    /* ==== Stage 1, her line after A Knock at Night (STAGE1_PROPOSAL.md, section 5) ===============================
       STAGE1-STUB: everything from here to mom_end is structure only. The scene passages are empty stubs, and the
       requirements, timings and numbers are first guesses from the proposal. Each beat waits for the main beat of
       the same phase of the timeline (proposal section 8) with questDone. */
    {
    	/* 5.1 The breather: wine, the living room, no device. Unlocks catching her at home (micro events 46 to 48,
    	   setup.momCanBeCaught in Define Events); Caught is the scene that follows */
    	id: "mom_boozeNight",
    	next: "mom_caught",
    	title: "The Booze Night",
        task: "$mom.callName opened a bottle of wine on a weeknight. She only does that when she wants company and won't ask for it.",
        where: [ setup.getLocationBySysName("livingroom") ],
        whenTime: [5, 6],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Booze Night",
        returnPassage: "Living Room",
        requirements: [
            "$date.dayCount >= setup.getQuestById('mom_nightVisit').doneDay + 3",
        ],
        requirementsText: [
            "Give her a few days",
        ],
    },
    {
    	/* 5.2 I walk in on her in the meeting room, and the hardware engineer nearly walks in on us. Phase 2 (main_veil) */
    	id: "mom_caught",
    	next: "mom_flirtDuty",
    	title: "Caught",
        task: "$mom.callName has been slipping off to the meeting room on her own lately, and she always comes back a little flushed.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Caught",
        returnPassage: "Company Stage 1",
        requirements: [
            "setup.questDone('main_veil')",
        ],
        requirementsText: [
            "Progress the main quest",
        ],
    },
    {
    	/* 5.3 A comedy: I coach her in flirting with the staff. Activates task_mom_flirt_duty. Phase 3 (main_lateNight) */
    	id: "mom_flirtDuty",
    	next: "mom_notEnough",
    	title: "Flirt Duty",
        task: "The staff works harder when somebody makes them feel good about it. $mom.callName could be that somebody, if she still remembers how to flirt.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [1, 2],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Flirt Duty",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [
            "setup.questDone('main_lateNight')",
        ],
        requirementsText: [
            "Progress the main quest",
        ],
        set: [ "setup.getTaskById('task_mom_flirt_duty').active = true" ],
        notify: [ "New task for $mom.callName: Flirt Duty" ],
    },
    {
    	/* 5.4 Handjobs are not enough, she says no, I send her away. Starts the silence ($mom.flags.silence).
    	   Phase 4 (main_firstSale) */
    	id: "mom_notEnough",
    	next: "mom_silence",
    	title: "Not Enough",
        task: "$mom.callName is getting good at her rounds. Her rule about what happens in my room hasn't kept up.",
        where: [ setup.getLocationBySysName("bedroom") ],
        whenTime: [5],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Not Enough",
        returnPassage: "Bedroom",
        requirements: [
            "setup.questDone('main_firstSale')",
            "setup.getTaskById('task_mom_flirt_duty').count >= 3",
        ],
        requirementsText: [
            "Progress the main quest",
            "$mom.callName does her flirt duty rounds ({{Math.min(3, setup.getTaskById('task_mom_flirt_duty').count)}}/3)",
        ],
        set: [
            "$mom.flags.silence = true",
            "setup.getMealById('silence_breakfast').isActive = true",
            "setup.getMealById('silence_lasagna').isActive = true",
        ],
    },
    {
    	/* 5.5 A week of nothing, then it moves on by itself. What the week does (locked interactions, her attempts
    	   to make up, the guilt) is in The Silence in Define NPCs */
    	id: "mom_silence",
    	next: "mom_crawl",
    	title: "The Silence",
        task: "A week. No talking, no favors, no smiling at breakfast. She needs to find out what it's like when I stop needing her.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$date.dayCount >= setup.getQuestById('mom_notEnough').doneDay + 7",
        set: [
            "$mom.flags.silence = false",
            "setup.getMealById('silence_breakfast').isActive = false",
            "setup.getMealById('silence_lasagna').isActive = false",
        ],
    },
    {
    	/* 5.6 Friday, the empty office, her apology. Sets $mom.flags.morningRoutine, which unlocks the morning routine
    	   (Morning Routine, offered by Activity Sleep). Phase 5 (main_gymMeeting) */
    	id: "mom_crawl",
    	next: "mom_gymDinner",
    	title: "The Crawl",
        task: "It's Friday, the office empties out early, and $mom.callName has been working up to an apology all week.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [4, 5],
        whenDay: [4],
        active: false,
        needsEvent: true,
        passage: "The Crawl",
        returnPassage: "Company Stage 1",
        requirements: [ "setup.questDone('main_gymMeeting')" ],
        requirementsText: [ "Progress the main quest" ],
        set: [ "$mom.flags.morningRoutine = true", "setup.getMealById('crawl_thank_you').isActive = true" ],
    },
    {
    	/* 5.7 OPTIONAL: only if I sent her to the gym dinner (main_gymDinner sets $mom.flags.gymDinner).
    	   Her report when she comes home that night: Was that right? Stays an event, told like her end-of-day report */
    	id: "mom_gymDinner",
    	next: "mom_waitCatalystNight",
    	title: "Was That Right?",
        task: "$mom.callName had dinner with $gymOwner.name tonight because I sent her. She'll want to tell me how it went.",
        where: [ setup.getLocationBySysName("livingroom"), setup.getLocationBySysName("kitchen") ],
        whenTime: [5, 6],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Mom Gym Dinner Report",
        returnPassage: "Living Room",
        skip: "$mom.flags.gymDinner === false",
        requirements: [
            "setup.questDone('main_gymDinner')",
        ],
        requirementsText: [
            "Progress the main quest",
        ],
    },
    {
    	/* her Catalyst night (5.8) is part of the main event main_catalystNight */
    	id: "mom_waitCatalystNight",
    	next: "mom_calendar",
    	title: "Progress Main Quest",
        task: "Continue with the main quest before you can continue $mom.callName's.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "setup.questDone('main_catalystNight')",
    },
    {
    	/* 5.9 Milestone into stage 3 (Complicit). The choice sets $mom.flags.calendarChoice ("truth" or "anchor").
    	   Sets $mom.flags.freeUse, which unlocks the Whenever card (Define Interactions). On the anchor path the scene
    	   uses the Anchor through setup.useDevice (key valenxAnchor, target mom, impact 10) */
    	id: "mom_calendar",
    	next: "mom_afterHours",
    	title: "The Calendar",
        task: "$mom.callName keeps the company calendar, and this week she's been staring at it a lot.",
        lockedTask: "$mom.callName has been very quiet at her desk lately.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Calendar",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [
            "setup.projectDone('project_company_anchor')",
            "setup.deviceUsesLeft($company.devices.valenxAnchor) > 0",
            "$date.dayCount >= setup.getQuestById('main_catalystNight').doneDay + 3",
            "setup.corruptionReady('mom') || setup.corruptionStage('mom') >= 3",
        ],
        requirementsText: [
            "Finish the Anchor project",
            "The $company.devices.valenxAnchor.name has a use left",
            "Give her a few days after the Catalyst",
            "$mom.callName's corruption is full",
        ],
        set: [ "$mom.flags.freeUse = true" ],
        notify: [ "New interaction with $mom.callName: Whenever I want" ],
    },
    {
    	/* 5.10 OPTIONAL: only if I offer her to the boss (The Arrangement, boss_arrangement, sets
    	   $mom.flags.offeredToBoss). Her line waits here until that is decided (null), then plays it or skips it.
    	   The first of his Thursdays: it starts at our office after hours (she asks me, I say go), I drive her over and it
    	   ends at the door of his office. Not on the day of The Arrangement itself */
    	id: "mom_afterHours",
    	next: "mom_lastNight",
    	title: "After Hours",
        task: "Thursday evening. $boss.callName expects his consultant to stay late.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [4],
        whenDay: [3],
        active: false,
        needsEvent: true,
        passage: "After Hours",
        returnPassage: "Company Stage 1",
        skip: "$mom.flags.offeredToBoss === false",
        requirements: [
            "setup.questDone('boss_arrangement')",
            "$mom.flags.offeredToBoss === true",
            "setup.questDone('boss_arrangement') && $date.dayCount > setup.getQuestById('boss_arrangement').doneDay",
        ],
        requirementsText: [ "Settle things with $boss.callName", "Offer $mom.callName to $boss.callName", "Wait for his first Thursday" ],
    },
    {
    	/* 5.11 OPTIONAL: only if I offer them to the supplier (main_supplier sets $flags.supplierOffered).
    	   No event of its own: it is part of the main event main_nightShift, whose passage Last Night Mom advances it */
    	id: "mom_lastNight",
    	next: "mom_end",
    	title: "The Last Night",
        task: "Tonight she wears what I picked for her.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        skip: "$flags.supplierOffered === false",
        requirements: [ "setup.questDone('main_supplier')" ],
        requirementsText: [ "Progress the main quest" ],
    },
    {
    	id: "mom_end",
    	title: "End of Content - $mom.name",
        task: "This is the end for the current Version.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
    },
]>>


