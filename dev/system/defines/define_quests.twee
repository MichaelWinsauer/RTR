:: Define Quests [system] {"position":"875,0","size":"100,100"}
<<set $player.quests to [
	{
    	id: "main_meetSister",
    	next: "main_plan",
    	title: "Meet $sister.name",
        task: "It's time to catch up with $sister.callName.",
        where: [ setup.getLocationBySysName("livingroom") ],
        whenTime: [0, 1, 2, 3, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6 ],
        active: true,
        needsEvent: true,
        passage: "Meet Sister",
        returnPassage: "Living Room",
    },
    {
    	id: "main_plan",
    	next: "main_prototype40",
    	title: "Everyone needs a Plan",
        task: "I need a solid plan for the upcoming time.",   
        where: [ setup.getLocationBySysName("bedroom") ],
        whenTime: [0, 1, 2, 3, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6 ],
        active: false,
        needsEvent: true,
        passage: "Stage 0 Plan",
        returnPassage: "Bedroom",
        set: [ "$locations[7].open to [0, 1, 2, 3, 4, 5, 6]", "$flags.introDone = true" ],
    },
    {
    	id: "main_prototype40",
    	next: "main_testRunPrep",
    	title: "Work work work work work",
        task: "Get the progress of your $company.prototype.name prototype to 40.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$company.prototype.progress >= 40",
    },
    {
    	id: "main_testRunPrep",
    	next: "main_momRelation10",
    	title: "Prototype Test-Run Preparations",
        task: "Go to your Office and plan your Test-Run.",
        where: [ setup.getLocationBySysName("company") ],
        whenTime: [0, 1, 2, 3, 4, 5, ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Prototype Test-Run Preparation",
        returnPassage: "Company",
    },    
    {
    	id: "main_momRelation10",
    	next: "main_testRun",
    	title: "Further Preparations",
        task: "I have to strengthen my relationship with $mom.callName to at least 10.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$mom.stats.relation >= 10",
    },
    {
    	id: "main_testRun",
    	next: "main_continueMom",
    	title: "Prototype Test-Run",
        task: "Meet your $mom.relation in the Kitchen to test your prototype.",
        where: [ setup.getLocationBySysName("kitchen") ],
        whenTime: [ 4 ],
        whenDay: [ 0, 1, 2, 3, 4, 5, 6 ],
        active: false,
        needsEvent: true,
        passage: "Prototype Test-Run",
        device: { target: "mom", impact: 6 },
        returnPassage: "Bedroom",
    },      
    {
    	id: "main_continueMom",
    	next: "main_breakthrough",
    	title: "Continue $mom.callName's Quest",
        task: "Continue $mom.callName's ($mom.name $mom.surname) Quest",
        where: [ ],
        whenTime: [ ],
        whenDay: [ ],
        active: false,
    },          
    {
    	id: "main_breakthrough",
    	next: "main_prototype70",
    	title: "Breakthrough",
        task: "I can't believe it.",
        where: [ setup.getLocationBySysName("bedroom") ],
        whenTime: [ 5 ],
        whenDay: [ 0, 1, 2, 3, 4, 5, 6, ],
        active: false,
        needsEvent: true,
        passage: "Prototype Breakthrough",
        returnPassage: "Bedroom",
        set: [ 
        	"$company.prototype.maxProgress to 70", 
            "setup.activateQuest('sister_classProject')"
        ],
    },
    {
    	id: "main_prototype70",
    	next: "main_moreTimeNeeded",
    	title: "Things are getting started!",
        task: "Now that I'm sure that my prototype actually works, I should continue to work on it! [Progress to 70]",
        where: [ ],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$company.prototype.progress >= 70",
    },    
    {
    	id: "main_moreTimeNeeded",
    	next: "main_officeOutreach",
    	title: "More time needed",
        task: "Money's getting tight if I want to spend more time on my prototype. Maybe I can use my prototype on $sister.name to help me out a little...",
        where: [ setup.getLocationBySysName("sisterroom")],
        whenTime: [ 3, ],
        whenDay: [ 0, 1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "More Time Needed",
        device: { target: "sister", impact: 4 },
        returnPassage: "Living Room",
        set: [ "$sister.flags.doesChores to true" ],
        requirements: ["$sister.stats.relation >= 25"],
        requirementsText: ["$sister.name's relation >= 25"],
    },
    {
    	id: "main_officeOutreach",
    	next: "main_differentApproach",
    	title: "Office Outreach",
        task: "Now that I've enough time to focus on my prototype, I should try to advertise to some new clients!",
        where: [ setup.getLocationBySysName("company") ],
        whenTime: [ 2, ],
        whenDay: [ 0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Office Outreach",
        returnPassage: "Company",
    },
    {
    	id: "main_differentApproach",
    	next: "main_dinerSuggestion",
    	title: "Different approach",
        task: "Just writing mails won't work. I need connections, but how do I get those? Maybe $sister.name has an Idea",
        where: [ setup.getLocationBySysName("sisterroom") ],
        whenTime: [ 4, 5, ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Different Approach",
        returnPassage: "Bedroom",
        requirements: ["setup.questDone('sister_partyAnimal')"],
        requirementsText: ["Finish $sister.name's quest \"Party Animal\""],
    },
    {
    	id: "main_dinerSuggestion",
    	next: "main_prototype100",
    	title: "Not a bad Idea",
        task: "Honestly don't know why I didn't thought of that on my own. Anyway, I should talk to my manager at the Diner about my prototype. I should also get the prototype ready for the talk...",
        where: [ setup.getLocationBySysName("diner") ],
        whenTime: [ 3 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Diner Suggestion",
        returnPassage: "Diner",
        set: [ "$company.prototype.maxProgress = 100" ],
        requirements: ["setup.questReached('sister_conflictingFeelings')"],
        requirementsText: ["Reach $sister.callName's quest \"Conflicting feelings\""],
    },
    {
    	id: "main_prototype100",
    	next: "main_dinerTestRun",
    	title: "Time to Finish",
        task: "It's time to complete my prototype before I run the first offial test with strangers. [Progress to 100]",
        where: [ ],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$company.prototype.progress >= 100",
    },
    {
    	id: "main_dinerTestRun",
    	next: "main_expansionRequest",
    	title: "The time has come.",
        task: "Okay, with my Prototype finished, it's time to try my prototype in the real world. Fingers crossed.",
        where: [ setup.getLocationBySysName("diner") ],
        whenTime: [ 1 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Diner Test-Run",
        device: { target: "general", impact: 6 },
        returnPassage: "Diner",
    },
    {
    	id: "main_expansionRequest",
    	next: "main_homeRelations",
    	title: "Time to Expand",
        task: "Nice, now that I finally have a stable client, I should talk to $landlord.callName to get a larger Office, so I can hire employees!",
        where: [ setup.getLocationBySysName("company") ],
        whenTime: [ 1 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Landlord Expansion Request",
        returnPassage: "Company",
    },
    {
    	id: "main_homeRelations",
    	next: "main_familyLandlordHelp",
    	title: "Home Relations",
        task: "Progress $mom.callName's & $sister.callName's [Relation to 40] and [Corruption to 30]",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$mom.stats.relation >= 40 && setup.corruptionTotal('mom') >= 30 && $sister.stats.relation >= 40 && setup.corruptionTotal('sister') >= 30",
    },
    {
    	id: "main_familyLandlordHelp",
    	next: "main_waitLandlord",
    	title: "Family's there for one another.",
        task: "I need $mom.callName and $sister.callName to convince $landlord.callName.",
        where: [ setup.getLocationBySysName("livingroom") ],
        whenTime: [ 4 ],
        whenDay: [ 6 ],
        active: false,
        needsEvent: true,
        passage: "Family Landlord Help",
        returnPassage: "Residential Area",
        set: [ "$waitForLandlordMessage to $date.dayCount" ],
    },
    {
    	id: "main_waitLandlord",
    	next: "main_stage1",
    	title: "Wait on $landlord.callName Message",
        task: "Fuck yeah, with my first client now, I can finally really get things rolling. I need to prepare the expansion of my Company!",
        where: [ ],
        whenTime: [ ],
        whenDay: [ ],
        active: false,
        check: "$waitForLandlordMessage + 3 <= $date.dayCount"
    },
    {
    	id: "main_stage1",
    	next: "main_finishingRenovations",
    	title: "Stage 1",
        task: "It's time to finally pay up the renovations and move into a larger office! [Money 10000]",
        where: [ setup.getLocationBySysName("company") ],
        whenTime: [0, 1, 2, 3, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Stage 1",
        returnPassage: "Company Stage 1",
        requirements: [
        	"setup.questDone('sister_internshipSeason')",
            "setup.questDone('mom_businessRelations')",
            "$player.money >= 10000",
        ],
        requirementsText: [
        	"Finish $sister.callName's quest \"Internship season!\"",
            "\nFinish $mom.callName's quest \"Business Relations\"",
            "\nMoney >= 10000",
        ],
        set: ["$companyLocationIdReference = 13"]
    },    
    {
    	id: "main_finishingRenovations",
    	next: "main_tooMuchWork",
    	title: "Finishing Renovations",
        task: "It's been a week since I got the new office. It was quite a lot of work but worth it in the end...",
        where: [ setup.getLocationBySysName("companystage1") ],
        whenTime: [0, 1, 2, 3, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Finishing Renovations",
        returnPassage: "Company Stage 1",
    },
    {
    	id: "main_tooMuchWork",
    	next: "main_officialProductMeeting",
    	title: "Too Much Work",
        task: "I should answer all of my mails.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [1, 2, 3, 4, 5],
        whenDay: [0, 1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "Too Much Work",
        returnPassage: "Company Stage 1",
        requirements: [
            "$company.mails[0].answered == true",
            "$company.mails[1].answered == true",
            "$company.mails[2].answered == true",
        ],
        requirementsText: [
        	"Answer $landlord.callName's Mail.",
            "Answer $boss.callName's Mail.",
            "Answer $manager.callName's Mail.",
        ],
        set: [
            "$company.employees.push($ethan)",
            "$company.employees.push($brian)",
            "$company.employees.push($darius)"
        ],
    },
    {
    	id: "main_officialProductMeeting",
    	next: "main_end",
    	title: "It'll be official",
        task: "Let's have a meeting to talk with everyone about the next step.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [1, 2, 3, 4, 5],
        whenDay: [1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "Official Product Meeting",
        returnPassage: "Company Stage 1",
        requirements: [
            "setup.projectDone('project_boss_prototype')",
            "setup.projectDone('project_diner_analysis')",
        ],
        requirementsText: [
        	"Finish $boss.callName's Project",
        	"Finish $manager.callName's Project",
        ],
        set: [  "setup.unlockProject('project_company_official')" ], /* shows the product project in the overview */
    },
    {
    	id: "main_end",
    	title: "End of Content - Main",
        task: "This is the end for the current Version.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
    },
]>>

<<set $mom.quests to [
	{
    	id: "mom_stressRelief",
    	next: "mom_relation25",
    	title: "$mom.callName Stress Relief",
        task: "I should check if I can catch her masturbating!",
        where: [ setup.getLocationBySysName("momroom") ],
        whenTime: [ 5, ],
        whenDay: [ 0, 1, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Mom Bed Masturbation",
        returnPassage: "Hallway",
    },
    {
    	id: "mom_relation25",
    	next: "mom_wakingTroubles",
    	title: "$mom.callName's relation",
        task: "I have to strengthen my relationship with $mom.callName to at least 25.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$mom.stats.relation >= 25",
    },
    {
    	id: "mom_wakingTroubles",
    	next: "mom_waitRent",
    	title: "Waking Troubles",
        task: "I should try to use $company.prototype.name on her again, now that we have a stronger relationship.",
        where: [ setup.getLocationBySysName("momroom"), setup.getLocationBySysName("livingroom"), setup.getLocationBySysName("kitchen") ],
        whenTime: [0, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Waking Troubles",
        device: { target: "mom", impact: 4 },
        returnPassage: "Bedroom",
        set: [ "$mom.flags.wakeUp = true" ],
    },
    {
    	id: "mom_waitRent",
    	next: "mom_hereToHelp",
    	title: "Waiting...",
        task: "Wait until after you paid this weeks rent.",
        where: [ ],
        whenTime: [ ],
        whenDay: [ ],
        active: false,
    },    
    {
    	id: "mom_hereToHelp",
    	next: "mom_waitMainOutreach",
    	title: "$mom.callName's here to help",
        task: "I should talk to her again in her room.",
        where: [ setup.getLocationBySysName("momroom") ],
        whenTime: [0, 1, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6 ],
        active: false,
        needsEvent: true,
        passage: "Mom's here to help",
        device: { target: "mom", impact: 4 },
        returnPassage: "Mom Room",
        set: [ "$mom.flags.rentHelp to true" ]
    },    
    {
    	id: "mom_waitMainOutreach",
    	next: "mom_descent",
    	title: "Progress Main Quest",
        task: "Continue with the main Quest before you can continue $mom.callName's.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "setup.questReached('main_officeOutreach')",
    },
    {
    	id: "mom_descent",
    	next: "mom_hasItTough",
    	title: "Descent",
        task: "Increase your [Corruption to 35]",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$player.stats.corruption >= 35",
    },
    {
    	id: "mom_hasItTough",
    	next: "mom_helpfulSon",
    	title: "$mom.callName has it tough.",
        task: "Catch $mom.callName in the living room in the evening. She's had a rough few days lately.",
        where: [ setup.getLocationBySysName("livingroom") ],
        whenTime: [ 4 ],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Mom Has It Tough",
        returnPassage: "Living Room",
        set: [ "$mom.flags.workUnlocked = true" ],
    },
    {
    	id: "mom_helpfulSon",
    	next: "mom_firstConfrontation",
    	title: "The Helpful $mom.playerRelation",
        task: "So $mom.callName's having trouble at work. I offered her to help her with my prototype at work, so I should meet her at her workplace to help her unwind a little...",
        where: [ setup.getLocationBySysName("momswork") ],
        whenTime: [ 1, 2, 3 ],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Helpful Son",
        device: { target: "mom", impact: 8 },
        returnPassage: "Residential Area",
    },
    {
    	id: "mom_firstConfrontation",
    	next: "mom_waitBoss",
    	title: "First Confrontation",
        task: "Damn, I just experienced first hand how terrible her boss really is. I will manipulate him using my prototype to shut him up for good!",
        where: [ setup.getLocationBySysName("momswork") ],
        whenTime: [ 1, 2, 3 ],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "First Boss Confrontation",
        device: { target: "general", impact: 6 },
        returnPassage: "Moms Work",
        set: [ "$bossTalkedOnDay to $date.dayCount" ],
        requirements: ["$company.prototype.progress >= 40"],
        requirementsText: ["Prototype Progress >= 40"],
    },
    {
    	id: "mom_waitBoss",
    	next: "mom_hasItToughAgain",
    	title: "Waiting",
        task: "I should wait a few days and see if all this has made any difference...",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$date.dayCount >= $bossTalkedOnDay + 3"
    },
    {
    	id: "mom_hasItToughAgain",
    	next: "mom_secondConfrontation",
    	title: "$mom.callName Has It Tough Again",
        task: "I should enter her room in the evening. She seems down lately again.",
        where: [ setup.getLocationBySysName("momroom") ],
        whenTime: [ 4, 5, 6 ],
        whenDay: [ 0, 1, 2, 3, 4 ],
        active: false,
        needsEvent: true,
        passage: "Mom Has It Tough Again",
        device: { target: "mom", impact: 7 },
        returnPassage: "Hallway",
        requirements: ["$player.stats.corruption >= 15"],
        requirementsText: ["Corruption >= 15"],
    },    
    {
    	id: "mom_secondConfrontation",
    	next: "mom_agreement",
    	title: "Second Confrontation",
        task: "Fuck, I really made things worse. Okay, fuck this guy, I'll make him agree!",
        where: [ setup.getLocationBySysName("momswork") ],
        whenTime: [ 1, 2, 3 ],
        whenDay: [ 0, 1, 2, 3, 4 ],
        active: false,
        needsEvent: true,
        passage: "Second Boss Confrontation",
        device: { target: "general", impact: 8 },
        returnPassage: "Moms Work",        
        requirements: ["$company.prototype.progress >= 70"],
        requirementsText: ["Prototype progress >= 70"],
    },
    {
    	id: "mom_agreement",
    	next: "mom_agreement2",
    	title: "Agreement",
        task: "$mom.callName's Boss and I came to an agreement afterall. Though I have to get $5000 now and a short clip of $mom.callName masturbating... I'll focus on the money first.",
        where: [ ],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$player.money >= 5000",
    },
    {
    	id: "mom_agreement2",
    	next: "mom_sabotage",
    	title: "Agreement 2",
        task: "Now for the short Video of $mom.callName masturbating. I should walk in on her in her room when she's masturbating again.",
        where: [ setup.getLocationBySysName("momroom") ],
        whenTime: [ 5 ],
        whenDay: [ 0, 1, 4, 5, 6 ],
        active: false,
        check: "$player.flags.hasMomClip == true",
    },
    {
    	id: "mom_sabotage",
    	next: "mom_falseSympathy",
    	title: "Sabotage",
        task: "Ok, now that I have the money I need, it's time to sneak into $mom.callName's room at night and mess her work up.",
        where: [ setup.getLocationBySysName("momroom") ],
        whenTime: [ 6 ],
        whenDay: [ 0, 1, 2, 3, 4, 5, 6 ],
        active: false,
        needsEvent: true,
        passage: "Sabotage",
        returnPassage: "Hallway",
    },
    {
    	id: "mom_falseSympathy",
    	next: "mom_businessRelations",
    	title: "False Sympathy",
        task: "Now I just have to wait for $mom.callName to come back from work.",
        where: [ setup.getLocationBySysName("hallway") ],
        whenTime: [ 4 ],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "False Sympathy",
        device: { target: "mom", impact: 6 },
        returnPassage: "Hallway",
        requirements: ["setup.questDone('main_familyLandlordHelp')"],
        requirementsText: ["Finish the main quest \"Family's there for one another.\""],
    }, 
    {
    	id: "mom_businessRelations",
    	next: "mom_waitMainStage1",
    	title: "Business Relations",
        task: "I should talk to $mom.callName's boss again. I think we could profit from each other.",
        where: [ setup.getLocationBySysName("momswork") ],
        whenTime: [ 1, 2, 3, ],
        whenDay: [ 0, 1, 2, 3, 4 ],
        active: false,
        needsEvent: true,
        passage: "Business Relations",
        device: { target: "general", impact: 4 },
        returnPassage: "Moms Work",
        requirements: ["$player.money >= 5000"],
        requirementsText: ["Money >= 5000"],
    },      
    {
    	id: "mom_waitMainStage1",
    	next: "mom_ceoStruggles",
    	title: "Progress Main Quest",
        task: "Continue with the main Quest before you can continue $mom.callName's.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "setup.questDone('main_stage1')",
    },            
    {
    	id: "mom_ceoStruggles",
    	next: "mom_waitNewJobImpression",
    	title: "Being a CEO is hard...",
        task: "Three people depend on me now, and my back is starting to feel it. Maybe $mom.callName can help me unwind after work.",
        where: [ setup.getLocationBySysName("companystage1") ],
        whenTime: [4],
        whenDay: [0, 1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "CEO Struggles",
        returnPassage: $locations[13].passage,
        device: { key: "valenx", target: "mom", impact: 3 },
        requirements: [
            "setup.questDone('main_tooMuchWork')",
            "setup.questDone('main_tooMuchWork') && $date.dayCount >= setup.getQuestById('main_tooMuchWork').doneDay + 3",
        ],
        requirementsText: [
            "Hire your first employees",
            "Give them a few days to settle in",
        ],
        set: [ "setup.getTaskById('task_mom_private_attention').active = true" ], /* unlocks the "Private Attention" task */
    },
    {
    	id: "mom_waitNewJobImpression",
    	next: "mom_newJobImpression",
    	title: "Wait a few days...",
        task: "...",
        where: [ ],
        whenTime: [ ],
        whenDay:  [],
        active: false,
        check: "$date.dayCount >= setup.getQuestById('mom_ceoStruggles').doneDay + 3"
    },
    {
    	id: "mom_newJobImpression",
    	next: "mom_waitTestSessionRequest",
    	title: "How's your new job?",
        task: "Our first project is done. I should drop by $mom.callName's room in the evening and ask how she likes working for me.",
        where: [ setup.getLocationBySysName("momroom") ],
        whenTime: [4],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "New Job Impression",
        returnPassage: "Hallway",
        requirements: ["State.variables.company.projects.some((p) => p.timesCompleted > 0)"],
        requirementsText: ["Finish your first project"],
        /* finishing it opens her weekday Evening cells (rows 12-14) in the scheduler: see the task rows of
           the routine mom_stage1 in Define Schedule */
    },
    {
    	id: "mom_waitTestSessionRequest",
    	next: "mom_testSessionRequest",
    	title: "Wait till tomorrow",
        task: "...",
        where: [ ],
        whenTime: [ ],
        whenDay:  [ ],
        active: false,
        check: "$date.dayCount >= setup.getQuestById('mom_newJobImpression').doneDay + 1"
    },
    {
    	id: "mom_testSessionRequest",
    	next: "mom_controlSession",
    	title: "Can you help me a little more?",
        task: "$mom.callName wants to do more for the company. I could use a test subject who has no idea how $company.prototype.name works. I'll ask her to stay late and meet me in the meeting room.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [4],
        whenDay: [0, 1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "Test Session Request",
        returnPassage: $locations[13].passage,
        device: { key: "valenx", target: "mom", impact: 2 },
        set: [ "setup.getTaskById('task_mom_test_session').active = true" ], /* unlocks the "Test Session" task */
    },
    {
    	/* the first test without the device: she undresses in my room because I ask her to. The last paragraph of
    	   the Test Session stage 3 scene reads questDone of this quest */
    	id: "mom_controlSession",
    	next: "mom_briefing",
    	title: "No stimulus",
        task: "Ten test sessions, and every one of them with $company.prototype.name doing the talking. I need to know what's left of all that when it's switched off. Tonight, in my room, with no box on the table.",
        where: [ setup.getLocationBySysName("bedroom") ],
        whenTime: [5],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Control Session",
        returnPassage: "Bedroom",
        requirements: [
            "setup.getTaskById('task_mom_test_session').count >= 10",
            "setup.corruptionTotal('mom') >= 40",
            "setup.npcNow('mom').location && setup.inLocations(setup.npcNow('mom').location.sysName, ['home'])",
        ],
        requirementsText: [
            "Hold 10 test sessions with $mom.callName ({{Math.min(10, setup.getTaskById('task_mom_test_session').count)}}/10)",
            "$mom.callName needs 40 corruption ({{Math.min(40, setup.corruptionTotal('mom'))}}/40)",
            "$mom.callName has to be home",
        ],
    },
    {
    	/* Her first corruption milestone (stage 0 to 1, setup.corruptionStages in Define NPCs): the morning of the
    	   handover of the boss prototype. Two passages, The Briefing (meeting room, ends with the stage-up) and
    	   The Handover (the boss office, advances the quest). Finishing it unlocks the repeatable support project. */
    	id: "mom_briefing",
    	next: "mom_nightVisit",
    	title: "The Briefing",
        task: "$boss.callName's unit is finished, and the handover is on his floor, in front of his people. Before $mom.callName walks in there, I'll go through everything with her in the meeting room. What she says, and what she wears.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [1],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Briefing",
        returnPassage: $locations[13].passage,
        device: { key: "valenx", target: "mom", impact: 5 },
        requirements: [
            "setup.projectDone('project_boss_prototype')",
            "setup.corruptionReady('mom') || setup.corruptionStage('mom') >= 1",
        ],
        requirementsText: [
            "Finish $boss.callName's prototype",
            "$mom.callName's corruption is full",
        ],
        set: [ "setup.unlockProject('project_boss_support')" ],
    },
    {
    	/* A few nights after The Briefing, with her lust very high, she comes up to my room to take the handjob back.
    	   I turn the device all the way up and talk her into seeing it as her duty, and she does it again in my bed.
    	   Two passages, Night Visit and Night Visit 2. Finishing it unlocks the Handjob interaction (its requires in
    	   Define Interactions reads questDone of this quest) */
    	id: "mom_nightVisit",
    	next: "mom_end",
    	title: "A Knock at Night",
        task: "Since the morning of the handover, $mom.callName has been cleaning the kitchen until midnight again. Sooner or later she'll come upstairs to talk about it. When she does, I want $company.prototype.name in my desk drawer, calibrated to her and charged all the way.",
        lockedTask: "$mom.callName has been very cheerful since the handover. She's been cleaning a lot, too.",
        where: [ setup.getLocationBySysName("bedroom") ],
        whenTime: [5, 6],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Night Visit",
        returnPassage: "Bedroom",
        device: { key: "valenx", target: "mom", impact: 10 },
        requirements: [
            "$date.dayCount >= setup.getQuestById('mom_briefing').doneDay + 2",
            "$mom.stats.lust >= 80",
            "setup.npcNow('mom').location && setup.inLocations(setup.npcNow('mom').location.sysName, ['home'])",
        ],
        requirementsText: [
            "Give her a few days after the handover",
            "$mom.callName needs 80 lust ({{Math.min(80, $mom.stats.lust)}}/80)",
            "$mom.callName has to be home",
        ],
    },
    {
    	id: "mom_end",
    	title: "End of Content - $mom.name",
        task: "This is the end for the current Version.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
    },
]>>


