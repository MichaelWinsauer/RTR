<<set $quests to [

]>>

/* The quest each line starts with. "quest" always holds the id of the line's current quest,
   <<NextQuest>> moves it along the "next" ids. */
<<set $player.quest to "main_meetSister">>
<<set $mom.quest to "mom_stressRelief">>
<<set $sister.quest to "sister_classProject">>
<<set $prof.quest to "prof_waitFirstProjects">>

/* Quests that use the device: device: { target, impact [, key] [, minQuality] }
   key:        a device in $company.devices (Stage 1). Without it the Stage 0 prototype is used.
   target:     the calibration the scene needs (mom, sister, general, or a preset of that device)
   impact:     1-10, the charge it costs (see $company.impactCost)
   minQuality: optional, the calibration quality needed. Without it any successful calibration counts.
   Checked separately from "requirements" (event check, eligible glow) and shown as pills on the sidebar quest.
   The scene spends the charge itself with <<UseQuestDevice $mom>> (see "Quest Widgets").
   setup.questDevice(device) returns { dev, cost, calOk, chargeOk, ok } for the current state. */
<<set setup.questDevice = (device) => {
    const v = State.variables;
    const dev = device.key ? v.company.devices[device.key] : v.company.prototype;
    const cost = v.company.impactCost[device.impact] || 0;
    const calOk = !!dev && dev.calibration === device.target && dev.calibrationQuality >= (device.minQuality || 1);
    const chargeOk = !!dev && dev.charge >= cost;
    return { dev, cost, calOk, chargeOk, ok: calOk && chargeOk };
}>>


<<set setup.getActiveQuests = () => {
    let result = [];

    setup.getQuestLines().forEach((line) => {
        line.quests.forEach((quest) => {
            if(quest.active) {
                result.push(quest);
            }
        });
    });

    return result;
}>>


<<set setup.getEligibleQuests = () => {
    const v = State.variables;
    const day = v.date.today.value;
    const time = v.time.current.value;

    const result = [];
    setup.getQuestLines().forEach((character) => {
        character.quests.forEach((quest) => {
            if (quest.active
                && quest.whenDay && quest.whenDay.includes(day)
                && quest.whenTime && quest.whenTime.includes(time)
                && setup.questRequirementsMet(quest)
                && (!quest.device || setup.questDevice(quest.device).ok)) {
                result.push(quest);
            }
        });
    });

    return result;
}>>

/* Locked quests ===============================================================
   While the requirements of a quest are not met yet (the device does not count), the sidebar card and the
   CMD header do not show its title, task, place, day and time, so nothing gets spoiled. They show
   setup.questLockedText instead, and the requirements checklist stays visible so the player knows what to do.
   A quest can bring its own stand-in text with the optional fields
       lockedTitle   "Something about $sister.callName"
       lockedTask    "She has been acting strange lately."
   setup.questRequirementsMet(quest)   every requirements string is true (true without requirements)
   setup.questLocked(quest)            it has requirements and they are not met yet
   setup.questDisplay(quest)           { title, task, locked }: what the UI shows for it right now */
<<set setup.questLockedText to {
    title: "Not yet available...",
    task: "",
}>>

<<set setup.questRequirementsMet = (quest) => {
    if (!quest || !quest.requirements) { return true; }
    return quest.requirements.every((req) => !!Scripting.evalTwineScript(req));
}>>

<<set setup.questLocked = (quest) => {
    return !!quest && !!quest.requirements && quest.requirements.length > 0 && !setup.questRequirementsMet(quest);
}>>

<<set setup.questDisplay = (quest) => {
    if (setup.questLocked(quest)) {
        return {
            title: quest.lockedTitle || setup.questLockedText.title,
            task: quest.lockedTask || setup.questLockedText.task,
            locked: true,
        };
    }
    return { title: quest.title, task: quest.task, locked: false };
}>>

/* Live counters in requirement texts ===========================================
   A requirementsText entry may hold {{TwineScript}}, which is replaced by its value whenever the text is shown
   (sidebar card, CMD header, profile): "Hold 10 test sessions ({{setup.getTaskById(...).count}}/10)".
   (A print macro in there would close the set macro that defines the quests, so it can not be used.)
   setup.questRequirementText(quest, i)   the i-th requirement text with its counters filled in */
<<set setup.questRequirementText = (quest, i) => {
    const raw = ((quest && quest.requirementsText) || [])[i];
    if (raw == null) { return ""; }
    return String(raw).replace(/\{\{(.+?)\}\}/g, (match, code) => {
        try { return String(Scripting.evalTwineScript(code)); }
        catch (e) { console.error('setup.questRequirementText: "' + code + '" failed: ' + e.message); return "?"; }
    });
}>>

/* Shortens runs of consecutive values: [0,1,2,3,4] with day labels gives "Mon-Fri", [5,6] gives "Sat, Sun". */
<<set setup.formatRuns = (values, labels) => {
    const sorted = [...new Set(values)].sort((a, b) => a - b);
    const runs = [];
    sorted.forEach((value) => {
        const last = runs[runs.length - 1];
        if (last && value === last.end + 1) {
            last.end = value;
        } else {
            runs.push({ start: value, end: value });
        }
    });
    return runs.map((run) => {
        if (run.start === run.end) { return labels[run.start]; }
        if (run.end === run.start + 1) { return labels[run.start] + ", " + labels[run.end]; }
        return labels[run.start] + "–" + labels[run.end];
    }).join(", ");
}>>

/* Quest lookup ================================================================
   Every quest has a unique string id ("main_...", "mom_...", "sister_...") and the id of the quest
   that follows it in "next" (the last quest of a line has none). Never reference quests by array index.

   setup.questLines            the characters that own a quest line. Add a new one here and the
                               helpers, events, checks, the sidebar and the CMD header pick it up.
                               A new line needs: <<set $<key>.quests to [ ... ]>> above, its start with
                               <<set $<key>.quest to "id">>, a "<key>_end" quest, and a portrait at
                               images/characters/portraits/<key>.jpg (sidebar card, CMD header).
                               Optional: a ring color for its CMD header chip (.cmd-quest[data-line] in CMD Header).
   setup.getQuestLines()       those characters' objects ($player, $mom, ...)
   setup.questLineLabel(key)   who a line belongs to, for notifications: "" for the main line, else the callName

   A quest with hidden: true runs like any other (check, set, events) but is never shown: no sidebar card,
   no CMD header chip. For background waits at the start of a line that the player should not know about yet.
   setup.getQuestById(id)      the quest with that id, from any line
   setup.getQuestLine(id)      the character whose line contains that quest
   setup.getCurrentQuest($mom) the quest the line is on right now (it can still be inactive)
   setup.questDone(id)         true once <<NextQuest>> moved past that quest
   setup.questReached(id)      true when the quest is the current one or done
   setup.activateQuest(id)     sets the quest active, and its event if it has one */
<<set setup.questLines = ["player", "mom", "sister", "prof"]>>

<<set setup.getQuestLines = () => {
    return setup.questLines.map((key) => State.variables[key]);
}>>

<<set setup.questLineLabel = (key) => {
    if (key === "player") { return ""; }
    const owner = State.variables[key];
    return owner ? (owner.callName || owner.name || key) : key;
}>>

<<set setup.getQuestById = ((id) => {
    for (const line of setup.getQuestLines()) {
        const quest = line.quests.find((q) => q.id === id);
        if (quest) { return quest; }
    }
    console.error('setup.getQuestById: there is no quest with the id "' + id + '"');
    return undefined;
})>>

<<set setup.getQuestLine = ((id) => {
    return setup.getQuestLines().find((line) => line.quests.some((q) => q.id === id));
})>>

<<set setup.getCurrentQuest = ((character) => {
    return setup.getQuestById(character.quest);
})>>

<<set setup.questDone = ((id) => {
    const quest = setup.getQuestById(id);
    return !!(quest && quest.done);
})>>

<<set setup.questReached = ((id) => {
    const line = setup.getQuestLine(id);
    return setup.questDone(id) || (!!line && line.quest === id);
})>>

<<set setup.activateQuest = ((id) => {
    const quest = setup.getQuestById(id);
    if (!quest) { return; }
    quest.active = true;
    if (quest.eventId != null) {
        State.variables.events[quest.eventId].active = true;
    }
})>>

/* Needs the helpers above, so it runs last. */
<<GenerateEventsForQuests>>
