:: Define Quests [system] {"position":"875,0","size":"100,100"}
<<set $player.quests to [
	{
    	id: "main_meetSister",
    	next: "main_plan",
    	title: "Meet $sister.name",
        task: "It's time to catch up with $sister.callName.",
        where: [ setup.getLocationBySysName("livingroom") ],
        whenTime: [0, 1, 2, 3, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6 ],
        active: true,
        needsEvent: true,
        passage: "Meet Sister",
        returnPassage: "Living Room",
    },
    {
    	id: "main_plan",
    	next: "main_prototype40",
    	title: "Everyone needs a Plan",
        task: "I need a solid plan for the upcoming time.",   
        where: [ setup.getLocationBySysName("bedroom") ],
        whenTime: [0, 1, 2, 3, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6 ],
        active: false,
        needsEvent: true,
        passage: "Stage 0 Plan",
        returnPassage: "Bedroom",
        set: [ "$locations[7].open to [0, 1, 2, 3, 4, 5, 6]", "$flags.introDone = true" ],
    },
    {
    	id: "main_prototype40",
    	next: "main_testRunPrep",
    	title: "Work work work work work",
        task: "Get the progress of your $company.prototype.name prototype to 40.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$company.prototype.progress >= 40",
    },
    {
    	id: "main_testRunPrep",
    	next: "main_momRelation10",
    	title: "Prototype Test-Run Preparations",
        task: "Go to your Office and plan your Test-Run.",
        where: [ setup.getLocationBySysName("company") ],
        whenTime: [0, 1, 2, 3, 4, 5, ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Prototype Test-Run Preparation",
        returnPassage: "Company",
    },    
    {
    	id: "main_momRelation10",
    	next: "main_testRun",
    	title: "Further Preparations",
        task: "I have to strengthen my relationship with $mom.callName to at least 10.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$mom.stats.relation >= 10",
    },
    {
    	id: "main_testRun",
    	next: "main_continueMom",
    	title: "Prototype Test-Run",
        task: "Meet your $mom.relation in the Kitchen to test your prototype.",
        where: [ setup.getLocationBySysName("kitchen") ],
        whenTime: [ 4 ],
        whenDay: [ 0, 1, 2, 3, 4, 5, 6 ],
        active: false,
        needsEvent: true,
        passage: "Prototype Test-Run",
        device: { target: "mom", impact: 6 },
        returnPassage: "Bedroom",
    },      
    {
    	id: "main_continueMom",
    	next: "main_breakthrough",
    	title: "Continue $mom.callName's Quest",
        task: "Continue $mom.callName's ($mom.name $mom.surname) Quest",
        where: [ ],
        whenTime: [ ],
        whenDay: [ ],
        active: false,
    },          
    {
    	id: "main_breakthrough",
    	next: "main_prototype70",
    	title: "Breakthrough",
        task: "I can't believe it.",
        where: [ setup.getLocationBySysName("bedroom") ],
        whenTime: [ 5 ],
        whenDay: [ 0, 1, 2, 3, 4, 5, 6, ],
        active: false,
        needsEvent: true,
        passage: "Prototype Breakthrough",
        returnPassage: "Bedroom",
        set: [ 
        	"$company.prototype.maxProgress to 70", 
            "setup.activateQuest('sister_classProject')"
        ],
    },
    {
    	id: "main_prototype70",
    	next: "main_moreTimeNeeded",
    	title: "Things are getting started!",
        task: "Now that I'm sure that my prototype actually works, I should continue to work on it! [Progress to 70]",
        where: [ ],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$company.prototype.progress >= 70",
    },    
    {
    	id: "main_moreTimeNeeded",
    	next: "main_officeOutreach",
    	title: "More time needed",
        task: "Money's getting tight if I want to spend more time on my prototype. Maybe I can use my prototype on $sister.name to help me out a little...",
        where: [ setup.getLocationBySysName("sisterroom")],
        whenTime: [ 3, ],
        whenDay: [ 0, 1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "More Time Needed",
        device: { target: "sister", impact: 4 },
        returnPassage: "Living Room",
        set: [ "$sister.flags.doesChores to true" ],
        requirements: ["$sister.stats.relation >= 25"],
        requirementsText: ["$sister.name's relation >= 25"],
    },
    {
    	id: "main_officeOutreach",
    	next: "main_differentApproach",
    	title: "Office Outreach",
        task: "Now that I've enough time to focus on my prototype, I should try to advertise to some new clients!",
        where: [ setup.getLocationBySysName("company") ],
        whenTime: [ 2, ],
        whenDay: [ 0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Office Outreach",
        returnPassage: "Company",
    },
    {
    	id: "main_differentApproach",
    	next: "main_dinerSuggestion",
    	title: "Different approach",
        task: "Just writing mails won't work. I need connections, but how do I get those? Maybe $sister.name has an Idea",
        where: [ setup.getLocationBySysName("sisterroom") ],
        whenTime: [ 4, 5, ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Different Approach",
        returnPassage: "Bedroom",
        requirements: ["setup.questDone('sister_partyAnimal')"],
        requirementsText: ["Finish $sister.name's quest \"Party Animal\""],
    },
    {
    	id: "main_dinerSuggestion",
    	next: "main_prototype100",
    	title: "Not a bad Idea",
        task: "Honestly don't know why I didn't thought of that on my own. Anyway, I should talk to my manager at the Diner about my prototype. I should also get the prototype ready for the talk...",
        where: [ setup.getLocationBySysName("diner") ],
        whenTime: [ 3 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Diner Suggestion",
        returnPassage: "Diner",
        set: [ "$company.prototype.maxProgress = 100" ],
        requirements: ["setup.questReached('sister_conflictingFeelings')"],
        requirementsText: ["Reach $sister.callName's quest \"Conflicting feelings\""],
    },
    {
    	id: "main_prototype100",
    	next: "main_dinerTestRun",
    	title: "Time to Finish",
        task: "It's time to complete my prototype before I run the first offial test with strangers. [Progress to 100]",
        where: [ ],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$company.prototype.progress >= 100",
    },
    {
    	id: "main_dinerTestRun",
    	next: "main_expansionRequest",
    	title: "The time has come.",
        task: "Okay, with my Prototype finished, it's time to try my prototype in the real world. Fingers crossed.",
        where: [ setup.getLocationBySysName("diner") ],
        whenTime: [ 1 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Diner Test-Run",
        device: { target: "general", impact: 6 },
        returnPassage: "Diner",
    },
    {
    	id: "main_expansionRequest",
    	next: "main_homeRelations",
    	title: "Time to Expand",
        task: "Nice, now that I finally have a stable client, I should talk to $landlord.callName to get a larger Office, so I can hire employees!",
        where: [ setup.getLocationBySysName("company") ],
        whenTime: [ 1 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Landlord Expansion Request",
        returnPassage: "Company",
    },
    {
    	id: "main_homeRelations",
    	next: "main_familyLandlordHelp",
    	title: "Home Relations",
        task: "Progress $mom.callName's & $sister.callName's [Relation to 40] and [Corruption to 30]",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        check: "$mom.stats.relation >= 40 && setup.corruptionTotal('mom') >= 30 && $sister.stats.relation >= 40 && setup.corruptionTotal('sister') >= 30",
    },
    {
    	id: "main_familyLandlordHelp",
    	next: "main_waitLandlord",
    	title: "Family's there for one another.",
        task: "I need $mom.callName and $sister.callName to convince $landlord.callName.",
        where: [ setup.getLocationBySysName("livingroom") ],
        whenTime: [ 4 ],
        whenDay: [ 6 ],
        active: false,
        needsEvent: true,
        passage: "Family Landlord Help",
        returnPassage: "Residential Area",
        set: [ "$waitForLandlordMessage to $date.dayCount" ],
    },
    {
    	id: "main_waitLandlord",
    	next: "main_stage1",
    	title: "Wait on $landlord.callName Message",
        task: "Fuck yeah, with my first client now, I can finally really get things rolling. I need to prepare the expansion of my Company!",
        where: [ ],
        whenTime: [ ],
        whenDay: [ ],
        active: false,
        check: "$waitForLandlordMessage + 3 <= $date.dayCount"
    },
    {
    	id: "main_stage1",
    	next: "main_finishingRenovations",
    	title: "Stage 1",
        task: "It's time to finally pay up the renovations and move into a larger office! [Money 10000]",
        where: [ setup.getLocationBySysName("company") ],
        whenTime: [0, 1, 2, 3, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Stage 1",
        returnPassage: "Company Stage 1",
        requirements: [
        	"setup.questDone('sister_internshipSeason')",
            "setup.questDone('mom_businessRelations')",
            "$player.money >= 10000",
        ],
        requirementsText: [
        	"Finish $sister.callName's quest \"Internship season!\"",
            "\nFinish $mom.callName's quest \"Business Relations\"",
            "\nMoney >= 10000",
        ],
        set: ["$companyLocationIdReference = 13"]
    },    
    {
    	id: "main_finishingRenovations",
    	next: "main_tooMuchWork",
    	title: "Finishing Renovations",
        task: "It's been a week since I got the new office. It was quite a lot of work but worth it in the end...",
        where: [ setup.getLocationBySysName("companystage1") ],
        whenTime: [0, 1, 2, 3, 4, 5 ],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Finishing Renovations",
        returnPassage: "Company Stage 1",
    },
    {
    	id: "main_tooMuchWork",
    	next: "main_officialProductMeeting",
    	title: "Too Much Work",
        task: "I should answer all of my mails.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [1, 2, 3, 4, 5],
        whenDay: [0, 1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "Too Much Work",
        returnPassage: "Company Stage 1",
        requirements: [
            "$company.mails[0].answered == true",
            "$company.mails[1].answered == true",
            "$company.mails[2].answered == true",
        ],
        requirementsText: [
        	"Answer $landlord.callName's Mail.",
            "Answer $boss.callName's Mail.",
            "Answer $manager.callName's Mail.",
        ],
        set: [
            "$company.employees.push($ethan)",
            "$company.employees.push($brian)",
            "$company.employees.push($darius)"
        ],
    },
    {
    	id: "main_officialProductMeeting",
    	next: "main_veil",
    	title: "It'll be official",
        task: "Let's have a meeting to talk with everyone about the next step.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [1, 2, 3, 4, 5],
        whenDay: [1, 2, 3, 4,],
        active: false,
        needsEvent: true,
        passage: "Official Product Meeting",
        returnPassage: "Company Stage 1",
        requirements: [
            "setup.projectDone('project_boss_prototype')",
            "setup.projectDone('project_diner_analysis')",
        ],
        requirementsText: [
        	"Finish $boss.callName's Project",
        	"Finish $manager.callName's Project",
        ],
        set: [  "setup.unlockProject('project_company_official')" ], /* shows the product project in the overview */
    },

    /* ==== Stage 1, acts 2 to 4 (STAGE1_PROPOSAL.md, section 4) ====================================================
       STAGE1-STUB: everything from here to main_end is structure only. The scene passages are empty stubs, and the
       requirements, timings and numbers are first guesses from the proposal. Find every open spot with
       grep -rn STAGE1-STUB dev (the quest audit counts them too). */
    {
    	/* 4.2 The idea comes from the proposition of the professor (prof_researchProject). Unlocks the Veil project */
    	id: "main_veil",
    	next: "main_lateNight",
    	title: "The Veil",
        task: "$prof.callName wants a whole lecture hall under one unit, and I told him that would take months. Time to tell the team what we're building next.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Veil",
        returnPassage: "Company Stage 1",
        requirements: [ "setup.questDone('prof_researchProject')" ],
        requirementsText: [ "Hear out what $prof.callName wants" ],
        set: [ "setup.unlockProject('project_company_veil')" ],
    },
    {
    	/* 4.3 The night the Veil is finished. The project (onComplete) makes the device owned, this is its first switch-on */
    	id: "main_lateNight",
    	next: "main_firstSale",
    	title: "The Late Night",
        task: "The $company.devices.valenxVeil.name needs its field strength set before it goes anywhere near a lecture hall. That means a long night at the office, and $ethan.name has already claimed the pizza order.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [4, 5],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Late Night",
        returnPassage: "Company Stage 1",
        requirements: [ "setup.projectDone('project_company_veil')" ],
        requirementsText: [ "Finish the $company.devices.valenxVeil.name project" ],
    },
    {
    	/* 4.4 A clean sale to the marketing firm. pressClient matters at the end (they launch the rival company).
    	   STAGE1-STUB: how the lead arrives (a mail like the gym, or a call in the scene) is not decided */
    	id: "main_firstSale",
    	next: "main_waitGymLead",
    	title: "The First Real Sale",
        task: "$dana.name runs $marketingFirm.name, a building full of people who sell things for a living, and she wants to see what a calmer conference room does for her pitches. No favors and no family friends this time, just a sale.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "First Real Sale",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [ "$date.dayCount >= setup.getQuestById('main_lateNight').doneDay + 2" ],
        requirementsText: [ "Give the $company.devices.valenxVeil.name a few days of testing" ],
        set: [
            "setup.unlockProject('project_marketing_veil')",
            "$flags.pressClient = true",
        ],
    },
    {
    	/* hidden: a few days after the first sale the mail of the gym owner arrives ($company.mails[4]) */
    	id: "main_waitGymLead",
    	next: "main_gymMeeting",
    	title: "Waiting for the gym lead",
        task: "",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
        hidden: true,
        check: "$date.dayCount >= setup.getQuestById('main_firstSale').doneDay + 3",
        set: [
            "$company.mails[4].active = true",
            "Notification.show('New mail from ' + $rick.name + '.', { type: Notification.INFORMATION })",
        ],
    },
    {
    	/* 4.5a Corporate talk, a comedy with a straight face. Part 2 is the afternoon of the router redesign */
    	id: "main_gymMeeting",
    	next: "main_gymDinner",
    	title: "The Gym Meeting",
        task: "$darius.name's old friend $rick.name runs $gymChain.name and wants to talk about the wellbeing of his members. I'll need a straight face and a lot of coffee.",
        where: [ setup.getLocationBySysName("companystage1meeting") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Gym Meeting",
        returnPassage: "Company Stage 1",
        requirements: [
            "$company.mails[4].answered == true",
            "$date.dayCount > ($company.mails[4].answeredDay || 0)",
        ],
        requirementsText: [
            "Answer $rick.name's mail",
            "Wait for the day of the meeting",
        ],
    },
    {
    	/* 4.5b The first family option. The scene sets $mom.flags.gymDinner (true: she goes, false: I go and give a
    	   discount). Sending her is only offered once her line has reached mom_gymDinner.
    	   STAGE1-STUB: the offer should also check her corruption and exhibition (proposal 3.1) */
    	id: "main_gymDinner",
    	next: "main_morale",
    	title: "The Gym Dinner",
        task: "$rick.name won't sign anything until he's had dinner with the people behind the company. Somebody has to sit across the table from him and haggle.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [3, 4],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Gym Dinner",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [ "$date.dayCount >= setup.getQuestById('main_gymMeeting').doneDay + 2" ],
        requirementsText: [ "Let $rick.name think it over for a couple of days" ],
        set: [ "setup.unlockProject('project_gym_veil')" ],
    },
    {
    	/* 4.6 The scene sets $flags.dariusBroughtIn (true: ally with a stake, false: shut out) */
    	id: "main_morale",
    	next: "main_dinerIncident",
    	title: "Morale",
        task: "The new contracts are eating everyone alive. The office could use a little more warmth, and I know exactly who to ask for it.",
        where: [ setup.getLocationBySysName("companystage1") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Low Morale",
        returnPassage: "Company Stage 1",
        requirements: [ "$date.dayCount >= setup.getQuestById('main_gymDinner').doneDay + 3" ],
        requirementsText: [ "Let the new contract settle in" ],
    },
    {
    	/* 4.7 The first accident of the Veil, told by her at home.
    	   STAGE1-STUB: the Veil is not installed at the diner yet (that is the Debrief of the manager line, 7.3) */
    	id: "main_dinerIncident",
    	next: "main_anchor",
    	title: "The Diner Incident",
        task: "Something happened at $diner.name today. $sister.callName came home quieter than usual, and she hasn't looked at her phone in an hour.",
        lockedTask: "$sister.callName keeps telling stories about the regulars at $diner.name.",
        where: [ setup.getLocationBySysName("livingroom"), setup.getLocationBySysName("kitchen") ],
        whenTime: [4, 5],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Diner Incident",
        returnPassage: "Living Room",
        requirements: [
            "setup.getTaskById('task_sister_diner_shift').count >= 10",
            "setup.npcNow('sister').location && setup.inLocations(setup.npcNow('sister').location.sysName, ['home'])",
        ],
        requirementsText: [
            "$sister.callName works 10 shifts at $diner.name ({{Math.min(10, setup.getTaskById('task_sister_diner_shift').count)}}/10)",
            "$sister.callName has to be home",
        ],
    },
    {
    	/* 4.8 Needs a week of her attention for the hardware engineer (sister_beNiceToBrian, task_sister_be_nice_to_brian).
    	   Unlocks the Anchor project. Having the Anchor = setup.projectDone('project_company_anchor').
    	   STAGE1-STUB: only the hardware engineer should work on the Anchor project, the project system has no such rule */
    	id: "main_anchor",
    	next: "main_profitParty",
    	title: "The Anchor",
        task: "Some negotiations don't need a calmer room. They need one idea that stays where I put it. $brian.name can build that, as long as nobody tells him what it's for.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Anchor",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [ "setup.getTaskById('task_sister_be_nice_to_brian').count >= 3" ],
        requirementsText: [ "$sister.callName keeps $brian.name company ({{Math.min(3, setup.getTaskById('task_sister_be_nice_to_brian').count)}}/3)" ],
        set: [
            "setup.unlockProject('project_company_anchor')",
            "setup.getTaskById('task_sister_be_nice_to_brian').active = false",
        ],
    },
    {
    	/* 4.9 Only needs the company account in the black. Unlocks the Catalyst project.
    	   STAGE1-STUB: equity for the old friend ($flags.ethanEquity) is still undecided (proposal section 10, item 6) */
    	id: "main_profitParty",
    	next: "main_catalystNight",
    	title: "The Profit Party",
        task: "The company account is in the black. For once the office has earned pizza that isn't a late-night apology.",
        where: [ setup.getLocationBySysName("companystage1") ],
        whenTime: [4],
        whenDay: [4],
        active: false,
        needsEvent: true,
        passage: "Profit Party",
        returnPassage: "Company Stage 1",
        requirements: [ "$company.finances.money > 0" ],
        requirementsText: [ "Get the company account into the black" ],
        set: [ "setup.unlockProject('project_company_catalyst')" ],
    },
    {
    	/* 5.8 and 6.6 as ONE event: the Catalyst night of both. Part 1 (office, evening) is her milestone into stage 2
    	   (Devoted), part 2 (home, night) is the milestone of mom into stage 2 (Willing). Both lines wait for it in
    	   mom_waitCatalystNight / sister_waitCatalystNight.
    	   STAGE1-STUB: the device field takes one target, the Catalyst needs a calibration for each of them */
    	id: "main_catalystNight",
    	next: "main_crack",
    	title: "The Catalyst Night",
        task: "The $company.devices.valenxCatalyst.name doesn't create anything. It only turns up what's already there, and I know what's already there in both of them.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [4],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Catalyst Night",
        returnPassage: "Company Stage 1",
        requirements: [
            "setup.projectDone('project_company_catalyst')",
            "setup.questReached('mom_waitCatalystNight')",
            "setup.questReached('sister_waitCatalystNight')",
            "setup.corruptionReady('mom') || setup.corruptionStage('mom') >= 2",
            "setup.corruptionReady('sister') || setup.corruptionStage('sister') >= 2",
        ],
        requirementsText: [
            "Finish the $company.devices.valenxCatalyst.name project",
            "Progress $mom.callName's quest",
            "Progress $sister.callName's quest",
            "$mom.callName's corruption is full",
            "$sister.callName's corruption is full",
        ],
    },
    {
    	/* 4.10 Weekend: the old friend runs the full-strength code on himself. Part 2 (Monday) is the red herring:
    	   the log pull from the login of the analyst */
    	id: "main_crack",
    	next: "main_retailIntroduction",
    	title: "The Crack",
        task: "$ethan.name wants the office to himself this weekend for some stability checks. I think I'll drop by anyway.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [1, 2, 3],
        whenDay: [5, 6],
        active: false,
        needsEvent: true,
        passage: "The Crack",
        returnPassage: "Company Stage 1",
        requirements: [ "$date.dayCount >= setup.getQuestById('main_catalystNight').doneDay + 2" ],
        requirementsText: [ "Wait a few days" ],
    },
    {
    	/* 4.11, first half: the second family option. The scene sets $flags.retailIntro to "broker" (pay), "wait" (two
    	   weeks) or "sister" (she hosts the rooftop evening, sister_rooftop). Offering her only once her line has reached
    	   sister_rooftop. STAGE1-STUB: the broker fee and the corruption/exhibition gate of the offer */
    	id: "main_retailIntroduction",
    	next: "main_retailPitch",
    	title: "The Introduction",
        task: "$whitfield.callName can open the door to $retailChain.name. Doors like that cost money, or time, or something else.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [1, 2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Retail Introduction",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [ "$date.dayCount >= setup.getQuestById('main_crack').doneDay + 2" ],
        requirementsText: [ "Wait a few days" ],
    },
    {
    	/* 4.11, second half: the night before the demo, master access for the old friend. The scene sets
    	   $flags.trustedEthan */
    	id: "main_retailPitch",
    	next: "main_supplier",
    	title: "The Retail Pitch",
        task: "The biggest pitch we've ever had is tomorrow. Everything has to work, so somebody has to set up the demo tonight.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [4, 5],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "Retail Pitch",
        returnPassage: "Company Stage 1",
        requirements: [
            "$flags.retailIntro == 'broker' || ($flags.retailIntro == 'wait' && $date.dayCount >= setup.getQuestById('main_retailIntroduction').doneDay + 14) || ($flags.retailIntro == 'sister' && setup.questDone('sister_rooftop'))",
        ],
        requirementsText: [ "Get the introduction to $retailChain.name" ],
    },
    {
    	/* 4.12, first half: the price of the supplier, $20,000 or an evening with both of them. The scene sets
    	   $flags.supplierOffered. Offering them only once both lines have reached their optional quests
    	   (mom_lastNight, sister_rehearsal).
    	   STAGE1-STUB: the boss line (7.2, The Introduction) should name the supplier first, gate on it once it exists.
    	   STAGE1-STUB: the pay branch (empty the account, a loan or a cancelled project) */
    	id: "main_supplier",
    	next: "main_nightShift",
    	title: "The Supplier",
        task: "Everything I've read since the incident at $diner.name says the right compounds would fix the problem. $calloway.callName has them, and he names his own price.",
        where: [ setup.getLocationBySysName("companystage1desk") ],
        whenTime: [2, 3],
        whenDay: [0, 1, 2, 3, 4],
        active: false,
        needsEvent: true,
        passage: "The Supplier",
        returnPassage: setup.getLocationBySysName("companystage1desk").passage,
        requirements: [ "$date.dayCount >= setup.getQuestById('main_retailPitch').doneDay + 2" ],
        requirementsText: [ "Wait a few days after the pitch" ],
    },
    {
    	/* 4.12, second half: the night. If they go, it runs through Last Night Mom (mom_lastNight) and Last Night Sister
    	   (sister_lastNight), which advance those lines. The car, then the call of the old friend at 11:40 p.m.
    	   (the scene sets $flags.answeredEthan) */
    	id: "main_nightShift",
    	next: "main_morningAfter",
    	title: "The Night Shift",
        task: "Tonight $calloway.callName gets what he asked for, one way or the other.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [4],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Night Shift",
        returnPassage: "Company Stage 1",
        requirements: [
            "$date.dayCount > setup.getQuestById('main_supplier').doneDay",
            "$flags.supplierOffered !== true || (setup.questReached('mom_lastNight') && setup.questReached('sister_lastNight') && $date.dayCount > setup.getQuestById('sister_rehearsal').doneDay)",
        ],
        requirementsText: [
            "Wait until tomorrow",
            "Rehearse the evening with $sister.callName",
        ],
    },
    {
    	/* 4.13 End of Stage 1: the heist, the investigation, the rival launch.
    	   STAGE1-STUB: the set below follows proposal 3.7 (every device but the original is gone) and lets the old friend
    	   leave the staff. Check what else has to reset (projects he is assigned to, the vent, the CCTV) and where
    	   Stage 2 starts ($company.stage) */
    	id: "main_morningAfter",
    	next: "main_end",
    	title: "The Morning After",
        task: "Something's wrong at the office. I can feel it before I've even unlocked the door.",
        where: [ setup.getLocationBySysName("companystage1"), setup.getLocationBySysName("companystage1desk") ],
        whenTime: [0, 1, 2],
        whenDay: [0, 1, 2, 3, 4, 5, 6],
        active: false,
        needsEvent: true,
        passage: "Morning After",
        returnPassage: "Company Stage 1",
        requirements: [ "$date.dayCount > setup.getQuestById('main_nightShift').doneDay" ],
        requirementsText: [ "Wait until morning" ],
        set: [
            "Object.keys($company.devices).forEach((k) => { if (k !== 'valenx') { $company.devices[k].owned = false; } })",
            "$company.employees = $company.employees.filter((e) => e.sysName !== 'ethan')",
        ],
    },
    {
    	id: "main_end",
    	title: "End of Content - Main",
        task: "This is the end for the current Version.",
        where: [],
        whenTime: [],
        whenDay: [],
        active: false,
    },
]>>

