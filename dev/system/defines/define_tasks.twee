:: Define Tasks [system] {"position":"1000,0","size":"100,100"}
/* Tasks: jobs mom and sister do when they are scheduled (CMD Schedule).
   id is a string, task_<who>_<what> ("task_mom_test_session"). Look a task up with setup.getTaskById(id)
   and store the id, never the array index or the task object (state copies go stale). Stages are part of
   the task itself (see "Task Stages" in the Story JavaScript), so the id has no stage number.
   Optional cooldown: N (days) makes a task happen at most once every N days ("Task cooldown" below).

   More optional fields (STAGE1_TASKS.md):
     effects:  { ... }        what one run does, on the task or on a stage (the stage wins key by key). Applied when
                              it finishes, before onComplete ("Task effects" below)
     private:  "room"         only while the other one of mom and sister is not at the same place (the meeting room)
               "afterHours"   that, and only outside the work hours, when the staff has gone home ("Private tasks")
     pair:     "task_..."     a task for two: placing it puts the partner task into the other column at the same time,
                              and it only starts when both can ("Tasks for two")
     npcLabel: "Clients"      the column of the task picker when there is no story NPC to name (npc left out)
     intro:    { passage, where, whenTime [, whenDay] , requirements }
                              the task starts locked (active: false) and a short scene unlocks it: an event that is
                              generated from this field ("Task introductions"). The scene ends with <<EndTaskIntro>>
     onUnlock: [ fns ]        run once when it is unlocked (setup.unlockTask)
   A task at an off-site place (a location with offsite: true, Define Locations) has no camera: her end-of-day
   report is the only door to its POV passages.
   Stages may also wait for her corruption stage (corruptionStage) or a quest (quest), next to minCount
   ("Task Stages" in the Story JavaScript). */
<<set $tasks to [
	{
    	id: "task_mom_secretary_work",
    	who: $mom,
        title: "Secretary Work",
        description: "Boosts active projects progress by <b class='accent'>2</b> for each requirement, and company Efficiency by <b class='accent'>+2</b> while she keeps the office organised.",
        location: $locations[13], /*Stage 1 Office*/
        apCost: 2,
        active: true,
        startTime: [ 1, 2, 3, 4 ],
        npc: $player,
        activity: "working",
        /* her end-of-day report (Define NPCs): the small stuff, no passage to hear in full */
        report: {
            line: [
                "I color-coded the client folders today. Nobody noticed. I'm choosing to believe that means it works.",
                "The printer jammed three times and I fixed it three times. Put that on my headstone, sweetie.",
                "$ethan.name asked me where we keep the stapler. It's on his desk. It's been on his desk since Tuesday.",
            ],
            /* asked the next morning (End-of-day report, Define NPCs): the same lines, in the same order */
            lineLater: [
                "I color-coded the client folders yesterday. Nobody noticed. I'm choosing to believe that means it works.",
                "The printer jammed three times and I fixed it three times. Put that on my headstone, sweetie.",
                "$ethan.name asked me where we keep the stapler. It's on his desk. It's been on his desk since Tuesday.",
            ],
        },
        onComplete: [
        	() => {
            	State.variables.company.projects.forEach((p) => {
                	if(p.active) {
                        Object.keys(p.requirements).forEach((catagory) => {
                            if(p.requirements[catagory] > 0) {
                                p.progress[catagory] += 2;
                            }
                        });
                    }
                });
                /* a one-off boost: it fades again toward the efficiency target (Define Company) */
                setup.changeCompanyStat("efficiency", 2);
            },
        ],
        revenue: 0,
        baseEnergyCost: 5,
        count: 0,
        lastCompletedAt: 0,
    },
	{
    	id: "task_sister_diner_shift",
    	who: $sister,
        title: "Diner Shift",
        location: $locations[8], /*Diner*/
        apCost: 2,
        active: false,
        startTime: [ 1, 2, 3, 4 ],
        npc: $manager,
        activity: "working_diner",
        revenue: 80,
        baseEnergyCost: 10,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_mom_client_consultant",
    	who: $mom,
        title: "Client Consultant",
        description: "Adds <b class='accent'>+3</b> to the consulting requirement of $boss.callName's active projects.",
        location: $locations[12],
        apCost: 4,
        startTime: [ 1, 2 ],
        npc: $boss,
        activity: "working_boss",
        revenue: 100,
        baseEnergyCost: 25,
        count: 0,
        lastCompletedAt: 0,
        onComplete: [
        	() => {
                let projectBossPrototype = setup.getProjectById("project_boss_prototype");
                if(projectBossPrototype.active) {
                    Math.clamp(projectBossPrototype.progress.consulting += 3, 0, projectBossPrototype.requirements.consulting);
                }    

                let projectBossPrototypeRepeat = setup.getProjectById("project_boss_support");
                if(projectBossPrototypeRepeat.active) {
                    Math.clamp(projectBossPrototypeRepeat.progress.consulting += 3, 0, projectBossPrototypeRepeat.requirements.consulting);
                }  
            },
        ],
    },
    {
    	id: "task_mom_help_landlord",
    	who: $mom,
        title: "Helping $landlord.callName",
        description: "$landlord.callName demands to be visited at least <b class='red'>once per week</b>!",
        location: $locations[19],
        active: false,
        apCost: 3,
        startTime: [ 3, 4 ],
        npc: $landlord,
        activity: "helping_landlord0",
        stage: 0,
        stages: [
        	{ activity: "helping_landlord0", passage: "CCTV Mom Landlord 0" },
            /* Next stage, unlocked after finishing the task 3 more times with enough corruption:
            {
            	activity: "helping_landlord1",
                passage: "CCTV Mom Landlord 1",
                minCount: 3,
                requirements: [ () => setup.corruptionTotal("mom") >= 30 ],
                requirementsText: [ "$mom.callName needs 30 corruption" ],
            },
            */
        ],
        onComplete: [
        	() => State.variables.flags.visitedLandlordThisWeek = true,
        ],
        revenue: 0,
        baseEnergyCost: 15,
        count: 0,
        lastCompletedAt: 0,
    },    
    {
    	id: "task_sister_help_landlord",
    	who: $sister,
        title: "Helping $landlord.callName",
        description: "$landlord.callName demands to be visited at least <b class='red'>once per week</b>!",
        location: $locations[19], 
        active: false,
        apCost: 3,
        startTime: [ 3, 4 ],
        npc: $landlord,
        activity: "helping_landlord0",
        stage: 0,
        stages: [
        	{ activity: "helping_landlord0", passage: "CCTV Sister Landlord 0" },
            /* Next stage, unlocked after finishing the task 3 more times with enough corruption:
            {
            	activity: "helping_landlord1",
                passage: "CCTV Sister Landlord 1",
                minCount: 3,
                requirements: [ () => setup.corruptionTotal("sister") >= 30 ],
                requirementsText: [ "$sister.callName needs 30 corruption" ],
            },
            */
        ],
        onComplete: [
        	() => State.variables.flags.visitedLandlordThisWeek = true,
        ],
        revenue: 0,
        baseEnergyCost: 15,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_sister_tutoring_home",
    	who: $sister,
        title: "Tutoring",
        location: $locations[2], /*Living Room*/
        apCost: 2,
        active: true,
        startTime: [ 1, 2, 3, 4 ],
        npc: $player,
        activity: "tutor_home",
        revenue: 25,
        baseEnergyCost: 10,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_sister_tutoring_college",
    	who: $sister,
        title: "Tutoring",
        location: $locations[11], /*College*/
        apCost: 3,
        active: false,
        startTime: [ 1, 2, 3, 4 ],
        npc: $prof,
        activity: "tutor_college",
        revenue: 60,
        baseEnergyCost: 10,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_mom_private_attention",
    	who: $mom,
        title: "Massage",
        description: "She works the knots out of my shoulders in the meeting room. Raises her <b class='accent'>Relation</b> and <b class='accent'>Lust</b>, and it goes further the more often she does it.",
        location: $locations[15], /*Meeting Room*/
        apCost: 2,
        active: false, /* unlocked by the quest "Being a CEO is hard..." (mom_ceoStruggles) */
        startTime: [ 1, 2, 3 ],
        npc: $player,
        activity: "giving_massage0",
        withPlayer: {
            where: [ 15 ],
            prompt: "$mom.callName slips into the meeting room and closes the door behind her, right on time for our 'ergonomics check'.",
            accept: "Lean back",
            decline: "Send her back to work",
            summary: "$mom.callName slipped in behind my chair in the meeting room and worked the knots out of my shoulders while I read through my mails.",
            waiting: "$mom.callName is waiting in the meeting room for our appointment, and I'm not. I should head over before she gives up on me.",
            missed: "$mom.callName waited in the meeting room for our appointment, but I never showed up.",
            declined: "I sent $mom.callName back to her desk. She went, but she took her time about it.",
            missedCost: { relation: 1, morale: 3 },
        },
        stage: 0,
        stages: [
            { activity: "giving_massage0", passage: "Task Mom Massage 0" },
            {
                activity: "giving_massage1",
                passage: "Task Mom Massage 1",
                minCount: 5,
                requirements: [ () => setup.corruptionTotal("mom") >= 40 ],
                requirementsText: [ "$mom.callName needs 40 corruption" ],
            },
            {
                activity: "giving_massage2",
                passage: "Task Mom Massage 2",
                minCount: 5,
                requirements: [ () => setup.corruptionTotal("mom") >= 60 ],
                requirementsText: [ "$mom.callName needs 60 corruption" ],
            },
            {
                /* after The Briefing (mom_briefing), her first corruption stage */
                activity: "giving_massage3",
                passage: "Task Mom Massage 3",
                minCount: 5,
                requirements: [ () => setup.corruptionTotal("mom") >= 100 ],
                requirementsText: [ "$mom.callName needs corruption stage 1" ],
            },
            {
                /* after The Crawl (mom_crawl): it ends on her knees now, the version from that night */
                activity: "giving_massage4",
                passage: "Task Mom Massage 4",
                minCount: 3,
                quest: "mom_crawl",
                /* on top of onComplete: it ends under the table now */
                effects: { corruption: 1, lust: -12, feel: { player: 1 } },
            },
        ],
        onComplete: [
        	() => {
            	const mom = State.variables.mom;
                mom.stats.relation = Math.clamp(mom.stats.relation + 1, mom.stats.min.relation, mom.stats.max.relation);
                mom.stats.lust = Math.clamp(mom.stats.lust + 2, mom.stats.min.lust, mom.stats.max.lust);
            },
        ],
        revenue: 0,
        baseEnergyCost: 5,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_sister_office_work",
    	who: $sister,
        title: "Work",
        description: "Boosts active projects progress by <b class='accent'>1</b> for each requirement.",
        location: $locations[13], /*Stage 1 Office*/
        apCost: 2,
        active: true,
        startTime: [ 1, 2, 3, 4 ],
        npc: $player,
        activity: "working",
        onComplete: [
        	() => {
            	State.variables.company.projects.forEach((p) => {
                	if (!p.active) { return; }
                    Object.keys(p.requirements).forEach((category) => {
                        const need = Number(p.requirements[category]) || 0;
                        if (need > 0) {
                            p.progress[category] = Math.min(need, (Number(p.progress[category]) || 0) + 1);
                        }
                    });
                });
            },
        ],
        revenue: 0,
        baseEnergyCost: 10,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_sister_coffee_break",
    	who: $sister,
        title: "Coffee Break",
        description: "<b class='accent'>+3</b> morale for everyone else on the staff and <b class='accent'>+2</b> company Morale, but costs her <b class='red'>-10</b> morale",
        location: $locations[13], /*Stage 1 Office*/
        apCost: 2,
        active: true,
        startTime: [ 1, 2, 3, 4 ],
        npc: $player,
        activity: "bring_coffee",
        /* her end-of-day report (Define NPCs): office gossip, no passage to hear in full */
        report: {
            line: [
                "$ethan.name is on noodle cup number nine this week. I asked if he owns a pot. He said, and I quote, 'conceptually'.",
                "$brian.name walked into the glass door again. Same door. I think it's personal at this point.",
                "$darius.name's cologne is a lot. It's like being hugged by a department store.",
                "Somebody took all the good pens. I'm not saying it was me. I'm saying I know where they are.",
            ],
        },
        onComplete: [
        	() => {
            	const v = State.variables;
                /* the employee entries are copies, so change the live NPCs. Morale, because staff energy never
                   changes (their project work costs morale, Define Projects) */
                v.company.employees.forEach((e) => {
                    const npc = v[e.sysName];
                    if (!npc || !npc.stats || e.sysName === "sister") { return; }
                    npc.stats.morale = Math.clamp((Number(npc.stats.morale) || 0) + 3, npc.stats.min.morale, npc.stats.max.morale);
                });

                /* running around with a tray all afternoon wears her down */
                v.sister.stats.morale = Math.clamp(v.sister.stats.morale - 10, v.sister.stats.min.morale, v.sister.stats.max.morale);

                /* the office as a whole is in a better mood (company Morale, Define Company) */
                setup.changeCompanyStat("morale", 2);
            },
        ],
        revenue: 0,
        baseEnergyCost: 5,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_mom_test_session",
    	who: $mom,
        title: "Test Session",
        description: "Boosts the <b class='accent'>testing</b> progress of active projects by <b class='accent'>3</b>, and the <b class='accent'>calibration</b> of the original for her by 2.",
        location: $locations[15], /*Meeting Room*/
        apCost: 3,
        active: false, /* unlocked by the quest "Can you help me a little more?" (mom_testSessionRequest) */
        startTime: [ 4 ],
        npc: $player,
        activity: "testing_prototype",
        withPlayer: {
            where: [ 15 ],
            prompt: "$mom.callName is waiting in the meeting room with her questionnaire, ready for tonight's test session.",
            accept: "Start the session",
            decline: "Call it off",
            summary: "I ran another test session with $mom.callName in the meeting room and filled in her questionnaire.",
            waiting: "$mom.callName is setting up her questionnaire in the meeting room. If I want that test session, I'd better get over there.",
            missed: "$mom.callName waited in the meeting room for our test session, but I never showed up.",
            declined: "I called off tonight's test session. $mom.callName packed up her pen and went home early.",
            missedCost: { relation: 1, morale: 2 },
        },
        /* every stage is a little dirtier than the last, so it also corrupts her more: corruption and lust are what
           one session on that stage gives (read by onComplete). 10 sessions = 19 corruption, before the follow-up quest */
        stage: 0,
        stages: [
            { activity: "testing_prototype", passage: "Task Mom Test Session 0", corruption: 1, lust: 2 },
            { activity: "testing_prototype", passage: "Task Mom Test Session 1", corruption: 2, lust: 3, requirements: [ () => setup.getTaskById("task_mom_test_session").count > 2 ], },
            { activity: "testing_prototype", passage: "Task Mom Test Session 2", corruption: 2, lust: 4, requirements: [ () => setup.getTaskById("task_mom_test_session").count > 5 ],  },
            { activity: "testing_prototype", passage: "Task Mom Test Session 3", corruption: 3, lust: 5, requirements: [ () => setup.getTaskById("task_mom_test_session").count > 7 ],  },
            /* her corruption stage 3: she asks for a session herself, and wants it without the device */
            { activity: "testing_prototype", passage: "Task Mom Test Session 4", corruption: 2, lust: 5, minCount: 3, corruptionStage: 3 },
        ],
        onComplete: [
        	() => {
            	const v = State.variables;
            	const mom = v.mom;
                /* the stage that was just played (onComplete runs before the next stage unlocks) */
                const played = setup.getTaskStage(setup.getTaskById("task_mom_test_session")) || {};
                mom.stats.corruption = Math.clamp(mom.stats.corruption + (played.corruption || 1), mom.stats.min.corruption, mom.stats.max.corruption);
                mom.stats.lust = Math.clamp(mom.stats.lust + (played.lust || 2), mom.stats.min.lust, mom.stats.max.lust);
                /* she is an untrained test subject, so the sessions count as testing for every project that needs it */
                v.company.projects.forEach((p) => {
                    if (p.active && !p.completed && p.requirements.testing > 0) {
                        p.progress.testing += 3;
                    }
                });
                /* every session tells me more about her: the calibration of the original for her gets a little
                   better, up to 100 (it has to be calibrated for her already) */
                const vx = v.company.devices && v.company.devices.valenx;
                if (vx && vx.calibration === "mom" && vx.calibrationQuality > 0) {
                    vx.calibrationQuality = Math.min(100, vx.calibrationQuality + 2);
                }
            },
        ],
        revenue: 0,
        baseEnergyCost: 15,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_sister_internship_overview",
    	who: $sister,
        title: "Internship Overview",
        description: "We go over her internship journal together. Raises her <b class='accent'>Relation</b> by 2 and her <b class='accent'>Lust</b> by 1. She only has new things to write down <b class='accent'>every other day</b>.",
        location: $locations[15], /*Meeting Room*/
        apCost: 2,
        active: false, /* unlocked by the quest "Internship Overview Meetings" (sister_internshipOverviewRequest) */
        startTime: [ 3 ],
        cooldown: 2, /* every other day at most, see Task cooldown below */
        npc: $player,
        activity: "internship_overview",
        withPlayer: {
            where: [ 15 ],
            prompt: "$sister.callName knocks on the open meeting room door with her internship journal under her arm and two pens, in case one of them gives up on her.",
            accept: "Go over her journal",
            decline: "Not today",
            summary: "I went over the internship journal with $sister.callName in the meeting room. She wrote down everything I said, including the parts I meant as jokes.",
            waiting: "$sister.callName is waiting in the meeting room with her internship journal. If I want our overview meeting, I should head over.",
            missed: "$sister.callName sat in the meeting room with her journal for our overview meeting, and I never came.",
            declined: "I told $sister.callName we'd skip the overview today. She said that was totally fine. Twice.",
            missedCost: { relation: 1, morale: 2 },
        },
        stage: 0,
        stages: [
            { activity: "internship_overview", passage: "Task Sister Internship Overview 0" },
        ],
        onComplete: [
        	() => {
            	const sister = State.variables.sister;
                sister.stats.relation = Math.clamp(sister.stats.relation + 2, sister.stats.min.relation, sister.stats.max.relation);
                sister.stats.lust = Math.clamp(sister.stats.lust + 1, sister.stats.min.lust, sister.stats.max.lust);
            },
        ],
        revenue: 0,
        baseEnergyCost: 5,
        count: 0,
        lastCompletedAt: 0,
    },

    /* ==== Stage 1, acts 2 to 4 (STAGE1_PROPOSAL.md) ===============================================================
       Flirt Duty (mom, proposal 5.3) and Extra Friendly (sister, 6.5b). Neither is a task with me: I watch them on
       the camera, and the CCTV arrow opens her side of it, a POV passage per stage (dev/tasks/<npc>/, tag pov).
       The same passage is what I hear when I ask about it in her end-of-day report (report on each stage).
       Every stage has its own activity (and clips, Define Activities). What one round does is on the stage that
       was played (read by onComplete through setup.getTaskStage, like the test sessions). */
    {
    	id: "task_mom_flirt_duty",
    	who: $mom,
        title: "Flirt Duty",
        description: "She does the rounds and makes the staff feel good about their work: <b class='accent'>+morale</b> for everyone on the staff and company <b class='accent'>Morale</b>, a little <b class='accent'>Exhibition</b> for her. She gets better at it every round.",
        location: $locations[13], /*Stage 1 Office*/
        apCost: 2,
        active: false, /* activated by the quest Flirt Duty (mom_flirtDuty). Not Enough (mom_notEnough) waits for 3 of them */
        startTime: [ 1, 2, 3 ],
        npc: $player,
        activity: "flirt_duty0",
        /* terrible at first, then good, then a little scary. staffMorale: each employee, companyMorale: the company
           stat, exhibition and corruption: hers, proud: she likes being good at it (a warmer mood toward me) */
        stage: 0,
        stages: [
            {
                activity: "flirt_duty0", passage: "Task Mom Flirt Duty 0",
                staffMorale: 2, companyMorale: 1, exhibition: 1, corruption: 0,
                report: { line: "I tried the arm thing on $ethan.name, honey. He was holding his coffee at the time. I don't think his shirt is going to make it.", ask: "Ask how her first round went" },
            },
            {
                activity: "flirt_duty1", passage: "Task Mom Flirt Duty 1", minCount: 1,
                staffMorale: 3, companyMorale: 2, exhibition: 1, corruption: 1, proud: true,
                report: { line: "$darius.name told me my blouse was an 'objectively good color'. I've decided that counts.", ask: "Ask about $darius.name" },
            },
            {
                activity: "flirt_duty2", passage: "Task Mom Flirt Duty 2", minCount: 1,
                staffMorale: 4, companyMorale: 2, exhibition: 2, corruption: 1, proud: true,
                report: {
                    line: [
                        "$brian.name walked into the glass door again. I wasn't even trying that time, sweetie. Well. Not very hard.",
                        "$ethan.name stopped making jokes when I sat on the corner of his desk. I didn't know he could do that.",
                        "I got $darius.name to laugh. Out loud. He looked so surprised at himself, I almost apologized.",
                    ],
                    ask: "Ask about her rounds",
                },
            },
            {
                /* her corruption stage 2: she sits on the edge of their desks, and the staff start needing help on purpose */
                activity: "flirt_duty3", passage: "Task Mom Flirt Duty 3", minCount: 4, corruptionStage: 2,
                staffMorale: 5, companyMorale: 3, exhibition: 2, corruption: 1, proud: true,
                report: {
                    line: [
                        "$ethan.name asked me to help him with his chair, sweetie. There is nothing wrong with his chair. I helped him anyway.",
                        "$brian.name has a new printer problem every afternoon at three now. It is always the same problem, and I always have to lean over him to fix it.",
                        "$darius.name asked for my opinion on a chart. He knew exactly what he thought about that chart. He just wanted me to stand there a while.",
                    ],
                    ask: "Ask about her rounds",
                },
            },
        ],
        onComplete: [
        	() => {
            	const v = State.variables;
                const mom = v.mom;
                const live = setup.getTaskById("task_mom_flirt_duty");
                /* the stage that was just played (onComplete runs before the next stage unlocks) */
                const played = setup.getTaskStage(live) || {};

                /* the staff (copies in the employee list, so change the live NPCs) and the office as a whole */
                v.company.employees.forEach((e) => {
                    const npc = v[e.sysName];
                    if (!npc || !npc.stats || e.sysName === "mom" || e.sysName === "sister") { return; }
                    npc.stats.morale = Math.clamp(npc.stats.morale + (played.staffMorale || 2), npc.stats.min.morale, npc.stats.max.morale);
                });
                setup.changeCompanyStat("morale", played.companyMorale || 1);

                mom.stats.exhibition = Math.clamp(mom.stats.exhibition + (played.exhibition || 0), mom.stats.min.exhibition, mom.stats.max.exhibition);
                mom.stats.corruption = Math.clamp(mom.stats.corruption + (played.corruption || 0), mom.stats.min.corruption, mom.stats.max.corruption);

                /* what she thinks of each of them (Feelings, Define NPCs). The first round settles it: the joker makes
                   it easy, and she feels for the hardware guy. Every round warms all three a little */
                if (live.count === 1) {
                    setup.feel("mom", "ethan", 1, true);
                    setup.feel("mom", "brian", 1, true);
                }
                setup.feel("mom", "ethan", 1);
                setup.feel("mom", "darius", 1);
                setup.feel("mom", "brian", 1);
                if (played.proud) { setup.feel("mom", "player", 1); }
            },
        ],
        revenue: 0,
        baseEnergyCost: 5,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_sister_be_nice_to_brian",
    	who: $sister,
        title: "Extra Friendly",
        description: "She spends some extra time at the desk of $brian.name: coffee, a shoulder rub, and a lot of quiet company. Lifts his <b class='accent'>morale</b>, the company <b class='accent'>Efficiency</b> a little, and her <b class='accent'>Exhibition</b>.",
        location: $locations[13], /*Stage 1 Office*/
        apCost: 2,
        active: false, /* activated by the quest Be Nice to Brian (sister_beNiceToBrian), switched off by The Anchor (main_anchor), which waits for 3 */
        startTime: [ 1, 2, 3, 4 ],
        npc: $brian,
        activity: "extra_friendly0",
        /* brianMorale: his, exhibition: hers */
        stage: 0,
        stages: [
            {
                activity: "extra_friendly0", passage: "Task Sister Extra Friendly 0",
                brianMorale: 6, exhibition: 1,
                report: { line: "He showed me his soldering iron collection. I think where he's from, that's a proposal.", ask: "Ask about $brian.name" },
            },
            {
                activity: "extra_friendly1", passage: "Task Sister Extra Friendly 1", minCount: 1,
                brianMorale: 8, exhibition: 1,
                report: {
                    line: [
                        "I rubbed his shoulders for like two minutes and he apologized to me four times. For what? Having shoulders?",
                        "He named a circuit board after me. I think. It's either me or a resistor. He went very red either way.",
                    ],
                    ask: "Ask how it went at the desk of $brian.name",
                },
            },
        ],
        onComplete: [
        	() => {
            	const v = State.variables;
                const live = setup.getTaskById("task_sister_be_nice_to_brian");
                const played = setup.getTaskStage(live) || {};
                const brian = v.brian;
                const sister = v.sister;
                brian.stats.morale = Math.clamp(brian.stats.morale + (played.brianMorale || 6), brian.stats.min.morale, brian.stats.max.morale);
                sister.stats.exhibition = Math.clamp(sister.stats.exhibition + (played.exhibition || 0), sister.stats.min.exhibition, sister.stats.max.exhibition);
                setup.changeCompanyStat("efficiency", 1);

                /* Feelings (Define NPCs): fond of him, a bit sorry for him. And the first time a small sting toward me
                   for asking her to be nice to another man (a mood, it fades) */
                if (live.count === 1) {
                    setup.feel("sister", "brian", 1, true);
                    setup.feel("sister", "player", -1);
                }
                setup.feel("sister", "brian", 1);
            },
        ],
        revenue: 0,
        baseEnergyCost: 5,
        count: 0,
        lastCompletedAt: 0,
    },

    /* ==== Stage 1 task plan (STAGE1_TASKS.md) =====================================================================
       Every task below starts locked and is unlocked by its own short scene (intro, see "Task introductions").
       Stages wait for a count on the stage before (minCount) and her corruption stage or a quest. What one run does
       is in effects, on the stage that was played ("Task effects"). Tasks without me have a POV passage per stage
       (dev/tasks/<npc>/, tag pov), behind the CCTV arrow, or only behind her report when the place is off-site.
       Tasks with me have a scene per stage (tag task_scene). */

    /* ---- Mom ---- */
    {
    	id: "task_mom_client_lunch",
    	who: $mom,
        title: "Client Lunch",
        description: "She takes a client to lunch on the company card. Raises company <b class='accent'>Reputation</b> and her <b class='accent'>Exhibition</b>. Off-site: no camera there, I only hear about it from her.",
        location: $locations[21], /* the steakhouse downtown, off-site */
        apCost: 3,
        active: false,
        startTime: [ 2 ],
        npcLabel: "Clients",
        activity: "client_lunch0",
        intro: {
            passage: "Task Intro Client Lunch",
            where: [ 13, 14, 15 ],
            whenTime: [ 1, 2, 3 ],
            requirements: [ "setup.questDoneDaysAgo('main_firstSale', 1)", "!setup.momSilent()" ],
        },
        stage: 0,
        stages: [
            {
                activity: "client_lunch0", passage: "Task Mom Client Lunch 0",
                effects: { reputation: 2, exhibition: 1 },
                report: { line: "He talked about his boat for forty minutes, sweetie. I know more about bilge pumps now than any woman should. He signed, though.", ask: "Ask how the lunch went" },
            },
            {
                /* a hand on her knee that she does not move */
                activity: "client_lunch1", passage: "Task Mom Client Lunch 1", minCount: 3, corruptionStage: 1,
                effects: { reputation: 3, exhibition: 2, corruption: 1, lust: 2 },
                report: { line: "He kept his hand on my knee all through dessert, honey. I didn't move it. I'm not really sure why I'm telling you that.", ask: "Ask about the client" },
            },
            {
                /* the dress I picked, and she lets the client choose the wine and the topic */
                activity: "client_lunch2", passage: "Task Mom Client Lunch 2", minCount: 3, corruptionStage: 1,
                effects: { reputation: 3, exhibition: 2, corruption: 1, lust: 3 },
                report: { line: "I wore the dress you picked. He chose the wine, and he chose what we talked about, and I let him have both. Mostly we talked about me.", ask: "Ask what they talked about" },
            },
            {
                /* her corruption stage 2: dessert in the car of the client */
                activity: "client_lunch3", passage: "Task Mom Client Lunch 3", minCount: 4, corruptionStage: 2,
                effects: { reputation: 4, exhibition: 3, corruption: 2, lust: 3 },
                report: { line: "We had dessert in his car. That's all I'm going to say about dessert, sweetie. Unless you ask.", ask: "Ask about dessert" },
            },
        ],
        revenue: 0,
        baseEnergyCost: 15,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_mom_product_demos",
    	who: $mom,
        title: "Product Demos",
        description: "She shows the official unit to clients in the meeting room, on herself. Pushes the <b class='accent'>sales</b> and <b class='accent'>consulting</b> progress of active projects, raises <b class='accent'>Reputation</b> and her <b class='accent'>Exhibition</b>.",
        location: $locations[15], /*Meeting Room*/
        apCost: 2,
        active: false,
        startTime: [ 1, 2, 3 ],
        npcLabel: "Clients",
        activity: "product_demo0",
        intro: {
            passage: "Task Intro Product Demos",
            where: [ 13, 14, 15 ],
            whenTime: [ 1, 2, 3 ],
            requirements: [ "setup.questDoneDaysAgo('main_catalystNight', 2)", "!setup.momSilent()" ],
        },
        stage: 0,
        stages: [
            {
                /* she wears the unit and the clients watch it calm her down on the screen */
                activity: "product_demo0", passage: "Task Mom Product Demos 0",
                effects: { progress: { categories: [ "sales", "consulting" ], amount: 4 }, reputation: 2, exhibition: 2, corruption: 1 },
                report: { line: "I wore the unit on my wrist and let them watch my pulse go down on the big screen. One of them asked if it comes in my size. I think that was a joke.", ask: "Ask about the demo" },
            },
            {
                /* a client gets the dial */
                activity: "product_demo1", passage: "Task Mom Product Demos 1", minCount: 3, corruptionStage: 2,
                effects: { progress: { categories: [ "sales", "consulting" ], amount: 5 }, reputation: 3, exhibition: 3, corruption: 1, lust: 4 },
                report: { line: "I let the client hold the dial today. He turned it up when he thought I wasn't looking. I was looking, honey.", lineLater: "I let the client hold the dial yesterday. He turned it up when he thought I wasn't looking. I was looking, honey.", ask: "Ask about the dial" },
            },
            {
                /* her corruption stage 3: a live demonstration, on the meeting room table */
                activity: "product_demo2", passage: "Task Mom Product Demos 2", minCount: 3, corruptionStage: 3,
                effects: { progress: { categories: [ "sales", "consulting" ], amount: 6 }, reputation: 4, exhibition: 3, corruption: 2, lust: 5 },
                report: { line: "They called it a live demonstration. It was very live. Somebody should probably wipe down the meeting room table before tomorrow.", ask: "Ask about the demonstration" },
            },
        ],
        revenue: 0,
        baseEnergyCost: 10,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_mom_lunch_break",
    	who: $mom,
        title: "Lunch Break",
        description: "She brings my lunch to the meeting room and stays a while after I have eaten it. Only while her daughter is somewhere else.",
        location: $locations[15], /*Meeting Room*/
        apCost: 2,
        active: false,
        startTime: [ 2 ],
        npc: $player,
        activity: "lunch_break0",
        private: "room",
        intro: {
            passage: "Task Intro Lunch Break",
            where: [ 13, 14, 15 ],
            whenTime: [ 1, 2, 3 ],
            requirements: [ "setup.questDoneDaysAgo('mom_nightVisit', 1)", "!setup.momSilent()" ],
        },
        withPlayer: {
            where: [ 15 ],
            prompt: "$mom.callName backs into the meeting room with a paper bag from the deli downstairs and closes the door with her hip.",
            accept: "Let her in",
            decline: "Not today",
            summary: "$mom.callName brought my lunch to the meeting room and stayed a while after I finished it.",
            waiting: "$mom.callName is waiting in the meeting room with my lunch. My lunch, and the rest of it.",
            missed: "$mom.callName sat in the meeting room with my sandwich going cold, and I never came.",
            declined: "I sent $mom.callName back out. She left the paper bag on my desk anyway.",
            missedCost: { relation: 1, morale: 2 },
        },
        stage: 0,
        stages: [
            { activity: "lunch_break0", passage: "Task Mom Lunch Break 0", effects: { corruption: 1, lust: -10, relation: 1, feel: { player: 1 } } },
            /* after The Crawl (mom_crawl) */
            { activity: "lunch_break1", passage: "Task Mom Lunch Break 1", minCount: 3, quest: "mom_crawl", effects: { corruption: 1, lust: -15, relation: 1, feel: { player: 1 } } },
            /* after The Calendar (mom_calendar) */
            { activity: "lunch_break2", passage: "Task Mom Lunch Break 2", minCount: 3, quest: "mom_calendar", effects: { corruption: 1, lust: -20, relation: 1, feel: { player: 1 } } },
        ],
        revenue: 0,
        baseEnergyCost: 5,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_mom_working_late",
    	who: $mom,
        title: "Working Late",
        description: "She stays after everyone has gone home and keeps me company at my desk while I work. Only after work hours, when the office is empty.",
        location: $locations[14], /*My Desk*/
        apCost: 2,
        active: false,
        startTime: [ 4 ],
        npc: $player,
        activity: "working_late0",
        private: "afterHours",
        intro: {
            passage: "Task Intro Working Late",
            where: [ 13, 14, 15 ],
            whenTime: [ 4 ],
            requirements: [ "setup.questDoneDaysAgo('mom_crawl', 1)", "!setup.momSilent()" ],
        },
        withPlayer: {
            where: [ 14 ],
            prompt: "The others went home an hour ago. $mom.callName switches off the lights over their desks one by one, and then she comes over to mine.",
            accept: "Keep working",
            decline: "Send her home",
            summary: "$mom.callName stayed late and kept me company at my desk while I worked.",
            waiting: "$mom.callName is waiting at my desk in the empty office. I should get over there.",
            missed: "$mom.callName waited at my desk in the dark office until she gave up and went home.",
            declined: "I sent $mom.callName home. She said goodnight from the door, twice.",
            missedCost: { relation: 1, morale: 2 },
        },
        stage: 0,
        stages: [
            /* under the desk while I work */
            { activity: "working_late0", passage: "Task Mom Working Late 0", effects: { corruption: 1, lust: -15, relation: 1, feel: { player: 1 } } },
            /* after the Catalyst Night: on the desk */
            { activity: "working_late1", passage: "Task Mom Working Late 1", minCount: 3, quest: "main_catalystNight", effects: { corruption: 1, lust: -20, relation: 1, feel: { player: 1 } } },
            /* her corruption stage 3: she leaves the door open */
            { activity: "working_late2", passage: "Task Mom Working Late 2", minCount: 3, corruptionStage: 3, effects: { corruption: 1, lust: -20, exhibition: 1, relation: 1, feel: { player: 1 } } },
        ],
        revenue: 0,
        baseEnergyCost: 5,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_mom_client_evening",
    	who: $mom,
        title: "Client Evening",
        description: "She and her daughter take a client out for the night, together. Good money and a lot of <b class='accent'>Reputation</b>. Off-site: I only hear about it from them.",
        location: $locations[23], /* the club, off-site */
        apCost: 3,
        active: false,
        startTime: [ 5 ],
        npcLabel: "Clients",
        activity: "client_evening0",
        pair: "task_sister_client_evening",
        /* the intro sits on this task and unlocks both (setup.unlockTask follows pair) */
        intro: {
            passage: "Task Intro Client Evening",
            where: [ 13, 14, 15 ],
            whenTime: [ 1, 2, 3, 4 ],
            /* after The Supplier, and after the rehearsal if I offered them: it is their warm-up before the Night Shift,
               which waits for three of them (main_nightShift) */
            requirements: [ "setup.questDone('mom_calendar')", "setup.questDone('sister_everything')", "setup.questDoneDaysAgo('main_supplier', 1)", "$flags.supplierOffered !== true || setup.questDone('sister_rehearsal')", "!setup.momSilent()" ],
        },
        stage: 0,
        stages: [
            {
                activity: "client_evening0", passage: "Task Mom Client Evening 0",
                effects: { reputation: 3, exhibition: 3, corruption: 1 },
                report: { line: "$sister.callName and I took a client out tonight, honey. We were very professional. We both very professionally didn't watch what the other one was doing.", lineLater: "$sister.callName and I took a client out last night, honey. We were very professional. We both very professionally didn't watch what the other one was doing.", ask: "Ask about the evening" },
            },
            {
                /* the private room at the back of the club */
                activity: "client_evening1", passage: "Task Mom Client Evening 1", minCount: 2,
                effects: { reputation: 4, exhibition: 3, corruption: 2, lust: 4 },
                report: { line: "There's a private room at the back of $club.name. The door locks from the inside. I know, because I checked.", ask: "Ask about the private room" },
            },
        ],
        revenue: 250,
        baseEnergyCost: 20,
        count: 0,
        lastCompletedAt: 0,
    },

    /* ---- Sister ---- */
    {
    	id: "task_sister_socials",
    	who: $sister,
        title: "Socials",
        description: "She runs the company accounts and is the face in the pictures. Pushes the <b class='accent'>sales</b> and <b class='accent'>marketing</b> progress of active projects, raises <b class='accent'>Reputation</b> and her <b class='accent'>Exhibition</b>.",
        location: $locations[15], /* the meeting room doubles as her photo studio */
        apCost: 2,
        active: false,
        startTime: [ 1, 2, 3 ],
        activity: "socials0",
        intro: {
            passage: "Task Intro Socials",
            where: [ 13, 14, 15 ],
            whenTime: [ 2, 3 ],
            requirements: [ "setup.questDoneDaysAgo('main_firstSale', 2)" ],
        },
        stage: 0,
        stages: [
            {
                /* product shots, only her hands */
                activity: "socials0", passage: "Task Sister Socials 0",
                effects: { progress: { categories: [ "sales", "marketing" ], amount: 2 }, reputation: 1, exhibition: 1 },
                report: { line: "I took forty pictures of the unit on a desk today. The desk looks amazing. The unit looks like a smoke detector.", lineLater: "I took forty pictures of the unit on a desk yesterday. The desk looks amazing. The unit looks like a smoke detector.", ask: "Ask about the photos" },
            },
            {
                /* her face becomes the brand, and the comments start */
                activity: "socials1", passage: "Task Sister Socials 1", minCount: 3, corruptionStage: 1,
                effects: { progress: { categories: [ "sales", "marketing" ], amount: 3 }, reputation: 2, exhibition: 2, corruption: 1 },
                report: { line: "My face got more likes than the product. Somebody asked in the comments if I come with the unit. I'm choosing to take that as a compliment.", ask: "Ask about the comments" },
            },
            {
                /* the gym-wear shoot for the gym chain */
                activity: "socials2", passage: "Task Sister Socials 2", minCount: 4, corruptionStage: 2,
                effects: { progress: { categories: [ "sales", "marketing" ], amount: 3 }, reputation: 3, exhibition: 3, corruption: 1, lust: 2 },
                report: { line: "Gym-wear shoot in the meeting room. $brian.name came in for a cable, saw me, and left without the cable.", ask: "Ask about the shoot" },
            },
            {
                /* her corruption stage 3: the outtakes she sends me first */
                activity: "socials3", passage: "Task Sister Socials 3", minCount: 3, corruptionStage: 3,
                effects: { progress: { categories: [ "sales", "marketing" ], amount: 4 }, reputation: 3, exhibition: 3, corruption: 2, lust: 3 },
                report: { line: "There are outtakes from today. You get them first, and they're not going on the company page.", lineLater: "There are outtakes from yesterday. You get them first, and they're not going on the company page.", ask: "Ask about the outtakes" },
            },
        ],
        revenue: 0,
        baseEnergyCost: 10,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_sister_field_test",
    	who: $sister,
        title: "Field Test",
        description: "She trains at $gymChain.name with a sensor on, so the gym project gets real data. Pushes the <b class='accent'>testing</b> progress of the gym project, raises her <b class='accent'>Exhibition</b>. Hard work: it costs a lot of energy.",
        location: $locations[20], /*Gym*/
        apCost: 3,
        active: false,
        startTime: [ 1, 2, 3 ],
        npcLabel: "The gym",
        activity: "field_test0",
        intro: {
            passage: "Task Intro Field Test",
            where: [ 13, 14, 15 ],
            whenTime: [ 1, 2, 3 ],
            requirements: [ "setup.questDoneDaysAgo('main_gymMeeting', 1)" ],
        },
        /* the chain has cameras of its own, and the router project gives me access to them */
        onUnlock: [ () => { State.variables.cctv.cameras.gym = State.variables.date.dayCount; } ],
        stage: 0,
        stages: [
            {
                /* a normal workout with a sensor on her wrist */
                activity: "field_test0", passage: "Task Sister Field Test 0",
                effects: { progress: { categories: [ "testing" ], amount: 5, project: "project_gym_veil" }, exhibition: 1 },
                report: { line: "Forty minutes on the bike with a sensor taped to my wrist. Apparently my data is very clean. Thanks, I guess?", ask: "Ask about the gym" },
            },
            {
                /* the outfit I picked */
                activity: "field_test1", passage: "Task Sister Field Test 1", minCount: 3, corruptionStage: 1,
                effects: { progress: { categories: [ "testing" ], amount: 6, project: "project_gym_veil" }, exhibition: 2, corruption: 1 },
                report: { line: "The outfit you picked got me three free smoothies and one guy who walked straight into the mirror.", ask: "Ask about the outfit" },
            },
            {
                /* a trainer corrects her form */
                activity: "field_test2", passage: "Task Sister Field Test 2", minCount: 4, corruptionStage: 2,
                effects: { progress: { categories: [ "testing" ], amount: 6, project: "project_gym_veil" }, exhibition: 3, corruption: 1, lust: 3 },
                report: { line: "There's a trainer who keeps correcting my form. My form is fine. He corrects it anyway. With both hands.", ask: "Ask about the trainer" },
            },
            {
                /* her corruption stage 3: a private session after closing */
                activity: "field_test3", passage: "Task Sister Field Test 3", minCount: 4, corruptionStage: 3,
                effects: { progress: { categories: [ "testing" ], amount: 7, project: "project_gym_veil" }, exhibition: 3, corruption: 2, lust: 4 },
                report: { line: "He gave me a private session after closing. He locked the front door so nobody would bother us. Nobody did.", ask: "Ask about the private session" },
            },
        ],
        revenue: 0,
        baseEnergyCost: 25,
        count: 0,
        lastCompletedAt: 0,
    },
