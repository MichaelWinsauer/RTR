    {
    	id: "task_sister_team_spirit",
    	who: $sister,
        title: "Team Spirit",
        description: "She spends time with whoever on the staff needs it most right now (the lowest morale): a big <b class='accent'>morale</b> boost for him, company <b class='accent'>Efficiency</b>, and her <b class='accent'>Exhibition</b>.",
        location: $locations[13], /*Stage 1 Office*/
        apCost: 2,
        active: false,
        startTime: [ 1, 2, 3, 4 ],
        npcLabel: "The staff",
        activity: "team_spirit0",
        intro: {
            passage: "Task Intro Team Spirit",
            where: [ 13, 14, 15 ],
            whenTime: [ 1, 2, 3 ],
            requirements: [ "setup.questDoneDaysAgo('main_anchor', 2)" ],
        },
        /* staffMorale: for the one she picks (setup.teamSpiritTarget, "Team Spirit" below) */
        stage: 0,
        stages: [
            {
                /* lunch with him */
                activity: "team_spirit0", passage: "Task Sister Team Spirit 0", staffMorale: 8,
                effects: { efficiency: 1, exhibition: 1 },
                report: { line: "I had lunch with $sister.flags.teamSpiritName today. He talked the whole time. I think he needed that more than the lunch.", lineLater: "I had lunch with $sister.flags.teamSpiritName yesterday. He talked the whole time. I think he needed that more than the lunch.", ask: "Ask about $sister.flags.teamSpiritName" },
            },
            {
                /* her corruption stage 2: she sits on his desk */
                activity: "team_spirit1", passage: "Task Sister Team Spirit 1", minCount: 3, corruptionStage: 2, staffMorale: 10,
                effects: { efficiency: 2, exhibition: 2, corruption: 1 },
                report: { line: "I sat on the edge of the desk of $sister.flags.teamSpiritName for an hour. He got more done than all week. Don't ask me how that works.", ask: "Ask about $sister.flags.teamSpiritName" },
            },
            {
                /* her corruption stage 3: employee of the week, a private show in the meeting room */
                activity: "team_spirit2", passage: "Task Sister Team Spirit 2", minCount: 3, corruptionStage: 3, staffMorale: 12,
                effects: { efficiency: 2, exhibition: 3, corruption: 2, lust: 3 },
                report: { line: "$sister.flags.teamSpiritName is employee of the week. He got his prize in the meeting room. With the blinds down.", ask: "Ask about the prize" },
            },
        ],
        onComplete: [
        	() => {
            	const v = State.variables;
                const live = setup.getTaskById("task_sister_team_spirit");
                const played = setup.getTaskStage(live) || {};
                const who = setup.teamSpiritTarget();
                const npc = who ? v[who] : null;
                if (npc && npc.stats) {
                    npc.stats.morale = Math.clamp(npc.stats.morale + (played.staffMorale || 8), npc.stats.min.morale, npc.stats.max.morale);
                    setup.feel("sister", who, 1);
                }
            },
        ],
        revenue: 0,
        baseEnergyCost: 5,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_sister_front_desk",
    	who: $sister,
        title: "Front Desk",
        description: "She greets clients and visitors at the door now that they come to us. A little <b class='accent'>Reputation</b> every time, and her <b class='accent'>Exhibition</b>.",
        location: $locations[13], /*Stage 1 Office*/
        apCost: 2,
        active: false,
        startTime: [ 1, 2, 3 ],
        npcLabel: "Visitors",
        activity: "front_desk0",
        intro: {
            passage: "Task Intro Front Desk",
            where: [ 13, 14, 15 ],
            whenTime: [ 2, 3 ],
            requirements: [ "setup.questDoneDaysAgo('main_retailPitch', 2)" ],
        },
        stage: 0,
        stages: [
            {
                activity: "front_desk0", passage: "Task Sister Front Desk 0",
                effects: { reputation: 2, exhibition: 1 },
                report: { line: "A courier asked me out. Then a client asked me out. Then the courier came back. It was a whole thing.", ask: "Ask about the visitors" },
            },
            {
                /* her corruption stage 2: the short skirt, and the sign-in sheet on the low table */
                activity: "front_desk1", passage: "Task Sister Front Desk 1", minCount: 3, corruptionStage: 2,
                effects: { reputation: 2, exhibition: 2, corruption: 1 },
                report: { line: "I moved the sign-in sheet to the low table. Everybody signs in very, very slowly now.", ask: "Ask about the sign-in sheet" },
            },
            {
                /* her corruption stage 3: visitors who wait on the couch with her */
                activity: "front_desk2", passage: "Task Sister Front Desk 2", minCount: 3, corruptionStage: 3,
                effects: { reputation: 3, exhibition: 3, corruption: 1, lust: 3 },
                report: { line: "One of the retail guys came early, so I kept him company on the couch. He wasn't in any hurry to go in to his meeting.", ask: "Ask about the couch" },
            },
        ],
        revenue: 0,
        baseEnergyCost: 5,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_sister_hostess",
    	who: $sister,
        title: "Hostess",
        description: "She hosts the evenings of $investor.callName and his friends. Pays, raises <b class='accent'>Reputation</b> a lot, and her <b class='accent'>Exhibition</b>. Off-site: I only hear about it from her.",
        location: $locations[22], /* the rooftop, off-site */
        apCost: 3,
        active: false,
        startTime: [ 4 ],
        npc: $investor,
        activity: "hostess0",
        intro: {
            passage: "Task Intro Hostess",
            where: [ 13, 14, 15 ],
            whenTime: [ 1, 2, 3 ],
            requirements: [ "setup.questDoneDaysAgo('main_retailPitch', 3)" ],
        },
        stage: 0,
        stages: [
            {
                activity: "hostess0", passage: "Task Sister Hostess 0",
                effects: { reputation: 3, exhibition: 2 },
                report: { line: "Coats, wine, smiling. $investor.callName introduced me to a man who owns four hundred car washes. I didn't know one person could own that many car washes.", ask: "Ask about the evening" },
            },
            {
                /* her corruption stage 2: the friends of the investor, and their tips */
                activity: "hostess1", passage: "Task Sister Hostess 1", minCount: 2, corruptionStage: 2,
                effects: { reputation: 4, exhibition: 3, corruption: 1, lust: 3 },
                report: { line: "His friends tip. In cash, straight into my hand, and they hold on to the hand for a bit while they do it.", ask: "Ask about his friends" },
            },
            {
                /* her corruption stage 3: after midnight the party moves on to the club */
                activity: "hostess2", passage: "Task Sister Hostess 2", minCount: 2, corruptionStage: 3,
                effects: { reputation: 5, exhibition: 3, corruption: 2, lust: 4 },
                report: { line: "After midnight the whole party moved on to $club.name, and I went with it. I'll tell you about it if you want. You probably want.", ask: "Ask about $club.name" },
            },
        ],
        revenue: 150,
        baseEnergyCost: 20,
        count: 0,
        lastCompletedAt: 0,
    },
    {
    	id: "task_sister_client_evening",
    	who: $sister,
        title: "Client Evening",
        description: "She and her mother take a client out for the night, together. Good money and a lot of <b class='accent'>Reputation</b>. Off-site: I only hear about it from them.",
        location: $locations[23], /* the club, off-site */
        apCost: 3,
        active: false, /* unlocked together with the task of mom (pair, intro on that task) */
        startTime: [ 5 ],
        npcLabel: "Clients",
        activity: "client_evening0",
        pair: "task_mom_client_evening",
        stage: 0,
        stages: [
            {
                activity: "client_evening0", passage: "Task Sister Client Evening 0",
                effects: { reputation: 3, exhibition: 3, corruption: 1 },
                report: { line: "Me and $mom.callName, a client, a bottle of something French. We're good at this together. That's either great or really weird.", ask: "Ask about the evening" },
            },
            {
                activity: "client_evening1", passage: "Task Sister Client Evening 1", minCount: 2,
                effects: { reputation: 4, exhibition: 3, corruption: 2, lust: 4 },
                report: { line: "The private room at $club.name has a couch and a lock and no windows. $mom.callName sat on one end and I sat on the other. That's the clean version.", ask: "Ask for the other version" },
            },
        ],
        revenue: 250,
        baseEnergyCost: 20,
        count: 0,
        lastCompletedAt: 0,
    },
]>>

/* Slim who/npc ================================================================
   The list above writes who: $mom and npc: $landlord for readability, but SugarCube would store a full copy of
   that character in every task (quests and all, about 50 KB per task, and again in every scheduled copy in
   $activeTasks). The state is copied, diffed and compressed on every passage change, so those copies made every
   click slow. Everything reads these two fields by sysName only (State.variables[task.who.sysName]), so the
   copies are cut down to that. Keep it that way: never read anything but sysName off task.who or task.npc. */
<<run $tasks.forEach((task) => {
    task.who = { sysName: task.who.sysName };
    if (task.npc) { task.npc = { sysName: task.npc.sysName }; }
})>>

<<set $activeTasks to {
    mom: [],
    sister: []
}>>

/* Unlocking tasks =============================================================
   setup.taskUnlocked(id)            the task is active (in the picker)
   setup.unlockTask(id [, quiet])    makes it active, runs its onUnlock, unlocks its pair partner too, and shows
                                     "New task for ..." unless quiet. The story uses <<EndTaskIntro>> (Task Widgets)
   setup.questDoneDaysAgo(id, n)     the quest is done, and at least n days ago (intro requirements: the task
                                     shows up the day after the scene that leads to it, not on the same evening) */
<<set setup.taskUnlocked = (id) => {
    const live = setup.getTaskById(id);
    return !!(live && live.active);
}>>

<<set setup.unlockTask = (id, quiet) => {
    const v = State.variables;
    const live = setup.getTaskById(id);
    if (!live) { console.error('setup.unlockTask: there is no task "' + id + '"'); return; }
    const partner = live.pair ? setup.getTaskById(live.pair) : null;
    [ live, partner ].forEach((task) => {
        if (!task || task.active) { return; }
        task.active = true;
        (task.onUnlock || []).forEach((fn) => fn());
    });
    if (quiet) { return; }
    const names = [ live ].concat(partner ? [ partner ] : []).map((task) => v[task.who.sysName].callName).join(" and ");
    Notification.show("New task for " + names + ": " + wikifyText(live.title), { type: Notification.QUEST });
}>>

/* setup.lockTask(id)   the opposite, when the story ends a task: inactive again (and its partner), off both schedules */
<<set setup.lockTask = (id) => {
    const v = State.variables;
    const live = setup.getTaskById(id);
    if (!live) { console.error('setup.lockTask: there is no task "' + id + '"'); return; }
    const ids = [ live.id ].concat(live.pair ? [ live.pair ] : []);
    ids.forEach((taskId) => {
        const task = setup.getTaskById(taskId);
        if (task) { task.active = false; }
    });
    [ "mom", "sister" ].forEach((key) => {
        v.activeTasks[key] = (v.activeTasks[key] || []).filter((e) => !ids.includes(e.task.id));
    });
}>>

<<set setup.questDoneDaysAgo = (id, days) => {
    const quest = setup.getQuestById(id);
    if (!quest || !quest.done) { return false; }
    return State.variables.date.dayCount - (Number(quest.doneDay) || 0) >= (Number(days) || 0);
}>>


/* Task introductions ==========================================================
   A task with an intro field gets an event that unlocks it, generated here ($events, Define Events, id = index):
       intro: { passage: "Task Intro Client Lunch", where: [ 13, 14, 15 ], whenTime: [ 1, 2, 3 ] [, whenDay],
                requirements: [ "TwineScript", ... ] }
   where is a list of location ids (the event plays in their passages), whenDay defaults to the weekdays. The event
   waits until the requirements pass and the task is still locked, and it comes after the quest events in $events, so a
   quest scene at the same place always goes first. The scene is tagged [event] and ends with <<EndTaskIntro "id">>. */
<<set setup.generateTaskIntroEvents = () => {
    const v = State.variables;
    v.tasks.forEach((task) => {
        if (!task.intro) { return; }
        const intro = task.intro;
        const passages = (intro.where || []).map((id) => v.locations[id] && v.locations[id].passage).filter(Boolean);
        v.events.push({
            id: v.events.length,
            passage: intro.passage,
            returnPassage: passages[0] || "Company Stage 1 Desk",
            where: passages,
            whenTime: intro.whenTime || [ 1, 2, 3 ],
            whenDay: intro.whenDay || [ 0, 1, 2, 3, 4 ],
            requirements: (intro.requirements || []).concat([ "!setup.taskUnlocked('" + task.id + "')" ]),
            chance: 100,
            cooldown: 0,
            once: true,
            active: true,
            finished: false,
            completedAtDay: 0,
            taskIntro: task.id,
        });
    });
}>>
<<run setup.generateTaskIntroEvents()>>


/* Task effects ================================================================
   What one finished run does, applied by completeTaskEntry (Story JavaScript) before onComplete. The fields can sit on
   the task and on its stages; the stage that was played wins key by key.
       effects: {
           exhibition, corruption, lust, relation, morale, resistance   her own stats (+/-, kept inside her min/max)
           staffMorale                                                  every employee except mom and sister
           reputation, efficiency, companyMorale                        company stats (setup.changeCompanyStat)
           progress: { categories: [ "sales" ], amount: 3 [, project: "project_gym_veil"] }
                                                                        every active project (or only that one) that
                                                                        needs one of the categories gets the amount
                                                                        there, never past what it needs
           feel: { player: 1 }                                          her mood toward them (Feelings, Define NPCs)
       }
   setup.taskEffects(task)                 the merged effects of the current stage
   setup.applyTaskEffects(sysName, task)   applies them */
<<set setup.taskEffects = (task) => {
    const live = setup.getLiveTask(task);
    if (!live) { return {}; }
    const stage = setup.getTaskStage(live) || {};
    return Object.assign({}, live.effects || {}, stage.effects || {});
}>>

<<set setup.applyTaskEffects = (sysName, task) => {
    const v = State.variables;
    const fx = setup.taskEffects(task);
    const npc = v[sysName];
    [ "exhibition", "corruption", "lust", "relation", "morale", "resistance" ].forEach((key) => {
        if (!fx[key] || !npc || !npc.stats) { return; }
        npc.stats[key] = Math.clamp((Number(npc.stats[key]) || 0) + fx[key], npc.stats.min[key], npc.stats.max[key]);
    });
    if (fx.staffMorale) {
        (v.company.employees || []).forEach((e) => {
            const staff = v[e.sysName];
            if (!staff || !staff.stats || e.sysName === "mom" || e.sysName === "sister") { return; }
            staff.stats.morale = Math.clamp(staff.stats.morale + fx.staffMorale, staff.stats.min.morale, staff.stats.max.morale);
        });
    }
    if (fx.reputation) { setup.changeCompanyStat("reputation", fx.reputation); }
    if (fx.efficiency) { setup.changeCompanyStat("efficiency", fx.efficiency); }
    if (fx.companyMorale) { setup.changeCompanyStat("morale", fx.companyMorale); }
    if (fx.progress) {
        const cats = fx.progress.categories || [];
        v.company.projects.forEach((p) => {
            if (!p.active || (fx.progress.project && p.id !== fx.progress.project)) { return; }
            cats.forEach((cat) => {
                const need = Number(p.requirements[cat]) || 0;
                if (need > 0) { p.progress[cat] = Math.min(need, (Number(p.progress[cat]) || 0) + (Number(fx.progress.amount) || 0)); }
            });
        });
    }
    Object.keys(fx.feel || {}).forEach((key) => setup.feel(sysName, key, fx.feel[key]));
}>>


/* Private tasks, tasks for two, starting a task ==================================
   private: "room"         the other one of mom and sister has no task at the same place at the same time
   private: "afterHours"   that, and every action of it lies outside $company.workHours (the staff has gone home)
   pair: "task_..."        placing it places the partner task in the other column at the same rows (CMD Schedule); the
                           two entries share a pairId, are taken off the schedule together, and only start together

   setup.taskPrivacyIssue(task, sysName, startRow, endRow)   why the private task can not happen in those rows, or null
                                                             (read by the scheduler and when it starts)
   setup.taskPartner(task)                                   the live partner task of a task for two, or null
   setup.taskStartBlock(sysName, entry)                      checkTaskProgression: why the entry does not start
                                                             now ("rest", "energy", "private", "pair"), or null */
<<set setup.taskPrivacyIssue = (task, sysName, startRow, endRow) => {
    const v = State.variables;
    const live = setup.getLiveTask(task);
    if (!live || !live.private) { return null; }
    if (live.private === "afterHours") {
        for (let r = startRow; r < endRow; r++) {
            if (v.company.workHours[r] === true) { return "Only after work hours, when the staff has gone home"; }
        }
    }
    const other = sysName === "mom" ? "sister" : "mom";
    const day = v.date.dayCount;
    for (const e of (v.activeTasks[other] || [])) {
        if (!(e.startRow < endRow && e.endRow > startRow)) { continue; }
        if (e.missedDay === day || setup.taskRestsToday(e.task)) { continue; }
        const t = setup.getLiveTask(e.task);
        if (t && t.location && setup.sameLocation(t.location.id, live.location.id)) {
            return v[other].callName + " is there then (" + wikifyText(t.title) + ")";
        }
    }
    return null;
}>>

<<set setup.taskPartner = (task) => {
    const live = setup.getLiveTask(task);
    return (live && live.pair) ? (setup.getTaskById(live.pair) || null) : null;
}>>

<<set setup.taskStartBlock = (sysName, entry) => {
    const v = State.variables;
    const live = setup.getLiveTask(entry.task);
    if (!live) { return "rest"; }
    if (setup.taskRestsToday(live)) { return "rest"; }
    /* the whole cost, not just the base ("Energy cost" below) */
    if (!setup.taskHasEnergy(live, v[sysName])) { return "energy"; }
    if (setup.taskPrivacyIssue(live, sysName, entry.startRow, entry.endRow)) { return "private"; }
    const partner = setup.taskPartner(live);
    if (partner) {
        const other = sysName === "mom" ? "sister" : "mom";
        const pe = (v.activeTasks[other] || []).find((e) => e.pairId !== undefined && e.pairId === entry.pairId);
        if (!pe || setup.taskRestsToday(partner) || !setup.taskHasEnergy(partner, v[other])) { return "pair"; }
    }
    return null;
}>>


/* Stages in the picker ===========================================================
   setup.taskStageInfo(task)    { stage, of } for a task with stages (1-based), or null
   setup.taskStageNeeds(task)   what the next stage still waits for, in words without spoilers:
                                [ "2 more times", "her corruption stage 2", "something still has to happen" ],
                                [] when it only waits for the next run, null when there is no next stage */
<<set setup.taskStageInfo = (task) => {
    const live = setup.getLiveTask(task);
    if (!live || !Array.isArray(live.stages) || live.stages.length < 2) { return null; }
    return { stage: (Number(live.stage) || 0) + 1, of: live.stages.length };
}>>

<<set setup.taskStageNeeds = (task) => {
    const live = setup.getLiveTask(task);
    if (!live || !Array.isArray(live.stages)) { return null; }
    const next = live.stages[(Number(live.stage) || 0) + 1];
    if (!next) { return null; }
    const needs = [];
    const done = (Number(live.count) || 0) - (Number(live.stageStartCount) || 0);
    const more = (Number(next.minCount) || 0) - done;
    if (more > 0) { needs.push(more === 1 ? "1 more time" : more + " more times"); }
    if (next.corruptionStage !== undefined && setup.corruptionStage(live.who.sysName) < next.corruptionStage) {
        needs.push("her corruption stage " + next.corruptionStage);
    }
    if ((next.quest && !setup.questDone(next.quest)) || (next.requirements || []).some((req) => !req())) {
        needs.push((next.requirementsText || []).length ? wikifyText(next.requirementsText.join(", ")) : "something still has to happen");
    }
    return needs;
}>>

/* setup.taskHasReport(task)   the task (or one of its stages) leaves an entry in her end-of-day report */
<<set setup.taskHasReport = (task) => {
    const live = setup.getLiveTask(task);
    if (!live) { return false; }
    return !!live.report || (live.stages || []).some((stage) => !!stage.report);
}>>

/* New tasks in the picker =========================================================
   setup.taskIsNew(task)        unlocked, but I have never put it on the schedule: the picker shows a "New" badge,
                                in every row, the dimmed ones included. A task that is already on the schedule or has
                                run before (placed by the story or Skip Intro) is not new
   setup.markTaskPicked(task)   I put it on the schedule (window.placeTask): no longer new, its pair partner neither
   The flag is live.picked on the $tasks entry. */
<<set setup.taskIsNew = (task) => {
    const v = State.variables;
    const live = setup.getLiveTask(task);
    if (!live || !live.active || live.picked || (Number(live.count) || 0) > 0) { return false; }
    return ![ "mom", "sister" ].some((key) => (v.activeTasks[key] || []).some((e) => e.task.id === live.id));
}>>

<<set setup.markTaskPicked = (task) => {
    const live = setup.getLiveTask(task);
    if (!live) { return; }
    live.picked = true;
    const partner = live.pair ? setup.getTaskById(live.pair) : null;
    if (partner) { partner.picked = true; }
}>>


/* Team Spirit =================================================================
   The sister spends the task with whoever on the staff has the lowest morale. The pick is made the first time it is
   asked for on a day and kept for that day ($sister.flags.teamSpirit = { day, who }), so the CCTV, her POV passage,
   her report line and onComplete all name the same man. $sister.flags.teamSpiritName holds his name for the report line.
   setup.teamSpiritTarget()   the sysName of today's pick ("ethan", "brian", "darius"), or null without staff */
<<set setup.teamSpiritTarget = () => {
    const v = State.variables;
    const day = v.date.dayCount;
    const flags = v.sister.flags;
    if (flags.teamSpirit && flags.teamSpirit.day === day) { return flags.teamSpirit.who; }
    const staff = [ "ethan", "brian", "darius" ].filter((key) => (v.company.employees || []).some((e) => e.sysName === key) && v[key] && v[key].stats);
    if (!staff.length) { return null; }
    staff.sort((a, b) => v[a].stats.morale - v[b].stats.morale);
    flags.teamSpirit = { day: day, who: staff[0] };
    flags.teamSpiritName = v[staff[0]].name;
    return staff[0];
}>>

/* Energy cost ===================================================================
   A task costs her its baseEnergyCost, plus setup.taskEnergyTuning.perAction for every action it takes, plus a
   surcharge for the morale she is missing: (max morale - morale) * apCost / 10. So a 3-action task with base 15
   costs her 21 at full morale and 36 at morale 50. It only starts when she has that much (checkTaskProgression,
   StoryScript, through setup.taskStartBlock) and is paid when it ends (completeTaskEntry).
   Energy comes back overnight (a flat amount, Daily Update) and a little for every free task row of a weekday
   (an hour at her desk with nothing scheduled, checkTaskProgression).
   Balance (playtest 2026-11-24: it never ran out), simulated over three weeks at full morale: two short tasks a day
   stay around 80, three hold, four 2-action tasks a day (or the 4-action consultant job and two more) leave her
   near empty by Friday, and from there the expensive ones stop starting. The weekend fills her up again. Low
   morale makes all of it come sooner.
   setup.taskEnergyTuning                 the numbers
   setup.taskEnergyCost(task [, npc])     what it costs her right now (npc: her live object, default task.who)
   setup.taskHasEnergy(task [, npc])      she has enough to start it */
<<set setup.taskEnergyTuning to {
    perAction: 2,
    /* per free task row of a weekday, while no task of hers runs */
    idlePerRow: 1,
    /* overnight, every night (weekends too) */
    nightly: { mom: 30, sister: 35 },
}>>

<<set setup.taskEnergyCost = (task, npc) => {
    const her = npc || State.variables[task.who.sysName];
    const missingMorale = her.stats.max.morale - her.stats.morale;
    const actions = Number(task.apCost) || 0;
    return (Number(task.baseEnergyCost) || 0) + setup.taskEnergyTuning.perAction * actions + Math.round(missingMorale * actions / 10);
}>>

<<set setup.taskHasEnergy = (task, npc) => {
    const her = npc || State.variables[task.who.sysName];
    return her.stats.energy >= setup.taskEnergyCost(task, her);
}>>

/* Tasks with the player =======================================================
   A task with a "withPlayer" block is something mom/sister does WITH me (the massage in the meeting room, ...).
   It is scheduled like any other task, but it only happens when I'm there, and only if I say yes.

       withPlayer: {
           where:    [ 13 ],   location ids where I have to be when it starts (default: the task's location).
                               Locations of the same area count too: [ 13 ] (the office) includes My Desk
           prompt:   "...",    the question in the dialog when she shows up
           accept:   "...",    optional button text to start the scene (default "Let her")
           decline:  "...",    optional button text to send her away (default "Not now")
           summary:  "...",    notification when it finishes without its scene (a desk shortcut that spends several actions)
           waiting:  "...",    optional notification when it starts and I'm not there yet: I still have that
                               first action to get there (default: "<callName> is waiting for me at <place>.")
           missed:   "...",    notification when I don't make it in time. It then doesn't happen at all,
                               and she loses Relation and Morale for coming by for nothing (see below).
           declined: "...",    notification when I send her away (same effect as missed; falls back to "missed")
           missedCost: { relation: 1, morale: 3 },
                               what a missed or declined task costs her PER ACTION of the task (apCost),
                               so a long appointment I don't show up for hurts more than a quick one.
                               A stat that is left out (or the whole field) costs nothing.
       },
       stages: [ { activity, passage: "Scene Passage" }, ... ]   the scene comes from the current stage
                                                                (see "Task Stages" in the Story JavaScript)

   How it runs, per scheduled entry and day:
     1. checkTaskProgression starts it as usual (inProgress) when its first action comes and she has the energy.
     2. PassageReady calls <<CheckTaskScene>> after SetLocation. As soon as I'm in "where" while it runs,
        a dialog asks me (entry.offeredDay): accepting plays the stage passage (entry.sceneDay), declining
        or closing the dialog counts the same as not being there.
        Its first action is my time to get there: if I'm elsewhere when it starts, I only get the "waiting"
        notification (entry.waitingDay). It is missed (entry.missedDay) once that action is over and I'm
        still not there, so the walk over, which spends that action, arrives in time.
        A one-action task ends with that same action, so checkTaskProgression doesn't decide it then:
        allowTaskCompletion returns "wait" (entry.arrivalDay), and the next CheckTaskScene, where the walk
        lands, offers the scene or counts it as missed.
     3. The scene ends with <<EndTaskScene>>: it spends the task's remaining actions, so the task finishes
        the normal way (onComplete, count, stages), and goes back to my location. If no action is left
        (I walked in on a one-action task), setup.completeTaskSceneEntry() finishes it directly.
     4. When it finishes without a scene (several actions spent at once, like the desk shortcuts that work until
        the end of a task, so no passage showed while it started), it still counts if I'm in "where" (summary
        notification), otherwise it is missed. entry.doneDay stops it from finishing twice in one day.
   $taskScene { sysName, taskId, entryId, passage } is set while a scene runs.

   setup.isTaskWithPlayer(task)          true for a task with a withPlayer block
   setup.isPlayerAtTask(task)            am I where the task needs me right now?
   setup.checkTaskScenes()               PassageReady: { sysName, entryId } of a task to ask me about now, or null
                                         (also handles missed ones)
   setup.offerTaskScene(offer)           opens the dialog for that offer (after the passage has rendered)
   setup.acceptTaskScene(offer)          plays the scene
   setup.declineTaskScene(offer)         sends her away, like being somewhere else
   setup.allowTaskCompletion(entry)      checkTaskProgression: may this entry finish now? true, false
                                         or "wait" (keep it running until I've arrived somewhere)
   setup.completeTaskSceneEntry()        EndTaskScene: finishes the scene's entry when no action is left
   setup.notifyTaskWaiting(task)         the "she's waiting for me" notification (withPlayer.waiting or a default)
   setup.getTaskMissedCost(task)         { relation, morale } she would lose if it is missed or declined
   setup.missTaskWithPlayer(entry [, declined])
                                         marks the entry missed for today, costs her Relation and Morale,
                                         shows the notification
   setup.getTaskSceneActionsLeft()       actions the running scene still has to spend */

<<set setup.isTaskWithPlayer = (task) => {
    const live = setup.getLiveTask(task);
    return !!(live && live.withPlayer);
}>>

<<set setup.isPlayerAtTask = (task) => {
    const live = setup.getLiveTask(task);
    if (!live || !live.withPlayer) { return false; }
    const where = (live.withPlayer.where && live.withPlayer.where.length) ? live.withPlayer.where : [ live.location.id ];
    return where.some((id) => setup.sameLocation(id, State.variables.player.location));
}>>

<<set setup.getTaskMissedCost = (task) => {
    const live = setup.getLiveTask(task);
    const perAction = (live && live.withPlayer && live.withPlayer.missedCost) || {};
    const actions = Math.max(1, Number(live && live.apCost) || 1);
    return {
        relation: (Number(perAction.relation) || 0) * actions,
        morale: (Number(perAction.morale) || 0) * actions,
    };
}>>

<<set setup.missTaskWithPlayer = (entry, declined) => {
    const v = State.variables;
    const live = setup.getLiveTask(entry.task);
    entry.inProgress = false;
    entry.missedDay = v.date.dayCount;
    if (!live || !live.withPlayer) { return; }

    /* she came by for nothing: her Relation drops, her Morale too, scaled by how long the appointment was */
    const npc = v[live.who.sysName];
    const costs = setup.getTaskMissedCost(live);
    const lost = [];
    if (npc && npc.stats) {
        const statLabels = { relation: "Relation", morale: "Morale" };
        Object.keys(statLabels).forEach((key) => {
            const cost = costs[key];
            if (cost <= 0 || typeof npc.stats[key] !== "number") { return; }
            const min = (npc.stats.min && typeof npc.stats.min[key] === "number") ? npc.stats.min[key] : 0;
            const before = npc.stats[key];
            npc.stats[key] = Math.max(min, before - cost);
            if (before !== npc.stats[key]) { lost.push("-" + (before - npc.stats[key]) + " " + statLabels[key]); }
        });
    }

    const message = (declined && live.withPlayer.declined) || live.withPlayer.missed;
    if (message) {
        const text = wikifyText(message);
        Notification.show(text, { type: Notification.NEGATIVE });
    }
}>>

<<set setup.checkTaskScenes = () => {
    const v = State.variables;
    if (v.date.today.value > 4) { return null; }
    const row = v.time.current.value * v.time.actions.max + (v.time.actions.max - v.time.actions.left);
    const day = v.date.dayCount;

    for (const sysName of ["mom", "sister"]) {
        for (const entry of (v.activeTasks[sysName] || [])) {
            if (!setup.isTaskWithPlayer(entry.task)) { continue; }
            if (!entry.inProgress) { continue; }
            if (entry.offeredDay === day || entry.sceneDay === day || entry.missedDay === day || entry.doneDay === day) { continue; }
            /* a one-action task whose action is over: decided where my walk lands (see allowTaskCompletion) */
            const arriving = entry.arrivalDay === day;
            if (!arriving && (row < entry.startRow || row >= entry.endRow)) { continue; }

            const live = setup.getLiveTask(entry.task);
            const scene = setup.getTaskPassage(live);
            if (!setup.isPlayerAtTask(live)) {
                /* its first action is my time to get there */
                if (!arriving && row === entry.startRow) {
                    if (entry.waitingDay !== day) {
                        entry.waitingDay = day;
                        setup.notifyTaskWaiting(live);
                    }
                    continue;
                }
                setup.missTaskWithPlayer(entry);
                continue;
            }
            if (!scene || !Story.has(scene)) {
                console.error('setup.checkTaskScenes: task ' + live.id + ' has no scene passage "' + scene + '"');
                continue;
            }
            entry.offeredDay = day;
            return { sysName: sysName, entryId: entry.id };
        }
    }
    return null;
}>>

<<set setup.findTaskEntry = (offer) => {
    if (!offer) { return undefined; }
    return (State.variables.activeTasks[offer.sysName] || []).find((e) => e.id === offer.entryId);
}>>

<<set setup.acceptTaskScene = (offer) => {
    const v = State.variables;
    const entry = setup.findTaskEntry(offer);
    if (!entry) { return; }
    const live = setup.getLiveTask(entry.task);
    const scene = setup.getTaskPassage(live);
    entry.sceneDay = v.date.dayCount;
    v.taskScene = { sysName: offer.sysName, taskId: live.id, entryId: entry.id, passage: scene };
    v.eventJustTriggered = true;
    /* with a history entry, so tags() sees the scene (sidebar links and quick links are off) and a save keeps it */
    Engine.play(scene);
}>>

<<set setup.declineTaskScene = (offer) => {
    const entry = setup.findTaskEntry(offer);
    if (!entry) { return; }
    setup.missTaskWithPlayer(entry, true);
    if ($("#cmd-schedule").length) { $("#cmd-schedule").empty().wiki('<<include "CMD Schedule">>'); }
}>>

/* The dialog. Closing it (X, Escape, clicking outside) is the same as declining, otherwise the task would
   quietly count later through the "finishes without a scene" rule. */
<<set setup.offerTaskScene = (offer) => {
    setTimeout(() => {
        const entry = setup.findTaskEntry(offer);
        if (!entry) { return; }
        const live = setup.getLiveTask(entry.task);
        const wp = live.withPlayer;
        const npc = State.variables[offer.sysName];
        const v = State.variables;
        const cost = setup.getTaskMissedCost(live);
        const actions = Math.max(1, Number(live.apCost) || 1);
        const place = v.locations[live.location.id] ? wikifyText(v.locations[live.location.id].name) : "";

        let decided = false;
        if (Dialog.isOpen()) { Dialog.close(); }
        Dialog.setup(wikifyText(live.title), "task-offer");
        Dialog.append(function () {
            const card = $("<div class='tof'></div>");

            /* kicker: the kind of moment, plus the time of day */
            card.append($("<div class='tof-kicker'></div>").text("Appointment · " + v.time.current.text));

            /* who + what: portrait (her initial underneath, for a missing image), title, facts */
            const avatar = $("<div class='tof-avatar'></div>")
                .append($("<span class='tof-initial'></span>").text(String(npc.callName || "?").charAt(0)));
            $("<img alt=''>")
                .attr("src", v.path + "images/characters/portraits/" + npc.sysName + ".jpg")
                .on("error", function () { $(this).remove(); })
                .appendTo(avatar);
            const meta = $("<div class='tof-meta'></div>")
                .append($("<span class='tof-chip'></span>").text(npc.callName))
                .append(place ? $("<span class='tof-chip'></span>").text(place) : "")
                .append($("<span class='tof-chip'></span>").text(actions + (actions === 1 ? " action" : " actions")));
            const titles = $("<div class='tof-titles'></div>")
                .append($("<div class='tof-title'></div>").text(wikifyText(live.title)))
                .append(meta);
            card.append($("<div class='tof-head'></div>").append(avatar, titles));

            /* the moment itself */
            card.append($("<p class='tof-prompt'></p>").wiki(wp.prompt || (npc.callName + " is here for our appointment.")));

            /* what saying no costs */
            if (cost.relation > 0 || cost.morale > 0) {
                const consequence = $("<div class='tof-cost'></div>")
                    .append($("<span class='tof-cost-label'></span>").text("If I send her away"));
                if (cost.relation > 0) { consequence.append($("<span class='tof-cost-chip'></span>").text("−" + cost.relation + " Relation")); }
                if (cost.morale > 0) { consequence.append($("<span class='tof-cost-chip'></span>").text("−" + cost.morale + " Morale")); }
                card.append(consequence);
            }

            const declineButton = $("<button type='button' class='tof-btn tof-btn-ghost'></button>").wiki(wp.decline || "Not now");
            const acceptButton = $("<button type='button' class='tof-btn tof-btn-primary'></button>").wiki(wp.accept || "Let her");
            declineButton.on("click", () => { decided = true; Dialog.close(); setup.declineTaskScene(offer); });
            acceptButton.on("click", () => { decided = true; Dialog.close(); setup.acceptTaskScene(offer); });
            card.append($("<div class='tof-actions'></div>").append(declineButton, acceptButton));

            $(this).append(card);
        });
        Dialog.open(null, () => { if (!decided) { decided = true; setup.declineTaskScene(offer); } });
    }, 60);
}>>

<<set setup.allowTaskCompletion = (entry) => {
    const v = State.variables;
    const live = setup.getLiveTask(entry.task);
    if (!live || !live.withPlayer) { return true; }

    const day = v.date.dayCount;
    if (entry.doneDay === day || entry.missedDay === day) { return false; }
    if (entry.sceneDay !== day) {
        if (!setup.isPlayerAtTask(live)) {
            /* a one-action task ends with the action I may have spent walking over. My location only
               changes in the next PassageReady, so let CheckTaskScene decide there instead */
            const row = v.time.current.value * v.time.actions.max + (v.time.actions.max - v.time.actions.left);
            if (entry.offeredDay !== day && entry.arrivalDay !== day
                && row === entry.endRow && row === entry.startRow + 1) {
                entry.arrivalDay = day;
                return "wait";
            }
            setup.missTaskWithPlayer(entry);
            return false;
        }
        if (live.withPlayer.summary) {
            Notification.show(wikifyText(live.withPlayer.summary), { type: Notification.INFORMATION });
        }
    }
    entry.doneDay = day;
    return true;
}>>

<<set setup.notifyTaskWaiting = (task) => {
    const v = State.variables;
    const live = setup.getLiveTask(task);
    if (!live || !live.withPlayer) { return; }
    let text = live.withPlayer.waiting ? wikifyText(live.withPlayer.waiting) : "";
    if (!text) {
        const where = (live.withPlayer.where && live.withPlayer.where.length) ? live.withPlayer.where : [ live.location.id ];
        const places = where.map((id) => wikifyText(v.locations[id].name)).join(" or ");
        text = v[live.who.sysName].callName + " is waiting for me at " + places + ".";
    }
    Notification.show(text, { type: Notification.WARN });
}>>

<<set setup.completeTaskSceneEntry = () => {
    const v = State.variables;
    const scene = v.taskScene;
    if (!scene) { return; }
    const entry = (v.activeTasks[scene.sysName] || []).find((e) => e.id === scene.entryId);
    if (!entry || !entry.inProgress) { return; }
    if (setup.allowTaskCompletion(entry) === true) {
        window.completeTaskEntry(scene.sysName, entry);
    }
}>>

<<set setup.getTaskSceneActionsLeft = () => {
    const v = State.variables;
    const scene = v.taskScene;
    if (!scene) { return 0; }
    const entry = (v.activeTasks[scene.sysName] || []).find((e) => e.id === scene.entryId);
    if (!entry) { return 0; }
    const row = v.time.current.value * v.time.actions.max + (v.time.actions.max - v.time.actions.left);
    return Math.max(0, entry.endRow - row);
}>>


/* Task cooldown ===============================================================
   A task with cooldown: N (days) happens at most once every N days. Its entry stays in the schedule like any
   other (the schedule repeats every weekday), but on a resting day it does not start: she follows her routine
   in those rows instead, there is no scene, no pay, no energy cost and no missed penalty. The schedule block is
   greyed out for the day ("rest" in CMD Schedule).
   The rest is counted from lastCompletedAt with $date.dayCount, so weekends count too: cooldown 2 = every other
   day (done Monday, rests Tuesday, again Wednesday). Only a finished run starts the rest; a missed or declined
   one does not, so she comes back the next day.

   During The Silence (Define NPCs) the tasks of mom with me rest the same way, every day of that week.

   setup.taskNextDay(task)      the dayCount from which on it can run again (0: any day)
   setup.taskRestsToday(task)   true when it rests today (and did not already run today)
   setup.restsForSilence(task)  true for a task of mom with me during The Silence
   setup.taskRestText(task)     "again tomorrow" / "again in 2 days", for the schedule
   setup.taskCooldownText(task) "Every other day" / "Every 3 days", or "" without a cooldown */
<<set setup.taskNextDay = (task) => {
    const live = setup.getLiveTask(task);
    const cooldown = Number(live && live.cooldown) || 0;
    if (cooldown <= 0 || !((Number(live.count) || 0) > 0)) { return 0; }
    return (Number(live.lastCompletedAt) || 0) + cooldown;
}>>

<<set setup.taskRestsToday = (task) => {
    const live = setup.getLiveTask(task);
    const day = State.variables.date.dayCount;
    if (setup.restsForSilence(live)) { return true; }
    return !!live && live.lastCompletedAt !== day && day < setup.taskNextDay(live);
}>>

<<set setup.restsForSilence = (task) => {
    const live = setup.getLiveTask(task);
    return !!live && !!live.withPlayer && live.who.sysName === "mom" && setup.momSilent();
}>>

<<set setup.taskRestText = (task) => {
    if (setup.restsForSilence(task)) { return "not this week"; }
    const days = setup.taskNextDay(task) - State.variables.date.dayCount;
    return days <= 1 ? "again tomorrow" : "again in " + days + " days";
}>>

<<set setup.taskCooldownText = (task) => {
    const live = setup.getLiveTask(task);
    const cooldown = Number(live && live.cooldown) || 0;
    if (cooldown <= 1) { return ""; }
    return cooldown === 2 ? "Every other day" : "Every " + cooldown + " days";
}>>


/* Running tasks ===============================================================
   setup.getRunningTask()      the scheduled task (mom or sister) that is running right now and ends first,
                               { sysName, entry, task (the live task) }, or null when none runs
   setup.getRunningTaskEnd()   its endRow, or -1 when none runs. Used by the desk shortcut "Until ... is done"
                               (Define Quick Links). */
<<set setup.getRunningTask = () => {
    const v = State.variables;
    if (v.date.today.value > 4) { return null; }
    const row = v.time.current.value * v.time.actions.max + (v.time.actions.max - v.time.actions.left);
    let found = null;
    for (const sysName of ["mom", "sister"]) {
        for (const entry of (v.activeTasks[sysName] || [])) {
            if (!entry.inProgress || row < entry.startRow || row >= entry.endRow) { continue; }
            if (found === null || entry.endRow < found.entry.endRow) {
                found = { sysName: sysName, entry: entry, task: setup.getLiveTask(entry.task) };
            }
        }
    }
    return found;
}>>
<<set setup.getRunningTaskEnd = () => {
    const running = setup.getRunningTask();
    return running ? running.entry.endRow : -1;
}>>


/* The next task with me ===========================================================
   setup.getTaskPlaces(task)          location ids where I have to be for a task with me (withPlayer.where,
                                      or the task's own location)
   setup.getTaskPlace(task)           the location to go to for it: where I am if that counts already, else My Desk
                                      if that counts (it is part of the office area), else the first of its places
   setup.getNextTaskWithPlayer()      today's next task with me that can still happen, or null:
                                      { sysName, entry, task (the live task), waiting }
                                      waiting = it started with this very action and I'm not there yet, so its
                                      first action is my time to get there (see "Tasks with the player" above).
                                      Otherwise it lies ahead (startRow later than now). Entries that were already
                                      offered, played, missed or done today are skipped. Whether she has the energy
                                      to start it is not known yet, so it is not checked.
   Used by the quick links "work_task", "join_task" and "go_work" (Define Quick Links). */
<<set setup.getTaskPlaces = (task) => {
    const live = setup.getLiveTask(task);
    if (!live) { return []; }
    return (live.withPlayer && live.withPlayer.where && live.withPlayer.where.length) ? live.withPlayer.where : [ live.location.id ];
}>>

<<set setup.getTaskPlace = (task) => {
    const v = State.variables;
    const places = setup.getTaskPlaces(task);
    if (places.some((id) => setup.sameLocation(id, v.player.location))) { return v.player.location; }
    const desk = setup.getLocationBySysName("companystage1desk");
    if (desk && places.some((id) => setup.sameLocation(id, desk))) { return desk; }
    return v.locations[places[0]] || null;
}>>

<<set setup.getNextTaskWithPlayer = () => {
    const v = State.variables;
    if (v.date.today.value > 4) { return null; }
    const row = v.time.current.value * v.time.actions.max + (v.time.actions.max - v.time.actions.left);
    const day = v.date.dayCount;
    let next = null;
    for (const sysName of ["mom", "sister"]) {
        for (const entry of (v.activeTasks[sysName] || [])) {
            if (!setup.isTaskWithPlayer(entry.task)) { continue; }
            if (entry.offeredDay === day || entry.sceneDay === day || entry.missedDay === day || entry.doneDay === day) { continue; }
            if (setup.taskRestsToday(entry.task)) { continue; }
            const waiting = !!entry.inProgress && row === entry.startRow && !setup.isPlayerAtTask(entry.task);
            if (!waiting && row >= entry.startRow) { continue; }
            if (next === null || entry.startRow < next.entry.startRow) {
                next = { sysName: sysName, entry: entry, task: setup.getLiveTask(entry.task), waiting: waiting };
            }
        }
    }
    return next;
}>>
