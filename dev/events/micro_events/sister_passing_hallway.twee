:: Sister Passing Hallway [micro_event event nobr] {"position":"1550,2775","size":"100,100"}
/* Ambient: a few lines in passing, picked at random. Optional: stop and talk. */
<<Video "images/characters/sister/events/hallway/walking.mp4" "" "" 500>>
<<silently>>
<<set _pool to [
	[
		{ who: $sister, text: "Don't talk to me, I have three chapters to read and a headache that won't quit." },
		{ who: $player, text: "Good luck." }
	],
	[
		{ text: "She walks past with her headphones on, mouthing the lyrics, and doesn't notice me at all." }
	],
	[
		{ who: $sister, text: "Have you seen my keys? The ones with the little panda on them." },
		{ who: $player, text: "Did you check the couch?" },
		{ who: $sister, text: "Oh, that's actually smart. Thanks, little $sister.callPlayerShort." }
	],
	[
		{ who: $sister, text: "Just so you know, I used up all the hot water. I'd apologize, but I'm really not sorry." },
		{ who: $player, text: "Great. Thanks." }
	],
	[
		{ who: $sister, text: "I got front-row tickets for the concert in March, and I'm still not over it." },
		{ who: $player, text: "Lucky. Who's going with you?" },
		{ who: $sister, text: "Not you, if that's what you're asking." }
	],
	[
		{ text: "She shuffles past in sunglasses, indoors." },
		{ who: $sister, text: "Not one word. I mean it." }
	]
]>>
<<set _msgs to _pool.random()>>
<</silently>>
<<Chat _msgs>>
<br>
<div id="choice1" class="choices">
	<<link "Stop and talk for a minute">>
		<<replace "#choice1">>
			<<silently>>
			<<set _msgs to [
				{ who: $player, text: "Got a second?" },
				{ who: $sister, text: "About one, little $sister.callPlayerShort, so make it count." },
				{ who: $player, text: "Nothing, really. Just wanted to say hi." },
				{ who: $sister, text: "Hi. That was nice, bye." }
			]>>
			<</silently>>
			<<Chat _msgs>>
			<p>She grins over her shoulder as she disappears into her room.</p>
			<<UpdateStat "+" "SisterRelation" 1>>
		<</replace>>
	<</link>>
</div>
