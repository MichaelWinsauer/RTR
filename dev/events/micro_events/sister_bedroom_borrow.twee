:: Sister Bedroom Borrow [micro_event event nobr] {"position":"1050,2900","size":"100,100"}
/* Borrow request. Lending can leave her owing you a favour ($sister.flags.favorsOwed, one open favour at a time).
   Grows with her intimacy tier (MICRO_EVENTS_PLAN.md, <<MicroContext>>):
     0  the everyday version
     1  Conflicted: it's my gray hoodie she wants, and she doesn't give it back
     2  Yearning: after What Are We she asks by name, and an open favour can be called in. Offer: Sister Borrow Hands (it
        settles the favour). Before What Are We, no offer
     3  Devoted: the borrowing is an excuse, and she closes the door behind her. Offer: Sister Borrow Mouth */
<<MicroContext $sister>>
<<silent>>
<<set _bbOpen to _mc.tier >= 3 or (_mc.tier == 2 and setup.questDone("sister_whatAreWe"))>>
<<set _bbEager to _mc.lustBand == "high">>
<<set _item to (_mc.tier >= 1 ? either("gray hoodie", "gray hoodie", "phone charger", "headphones") : either("phone charger", "headphones", "black hoodie", "car keys"))>>
<</silent>>
<<if _mc.tier >= 3>>
	<p>$sister.callName comes in without knocking and shuts the door behind her, and leans on it.</p>
	<<silently>>
	<<if _bbEager>>
		<<set _msgs to [
			{ who: $sister, text: ("Can I borrow your " + _item + "? That's what I'm going to say if anybody asks why I'm in here.") },
			{ text: "She turns the key in the door behind her back without looking at it." },
		]>>
	<<else>>
		<<set _msgs to [
			{ who: $sister, text: ("Hey. Can I borrow your " + _item + "?") },
			{ text: "She's already wearing my gray hoodie. She doesn't move away from the door, and she doesn't look at the " + _item + " either." },
		]>>
	<</if>>
	<</silently>>
	<<Chat _msgs>>
<<elseif _mc.tier == 2 and _bbOpen>>
	<p>$sister.callName leans around my door frame, and then, instead of staying in the doorway the way she used to, she comes in and pushes the door shut behind her with her heel.</p>
	<<silently>>
	<<set _msgs to [
		{ who: $sister, text: ("$player.name, can I borrow your " + _item + "? Mine's somewhere in the black hole under my bed.") },
	]>>
	<</silently>>
	<<Chat _msgs>>
<<else>>
	<<silently>>
	<<set _msgs to [
		{ who: $sister, text: ("Hey, little $sister.callPlayerShort, can I borrow your " + _item + "? I've looked everywhere for mine and I'm already running late.") }
	]>>
	<</silently>>
	<p>$sister.callName leans around my door frame without knocking.</p>
	<<Chat _msgs>>
<</if>>
<div id="choice1" class="choices">
	<div>
		<<link "Lend it">>
			<<replace "#choice1">>
				<<silently>>
				<<if _item == "gray hoodie">>
					<<set _msgs to [
						{ who: $player, text: "Sure, just bring it back this time." },
						{ who: $sister, text: "Of course I'll bring it back. Eventually. At some point. When it stops smelling like you, probably." },
						{ text: "She pulls it on right there in the doorway, over whatever she was wearing, and pushes the sleeves up, and leaves with it. I already know I'm not getting it back. I'll see it on her in the kitchen tomorrow, and on the couch, and in the photos she posts, with the cuffs chewed." },
					]>>
				<<else>>
					<<set _msgs to [
						{ who: $player, text: "Sure, just bring it back this time." },
						{ who: $sister, text: "I always bring your stuff back. Eventually." }
					]>>
				<</if>>
				<</silently>>
				<<Chat _msgs>>
				<br>
				<<UpdateStat "+" "SisterRelation" 2>>
			<</replace>>
		<</link>>
	</div>
	<div>
		<<if $sister.flags.favorsOwed>>
			<span class="choice-locked">Lend it, and she owes you one<small>she already owes you a favor</small></span>
		<<else>>
			<<link "Lend it, and she owes you one">>
				<<replace "#choice1">>
					<<silently>>
					<<if _bbOpen>>
						<<set _msgs to [
							{ who: $player, text: "You can have it, but then you owe me one." },
							{ who: $sister, text: "A favor. Sure. I wonder what kind of favor you could possibly have in mind." },
							{ text: "She says it with a perfectly straight face, and takes the " + _item + ", and on her way out she looks back at me from the door to make sure I saw her not smiling." },
						]>>
					<<else>>
						<<set _msgs to [
							{ who: $player, text: "You can have it, but then you owe me one." },
							{ who: $sister, text: "Fine, one favor. Within reason, and I get to decide what's reasonable." }
						]>>
					<</if>>
					<</silently>>
					<<Chat _msgs>>
					<<set $sister.flags.favorsOwed to true>>
					<<UpdateStat "+" "SisterRelation" 1>>
				<</replace>>
			<</link>>
		<</if>>
	</div>
	<div>
		<<link "Say no">>
			<<replace "#choice1">>
				<<silently>>
				<<set _msgs to [
					{ who: $player, text: "Sorry, I actually need it today." },
					{ who: $sister, text: "Wow, okay. I'll remember that the next time you need something from me." }
				]>>
				<</silently>>
				<<Chat _msgs>>
				<<UpdateStat "-" "SisterRelation" 1>>
			<</replace>>
		<</link>>
	</div>
	<<if _bbOpen and _mc.tier >= 3>>
		<div>
			<<if _mc.offerLock>>
				<span class="choice-locked">Tell her to stay<small>_mc.offerLock</small></span>
			<<else>>
				<<link "Tell her to stay">><<MicroScene $sister "Sister Borrow Mouth">><</link>>
			<</if>>
		</div>
	<<elseif _bbOpen>>
		<div>
			<<if !$sister.flags.favorsOwed>>
				<span class="choice-locked">Call in your favor<small>she doesn't owe you one</small></span>
			<<elseif _mc.offerLock>>
				<span class="choice-locked">Call in your favor<small>_mc.offerLock</small></span>
			<<else>>
				<<link "Call in your favor">><<MicroScene $sister "Sister Borrow Hands">><</link>>
			<</if>>
		</div>
	<</if>>
</div>
