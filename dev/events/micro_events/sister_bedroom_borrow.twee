:: Sister Bedroom Borrow [micro_event event nobr] {"position":"1050,2900","size":"100,100"}
/* Borrow request. Lending can leave her owing you a favour ($sister.flags.favorsOwed, one open favour at a time). */
<<silently>>
<<set _item to either("phone charger", "headphones", "black hoodie", "car keys")>>
<<set _msgs to [
	{ who: $sister, text: ("Hey, little $sister.callPlayerShort, can I borrow your " + _item + "? I've looked everywhere for mine and I'm already running late.") }
]>>
<</silently>>
<p>$sister.callName leans around my door frame without knocking.</p>
<<Chat _msgs>>
<div id="choice1">
	<div>
		<<link "Lend it">>
			<<replace "#choice1">>
				<<silently>>
				<<set _msgs to [
					{ who: $player, text: "Sure, just bring it back this time." },
					{ who: $sister, text: "I always bring your stuff back. Eventually." }
				]>>
				<</silently>>
				<<Chat _msgs>>
				<br>
				<<UpdateStat "+" "SisterRelation" 2>>
			<</replace>>
		<</link>>
	</div>
	<div>
		<<if $sister.flags.favorsOwed>>
			<span style="opacity: .5;">Lend it, and she owes you one (she already owes you a favor)</span>
		<<else>>
			<<link "Lend it, and she owes you one">>
				<<replace "#choice1">>
					<<silently>>
					<<set _msgs to [
						{ who: $player, text: "You can have it, but then you owe me one." },
						{ who: $sister, text: "Fine, one favor. Within reason, and I get to decide what's reasonable." }
					]>>
					<</silently>>
					<<Chat _msgs>>
					<<set $sister.flags.favorsOwed to true>>
					<<UpdateStat "+" "SisterRelation" 1>>
				<</replace>>
			<</link>>
		<</if>>
	</div>
	<div>
		<<link "Say no">>
			<<replace "#choice1">>
				<<silently>>
				<<set _msgs to [
					{ who: $player, text: "Sorry, I actually need it today." },
					{ who: $sister, text: "Wow, okay. I'll remember that the next time you need something from me." }
				]>>
				<</silently>>
				<<Chat _msgs>>
				<<UpdateStat "-" "SisterRelation" 1>>
			<</replace>>
		<</link>>
	</div>
</div>
