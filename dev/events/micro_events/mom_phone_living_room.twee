:: Mom Phone Living Room [micro_event event nobr] {"position":"1425,2900","size":"100,100"}
/* Overheard call: listen in (she can catch you) or leave her to it. Her side of the call only. */
<<silently>>
<<set _calls to [
	[
		{ who: $mom, text: "No, I can't this weekend, I've got a mountain of laundry and I promised myself I'd finally clean out the fridge... yes, I know, I'm the most boring woman alive." },
		{ who: $mom, text: "Maybe next month? And tell Karen I said hi, and that I still want that recipe!" }
	],
	[
		{ who: $mom, text: "Oh, he's fine, he's working a lot. No, he doesn't tell me much, he's always been like that, even when he was little he'd just disappear into his room with some gadget for a whole weekend." },
		{ who: $mom, text: "I just want to know he's eating, that's all. Is that so much to ask?" }
	],
	[
		{ who: $mom, text: "Did you see the email? They moved the deadline to Friday?" },
		{ who: $mom, text: "Of course they did. Okay, fine, I'll stay late tomorrow, but I'm bringing snacks and I'm not sharing a single one with Gary." }
	]
]>>
<<if setup.questReached("mom_hasItTough")>>
	<<run _calls.push([
		{ who: $mom, text: "I can't keep covering for him forever. No, I'm not going to say anything, I don't want any trouble, you know how he gets when somebody questions him." },
		{ who: $mom, text: "I know, I know. I just need this week to be over, that's all." }
	])>>
	<<run _calls.push([
		{ who: $mom, text: "Oh, please don't tell me that, not today of all days." },
		{ who: $mom, text: "No, I'm fine, really, I am. Let me call you back later, okay?" }
	])>>
<</if>>
<<set _call to _calls.random()>>
<</silently>>
<p>$mom.callName is on the couch with her phone to her ear, speaking quietly. I can hear her voice from the hallway.</p>
<div id="choice1">
	<div>
		<<link "Listen in">>
			<<replace "#choice1">>
				<<if random(1, 100) <= Math.clamp(15 + Math.round($mom.stats.resistance / 2) - Math.round($mom.stats.relation / 10), 5, 70)>>
					<p>A floorboard creaks under my foot. She covers the phone with her hand and turns to look at me.</p>
					<<silently>>
					<<set _msgs to [
						{ who: $mom, text: "Sweetheart, this is a private call." },
						{ who: $player, text: "Sorry. I was just passing through." },
						{ who: $mom, text: "Then pass through a little faster, please." }
					]>>
					<</silently>>
					<<Chat _msgs>>
					<br>
					<<UpdateStat "-" "MomRelation" 3>>
					<<UpdateStat "+" "MomResistance" 3>>
				<<else>>
					<p>I stop just outside the doorway and listen.</p>
					<<set _msgs to _call>>
					<<Chat _msgs>>
					<p>She hangs up a minute later and sits there with the phone in her lap. I slip away before she sees me.</p>
				<</if>>
			<</replace>>
		<</link>>
	</div>
	<div>
		<<link "Leave her to it">>
			<<replace "#choice1">>
				<p>I leave her to it and go back the way I came.</p>
			<</replace>>
		<</link>>
	</div>
</div>
