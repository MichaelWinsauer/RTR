:: Sister Going Shower [micro_event event nobr] {"position":"1050,3025","size":"100,100"}
/* Insult teasing: she complains about the player hanging around the hallway. A pool of remarks, a few replies. */
<<silently>>
<<set _remark to either(
	"Why are you always hovering out here? It's a little creepy, you know.",
	"If you're just going to stand there, you could at least make yourself useful and start the coffee.",
	"And stop looking at me like you're plotting something. You've had that face since you were ten and it didn't work back then either.",
	"You know the hallway isn't a place where people hang out, right? Normal people have rooms for that."
)>>
<<set _msgs to [
	{ who: $sister, text: "Out of the way, little $sister.callPlayerShort, I need the bathroom before I head out." },
	{ who: $sister, text: _remark }
]>>
<</silently>>
<p>$sister.callName comes out of her room with a towel over one shoulder and a bottle of shampoo in her hand, heading straight for the bathroom.</p>
<<Chat _msgs>>
<div id="choice1">
	<div>
		<<link "Tease her back">>
			<<replace "#choice1">>
				<<silently>>
				<<set _msgs to [
					{ who: $player, text: "Relax, you're really not that interesting." },
					{ who: $sister, text: "Oh, that's adorable. Now move." }
				]>>
				<</silently>>
				<<Chat _msgs>>
				<br>
				<<if $sister.stats.relation >= 20>>
					<<UpdateStat "+" "SisterRelation" 1>>
				<<else>>
					<<UpdateStat "-" "SisterRelation" 1>>
				<</if>>
			<</replace>>
		<</link>>
	</div>
	<div>
		<<link "Brush it off">>
			<<replace "#choice1">>
				<<silently>>
				<<set _msgs to [
					{ who: $player, text: "I'm just passing through." },
					{ who: $sister, text: "Mm-hm. Sure you are." }
				]>>
				<</silently>>
				<<Chat _msgs>>
			<</replace>>
		<</link>>
	</div>
	<div>
		<<link "Apologize and step aside">>
			<<replace "#choice1">>
				<<silently>>
				<<set _msgs to [
					{ who: $player, text: "Sorry, go ahead." },
					{ who: $sister, text: "Thank you. That wasn't so hard, was it?" }
				]>>
				<</silently>>
				<<Chat _msgs>>
				<<UpdateStat "+" "SisterRelation" 1>>
			<</replace>>
		<</link>>
	</div>
</div>
