:: Breakfast {"position":"1100,1975"}
<<silent>>
<<set $mealType to "breakfast">>
<<set _meal to setup.pickMeal()>>
<</silent>>
<<include _meal.passage>>

<<UseAction>>
<<link "return" $player.location.passage>>
    <<set _meal.lastSeen to $date.dayCount>>
    <<run State.temporary.meal.set.forEach((set) => {
        set();
    })>>
<</link>>